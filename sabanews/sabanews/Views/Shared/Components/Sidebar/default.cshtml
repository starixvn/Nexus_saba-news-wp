<div class="block block-new">
	<h2 class="title-page">
		<a href="detail.html" class="heading">Tin Mới Nhất</a>
	</h2>
	<div class="main-card card-partial-news">
		@foreach (var post in Model)
	{
		<div class="card-items hot-news">
			<div class="row">
				<div class="col col-3">
					<div class="img-columns">
						<picture>
							<source srcset="@post.FeatureImage" type="image/webp">
							<source srcset="@post.FeatureImage" type="image/jpeg">
							<img src="@post.FeatureImage" alt="Alt Text!">
						</picture>
					</div>
				</div>
				<div class="col col-9">
					<div class="content-box">
						<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @post.ID })" class="heading">@post.PostTitle</a></h4>
						<div class="group-date-times">
							<p class="date-time">@post.PostDate</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
	</div>
</div>
