<div class="block block-new">
	<h2 class="title-page">
		<a href="detail.html" class="heading">Tin Mới Nhất</a>
	</h2>
	<div class="main-card card-partial-news">
		@foreach (var post in Model.Posts)
		{
		<div class="card-items hot-news">
			<div class="row">
				<div class="col col-3">
					<div class="img-columns">
						<picture>
							<source srcset="@post.FeatureImage" type="image/webp">
							<source srcset="@post.FeatureImage" type="image/jpeg">
							<img src="@post.FeatureImage" alt="Alt Text!">
						</picture>
					</div>
				</div>
				<div class="col col-9">
					<div class="content-box">
						<h4 class="title-box"><a href="@Url.Action("Single", "Home", new { ID = @post.ID })" class="heading">@post.PostTitle</a></h4>
						<div class="group-date-times">
							<p class="date-time">@post.PostDate</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		}
	</div>
</div>
<div class="block block-calendar">
	<h2 class="title-page">
		<a href="" class="heading">Lịch</a>
	</h2>
	<div class="main-card card-partial-news">
		<div class="box-calendar">
			<div class="date-year">Tháng @Model.CurrentMonth Năm @Model.CurrentYear</div>
			<table class="table-calendar">
				<thead>
					<tr>
						<th scope="col" title="Monday">T2</th>
						<th scope="col" title="Tuesday">T3</th>
						<th scope="col" title="Wednesday">T4</th>
						<th scope="col" title="Thursday">T5</th>
						<th scope="col" title="Friday">T6</th>
						<th scope="col" title="Saturday">T7</th>
						<th scope="col" title="Sunday">CN</th>
					</tr>
				</thead>
				<tbody>
					@{
						var colSpan = Model.FirstDayOfWeek - 1;
						var dayOfFirstWeek = 8 - Model.FirstDayOfWeek;
						var month = Model.CurrentMonth > 10 ? Model.CurrentMonth : "0" + Model.CurrentMonth;
						int weeks = (int)Math.Ceiling((Model.Days - 1) / 7.0);

					}
					<tr>
						<td colspan="@colSpan">&nbsp;</td>
						@for (int i = 1; i <= dayOfFirstWeek; i++)
						{
							<td class="lastday"><a href="detail.html" class="prev">@i</a></td>
						}
					</tr>

					@for (int week = 1; week <= weeks; week++)
					{
						var start = dayOfFirstWeek + 1 + (week - 1) * 7;
						var end = (start + 7 > Model.Days) ? Model.Days + 1 : start + 7;
						<tr>
							@for (int day = start; day < end; day++)
							{
								var lastday = "";
								var today = "";
								var date = Model.CurrentYear + "-" + month + "-" + day;
								if (day < Model.CurrentDay)
								{
									lastday = "lastday";
								}
								else if (day == Model.CurrentDay)
								{
									today = "today";
								}
								<td class="@lastday @date" id="@today">@day</td>
							}
						</tr>
					}
					
				</tbody>
				</table>
			<div class="calendar-prev">
				<a href="detail.html" class="prev">« Th10</a>
			</div>
		</div>
	</div>
</div>