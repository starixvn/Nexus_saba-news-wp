@section Styles{
	<link rel="stylesheet" href="~/css/news.css">
}
<section class="main">
	<div class="container">
		<div class="column-main">
			<div class="block block-hot-news">
				<div class="main-card">
					@foreach (var post in Model)
					{
						<div class="card-items">
							<div class="row align-items-center">
								<div class="col col-3">
									<div class="img-columns horizontal">
										<picture>
											<source srcset="@post.FeatureImage" type="image/webp">
											<source srcset="@post.FeatureImage" type="image/jpeg">
											<img src="@post.FeatureImage" alt="Alt Text!">
										</picture>
									</div>
								</div>
								<div class="col col-9">
									<div class="content-box ml-column">
										<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @post.ID })" class="heading">@post.PostTitle</a></h4>
										<p class="date-time">@post.PostDate</p>
										<div class="description">@post.PostExcerpt</div>
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
			@{
				int CurrentPage = Convert.ToInt32(ViewData["CurrentPage"]);
				int TotalPages = Convert.ToInt32(ViewData["TotalPages"]);
				var linkLast = Url.Action("Category", "Home", new { cateId = ViewData["CategoryId"], page = @ViewData["TotalPages"] });
				var linkFirst = Url.Action("Category", "Home", new { cateId = ViewData["CategoryId"], page = 1 });
				if (ViewData["controller"].ToString() == "Search")
				{
					linkLast = Url.Action("Search", "Home", new { keyword = ViewData["keyword"], page = @ViewData["TotalPages"] });
					linkFirst = Url.Action("Search", "Home", new { keyword = ViewData["keyword"], page = 1 });
				}
				else if (ViewData["controller"].ToString() == "Tag")
				{
					linkLast = Url.Action("Tag", "Home", new { keyword = ViewData["tag"], page = @ViewData["TotalPages"] });
					linkFirst = Url.Action("Tag", "Home", new { keyword = ViewData["tag"], page = 1 });
				}
			}
			<div class="pagination">
				<ul class="main-pagination">
					@if (TotalPages > 1)
					{
						var front = (CurrentPage - 1 > 2) ? 2 : CurrentPage - 1;
						front = (CurrentPage - 1 == 3) ? 3 : front;
						var back = (TotalPages - CurrentPage > 2) ? 2 : TotalPages - CurrentPage;
						back = (TotalPages - CurrentPage == 3) ? 3 : back;

						if (CurrentPage - 4 >= 1)
						{
							<li class="items-pagination"><a href="@linkFirst" class="item">1</a></li>
							<li class="items-pagination"><a class="item">...</a></li>
						}

						for (var i = CurrentPage - front; i <= CurrentPage + back; i++)
						{
							var link = Url.Action("Category", "Home", new { cateId = ViewData["CategoryId"], page = i });
							if (ViewData["controller"].ToString() == "Search")
							{
								link = Url.Action("Search", "Home", new { keyword = ViewData["keyword"], page = i });
							}
							else if (ViewData["controller"].ToString() == "Tag")
							{
								link = Url.Action("Tag", "Home", new { tag = ViewData["tag"], page = i });
							}
							var active = i == CurrentPage ? "active" : "";
							<li class="items-pagination @active"><a href="@link" class="item">@i</a></li>
						}

						if (CurrentPage + 4 <= TotalPages)
						{
							<li class="items-pagination"><a class="item">...</a></li>
							<li class="items-pagination"><a href="@linkLast" class="item">@ViewData["TotalPages"]</a></li>
						}
					}
				</ul>
			</div>

			@(await Component.InvokeAsync("Sidebar"))
		</div>
	</div>
</section>