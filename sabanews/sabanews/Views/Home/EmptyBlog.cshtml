@section Styles{
	<link rel="stylesheet" href="~/css/news.css">
}
<section class="main">
	<div class="container">
		<div class="row">
			<div class="col col-8 pd-column-left">
				<div class="block block-hot-detail">
					<h2 class="title-block"><a href="detail_news.html">@ViewData["HeadTitle"]</a></h2>
					<h2>No Found Any Post</h2>
				</div>
			</div>


			@if (ViewData["Controller"].ToString() == "DateSearch")
			{
				var countDate = ViewData["Date"].ToString().Split('-');
				if (countDate.Count() >= 2)
				{
					@(await Component.InvokeAsync("Sidebar", new { year = Convert.ToInt32(countDate[0]), month = Convert.ToInt32(countDate[1]) }))
				}
				else
				{
					@(await Component.InvokeAsync("Sidebar"))
				}
			}
			else
			{
				@(await Component.InvokeAsync("Sidebar"))
			}
		</div>
	</div>
</section>