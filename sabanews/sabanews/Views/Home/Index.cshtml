@{
	ViewData["Title"] = "Trang tin tức thể thao mới nhất, cập nhật liên tục";
	ViewData["CategoryId"] = 587;
}
@section Styles{
	<link rel="stylesheet" href="~/css/home.css">
}

<section class="main">
	<div class="container">
		<div class="column-main">
			<div class="block block-hot-news">
				<h2 class="title-page">
					<a href="#" class="heading">TIN MỚI NHẤT</a>
				</h2>
				<div class="main-card">
					@foreach (var post in Model.NewPosts)
					{
						<div class="card-items">
							<div class="row align-items-center">
								<div class="col col-3">
									<div class="img-columns horizontal">
										@if (post.FeatureImage != string.Empty)
										{
											<picture>
												<source srcset="@post.FeatureImage" type="image/webp">
												<source srcset="@post.FeatureImage" type="image/jpeg">
												<img src="@post.FeatureImage" this.src='@post.FeatureImage' alt="Alt Text!">
											</picture>
										}
									</div>
								</div>
								<div class="col col-9">
									<div class="content-box ml-column">
										<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = post.ID })" class="heading">@post.PostTitle</a></h4>
										<p class="date-time">@post.PostDate</p>
										<div class="description">@post.PostExcerpt</div>
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			</div>


			<div class="block block-soccer">
				<h2 class="title-page">
					<a href="#" class="heading">Bóng Đá</a>
				</h2>
				<div class="main-card">
					<div class="card-items">
						<div class="img-columns main-img">
							<picture>
								<source srcset="@Model.FootballPosts[0].FeatureImage" type="image/webp">
								<source srcset="@Model.FootballPosts[0].FeatureImage" type="image/jpeg">
								<img src="@Model.FootballPosts[0].FeatureImage" alt="Alt Text!">
							</picture>
						</div>
						<div class="content-box">
							<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @Model.FootballPosts[0].ID })" class="heading">@Model.FootballPosts[0].PostTitle</a></h4>
							<p class="date-time">@Model.FootballPosts[0].PostDate</p>
							<div class="description">@Model.FootballPosts[0].PostExcerpt</div>
						</div>
						<div class="child-grid">
							@for (int i = 1; i < Model.FootballPosts.Count; i++)
							{
								<div class="card-child">
									<div class="img-columns">
										<picture>
											<source srcset="@Model.FootballPosts[i].FeatureImage" type="image/webp">
											<source srcset="@Model.FootballPosts[i].FeatureImage" type="image/jpeg">
											<img src="@Model.FootballPosts[i].FeatureImage" alt="Alt Text!">
										</picture>
									</div>
									<div class="content-box">
										<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @Model.FootballPosts[i].ID })" class="heading">@Model.FootballPosts[i].PostTitle</a></h4>
										<p class="date-time">@Model.FootballPosts[i].PostDate</p>
										<div class="description">@Model.FootballPosts[i].PostExcerpt</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
			<div class="block block-basketball">
				<h2 class="title-page">
					<a href="#" class="heading">Bóng Rổ</a>
				</h2>
				<div class="main-card">
					<div class="card-items">
						<div class="img-columns main-img">
							<picture>
								<source srcset="@Model.BasketballPosts[0].FeatureImage" type="image/webp">
								<source srcset="@Model.BasketballPosts[0].FeatureImage" type="image/jpeg">
								<img src="@Model.BasketballPosts[0].FeatureImage" alt="Alt Text!">
							</picture>
						</div>
						<div class="content-box">
							<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @Model.BasketballPosts[0].ID })" class="heading">@Model.BasketballPosts[0].PostTitle</a></h4>
							<p class="date-time">@Model.BasketballPosts[0].PostDate</p>
							<div class="description">@Model.BasketballPosts[0].PostExcerpt</div>
						</div>
					</div>
					<ul class="block-list-content">
						@for (int i = 1; i < Model.BasketballPosts.Count; i++)
						{
							<li class="block-list"><a href="@Url.Action("Single", "Home", new {ID = @Model.BasketballPosts[i].ID })" class="title-change item-list"><i class="icon-right-arrow"></i> @Model.BasketballPosts[i].PostTitle</a></li>
						}
					</ul>
				</div>
			</div>
			<div class="block block-tennis">
				<h2 class="title-page">
					<a href="#" class="heading">Quần vợt</a>
				</h2>
				<div class="main-card">
					<div class="card-items">
						<div class="img-columns">
							<picture>
								<source srcset="@Model.TennisPosts[0].FeatureImage" type="image/webp">
								<source srcset="@Model.TennisPosts[0].FeatureImage" type="image/jpeg">
								<img src="@Model.TennisPosts[0].FeatureImage" alt="Alt Text!">
							</picture>
						</div>
						<div class="content-box">
							<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @Model.TennisPosts[0].ID })" class="heading">@Model.TennisPosts[0].PostTitle</a></h4>
							<p class="date-time">@Model.TennisPosts[0].PostDate</p>
							<div class="description">@Model.TennisPosts[0].PostExcerpt</div>
						</div>
					</div>
					<ul class="block-list-content">
						@for (int i = 1; i < Model.TennisPosts.Count; i++)
						{
							<li class="block-list"><a href="@Url.Action("Single", "Home", new {ID = @Model.TennisPosts[i].ID })" class="title-change item-list"><i class="icon-right-arrow"></i> @Model.TennisPosts[i].PostTitle</a></li>
						}
					</ul>
				</div>
			</div>
			<div class="swiper-container block block-swipper">
				<div class="swiper-wrapper">
					@foreach (var post in Model.VideoPosts)
					{
						<div class="swiper-slide">
							<div class="card card-video">
								<div class="card-items">
									<div class="img-columns">
										<picture>
											<source srcset="@post.FeatureImage" type="image/webp">
											<source srcset="@post.FeatureImage" type="image/jpeg">
											<img src="@post.FeatureImage" alt="Alt Text!">
										</picture>
										<div class="btn-play-video">
											<span class="icon-play-button-arrowhead"></span>
										</div>
									</div>
									<div class="play_video">@Html.Raw(@post.PostContent)</div>
									<div class="content-box">
										<p class="date-time">@post.PostDate</p>
										<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @post.ID })" class="heading">@post.PostTitle</a></h4>
									</div>
								</div>
							</div>
						</div>
					}

				</div>
				<div class="swiper-pagination"></div>
			</div>
			<div class="block block-guess">
				<h2 class="title-page">
					<a href="#" class="heading">Nhận định - dự đoán</a>
				</h2>
				<div class="main-card">
					<div class="card-items">
						<div class="img-columns">
							<picture>
								<source srcset="@Model.GuessPosts[0].FeatureImage" type="image/webp">
								<source srcset="@Model.GuessPosts[0].FeatureImage" type="image/jpeg">
								<img src="@Model.GuessPosts[0].FeatureImage" alt="Alt Text!">
							</picture>
						</div>
						<div class="content-box">
							<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @Model.GuessPosts[0].ID })" class="heading">@Model.GuessPosts[0].PostTitle</a></h4>
							<p class="date-time">@Model.GuessPosts[0].PostDate</p>
							<div class="description">@Model.GuessPosts[0].PostExcerpt</div>
						</div>
						<div class="child-grid">
							@for (int i = 1; i < Model.GuessPosts.Count; i++)
							{
								<div class="card-child">
									<div class="img-columns">
										<picture>
											<source srcset="@Model.GuessPosts[i].FeatureImage" type="image/webp">
											<source srcset="@Model.GuessPosts[i].FeatureImage" type="image/jpeg">
											<img src="@Model.GuessPosts[i].FeatureImage" alt="Alt Text!">
										</picture>
									</div>
									<div class="content-box">
										<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @Model.GuessPosts[i].ID })" class="heading">@Model.GuessPosts[i].PostTitle</a></h4>
										<p class="date-time">@Model.GuessPosts[0].PostDate</p>
										<div class="description">@Model.GuessPosts[i].PostExcerpt</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			</div>

			<div class="block block-behind">
				<h2 class="title-page">
					<a href="#" class="heading">HẬU TRƯỜNG</a>
				</h2>
				<div class="main-card">
					<div class="card-items">
						<div class="img-columns">
							<picture>
								<source srcset="@Model.BackstagePosts[0].FeatureImage" type="image/webp">
								<source srcset="@Model.BackstagePosts[0].FeatureImage" type="image/jpeg">
								<img src="@Model.BackstagePosts[0].FeatureImage" alt="Alt Text!">
							</picture>
						</div>
						<div class="content-box">
							<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @Model.BackstagePosts[0].ID })" class="heading">@Model.BackstagePosts[0].PostTitle</a></h4>
							<p class="date-time">@Model.BackstagePosts[0].PostDate</p>
							<div class="description">@Model.BackstagePosts[0].PostExcerpt</div>
						</div>
						<div class="child-grid">
							@for (int i = 1; i < Model.BackstagePosts.Count; i++)
							{
								<div class="card-child">
									<div class="img-columns">
										<picture>
											<source srcset="@Model.BackstagePosts[i].FeatureImage" type="image/webp">
											<source srcset="@Model.BackstagePosts[i].FeatureImage" type="image/jpeg">
											<img src="@Model.BackstagePosts[i].FeatureImage" alt="Alt Text!">
										</picture>
									</div>
									<div class="content-box">
										<h4 class="title-box"><a href="@Url.Action("Single", "Home", new {ID = @Model.BackstagePosts[i].ID })" class="heading">@Model.BackstagePosts[i].PostTitle</a></h4>
										<p class="date-time">@Model.BackstagePosts[i].PostDate</p>
										<div class="description">@Model.BackstagePosts[i].PostExcerpt</div>
									</div>
								</div>
							}

						</div>
					</div>
				</div>
			</div>
			<div class="block block-transfer">
				<h2 class="title-page">
					<a href="" class="heading">THỊ TRƯỜNG CHUYỂN NHƯỢNG</a>
				</h2>
				<div class="main-card">
					<ul class="block-list-content">
						@foreach (var post in Model.TransferPosts)
						{
							<li class="block-list"><a href="@Url.Action("Single", "Home", new {ID = @post.ID })" class="item-list"><i class="icon-right-arrow"></i> @post.PostTitle</a></li>

						}
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>