@section Styles{
	<link rel="stylesheet" href="~/css/detailnews.css">
}
@{
	ViewData["Title"] = Model.SinglePost.PostTitle;
}
<section class="main">
	<div class="container">
		<div class="row">
			<div class="col col-8 pd-column-left">
				<div class="block block-detail-news">
					<div class="block-vertical block-detail">
						<div class="img-item">
							<picture>
								<source srcset="@Model.SinglePost.FeatureImage" type="image/webp" class="img-res">
								<source srcset="@Model.SinglePost.FeatureImage" type="image/jpeg" class="img-res">
								<img src="@Model.SinglePost.FeatureImage" alt="Alt Text!" class="img-res img-block">
							</picture>
						</div>
						<div class="block-text">
							<div class="heading">
								<a href="#">
									@Model.SinglePost.PostTitle
								</a>
							</div>
							<p class="block-time">@Model.SinglePost.PostDate</p>
						</div>
					</div>

					<div class="content">
						@Html.Raw(Model.SinglePost.PostContent)
					</div>


					<ul class="block-list">
						@foreach (var post in Model.RelatedPosts)
						{
							<li class="list-item"><a href="@Url.Action("Single", "Home", new { ID = @post.ID })" class="item"><i class="icon-content icon-sport-soccer"></i> @post.PostTitle</a></li>
						}
					</ul>

					@{
						var absoluteLink = ViewData["BaseUrl"] + Url.Action("Single", "Home", new { ID = @Model.SinglePost.ID });
					}
					<ul class="social">
						<li class="item-social">Chia sẻ:</li>
						<li class="item-social"><a href="https://twitter.com/intent/tweet?url=@absoluteLink&text=@Model.SinglePost.PostTitle" data-count="twitter" target="_blank" rel="nofollow" class="item"><i class="icon-social icon-social-twitter"></i></a></li>
						<li class="item-social"><a href="http://www.facebook.com/sharer/sharer.php?u=@absoluteLink" data-count="facebook" target="_blank" rel="nofollow" class="item"><i class="icon-social icon-social-facebook"></i></a></li>
						<li class="item-social"><a href="http://pinterest.com/pin/create/link/?url=@absoluteLink" data-count="pinterest-circled" target="_blank" rel="nofollow" class="item"><i class="icon-social icon-social-pinterest"></i></a></li>
						<li class="item-social"><a href="https://t.me/share/url?url=@absoluteLink&text=@Model.SinglePost.PostTitle" data-count="telegram" target="_blank" rel="nofollow" class="item"><i class="icon-social icon-social-telegram"></i></a></li>
					</ul>
					<ul class="tag-post">
						@if (Model.SinglePost.Tags != "")
						{
							var tags = Model.SinglePost.Tags.Split(',');
							@foreach (var tag in tags)
							{
								<li class="tag-item"><a href="@Url.Action("Tag", "Home", new { tag = tag })" class="tag">@tag</a></li>
							}
						}
					</ul>
				</div>


				<div class="block block-care">
					<h2 class="title-block"><a href="#">CÓ THỂ BẠN QUAN TÂM</a></h2>
					@foreach (var post in Model.RandomRelatedPosts)
					{
						<div class="block-horizontal">
							<div class="block-item">
								<div class="flex-item">
									<div class="img-item">
										<a href="@Url.Action("Single", "Home", new {ID = @post.ID })">
											<picture>
												<source srcset="@post.FeatureImage" type="image/webp" class="img-res">
												<source srcset="@post.FeatureImage" type="image/jpeg" class="img-res">
												<img src="@post.FeatureImage" alt="Alt Text!" class="img-res img-block">
											</picture>
										</a>
									</div>
									<div class="block-text">
										<div class="heading"><a href="@Url.Action("Single", "Home", new {ID = @post.ID })">@post.PostTitle</a></div>
										<p class="block-time">@post.PostDate</p>
										<p class="description text-description">@post.PostExcerpt</p>
									</div>
								</div>
							</div>
						</div>
					}
					
				</div>
			</div>
			@(await Component.InvokeAsync("Sidebar"))
		</div>
	</div>
</section>