@using sabanews.Constants;
@section Styles{
	<link rel="stylesheet" href="~/styles/pages/video.css">
}

	<section class="main">
		<div class="container">
			<div class="block block-main">
				<h2 class="block__title"><a>@(ViewData["Title"] != null ? ViewData["Title"] : Model[0].Categories )</a></h2>
				<div class="block__swipper">
					<div class="swiper-container">
						<div class="swiper-wrapper">
							<div class="swiper-slide">
								<div class="img-item">
									<input type="hidden" name="iframe_value" value="@Model[0].PostContent" />
									<picture>
										<source srcset="@Url.Content(Model[0].FeatureImage)" type="image/webp">
										<source srcset="@Url.Content(Model[0].FeatureImage)" type="image/jpeg">
										<img src="@Url.Content(Model[0].FeatureImage)" alt="Alt Text!">
									</picture>
									<div class="btn-play-video">
										<span class="icon-play"></span>
									</div>
								</div>
								<div class="play_video"></div>
								<div class="content-box">
									<h4 class="title-box"><a href="@Url.Action("Single", "Home", new { slug = Model[0].Slug })" class="heading">@Model[0].PostTitle</a></h4>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="block__video">
					@for (int i = 1; i < Model.Count; i++)
					{
						<div class="card-vertical card-vertical-highlight">
							<a href="@Url.Action("Single", "Home", new { slug = Model[i].Slug })" class="card-vertical__image">
								<picture>
									<source srcset="@Url.Content(Model[i].FeatureImage)" type="image/webp" class="img-res">
									<source srcset="@Url.Content(Model[i].FeatureImage)" type="image/jpeg" class="img-res">
									<img src="@Url.Content(Model[i].FeatureImage)" alt="Alt Text!" class="img-res img-block">
								</picture>
							</a>
							<a href="@Url.Action("Single", "Home", new { slug = Model[i].Slug })" class="card-vertical__title">@Model[i].PostTitle</a>
							<p class="card-vertical__datetime">@Model[i].PostDate</p>
						</div>
					}

				</div>
				@{
					int CurrentPage = Convert.ToInt32(ViewData["CurrentPage"]);
					int TotalPages = Convert.ToInt32(ViewData["TotalPages"]);
					var linkLast = Url.Action("Category", "Home", new { page = @ViewData["TotalPages"] });
					var linkFirst = Url.Action("Category", "Home", new { page = 1 });
					var linkNext = Url.Action("Category", "Home", new { page = CurrentPage + 1 });
					var linkPrev = Url.Action("Category", "Home", new { page = CurrentPage - 1 });

					linkPrev = CurrentPage > 1 ? linkPrev : "javascript:;";
					linkNext = CurrentPage < TotalPages ? linkNext : "javascript:;";
				}
				@if (TotalPages > 1)
				{
					<div class="pagination">
						<a href="@linkFirst" class="icon-pagination icon-page-first"></a>
						<a href="@linkPrev" class="icon-pagination icon-chevron-left"></a>
						<ul class="main-pagination">
							@{
								var front = (CurrentPage - 1 > 2) ? 2 : CurrentPage - 1;
								front = (CurrentPage - 1 == 3) ? 3 : front;
								var back = (TotalPages - CurrentPage > 2) ? 2 : TotalPages - CurrentPage;
								back = (TotalPages - CurrentPage == 3) ? 3 : back;

								if (CurrentPage - 4 >= 1)
								{
									<li class="items-pagination"><a href="@linkFirst" class="item">1</a></li>
									<li class="items-pagination"><a class="item">...</a></li>
								}

								for (var i = CurrentPage - front; i <= CurrentPage + back; i++)
								{
									var link = Url.Action("Category", "Home", new { page = i });

									var active = i == CurrentPage ? "active" : "";
									<li class="items-pagination @active"><a href="@link" class="item">@i</a></li>
								}

								if (CurrentPage + 4 <= TotalPages)
								{
									<li class="items-pagination"><a class="item">...</a></li>
									<li class="items-pagination"><a href="@linkLast" class="item">@ViewData["TotalPages"]</a></li>
								}
							}
						</ul>
						<a href="@linkNext" class="icon-pagination icon-chevron-right"></a>
						<a href="@linkLast" class="icon-pagination icon-page-last"></a>
					</div>
				}
			</div>

			@if (ViewData["Controller"].ToString() == "DateSearch")
			{
				var countDate = ViewData["Date"].ToString().Split('-');
				if (countDate.Count() == 2)
				{
					@(await Component.InvokeAsync("Sidebar", new { year = Convert.ToInt32(countDate[0]), month = Convert.ToInt32(countDate[1]) }))
				}
				else
				{
					@(await Component.InvokeAsync("Sidebar"))
				}
			}
			else
			{
				@(await Component.InvokeAsync("Sidebar"))
			}
		</div>
	</section>