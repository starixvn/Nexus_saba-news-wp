<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net5.0</TargetFramework>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
        <CodeAnalysisRuleSet>..\..\.sonarlint\sabanewscsharp.ruleset</CodeAnalysisRuleSet>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="App_Data\SpNames.GC.xml" />
        <None Remove="App_Data\SpNames.LOCAL.xml" />
        <None Remove="App_Data\SpNames.PROD.xml" />
        <None Remove="App_Data\SpNames.UAT.xml" />
        <None Remove="App_Data\SpNames.xml" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\..\.sonarlint\sabanews\CSharp\SonarLint.xml" Link="SonarLint.xml" />
        <Content Include="App_Data\SpNames.GC.xml">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.LOCAL.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.PROD.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.UAT.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="5.0.0" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.10.13" />
        <PackageReference Include="MQTTnet" Version="3.1.2" />
        <PackageReference Include="StackExchange.Redis" Version="2.5.43" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SabaNews.Core\SabaNews.Core.csproj" />
        <ProjectReference Include="..\SabaNews.Livescore.Provider.API\SabaNews.Livescore.Provider.API.csproj" />
        <ProjectReference Include="..\SabaNews.Livescore.Services\SabaNews.Livescore.Services.csproj" />
        <ProjectReference Include="..\SabaNews.Livescore.SyncData\SabaNews.Livescore.SyncData.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="appsettings.GC.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
</Project>