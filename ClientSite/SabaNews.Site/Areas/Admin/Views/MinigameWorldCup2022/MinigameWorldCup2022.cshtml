@using SabaNews.Resources
@{
    Layout = "_AdminLayout";
}

@section TopHeader{
    @ViewResources.MinigameWorldCup2022
}

@section Title{
    @ViewResources.MinigameWorldCup2022
}

@section ActiveMenu {
    <input type="text" readonly hidden name="activeMenu" value="@ViewResources.MinigameWorldCup2022" />
}

@section Styles{
    <link rel="stylesheet" href="~/styles/pages/admin/minigameworldcup/minigame.css" asp-append-version="true">
}

<section class="page-content">
    <div class="form-filter" style="margin-bottom: 2rem">
        <form class="form-horizontal">
            <div class="form-input">
                <p class="label-admin">@ViewResources.Stage</p>
                <select class="custom-input list-input stage-select">
                    @for(int i = 1; i <= 4; i++){
                        <option value="@i" data-stage="@i">Giai Đoạn @i</option>
                    }
                </select>
            </div>
            <button type="button" class="btn-custom-admin search_user" style="width: 20.3rem; font-size: 1.6rem;">Count User Interactions</button>
        </form>
    </div>

    <div class="content">
        <div class="export-excel"><button class="label label-blue btn-link btn-exportexcel">Export excel</button></div>
        <div class="data-grid" id="data-grid"></div>
    </div>

    <div class="modal modal-detail-center" id="DetailPlayerContent" style="display:none">
        <div class="modal-content">
            <div class="modal-warning">
                <div class="modal-title">
                    <h2 class="title"></h2>
                    <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
                        <i class="icon-close"></i>
                    </button>
                </div>

                <div class="modal-body ck-content">
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin/minigameworldcup2022/minigameworldcup2022.js" asp-append-version="true"></script>
}