@using static SabaNews.Site.Extensions.LivescoreHelper;
@using static SabaNews.Site.Extensions.WorldCupHelper;
@using SabaNews.Resources;
@using SabaNews.Core.Helper;
@{
    var count = 0;
    int totalPoint = 0;
}
<div class="table-admin">
    <div class="form-filter-detail">
        <form class="form-horizontal">
            <p>User Name: </p>
            <input class="username" disabled type="text" value="@Model.Username" />
            <p>Email: </p>
            <input class="email" disabled type="text" value="@Model.Email" />
        </form>
        <form class="form-horizontal">
            <p>Ranking No. </p>
            <input class="rank" disabled type="text" value="@Model.Rank" />
            <p>Total Point: </p>
            <input class="total-point" disabled type="text" value="@Model.Totalpoint" />
        </form>
    </div>
    @if(Model.StageDetail != 4){
        <table class="data-grid">
            <thead>
                <tr>
                    <th width="5%">#</th>
                    <th width="30%">Match</th>
                    <th width="15%">Prediction</th>
                    <th width="10%">Result</th>
                    <th width="19%">Date & Time</th>
                    <th width="6%">Point</th>
                </tr>
            </thead>
            <tbody>
                @{
                    count = 16 * (Model.StageDetail - 1);
                    totalPoint = 0;
                    for (int i = 16 * (Model.StageDetail - 1); i < 16 * Model.StageDetail; i++)
                    {
                        count++;
                        var vote = GetVotePredict(Model.Matches[i], Model.Votes);
                        var result = GetResultPredict(Model.Matches[i], Model.Votes);
                        var teamVote = GetMatchNamePredict(Model.Matches[i], Model.Votes);
                        var point = vote != null ? vote.Point : 0;
                        totalPoint = totalPoint + point;
                            <tr>
                                <td class="text-center" width="5%">@count</td>
                                <td class="text-left" width="30%">@GetTeamName(Model.Matches[i].HomeTeam) -vs- @GetTeamName(Model.Matches[i].AwayTeam)</td>
                                <td class="text-center" width="15%">@teamVote</td>
                                <td class="text-center" width="10%">
                                    <span class="choose choose-@result">
                                        <i class="icon-@result"></i>
                                    </span>
                                </td>
                                <td class="text-center" width="19%">@(vote != null ? vote.UpdatedDate.ToString("dd/MM/yyyy, HH:mm:ss") : "")</td>
                                <td class="text-center" width="6%">@(vote != null ? vote.Point : "")</td>
                            </tr>
                    }
                }
            </tbody>
        </table>
        <div class="total-score">
            <span>Total point</span>
            <span>@totalPoint</span>
        </div>
    }
