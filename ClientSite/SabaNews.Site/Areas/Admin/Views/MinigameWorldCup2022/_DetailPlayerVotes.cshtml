@using static SabaNews.Site.Extensions.LivescoreHelper
@using SabaNews.Resources;
@using SabaNews.Core.Helper;
@{
    var count = 0;
}
<div class="table-admin">
    <div class="form-filter">
        <form class="form-horizontal">
           <p>Username: </p>
            <input disabled type="text" value="@Model.Username" />
            <p>Email: </p>
            <input disabled type="text" value="@Model.Email" />
        </form>
        <form class="form-horizontal">
            <p>Ranking No. </p>
            <input disabled type="text" value="@Model.Rank" />
            <p>Total Point: </p>
            <input disabled type="text" value="@Model.Totalpoint" />
        </form>
    </div>
    <table class="data-grid">
        <thead>
            <tr>
                <th>#</th>
                <th>Match</th>
                <th>Prediction</th>
                <th>Result</th>
                <th>Date & Time</th>
                <th>Point</th>
            </tr>
        </thead>
        <tbody>
            @{
                for (int i = 16 * (Model.StageDetail - 1); i < 16 * Model.StageDetail; i++){
                    count++;
                    <tr>
                        <td class="text-center" width="5%">@count</td>
                        <td class="text-left" width="30%">@Model.Matches[i].HomeTeam.TeamFullNameEN -vs- @Model.Matches[i].AwayTeam.TeamFullNameEN</td>
                        <td class="text-left" width="30%"></td>
                        <td class="text-center" width="10%"></td>
                        <td class="text-center" width="19%">@Model.Votes[i].UpdatedDate</td>
                        <td class="text-center" width="6%">@Model.Votes[i].Point</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>