@using SabaNews.Resources
@{
    Layout = "_AdminLayout";
    var current = DateTime.UtcNow.AddHours(7);
}

@section TopHeader{
    @ViewResources.MinigameWorldCup2022
}

    @section Title{
    @ViewResources.MinigameWorldCup2022
}

    @section ActiveMenu {
    <input type="text" readonly hidden name="activeMenu" value="@ViewResources.MinigameWorldCup2022" />
}

    @section Styles{
    <link rel="stylesheet" href="~/styles/pages/admin/minigameworldcup/minigame.css" asp-append-version="true">
}

    <section class="page-content">
        <div class="form-filter" style="margin-bottom: 2rem">
            <form class="form-horizontal">

            <div class="form-input">
                <p class="label-admin">@ViewResources.To</p>
                <input class="custom-input" type="date" id="dateSearch" name="dateSearch" value="@current.ToString("yyyy-MM-dd")" />
            </div>

            <button type="button" class="btn-custom-admin search_user">Submit</button>
        </form>
    </div>

     <div class="content">
        <div class="data-grid" id="data-grid"></div>
    </div>


</section>

@section Scripts {
    <script src="~/js/admin/minigameworldcup2022/count-user.js" asp-append-version="true"></script>
}