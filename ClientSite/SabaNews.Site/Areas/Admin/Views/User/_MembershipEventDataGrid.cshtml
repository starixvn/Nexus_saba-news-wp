@using SabaNews.Resources
@using System.Text;
@{ var count = (Model.Paging.CurrentPage - 1) * Model.Paging.PageSize; }
<div class="table-admin">
    <table class="data-grid">
        <thead>
            <tr>
                <th>#</th>
                <th>@ViewResources.Username</th>
                <th>@ViewResources.Phone</th>
                <th>@ViewResources.Email</th>
                <th>@ViewResources.Luckynumber</th>
                <th>
                    <p class="warning-admin">
                        @ViewResources.JoinedDate
                        <i id="date-sort" class="table-sort icon-sort-admin" sort-type="@Model.DateSort"></i>
                    </p>
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (var user in Model.Users)
                {
                    count++;
                    var joinDate = SabaNews.Core.Helper.DateTimeUtilize.ChangeTimeZoneToClient(user.JoinDate);

                    var emailFormat = user.Email;
                    var emailSplit = user.Email.Split('@');
                    var first = emailSplit[0].Length >= 3 ? emailSplit[0].Substring(0, 3) : emailSplit[0].Substring(0, emailSplit[0].Length);
                    var last = "";
                    if (emailSplit[0].Length > 6)
                    {
                        last = emailSplit[0].Substring(emailSplit[0].Length - 3);
                    }
                    emailFormat = first + "***" + last + "@" + emailSplit[1];

                    <tr>
                        <td class="text-center" width="5%">@count</td>
                        <td class="text-left" width="15%">@user.Name</td>
                        <td class="text-left" width="15%">@user.Phone</td>
                        <td class="text-left" width="15%">@emailFormat</td>
                        <td class="text-center">@user.LuckyNumber</td>
                        <td class="text-center" width="15%">@joinDate</td>
                    </tr>
                }
            }
            @if (Model.Users.Count == 0)
            {
                <tr>
                    <td class="nodata_table" colspan="9">@ViewResources.EmptyData</td>
                </tr>
            }
        </tbody>

    </table>
    @(await Component.InvokeAsync("Paging", new { model = Model.Paging }))
</div>