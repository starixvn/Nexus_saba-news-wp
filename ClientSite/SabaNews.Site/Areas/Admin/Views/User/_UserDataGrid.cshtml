@using SabaNews.Resources
<div class="card-view">
	<div class="card-item card-pupple aligncenter">
		<div class="card-icon bg-pupple"><i class="icon-page icon-icon-admin"></i></div>
		<ul class="card-total">
			<li class="cart-total-title">@ViewResources.Users</li>
			<li class="cart-toal-count">@Model.TotalItems</li>
		</ul>
	</div>
	
</div>
@{ var count = 0; }
<div class="table-admin">
	<table class="data-grid">
		<thead>
			<tr>
				<th>#</th>
				<th>SabaID</th>
				<th>@ViewResources.NameLabel</th>
				<th>@ViewResources.Email</th>
				<th>Phone</th>
				<th>Birthday year</th>
				<th>
					<p class="warning-admin">
						@ViewResources.JoinedDate
						<i id="date-sort" class="table-sort icon-sort-admin" sort-type="@Model.DateSort"></i>
					</p>
				</th>
			</tr>
		</thead>
		<tbody>
			@{
				foreach (var item in Model.Users)
				{
					count++;
					var registerDate = SabaNews.Core.Helper.DateTimeUtilize.ChangeTimeZoneToClient(item.RegisterDate);
					<tr>
						<td class="text-center" width="5%">@count</td>
						<td class="text-left" width="15%">@item.Id</td>
						<td class="text-left" width="15%">@item.Name</td>
						<td class="text-left" width="20%">@item.Email</td>
						<td class="text-left" width="13%">@item.Phone</td>
						<td class="text-left" width="13%">@item.YearOfBirth</td>
						<td class="text-center" width="25%">@registerDate</td>
					</tr>
				}
			}
			@if (Model.Users.Count == 0)
			{
				<tr>
					<td class="nodata_table" colspan="9">@ViewResources.EmptyData</td>
				</tr>
			}
		</tbody>
		
	</table>
	@(await Component.InvokeAsync("Paging", new { model = Model.Paging }))
</div>