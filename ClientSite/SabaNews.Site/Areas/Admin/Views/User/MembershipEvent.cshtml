@using SabaNews.Resources
@{
    Layout = "_AdminLayout";
}

@section TopHeader{
    @ViewResources.MembershipEvent
}

@section Title{
    @ViewResources.MembershipEvent
}

@section ActiveMenu {
    <input type="text" readonly hidden name="activeMenu" value="@ViewResources.User" />
}

<section class="page-content">
    <div id="error" class="error"></div>
    <div class="form-filter">
        <form class="form-horizontal" method="post" id="filter">
            <div class="form-input">
                <p class="label-admin">@ViewResources.SearchLabel</p>
                <input type="number" class="custom-input list-input" id="search" name="search" value="" placeholder="search approximately result..." />
            </div>

            <button class="btn-custom-admin" type="submit" id="submit-btn">@ViewResources.Submit</button>
        </form>
    </div>

    <div class="content">
        <div class="data-grid" id="data-grid"></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin/user/membership-event-management.js" asp-append-version="true"></script>
}