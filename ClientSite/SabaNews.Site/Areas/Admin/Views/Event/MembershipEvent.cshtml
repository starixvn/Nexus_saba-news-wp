@using SabaNews.Resources
@{
    Layout = "_AdminLayout";
}

@section TopHeader{
    @ViewResources.MembershipEvent
}

@section Title{
    @ViewResources.MembershipEvent
}

@section ActiveMenu {
    <input type="text" readonly hidden name="activeMenu" value="@ViewResources.MembershipEvent" />
}

@section Styles{
    <link rel="stylesheet" href="~/styles/pages/admin/event/membership-event.css" asp-append-version="true">
}

<section class="page-content">
    <div class="form-filter" style="margin-bottom: 2rem">
        <form class="form-horizontal" action="/Admin/Event/MembershipEventResult" method="get" >
            <div class="form-input">
                <input type="number" class="custom-input list-input" id="search" name="resultNumber"  placeholder="enter lucky number..." />
            </div>

            <button class="btn-custom-admin" type="submit" id="submit-btn">Check Winner</button>
        </form>
    </div>


    <div class="content">
        <div class="export-excel"><a href="@Url.Action("ExportExcel", "Event", new { Area = "Admin" })" class="label label-blue">Export excel</a></div>
        <div class="data-grid" id="data-grid"></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin/event/membership-event-management.js" asp-append-version="true"></script>
}