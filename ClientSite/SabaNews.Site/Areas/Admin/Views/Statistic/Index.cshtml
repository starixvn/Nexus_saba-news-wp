@{
    Layout = "_AdminLayout";
}

@section Title{
    Post View Statistic
}
<section>
    <div class="form-filter">
        <form action="PostViewStatistic" method="post" id="filter">
            <div class="form-row col-md-12">
                <div class="form-group col-md-4">
                    <label for="inputFromDate">From</label>
                    <input type="date" class="form-control" id="FromDate" name="FromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group col-md-4">
                    <label for="inputFromDate">To</label>
                    <input type="date" class="form-control" id="ToDate" name="ToDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group col-md-4">
                    <button class="btn btn-primary" type="submit" id="submit-btn">Submit</button>
                </div>
            </div>
        </form>
    </div>
    <div class="statistic-report" id="statistic-report"></div>
</section>
@section Scripts {
    <script src="~/minify/js/admin_statistic_post_view.min.js" asp-append-version="true"></script>
}