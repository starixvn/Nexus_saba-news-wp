@{
    Layout = "_AdminLayout";
}

@section Title{
    Post View Statistic
}




<section class="page-content">
    <div id="error" class="error"></div>
    <div class="form-filter">
        <form class="form-horizontal" action="PostViewStatistic" method="post" id="filter">
            <div class="form-input">
                <p class="label-admin">@ViewResources.From</p>
                <input type="date" class="custom-input" id="FromDate" name="FromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-input">
                <p class="label-admin">@ViewResources.To</p>
                <input type="date" class="custom-input" id="ToDate" name="ToDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <button class="btn-custom-admin" type="submit" id="submit-btn">@ViewResources.Submit</button>
        </form>
    </div>

    <div class="card-view">
        <div class="card-item card-pupple">
            <div class="card-icon bg-pupple"><i class="icon-page icon-icon-admin"></i></div>
            <ul class="card-total">
                <li class="cart-total-title">Total Post</li>
                <li class="cart-toal-count">100</li>
            </ul>
        </div>
        <div class="card-item card-green">
            <div class="card-icon bg-green"><i class="icon-page icon-icon-admin"></i></div>
            <ul class="card-total">
                <li class="cart-total-title">Total Post View</li>
                <li class="cart-toal-count">234567</li>
            </ul>
        </div>
        <div class="card-item card-orange">
            <div class="card-icon bg-orange"><i class="icon-page icon-icon-admin"></i></div>
            <ul class="card-total">
                <li class="cart-total-title">Total Video</li>
                <li class="cart-toal-count">100</li>
            </ul>
        </div>
        <div class="card-item card-blue">
            <div class="card-icon bg-blue"><i class="icon-page icon-icon-admin"></i></div>
            <ul class="card-total">
                <li class="cart-total-title">Total Video View </li>
                <li class="cart-toal-count">79879</li>
            </ul>
        </div>
    </div>


    <div class="content">
        <div class="statistic-report" id="statistic-report"></div>
    </div>
</section>
@section Scripts {
    <script src="~/minify/js/admin_statistic_post_view.min.js" asp-append-version="true"></script>
}