<div>
    <table class="data-grid">
        <thead>
            <tr>
                <th>Date</th>
                <th>Total Posts</th>
                <th>Post Views</th>
                <th>Total Videos</th>
                <th>Video Views</th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (var item in Model.PostViewDetails)
                {
                    <tr class="text-center">
                        <td>@item.OnDate.ToString("dd MMM yyyy")</td>
                        <td>@item.PostCount</td>
                        <td>@item.PostView</td>
                        <td>@item.VideoCount</td>
                        <td>@item.VideoView</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <td></td>
                <td>@Model.TotalPost</td>
                <td>@Model.TotalPostView</td>
                <td>@Model.TotalVideo</td>
                <td>@Model.TotalVideoView</td>
            </tr>
        </tfoot>
    </table>
</div>