@using SabaNews.Resources
@using SabaNews.Models;
@{
    var slugSelected = ViewBag.SlugSelected;
    var count = ViewBag.Count;
}
<table width="100%" id="edit-league">
    <tbody>
        <tr>
            <td>
                <table>
                    <tbody>
                        <tr>
                            <td>
                                <label>Category</label>
                            </td>
                            <td>
                                <select class="form-control txt-teamFullNameEn" id="Category">
                                    @foreach (var item in Model)
                                    {
                                        <option @(slugSelected == item.Slug ? "selected" : "") value="@item.Slug">@item.MenuTitle</option>
                                    }
                                </select>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <label>Slug</label>
                            </td>
                            <td>
                                @foreach (var item in Model)
                                {
                                    if (item.Slug == slugSelected)
                                    {
                                        <input type="text" disabled value="@item.Slug" class="form-control txt-countryVn txt-countryEn" id="editSlug" name="Slug" />
                                    }
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="form-btn">
                    <button class="btn btn-primary pl-4 pr-4" data-count="@count" id="btn-save">Save</button>
                    <button class="btn btn-secondary pl-4 pr-4" type="button" data-dismiss="modal">Cancel</button>
                </div>
            </td>
        </tr>
    </tbody>
</table>