@using static SabaNews.Site.Extensions.LivescoreHelper
@using SabaNews.Resources
@{
    Layout = "_AdminLayout";
}

@section TopHeader{
    @ViewResources.ManagementLeague
}

@section Title{
    @ViewResources.ManagementLeague
}
@section ActiveMenu {
    <input type="text" readonly hidden name="activeMenu" value="@ViewResources.ManagementLeague" />
}

@section Styles{
    <link rel="stylesheet" href="~/styles/pages/admin/managementleague/managementleague.css" asp-append-version="true">
    <link rel="stylesheet" href="~/styles/pages/select2.min.css" asp-append-version="true">
    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.8.24/themes/smoothness/jquery-ui.css" />
}

    

    <style type="text/css">
        table th, table td
        {
            width: 100px;
            padding: 5px;
            border: 1px solid #ccc;
        }
        .selected
        {
            background-color: #666;
            color: #fff;
        }
    </style>
    
<section class="page-content">
    <div class="form-horizontal show-league">
            <p href="javascript:;" id="btn_major_league" class="label label-blue btn_major_league btn_show_league">Major Leagues</p>
            <p href="javascript:;" id="btn_hot_league" class="label label-blue btn_hot_league">Hot Leagues</p>
    </div>
    
    <div class="form-horizontal filter" id="filter">
        <div class="form-input">
            <p class="label-admin">@ViewResources.SearchLabel</p>
            <input type="text" class="custom-input list-input" id="search" name="searchLeague" placeholder="Enter League Name..." />
        </div>
    </div>
    <div class="content">
        <div class="add-league">
            <button href="javascript:;" class="label label-blue btn-link btn_league"><img src="~/images/icon/icon-plus.png" class="icon-add-league" />@ViewResources.AddLeague</button>
        </div>
        <div class="data-grid" id="data-grid"></div>


            <table id="tblLocations" cellpadding="0" cellspacing="0" border="1">
                <tr>
                    <th>ID </th>
                    <th>Location</th>
                    <th>Preference</th>
                </tr>
                <tr>
                    <td>1</td>
                    <td> Goa</td>
                    <td>1</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Mahabaleshwar</td>
                    <td>2</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>Kerala</td>
                    <td>3</td>
                </tr>
                <tr>
                    <td>4</td>
                    <td>Kashmir</td>
                    <td>4</td>
                </tr>
                <tr>
                    <td>5</td>
                    <td>Ooty</td>
                    <td>5</td>
                </tr>
                <tr>
                    <td>6</td>
                    <td>Simla</td>
                    <td>6</td>
                </tr>
                <tr>
                    <td>7</td>
                    <td>Manali</td>
                    <td>7</td>
                </tr>
                <tr>
                    <td>8</td>
                    <td>Darjeeling</td>
                    <td>8</td>
                </tr>
                <tr>
                    <td>9</td>
                    <td>Nanital</td>
                    <td>9</td>
                </tr>
            </table>

    </div>

    <div class="modal modal-edit-center" id="AddLeagueContent" style="display:none">
        <div class="modal-content">
            <div class="modal-warning">
                <div class="modal-title">
                    <h2 class="title"></h2>
                    <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
                        <i class="icon-close"></i>
                    </button>
                </div>

                <div class="modal-body ck-content">
                </div>
            </div>
        </div>
    </div>

    <div class="modal" id="NoticeModal" style="display:none">
        <div class="modal-content">
            <div class="modal-warning">
                <div class="modal-title title-success">
                    <h2 class="title"><i class="icon-title icon-success-admin"></i> @ViewResources.Announcement</h2>

                    <button type="button" class="close-login close-announcement" data-dismiss="modal" aria-label="Close">
                        <i class="icon-close"></i>
                    </button>
                </div>

                <div class="modal-body">

                </div>
            </div>
        </div>
    </div>

    <div class="modal confirm" id="ConfirmModal" style="display:none">
        <div class="modal-content">
            <div class="modal-warning">
                <div class="modal-title">
                    <h2 class="title">@ViewResources.Confirmation</h2>
                    <button type="button" class="close-login close-announcement" data-dismiss="modal" aria-label="Close">
                        <i class="icon-close"></i>
                    </button>
                </div>

                <div class="modal-body"></div>
                <div class="button-confirm">
                    <button class="btn-custom-outline confirm-action">Yes</button>
                    <button data-dismiss="modal" aria-label="Close" class="btn-custom-admin">No</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal modal-edit-center" id="EditLeagueContent" style="display:none">
        <div class="modal-content">
            <div class="modal-warning">
                <div class="modal-title">
                    <h2 class="title"></h2>
                    <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
                        <i class="icon-close"></i>
                    </button>
                </div>

                <div class="modal-body ck-content">
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin/managementleague/managementleague.js" asp-append-version="true"></script>
    <script src="~/js/select2.min.js" asp-append-version="true"></script>

    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.8.24/jquery-ui.min.js"></script>

    <script type="text/javascript" asp-append-version="true">
        $(function () {
            $("#tblLocations").sortable({
                items: 'tr:not(tr:first-child)',
                cursor: 'pointer',
                axis: 'y',
                dropOnEmpty: false,
                start: function (e, ui) {
                    ui.item.addClass("selected");
                },
                stop: function (e, ui) {
                    ui.item.removeClass("selected");
                    $(this).find("tr").each(function (index) {
                        if (index > 0) {
                            $(this).find("td").eq(2).html(index);
                        }
                    });
                }
            });
        });
    </script>
}