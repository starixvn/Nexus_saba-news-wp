

<select class="custom-input list-input season-select">
    @if (Model.Count > 0)
    {
        foreach (var season in Model)
        {
            <option value="@season.SeasonId" data-name="@season.Year">@season.Year</option>
        }

    }
    else
    { 
        <option value="0">0</option>
    }
</select>