@using SabaNews.Resources
@using SabaNews.Core.Constants;
@using SabaNews.Core.Helper;
<form id="updateMatch">
    <table width="100%">
        <tbody>
            <tr>
                <td>
                    <table width="100%">
                        <tbody>
                            <tr>
                                <td width="30%">
                                    <label>@ViewResources.HomeName</label>
                                </td>
                                <td width="70%">
                                    <h4>@(!string.IsNullOrEmpty(Model.HomeTeam.TeamNameEN) ? Model.HomeTeam.TeamNameEN : Model.HomeTeam.TeamFullNameEN)</h4>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>@ViewResources.AwayName</label>
                                </td>
                                <td width="70%">
                                    <h4>@(!string.IsNullOrEmpty(Model.AwayTeam.TeamNameEN) ? Model.AwayTeam.TeamNameEN : Model.AwayTeam.TeamFullNameEN)</h4>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>Stage</label>
                                </td>
                                <td width="70%">
                                    <h4>@(Model.Stage.StageNameResource ?? Model.Stage.StageNameEN)</h4>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>StageVN</label>
                                </td>
                                <td width="70%">
                                    <input type="text" value="@Model.Stage.StageNameCustom" class="form-control txt-awayVN" id="stageNameVN" name="stageNameVN" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>@ViewResources.HomeNameVN</label>
                                </td>
                                <td width="70%">
                                    <input type="hidden" id="editHomeId" value="@Model.HomeTeam.TeamId" />
                                    <input type="text" value="@Model.HomeTeam.TeamNameVN" class="form-control txt-homeVN" id="editHomeVN" name="HomeVN" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>@ViewResources.HomeIconVN</label>
                                </td>
                                <td width="70%">
                                    @{
                                        var display = !string.IsNullOrEmpty(Model.HomeTeam.IconVN);
                                        var hide = display ? "none" : "flex";
                                        var show = display ? "flex" : "none";
                                    }
                                    <div class="input-upload">
                                        <input type="file" class="input-file photo" id="editHomeIcon">
                                        <div class="txt-img" style="display:@hide"><i class="icon-upload"></i> <span>@ViewResources.UploadNewImage</span></div>
                                        <div class="img-upload">
                                            <img class="review_photo" src="@Model.HomeTeam.IconVN" alt="review photo" width="150" style="display:@show" />
                                            <p class="error photo-error" style="display:none"></p>
                                            <button type="button" class="cancel-upload icon-close" style="display:@show"></button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>@ViewResources.AwayNameVN</label>
                                </td>
                                <td width="70%">
                                    <input type="text" value="@Model.AwayTeam.TeamNameVN" class="form-control txt-awayVN" id="editAwayVN" name="AwayVN" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>@ViewResources.AwayIconVN</label>
                                </td>
                                <td width="70%">
                                    @{
                                        display = !string.IsNullOrEmpty(Model.AwayTeam.IconVN);
                                        hide = display ? "none" : "flex";
                                        show = display ? "flex" : "none";
                                    }
                                    <div class="input-upload">
                                        <input type="file" class="input-file photo" id="editAwayIcon">
                                        <div class="txt-img" style="display:@hide"><i class="icon-upload"></i> <span>@ViewResources.UploadNewImage</span></div>
                                        <div class="img-upload">
                                            <img class="review_photo" src="@Model.AwayTeam.IconVN" alt="review photo" width="150" style="display:@show" />
                                            <p class="error photo-error" style="display:none"></p>
                                            <button type="button" class="cancel-upload icon-close" style="display:@show"></button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>Round</label>
                                </td>
                                <td width="70%">
                                    <input type="number" min="0" value="@Model.Round" class="form-control txt-homeVN" id="round" name="round" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>@ViewResources.Status</label>
                                </td>
                                <td width="70%">
                                    <select class="form-control" id="status">
                                        @foreach (var status in Livescore.ListMatchStatus)
                                        {
                                            var selected = status.Id == Model.Status ? "selected" : "";
                                            <option value="@status.Id" @selected>@status.Name</option>

                                        }
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>KO Time</label>
                                </td>
                                <td width="70%">
                                    <div class="form-input">
                                        <input class="custom-input" type="datetime-local" id="startTime" name="toDate"
                                               value="@DateTimeUtilize.FormatDateTime(Model.StartTime, "yyyy-MM-dd HH:mm")" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>Home Team Half Score</label>
                                </td>
                                <td width="70%">
                                    <input type="number" min="0" value="@Model.HomeTeamHalfScore" class="form-control txt-homeVN" id="homeTeamHalfScore" name="HomeVN" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>Away Team Half Score</label>
                                </td>
                                <td width="70%">
                                    <input type="number" min="0" value="@Model.AwayTeamHalfScore" class="form-control txt-homeVN" id="awayTeamHalfScore" name="HomeVN" />
                                </td>
                            </tr>

                            <tr>
                                <td width="30%">
                                    <label>Home Team Total Score</label>
                                </td>
                                <td width="70%">
                                    <input type="number" min="0" value="@(Model.HomeTeamExtraScore != null ? Model.HomeTeamExtraScore : Model.HomeTeamTotalScore)" class="form-control txt-homeVN" id="homeTeamExtraScore" name="HomeVN" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>Away Team Total Score</label>
                                </td>
                                <td width="70%">
                                    <input type="number" min="0" value="@(Model.AwayTeamExtraScore != null ? Model.AwayTeamExtraScore : Model.AwayTeamTotalScore)" class="form-control txt-homeVN" id="awayTeamExtraScore" name="HomeVN" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>Home Team AGG Score</label>
                                </td>
                                <td width="70%">
                                    <input type="number" min="0" value="@Model.HomeTeamAggregateScore" class="form-control txt-homeVN" id="homeTeamAggregateScore" name="HomeVN" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>Away Team AGG Score</label>
                                </td>
                                <td width="70%">
                                    <input type="number" min="0" value="@Model.AwayTeamAggregateScore" class="form-control txt-homeVN" id="awayTeamAggregateScore" name="HomeVN" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>Home Team PEN Score</label>
                                </td>
                                <td width="70%">
                                    <input type="number" min="0" value="@Model.HomeTeamPenaltyScore" class="form-control txt-homeVN" id="homeTeamPenaltyScore" name="HomeVN" />
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">
                                    <label>Away Team PEN Score</label>
                                </td>
                                <td width="70%">
                                    <input type="number" min="0" value="@Model.AwayTeamPenaltyScore" class="form-control txt-homeVN" id="awayTeamPenaltyScore" name="HomeVN" />
                                </td>
                            </tr>


                        </tbody>
                    </table>
                    <div class="form-btn">
                        <button class="btn btn-primary pl-4 pr-4" data-id="@Model.MatchId" id="btn-save">Save</button>
                        <button class="btn btn-secondary pl-4 pr-4" type="button" data-dismiss="modal">Cancel</button>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</form>
