@using SabaNews.Resources
@using SabaNews.Site.Extensions;
<table width="100%">
    <tbody>
        <tr>
            <td>
                <table  width="100%">
                    <tbody>
                        <tr>
                            <td width="30%">
                                <label>@ViewResources.HomeName</label>
                            </td>
                            <td width="70%">
                                <h4>@(!string.IsNullOrEmpty(Model.HomeTeam.TeamNameEN) ? Model.HomeTeam.TeamNameEN : Model.HomeTeam.TeamFullNameEN)</h4>
                            </td>
                        </tr>
                        <tr>
                            <td width="30%">
                                <label>@ViewResources.AwayName</label>
                            </td>
                            <td width="70%">
                                <h4>@(!string.IsNullOrEmpty(Model.AwayTeam.TeamNameEN) ? Model.AwayTeam.TeamNameEN : Model.AwayTeam.TeamFullNameEN)</h4>
                            </td>
                        </tr>
                        <tr>
                            <td width="30%">
                                <label>@ViewResources.HomeNameVN</label>
                            </td>
                            <td width="70%">
                                <input type="hidden" id="editHomeId" value="@Model.HomeTeam.TeamId" />
                                <input type="text" value="@Model.HomeTeam.TeamNameVN" class="form-control txt-homeVN" id="editHomeVN" name="HomeVN" />
                            </td>
                        </tr>
                        <tr>
                            <td width="30%">
                                <label>@ViewResources.HomeIconVN</label>
                            </td>
                            <td width="70%">
                                @{
                                    var display = !string.IsNullOrEmpty(Model.HomeTeam.IconVN);
                                    var hide = display ? "none" : "flex";
                                    var show = display ? "flex" : "none";
                                }
                                <div class="input-upload">
                                    <input type="file" class="input-file photo" id="editHomeIcon">
                                    <div class="txt-img" style="display:@hide"><i class="icon-upload"></i> <span>@ViewResources.UploadNewImage</span></div>
                                    <div class="img-upload">
                                        <img class="review_photo" src="@Model.HomeTeam.IconVN" alt="review photo" width="150" style="display:@show" />
                                        <p class="error photo-error" style="display:none"></p>
                                        <button type="button" class="cancel-upload icon-close" style="display:@show"></button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td width="30%">
                                <label>@ViewResources.AwayNameVN</label>
                            </td>
                            <td width="70%">
                                <input type="hidden" id="editAwayId" value="@Model.AwayTeam.TeamId" />
                                <input type="text" value="@Model.AwayTeam.TeamNameVN" class="form-control txt-awayVN" id="editAwayVN" name="AwayVN" />
                            </td>
                        </tr>
                        <tr>
                            <td width="30%">
                                <label>@ViewResources.AwayIconVN</label>
                            </td>
                            <td width="70%">
                                @{
                                    display = !string.IsNullOrEmpty(Model.AwayTeam.IconVN);
                                    hide = display ? "none" : "flex";
                                    show = display ? "flex" : "none";
                                }
                                <div class="input-upload">
                                    <input type="file" class="input-file photo" id="editAwayIcon">
                                    <div class="txt-img" style="display:@hide"><i class="icon-upload"></i> <span>@ViewResources.UploadNewImage</span></div>
                                    <div class="img-upload">
                                        <img class="review_photo" src="@Model.AwayTeam.IconVN" alt="review photo" width="150" style="display:@show" />
                                        <p class="error photo-error" style="display:none"></p>
                                        <button type="button" class="cancel-upload icon-close" style="display:@show"></button>
                                    </div>
                                </div>
                            </td>
                        </tr>

                    </tbody>
                </table>
                <div class="form-btn">
                    <button class="btn btn-primary pl-4 pr-4" data-id="@Model.MatchId"  id="btn-save">Save</button>
                    <button class="btn btn-secondary pl-4 pr-4" type="button" data-dismiss="modal">Cancel</button>
                </div>
            </td>
        </tr>
    </tbody>
</table>