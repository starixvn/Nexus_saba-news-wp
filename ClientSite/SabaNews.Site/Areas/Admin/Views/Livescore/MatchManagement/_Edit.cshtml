@using SabaNews.Resources
@using SabaNews.Core.Constants;
@using SabaNews.Core.Helper;
@using SabaNews.Site.Extensions;
<form id="updateMatch">

    <div class="admin-match-management">
        <div class="item item-home">
            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Logo Origin
                </label>
                <div class="admin-text-logo">
                    <img src="@LivescoreHelper.GetTeamIcon(Model.HomeTeam.Icon)" alt="Alternate Text" />
                </div>
            </div>
            <div class="form-input flex-form-input">
                <label class="label-admin">
                    @ViewResources.HomeName
                </label>
                <div class="admin-text-logo">
                    @(!string.IsNullOrEmpty(Model.HomeTeam.TeamNameEN) ? Model.HomeTeam.TeamNameEN : Model.HomeTeam.TeamFullNameEN)
                </div>
            </div>

            <div class="form-input flex-form-input">
                <label class="label-admin">
                    @ViewResources.HomeIconVN
                </label>
                <div class="admin-text-logo">
                    @{
                        var display = !string.IsNullOrEmpty(Model.HomeTeam.IconVN);
                        var hide = display ? "none" : "flex";
                        var show = display ? "flex" : "none";
                    }
                    <div class="input-upload">
                        <input type="file" class="input-file photo" id="editHomeIcon">
                        <div class="txt-img" style="display:@hide"><i class="icon-upload"></i> <span>@ViewResources.UploadNewImage</span></div>
                        <div class="img-upload">
                            <img class="review_photo" src="@Model.HomeTeam.IconVN" alt="review photo" style="display:@show" />
                            <p class="error photo-error" style="display:none"></p>
                            <button type="button" class="cancel-upload icon-close" style="display:@show"></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-input flex-form-input">
                <label class="label-admin">
                    @ViewResources.HomeNameVN
                </label>
                <div class="admin-text-logo">
                    <input type="hidden" id="editHomeId" value="@Model.HomeTeam.TeamId" />
                    <input type="text" value="@Model.HomeTeam.TeamNameVN" class="form-control custom-input txt-homeVN" id="editHomeVN" name="HomeVN" />
                </div>
            </div>

            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Home 1H Score
                </label>
                <div class="admin-text-logo">
                    <input type="number" min="0" max="100" value="@Model.HomeTeamHalfScore" class="form-control custom-input txt-homeVN" id="homeTeamHalfScore" name="HomeVN" />
                </div>
            </div>
            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Home 2H Score
                </label>
                <div class="admin-text-logo">
                    <input type="number" min="0" max="100" value="@(Model.HomeTeamExtraScore != null ? Model.HomeTeamExtraScore : Model.HomeTeamTotalScore)" class="form-control custom-input txt-homeVN" id="homeTeamExtraScore" name="HomeVN" />
                </div>
            </div>

            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Home PEN
                </label>
                <div class="admin-text-logo">
                    <input type="number" min="0" max="100" value="@Model.HomeTeamPenaltyScore" class="form-control custom-input txt-homeVN" id="homeTeamPenaltyScore" name="HomeVN" />
                </div>
            </div>
            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Home AGG
                </label>
                <div class="admin-text-logo">
                    <input type="number" min="0" max="100" value="@Model.HomeTeamAggregateScore" class="form-control custom-input txt-homeVN" id="homeTeamAggregateScore" name="HomeVN" />
                </div>
            </div>

        </div>




        <div class="item item-away">
            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Logo Origin
                </label>
                <div class="admin-text-logo">
                    <img src="@LivescoreHelper.GetTeamIcon(Model.AwayTeam.Icon)" alt="Alternate Text" />
                </div>
            </div>
            <div class="form-input flex-form-input">
                <label class="label-admin">
                    @ViewResources.AwayName
                </label>
                <div class="admin-text-logo">
                    @(!string.IsNullOrEmpty(Model.AwayTeam.TeamNameEN) ? Model.AwayTeam.TeamNameEN : Model.AwayTeam.TeamFullNameEN)
                </div>
            </div>

            <div class="form-input flex-form-input">
                <label class="label-admin">
                    @ViewResources.AwayIconVN
                </label>
                <div class="admin-text-logo">
                    @{
                        display = !string.IsNullOrEmpty(Model.AwayTeam.IconVN);
                        hide = display ? "none" : "flex";
                        show = display ? "flex" : "none";
                    }
                    <div class="input-upload">
                        <input type="file" class="input-file photo" id="editAwayIcon">
                        <div class="txt-img" style="display:@hide"><i class="icon-upload"></i> <span>@ViewResources.UploadNewImage</span></div>
                        <div class="img-upload">
                            <img class="review_photo" src="@Model.AwayTeam.IconVN" alt="review photo" style="display:@show" />
                            <p class="error photo-error" style="display:none"></p>
                            <button type="button" class="cancel-upload icon-close" style="display:@show"></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-input flex-form-input">
                <label class="label-admin">
                    @ViewResources.AwayNameVN
                </label>
                <div class="admin-text-logo">
                    <input type="hidden" id="editAwayId" value="@Model.AwayTeam.TeamId" />
                    <input type="text" value="@Model.AwayTeam.TeamNameVN" class="form-control custom-input custom-input txt-awayVN" id="editAwayVN" name="AwayVN" />
                </div>
            </div>

            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Away 1H Score
                </label>
                <div class="admin-text-logo">
                    <input type="number" min="0" max="100" value="@Model.AwayTeamHalfScore" class="form-control custom-input txt-homeVN" id="awayTeamHalfScore" name="HomeVN" />
                </div>
            </div>
            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Away 2H Score
                </label>
                <div class="admin-text-logo">
                    <input type="number" min="0" max="100" value="@(Model.HomeTeamExtraScore != null ? Model.HomeTeamExtraScore : Model.HomeTeamTotalScore)" class="form-control custom-input txt-homeVN" id="homeTeamExtraScore" name="HomeVN" />
                </div>
            </div>

            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Away PEN
                </label>
                <div class="admin-text-logo">
                    <input type="number" min="0" max="100" value="@Model.AwayTeamPenaltyScore" class="form-control custom-input txt-homeVN" id="awayTeamPenaltyScore" name="HomeVN" />
                </div>
            </div>
            <div class="form-input flex-form-input">
                <label class="label-admin">
                    Away AGG
                </label>
                <div class="admin-text-logo">
                    <input type="number" min="0" max="100" value="@Model.AwayTeamAggregateScore" class="form-control custom-input txt-homeVN" id="awayTeamAggregateScore" name="HomeVN" />
                </div>
            </div>
        </div>
    </div>
    <div class="form-btn">
        <button class="btn-custom-admin btn-btn-save" data-id="@Model.MatchId" id="btn-save">Save</button>
        <button class="btn-custom-admin btn-btn-cancel" type="button" data-dismiss="modal">Cancel</button>
    </div>
</form>
