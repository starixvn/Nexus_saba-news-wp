@using SabaNews.Resources
@using SabaNews.Core.Helper
@using SabaNews.Site.Extensions;
@{ var count = (Model.Paging.CurrentPage - 1) * Model.Paging.PageSize; }
<div class="table-admin">
    <table class="data-grid">
        <thead>
            <tr>
                <th width="2%">#</th>
                <th width="13%">@ViewResources.StartTime <i class="icon-sort-admin" id="date-sort" sort-type="@Model.DateSort"></i></th>
                <th width="10%">@ViewResources.HomeLogo</th>
                <th width="10%">@ViewResources.HomeName</th>
                <th width="10%">@ViewResources.AwayLogo</th>
                <th width="10%">@ViewResources.AwayName</th>
                <th width="10%">@ViewResources._1HScore</th>
                <th width="10%">@ViewResources._2HScore</th>
                <th width="10%">@ViewResources.PEN</th>
                <th width="10%">@ViewResources.AGG</th>
                <th width="5%">@ViewResources.Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (var match in Model.Matches)
                {
                    count++;
                        <tr>
                            <td class="text-center">@match.MatchId @count</td>
                            <td class="text-center">@DateTimeUtilize.ChangeTimeZoneToClient(match.StartTime)</td>
                            <td class="text-center"><img src="@(match.HomeTeam.IconVN ?? LivescoreHelper.GetTeamIcon(match.HomeTeam.Icon))" width="100"></td>
                            <td class="text-center">@LivescoreHelper.GetTeamName(match.HomeTeam)</td>
                            <td class="text-center"><img src="@(match.AwayTeam.IconVN ?? LivescoreHelper.GetTeamIcon(match.AwayTeam.Icon))" width="100"></td>
                            <td class="text-center">@LivescoreHelper.GetTeamName(match.AwayTeam)</td>
                            <td class="text-center">@match.HomeTeamHalfScore - @match.AwayTeamHalfScore</td>
                            <td class="text-center">@LivescoreHelper.GetMatchTotalScore(match, true) - @LivescoreHelper.GetMatchTotalScore(match, false)</td>
                            <td class="text-center">@match.HomeTeamPenaltyScore - @match.AwayTeamPenaltyScore</td>
                            <td class="text-center">@match.HomeTeamAggregateScore - @match.AwayTeamAggregateScore</td>

                            <td class="text-center">
                                <i class="icon icon-edit-admin btn-Edit" title="Edit"
                                   data-url="@Url.Action("EditMatch", "MatchManagement", new { matchId = match.MatchId})"></i>
                            </td>
                        </tr>
                }
            }
            @if (Model.Matches.Count == 0)
            {
                <tr>
                    <td class="nodata_table" colspan="9">@ViewResources.EmptyData</td>
                </tr>
            }
        </tbody>
    </table>
    @(await Component.InvokeAsync("Paging", new { model = Model.Paging }))
</div>