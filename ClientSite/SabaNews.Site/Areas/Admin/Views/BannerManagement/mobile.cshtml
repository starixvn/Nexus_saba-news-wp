                                    <li>
                                        <a href="javascipt:;" class="social-action remove" data-type="@Model.MobileCenterUrlKey">@ViewResources.Remove</a>
                                    </li>
                                }
                            </ul>
						</div>
						<div class="box-edit-form">
							<div class="title">
								<span>@ViewResources.MobileCenterBanner</span>
