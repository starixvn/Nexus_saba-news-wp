@using SabaNews.Resources
@{
	Layout = "_AdminLayout";
}

@section TopHeader{
	@ViewResources.BannerDesktop
}

@section Title{
	@ViewResources.BannerDesktop
}
@section Styles{
	<link rel="stylesheet" href="~/minify/styles/admin_banner.min.css" asp-append-version="true">
}
@section Scripts{
	<script src="~/minify/js/admin_banner.min.js" asp-append-version="true"></script>
}
@section ActiveMenu {
	<input type="text" readonly hidden name="activeMenu" value="@ViewResources.BannerInfo" />
}
<section class="page-content">
	<div class="form-horizontal navigation">
		<p id="btn_major_league" class="label label-blue item-navigation active ">Desktop</p>
		<p id="btn_category" class="label label-blue item-navigation"><a href="@Url.Action("Mobile", "BannerManagement")">Mobile</a></p>
		<p id="btn_category" class="label label-blue item-navigation"><a href="@Url.Action("Post", "BannerManagement")">Interscroller</a></p>
	</div>
</section>

<section class="page-content banner-info-content">
	<div class="main-list">
		<div class="main">
			@*---- Desktop top banner section-----*@
			<div class="block-extension">
				<div class="group-table">
					<div class="left-table">
						<div class="label-fill">@ViewResources.DesktopTopBanner</div>
					</div>
					<div class="right-table">
                        <div class="box-control">
                            <div class="main-fill name-section">
                                <ul class="txt-fill">
                                    <li class="txt-feild"><img src="@Model.DesktopTopUrl" asp-append-version="true" width="200" /></li>
                                </ul>
                            </div>
                            <ul class="action-banner-admin">
                                <li>
                                    <a href="#" class="action social-action">@ViewResources.ChangeAction</a>
                                </li>
                                @if (!string.IsNullOrEmpty(Model.DesktopTopUrl))
                                {
                                    <li>/</li>
                                    <li>
                                        <a href="javascipt:;" class="social-action remove" data-type="@Model.DesktopTopUrlKey">@ViewResources.Remove</a>
                                    </li>
                                }
                            </ul>
                        </div>
						<div class="box-edit-form">
							<div class="title">
								<span>@ViewResources.DesktopTopBanner</span>
								<button type="button" class="button btn-custom-outline list-banner">@ViewResources.UploadedBanners</button>
							</div>

							<div class="title">
								<input type="text" name="input-banner-url" placeholder="Update by url"  class="form-control input-custom input-banner-url" />
							</div>
							<form enctype="multipart/form-data" method="post" data-type="@Model.DesktopTopUrlKey" class="upload-banner" id="uploadDesktopTop">
								<div class="input-upload">
									<input type="file" class="input-file photo" id="act-upload" name="desktop-photo">
									<span class="txt-img"><i class="icon-upload"></i> @ViewResources.UploadNewImage</span>
									<div class="img-upload">
										<img class="review_photo" src="#" alt="review photo" width="150" style="display:none" />
										<p class="error photo-error"></p>
										<button type="submit" name="" class="save-img">@ViewResources.SaveAction</button>
										<button type="button" class="cancel-upload icon-close" style="display:none"></button>
									</div>
								</div>
							</form>
							<span class="close-edit icon-close"></span>
						</div>
					</div>
				</div>

				<div class="group-table">
					<div class="left-table">
						<div class="label-fill">@ViewResources.NavigationUrl</div>
					</div>
					<div class="right-table">
                        <div class="box-control">
                            <div class="main-fill name-section">
                                <ul class="txt-fill">
                                    <li class="txt-feild">@Model.DesktopTopNavigationUrl</li>
                                </ul>
                            </div>
                            <a href="#" class="action social-action">@ViewResources.ChangeAction</a>
                        </div>
						<div class="box-edit-form" id="form_update_name">
							<div class="title">@ViewResources.NavigationUrl</div>
							<input type="text" name="NavigationUrl" value="@Model.DesktopTopNavigationUrl" class="input-edit" />
							<p class="error navagation-error">@ViewResources.NavigationUrlRequired</p>
							<button class="btn-submit-edit btn-save-navigation" data-type="@Model.DesktopTopNavigationUrlKey" data-current="@Model.DesktopTopNavigationUrl">@ViewResources.Save</button>
							<span class="close-edit icon-close"></span>
						</div>
					</div>
				</div>
			</div>


