@using SabaNews.Resources
@{
	Layout = "_AdminLayout";
}

@section TopHeader{
	@ViewResources.BannerInfo
}

@section Title{
	@ViewResources.BannerInfo
}
@section Styles{
	<link rel="stylesheet" href="~/minify/styles/admin_banner.min.css" asp-append-version="true">
}
@section Scripts{
	<script src="~/minify/js/admin_banner.min.js" asp-append-version="true"></script>
}
@section ActiveMenu {
	<input type="text" readonly hidden name="activeMenu" value="@ViewResources.BannerInfo" />
}
