@using static SabaNews.Site.Extensions.LivescoreHelper
@using SabaNews.Resources
<form id="updateMatch">
    <div class="flex-form-input">
        <div class="form-group-input form-group-input-left">
            <label class="label-admin">
                League Name
            </label>
            <div class="admin-text-logo">
                <div class="form-input">
                    <select class="form-control custom-input league-select" id="leagueId" style="width: 100%">
                        <option value="0">-------</option>
                        @foreach (var league in Model)
                        {
                            <option  value="@league.LeagueId" data-name="@GetLeagueName(league)">@GetLeagueName(league)</option>
                        }
                    </select>
                    <p class="error-input league-error"></p>
                </div>
            </div>
        </div>
    </div>
    <div class="flex-form-input">
        <div class="form-group-input form-group-input-left">
            <label class="label-admin">
                Season
            </label>
            <div class="admin-text-logo">
                <div class="form-input" id="seasonFilter">
                    <select class="form-control custom-input season-select">
                        <option value="">-------</option>
                    </select>
                    <p class="error-input season-error"></p>
                </div>
            </div>
        </div>
    </div>

    <div class="flex-form-input">
        <div class="form-group-input form-group-input-left">
            <label class="label-admin">
                Order
            </label>
            <div class="admin-text-logo">
                <div class="form-input" id="seasonFilter">
                    <input class="form-control custom-input input-number order" type="number" name="order" id="order" />
                    <p class="error-input order-error"></p>
                </div>
            </div>
        </div>
    </div>
    <div class="form-btn">
        <button class="btn-custom-admin btn-btn-save" type="button" id="btn-save">Save</button>
        <button class="btn-custom-admin btn-btn-cancel" type="button" data-dismiss="modal">Cancel</button>
    </div>
</form>