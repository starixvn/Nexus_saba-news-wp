@using static SabaNews.Site.Extensions.LivescoreHelper
@using SabaNews.Resources
<div class="form-section">
    <form id="updateMatch">
        <div class="form-input">
            <span class="left-section">LeagueId</span>
            <div class="right-section">
                <input class="form-control input-custom input-number " readonly type="number" name="order" id="addLeagueId" />
            </div>
        </div>
        <div class="form-input">
            <span class="left-section">Priority</span>
            <div class="right-section">
                <input class="form-control input-custom input-number order" type="number" name="order" id="order" value="@ViewBag.Order" max="@ViewBag.Order" />
                <p class="error-input order-error"></p>
            </div>
        </div>
        <div class="form-input">
            <span class="left-section">League Name</span>
            <div class="right-section">
                <select class="form-control input-custom league-select" id="leagueId" style="width:100%">
                    <option value="0">-------</option>
                    @foreach (var league in Model)
                    {
                        <option value="@league.LeagueId" data-season="@league.CurrentSeasonId" data-name="@GetLeagueName(league)">@GetLeagueName(league)</option>
                    }
                </select>
                <p class="error-input league-error"></p>
            </div>
        </div>
        <div class="form-input">
            <span class="left-section">League Icon</span>
            <span class="admin-text-logo admin-text-logo-data-img" id="leagueIcon">
            </span>
        </div>
        <div class="form-input">
            <span class="left-section">Country</span>
            <label id="country"></label>
        </div>
        <div class="form-input">
            <span class="left-section">CountryVN</span>
            <label id="countryVN"></label>
        </div>
        <div class="form-input">
            <span class="left-section">Country Icon</span>
            <span class="admin-text-logo admin-text-logo-data-img" id="countryIcon">
            </span>
        </div>
            
        <div class="form-btn">
            <button class="btn-custom-admin btn-btn-save" type="button" id="btn-save">Save</button>
            <button class="btn-custom-admin btn-btn-cancel" type="button" data-dismiss="modal">Cancel</button>
        </div>
    </form>
</div>