@using SabaNews.Resources;
@using SabaNews.Site.Extensions;
@using System.Linq;
@using SabaNews.Core.Helper;
@model SabaNews.Models.Home.FixtureGridViewModel;
@{
    var count = 0;
}
<div class="table-admin">
    <table class="data-grid">
        <thead>
            <tr>
                <th width="2%">#</th>
                <th width="12%">@ViewResources.LeagueFullNameEN</th>
                <th width="12%">@ViewResources.LeagueNameVN</th>
                <th width="15%">@ViewResources.CreatedDate</th>
                <th width="5%">@ViewResources.Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (var fixture in Model.ListFixture)
                {
                    var league = Model.Leagues.FirstOrDefault(item => item.LeagueId == fixture.LeagueId);
                    count++;
                    <tr>
                        <td class="text-center">@fixture.Order</td>
                        <td class="text-center">@(league != null ? league.LeagueFullNameEN : "")</td>
                        <td class="text-center">@(league != null ? league.LeagueNameVN : "")</td>
                        <td class="text-center">@DateTimeUtilize.FormatDateTime(fixture.CreatedDate, "dd/MM/yyyy HH:mm:ssss")</td>
                        <td class="text-center">
                            <i class="icon icon-edit-admin btn-Edit" title="Edit" data-id="@fixture.Id" 
                                data-name="@(league != null ? LivescoreHelper.GetLeagueName(league) : "")"></i>
                            <i class="icon icon-delete-admin btn-Delete" data-id="@fixture.Id"  title="Delete"></i>
                        </td>
                    </tr>
                }
            }
            @if (Model.ListFixture.Count == 0)
            {
                <tr>
                    <td class="nodata_table" colspan="9">@ViewResources.EmptyData</td>
                </tr>
            }
        </tbody>
    </table>
</div>