@using SabaNews.Resources
@{
    Layout = "_AdminLayout";
}

@section TopHeader{
    @ViewResources.HomepageManagement
}

    @section Title{
    @ViewResources.HomepageManagement
}
    @section ActiveMenu {
    <input type="text" readonly hidden name="activeMenu" value="@ViewResources.HomepageManagement" />
}

    @section Styles{
    <link rel="stylesheet" href="~/styles/pages/admin/homepage/fixture.css" asp-append-version="true">
    <link rel="stylesheet" href="~/styles/pages/select2.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/styles/pages/jquery-ui.css" asp-append-version="true">
}

    <section class="page-content">
        <div class="form-horizontal navigation">
            <p id="btn_major_league" class="label label-blue item-navigation"><a href="@Url.Action("Fixture", "HomepageManagement")">Fixtures</a></p>
            <p id="btn_hot_league" class="label label-blue item-navigation"><a href="@Url.Action("Standing", "HomepageManagement")">Standings<a/></p>
            <p id="btn_category" class="label label-blue item-navigation"><a href="@Url.Action("FootBall", "HomepageManagement")">Category</a></p>
            <p id="btn_category" class="label label-blue item-navigation active">Poll</p>
        </div>

        <div class="content">
        <div class="data-grid" id="data-grid">
            <div class="table-admin poll">
                <table class="data-grid" cellspacing="0" cellpadding="0">
                    <thead>
                        <tr>
                            <th width="40%">Name</th>
                            <th width="40%">Question</th>
                            <th width="20%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th>
                                <select class="form-control poll-list"  >
                                    @foreach (var item in Model.Polls)
                                    {
                                        var selected = item.Id == Model.SelectedQuestId ? "selected" : "";
                                        <option value="@item.Id" data-question="@item.Question" @selected>@item.Name</option>
                                    }
                                </select>
                            </th>
                            <th class="poll-question">@Model.SelectedQuest</th>
                            <th>
                                <button class="label label-blue btn-link btn-add btn-save-poll">
                                    Save
                                </button>
                            </th>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

        <div class="modal" id="NoticeModal" style="display:none">
            <div class="modal-content">
                <div class="modal-warning">
                    <div class="modal-title title-success">
                        <h2 class="title"><i class="icon-title icon-success-admin"></i> @ViewResources.Announcement</h2>

                        <button type="button" class="close-login close-announcement" data-dismiss="modal" aria-label="Close">
                            <i class="icon-close"></i>
                        </button>
                    </div>

                    <div class="modal-body">
                    </div>
                </div>
            </div>
        </div>

        <div class="modal confirm" id="ConfirmModal" style="display:none">
            <div class="modal-content">
                <div class="modal-warning">
                    <div class="modal-title">
                        <h2 class="title">@ViewResources.Confirmation</h2>
                        <button type="button" class="close-login close-announcement" data-dismiss="modal" aria-label="Close">
                            <i class="icon-close"></i>
                        </button>
                    </div>

                    <div class="modal-body"></div>
                    <div class="button-confirm">
                        <button class="btn-custom-outline confirm-action">Yes</button>
                        <button data-dismiss="modal" aria-label="Close" class="btn-custom-admin">No</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal modal-edit-center" id="EditLeagueContent" style="display:none">
            <div class="modal-content">
                <div class="modal-warning">
                    <div class="modal-title">
                        <h2 class="title"></h2>
                        <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
                            <i class="icon-close"></i>
                        </button>
                    </div>

                    <div class="modal-body ck-content">
                    </div>
                </div>
            </div>
        </div>
    </section>

    @section Scripts {
        <script>
            var isFixtureOption = false;
        </script>
        <script src="~/js/select2.min.js" asp-append-version="true"></script>
        <script src="~/js/admin/homepage/poll.js" asp-append-version="true"></script>

}