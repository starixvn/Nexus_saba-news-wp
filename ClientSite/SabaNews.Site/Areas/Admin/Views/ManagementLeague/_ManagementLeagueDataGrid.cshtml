@using SabaNews.Resources
@using SabaNews.Core.Helper 
@{ var count = (Model.Paging.CurrentPage - 1) * Model.Paging.PageSize; }
<div class="table-admin">
    <table class="data-grid">
        <thead>
            <tr>
                <th>#</th>
                <th>@ViewResources.LeagueFullNameEN</th>
                <th>@ViewResources.LeagueNameVN</th>
                <th>@ViewResources.CreatedDate<i class="icon-sort-admin" id="btn-sort-createdDate"></i></th>
                <th>@ViewResources.Major</th>
                <th>@ViewResources.Priority<i class="icon-sort-admin" id="btn-sort-priority"></i></th>
                <th>@ViewResources.Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (var league in Model.Leagues)
                {
                    count++;
                        <tr>
                            <td class="text-center" width="5%">@count</td>
                            <td class="text-left" width="25%">@league.LeagueFullNameEN</td>
                            <td class="text-left" width="25%">@league.LeagueNameVN</td>
                            <td class="text-center" width="18%">@DateTimeUtilize.ChangeTimeZoneToClient(league.CreatedDate)</td>
                            <td class="text-center" width="9%">
                                <input type="checkbox" @(league.IsMajor == true ? "checked" : "")
                                       data-url="@Url.Action("ChangeMajor", "ManagementLeague", new { leagueId = league.LeagueId, priority = league.Priority })"
                                       class="isMajorLeague" id="checkMajor" />
                            </td>
                            <td class="text-center" width="9%">
                                <input type="text" class="text-center priority-league"
                                       data-url="@Url.Action("ChangePriority", "ManagementLeague", new { leagueId = league.LeagueId, isMajor = league.IsMajor})"
                                       value="@league.Priority" id="textPriority" />
                            </td>
                            <td class="text-center" width="8%">
                                <i class="icon icon-delete-admin btn-Delete"
                                   data-url="@Url.Action("RemoveLeagueExtra", "ManagementLeague", new { leagueId = league.LeagueId})"></i>
                            </td>
                        </tr>
                }
            }
            @if (Model.Leagues.Count == 0)
            {
                <tr>
                    <td class="nodata_table" colspan="9">@ViewResources.EmptyData</td>
                </tr>
            }
        </tbody>
    </table>
    @(await Component.InvokeAsync("Paging", new { model = Model.Paging }))
</div>