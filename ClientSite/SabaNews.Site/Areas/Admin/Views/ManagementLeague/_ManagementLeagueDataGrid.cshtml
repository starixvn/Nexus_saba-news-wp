@using SabaNews.Resources
<div class="table-admin">
    <table class="data-grid">
        <thead>
            <tr>
                <th>#</th>
                <th>@ViewResources.LeagueName</th>
                <th>@ViewResources.Major</th>
                <th>@ViewResources.Priority<i class="icon-sort-admin"></i></th>
                <th>@ViewResources.Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="text-center" width="5%" >1</td>
                <td class="text-center" width="25%">1</td>
                <td class="text-center" width="10%"><input type="checkbox" class="isMajor-league"/></td>
                <td class="text-center" width="10%"><input type="text" class="text-center priority-league"/></td>
                <td class="text-center" width="5%"><i class="icon icon-delete-admin"></i></td>
            </tr>
        </tbody>
    </table>
</div>