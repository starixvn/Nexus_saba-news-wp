@using SabaNews.Resources
@{
    Layout = "_AdminLayout";
}

@section TopHeader{
    @ViewResources.ManagementLeague
}

@section Title{
    @ViewResources.ManagementLeague
}
@section ActiveMenu {
    <input type="text" readonly hidden name="activeMenu" value="@ViewResources.ManagementLeague" />
}

@section Styles{
    <link rel="stylesheet" href="~/styles/pages/admin/managementleague/managementleague.css" asp-append-version="true">
    <link rel="stylesheet" href="~/styles/pages/select2.min.css" asp-append-version="true">
}

<section class="page-content">
    <div class="form-horizontal filter">
        <div class="form-input">
            <p class="label-admin">@ViewResources.SearchLabel</p>
            <input type="text" class="custom-input list-input" id="search" name="searchLeague" placeholder="Enter League Name..." />
        </div>
        <div class="form-input">
            <p class="label-admin">@ViewResources.IsHot</p>
            <select class="custom-input list-input filter-majorLeague" name="status" id="major">
                <option value="-1">@ViewResources.All</option>
                <option value="1">@ViewResources.Yes</option>
                <option value="0">@ViewResources.No</option>
            </select>
        </div>
        <button class="btn-custom-admin" type="submit" id="submit-btn">@ViewResources.Submit</button>
    </div>
    <div class="content">
        <div class="add-league">
            <button href="javascript:;" class="label label-blue btn-link btn_league"><img src="~/images/icon/icon-plus.png" class="icon-add-league" />@ViewResources.AddLeague</button>
        </div>
        <div class="data-grid" id="data-grid"></div>
    </div>

    <div class="modal modal-edit-center" id="AddLeagueContent" style="display:none">
        <div class="modal-content">
            <div class="modal-warning">
                <div class="modal-title">
                    <h2 class="title"></h2>
                    <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
                        <i class="icon-close"></i>
                    </button>
                </div>

                <div class="modal-body ck-content">
                </div>
            </div>
        </div>
    </div>

    <div class="modal" id="NoticeModal" style="display:none">
        <div class="modal-content">
            <div class="modal-warning">
                <div class="modal-title title-success">
                    <h2 class="title"><i class="icon-title icon-success-admin"></i> @ViewResources.Announcement</h2>

                    <button type="button" class="close-login close-announcement" data-dismiss="modal" aria-label="Close">
                        <i class="icon-close"></i>
                    </button>
                </div>

                <div class="modal-body">

                </div>
            </div>
        </div>
    </div>

    <div class="modal confirm" id="ConfirmModal" style="display:none">
        <div class="modal-content">
            <div class="modal-warning">
                <div class="modal-title">
                    <h2 class="title">@ViewResources.Confirmation</h2>
                    <button type="button" class="close-login close-announcement" data-dismiss="modal" aria-label="Close">
                        <i class="icon-close"></i>
                    </button>
                </div>

                <div class="modal-body"></div>
                <div class="button-confirm">
                    <button class="btn-custom-outline confirm-action">Yes</button>
                    <button data-dismiss="modal" aria-label="Close" class="btn-custom-admin">No</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal modal-edit-center" id="EditLeagueContent" style="display:none">
        <div class="modal-content">
            <div class="modal-warning">
                <div class="modal-title">
                    <h2 class="title"></h2>
                    <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
                        <i class="icon-close"></i>
                    </button>
                </div>

                <div class="modal-body ck-content">
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin/managementleague/managementleague.js" asp-append-version="true"></script>
    <script src="~/js/select2.min.js" asp-append-version="true"></script>
}