@using SabaNews.Resources
@{
    Layout = "_AdminLayout";
}

@section TopHeader{
    @ViewResources.ManagementLeague
}

@section Title{
    @ViewResources.ManagementLeague
}
@section ActiveMenu {
    <input type="text" readonly hidden name="activeMenu" value="@ViewResources.ManagementLeague" />
}

@section Styles{
    <link rel="stylesheet" href="~/styles/pages/admin/managementleague/managementleague.css" asp-append-version="true">
}

<section class="page-content">
    <div class="form-filter" style="margin-bottom: 2rem">
        <form class="form-horizontal" action="/Admin/ManagementLeague/SearchData" method="get">
            <div class="form-input">
                <input type="text" class="custom-input list-input" id="search" name="resultNumber" placeholder="Enter League Name..." />
            </div>

            <button class="btn-custom-admin" type="submit" id="submit-btn">Search</button>
        </form>
    </div>
    <div class="content">
        <div class="add-league"><a href="" class="label label-blue">Add League</a></div>
        <div class="data-grid" id="data-grid"></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin/managementleague/managementleague.js" asp-append-version="true"></script>
}