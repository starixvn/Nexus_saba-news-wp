@using SabaNews.Resources
@{
    var count = (Model.Paging.CurrentPage - 1) * Model.Paging.PageSize;
    var searchAddLeague = @ViewBag.SearchAddLeague;
}
<div class="form-horizontal" style="margin-bottom:20px;">
    <div class="form-input">
        <p class="label-admin">@ViewResources.SearchLabel</p>
        <input type="text" class="custom-input list-input" id="searchLeague" value="@(searchAddLeague != null ? searchAddLeague : "")" name="resultNumber" placeholder="Enter League Name..." />
    </div>
    <button class="btn-custom-admin" type="submit" id="submit-btnAddLeague">@ViewResources.Submit</button>
</div>
<div class="table-admin" id="data-grid-addLeague">
    <table class="data-grid-addLeague">
        <thead>
            <tr>
                <th>#</th>
                <th>@ViewResources.LeagueFullNameEN</th>
                <th>@ViewResources.LeagueNameEN</th>
                <th>@ViewResources.LeagueNameVN</th>
                <th>@ViewResources.Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (var league in Model.Leagues)
                {
                    count++;
                    <tr>
                        <td class="text-center" width="2%">@count</td>
                        <td class="text-left" width="18%">@league.LeagueFullNameEN</td>
                        <td class="text-left" width="18%">@league.LeagueNameEN</td>
                        <td class="text-left" width="18%">@league.LeagueNameVN</td>
                        <td class="text-center" width="8%">
                            <span class="btn-addleague" id="@league.LeagueId"
                                  data-id="@(league.LeagueId)"
                                  data-url="@Url.Action("AddLeagueExtra", "ManagementLeague", new { leagueId = league.LeagueId})">Add</span>
                        </td>
                    </tr>
                }
            }
            @if (Model.Leagues.Count == 0)
            {
                <tr>
                    <td class="nodata_table" colspan="9">@ViewResources.EmptyData</td>
                </tr>
            }
        </tbody>
    </table>
    @(await Component.InvokeAsync("Paging", new { model = Model.Paging }))
</div>
