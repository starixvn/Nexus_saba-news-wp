@using SabaNews.Resources;
@{
	Layout = "_AdminLayout";
}


@section Title{
	@ViewBag.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/email.min.css" asp-append-version="true">
}

@section Scripts{
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.blockUI/2.70/jquery.blockUI.js"></script>

	<script src="~/js/admin/email/index.js" asp-append-version="true"></script>
}

<section>
	<div class="block block-email">
		<div class="controls">
			<div class="line">
				<h2 class="block__title"><a>@ViewResources.ListSentEmailDetail</a> </h2>
				<div class="list_email_block"></div>
			</div>
		</div>

	</div>

	<div class="modal" id="ViewEmailContent" style="display:none">
		<div class="modal-content">
			<div class="modal-warning">
				<div class="modal-title">
					<h2 class="title"></h2>
					<button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>

				<div class="modal-body ck-content">
				</div>
			</div>
		</div>
	</div>

	<div class="modal" id="ReviewSendEmail" style="display:none">
		<div class="modal-content">
			<div class="modal-warning">
				<div class="modal-title">
					<h2 class="title">Review Send Email</h2>
					<button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>

				<div class="modal-body">
					<form id="form_review_sendemail" class="form">
						<input type="hidden" name="emailId" id="emailId" value="" />
						<div class="form-group  option">
							<label>@ViewResources.SendTo</label>
							<input type="radio" name="sendTo" class="send_to" value="email" checked /> Email
							<input type="radio" name="sendTo" class="send_to" value="user" /> User
						</div>

						<div class="form-group user_list">
							<label>@ViewResources.ListUsers</label>
							<select name="user" class="form-control user">
								@foreach (var user in Model)
								{
									<option value="@user.Email" data-email="@user.Email">@user.Name</option>
								}
							</select>
						</div>

						<div class="form-group email">
							<label>@ViewResources.Email</label>
							<input type="text" class="form-control" id="email" placeholder="" name="email" />
							<p class="help-block"></p>
						</div>
						<div class="form-group">
							<button type="button" class="btn btn-success btn-review-send-email">Send</button>
						</div>
					</form>
					
				</div>
			</div>
		</div>
	</div>

	<div class="modal" id="NoticeModal" style="display:none">
		<div class="modal-content">
			<div class="modal-warning">
				<div class="modal-title">
					<h2 class="title">@ViewResources.Announcement</h2>
					<button type="button" class="close close-announcement" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>

				<div class="modal-body">

				</div>
			</div>
		</div>
	</div>

</section>

