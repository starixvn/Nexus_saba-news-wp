@using SabaNews.Resources;

<table class="custom-table detail-table text-center">
	<tr>
		<th width="3%">@ViewResources.STT</th>
		<th>@ViewResources.Email</th>
		<th width="15%">@ViewResources.SentDate</th>
		<th width="15%">@ViewResources.UserInteraction</th>
		<th width="15%">@ViewResources.Status</th>
		<th width="15%">@ViewResources.Action</th>
	</tr>
	@{ var stt = 0; }
	@foreach (var detail in Model.ListEmailDetails)
	{
		stt++;
		<tr>
			<td>@stt</td>
			<td class="text-left">@detail.EmailAddress</td>
			<td>@detail.SendTime.ToString("dd MMM yyyy HH:mm:ssss ")</td>
			<td>@Html.Raw(detail.IsUserClicked == 1 ? "<b>Clicked</b>" : "None")</td>
			<td>@(detail.Status == 0 ? ViewResources.Successful : ViewResources.Failed)
			</td>
			<td>
				@if (detail.Status != 0)
				{
					<a href="javascript:;" class="label label-blue resend-email" data-emailid="@detail.EmailId" data-userid="@detail.UserId">@ViewResources.Resend</a>
				}
			</td>
		</tr>
	}
	@if (Model.ListEmailDetails.Count == 0)
	{
		<tr>
			<th class="nodata_table" colspan="6">@ViewResources.EmptyData</th>
		</tr>
	}
	
</table>
@{
	int CurrentPage = Convert.ToInt32(Model.Paging.CurrentPage);
	int TotalPages = Convert.ToInt32(Model.Paging.TotalPages);
	var pageLast = Model.Paging.TotalPages;
	var pageNext = CurrentPage + 1;
	var pagePrev = CurrentPage - 1;
	var checkPrev = CurrentPage > 1 ? "paging" : "disabled";
	var checkNext = CurrentPage < TotalPages ? "paging" : "disabled";
}

@if (TotalPages > 1)
{
	<div class="pagination">
		<a href="javascript:;" data-page="1" class="icon-pagination icon-page-first @checkPrev"></a>
		<a href="javascript:;" data-page="@pagePrev" class="icon-pagination icon-chevron-left @checkPrev"></a>
		<ul class="main-pagination">
			@{ var front = (CurrentPage - 1 > 2) ? 2 : CurrentPage - 1;
				front = (CurrentPage - 1 == 3) ? 3 : front;
				var back = (TotalPages - CurrentPage > 2) ? 2 : TotalPages - CurrentPage;
				back = (TotalPages - CurrentPage == 3) ? 3 : back;

				if (CurrentPage - 4 >= 1)
				{
					<li class="items-pagination"><a href="javascript:;" data-page="1" class="item paging">1</a></li>
					<li class="items-pagination"><a class="item">...</a></li>
				}

				for (var i = CurrentPage - front; i <= CurrentPage + back; i++)
				{
					var active = i == CurrentPage ? "active" : "";
					<li class="items-pagination @active"><a href="javascript:;" data-page="@i" class="item paging">@i</a></li>
				}

				if (CurrentPage + 4 <= TotalPages)
				{
					<li class="items-pagination"><a class="item">...</a></li>
					<li class="items-pagination"><a href="javascript:;" data-page="@pageLast" class="item paging">@Model.Paging.TotalPages</a></li>
				} }
		</ul>
		<a href="javascript:;" data-page="@pageNext" class="icon-pagination icon-chevron-right @checkNext"></a>
		<a href="javascript:;" data-page="@pageLast" class="icon-pagination icon-page-last @checkNext"></a>
	</div>
}