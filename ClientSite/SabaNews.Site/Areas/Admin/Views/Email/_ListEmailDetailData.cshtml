@using SabaNews.Resources;

<table class="custom-table detail-table text-center">
	<tr>
		<th width="3%">@ViewResources.STT</th>
		<th>@ViewResources.Email</th>
		<th width="15%">@ViewResources.SentDate</th>
		<th width="15%">@ViewResources.UserInteraction</th>
		<th width="15%">@ViewResources.Status</th>
		<th width="15%">@ViewResources.Action</th>
	</tr>
	@{ var stt = 0; }
	@foreach (var detail in Model.ListEmailDetails)
	{
		var sendDate = SabaNews.Core.Helper.DateTimeUtilize.ChangeTimeZoneToClient(detail.SendTime);
		stt++;
		<tr>
			<td>@stt</td>
			<td class="text-left">@detail.EmailAddress</td>
			<td>@sendDate</td>
			<td>@Html.Raw(detail.IsUserClicked == 1 ? "<b>Clicked</b>" : "None")</td>
            <td>
                @if (detail.Status == 0)
				{
					@ViewResources.Successful;
				}
				else if (detail.Status == 1)
				{
					@ViewResources.Failed;
				} 
				else if (detail.Status == 2)
				{
					@ViewResources.New;
				}
            </td>
			<td>
				@if (detail.Status != 0)
				{
					<p class="table-control">
						<a href="javascript:;" class="action action-resend resend-email" data-emailid="@detail.EmailId" data-userid="@detail.UserId">
							<i class="icon-resend-admin"></i>
							<span class="tooltip-menu">
								@(detail.Status == 1 ? "Resend" : "Send")
							</span>
						</a>
					</p>
				}
			</td>
		</tr>
	}
	@if (Model.ListEmailDetails.Count == 0)
	{
		<tr>
			<th class="nodata_table" colspan="6">@ViewResources.EmptyData</th>
		</tr>
	}

</table>

@(await Component.InvokeAsync("Paging", new { model = Model.Paging }))