@using SabaNews.Resources;
<table>
	<tr>
		<th width="5%">@ViewResources.STT</th>
		<th>@ViewResources.Subject</th>
		<th width="10%">@ViewResources.Content</th>
		<th width="15%">@ViewResources.SendDate</th>
		<th width="10%">@ViewResources.CreatedBy</th>
		<th width="10%">@ViewResources.NumberSent</th>
		<th width="10%">@ViewResources.NumberClicked</th>
		<th width="10%">@ViewResources.Status</th>
		<th width="15%">@ViewResources.Action</th>

		@{ var stt = (Model.Paging.CurrentPage - 1) * Model.Paging.PageSize; }
		@foreach (var email in Model.Emails)
		{	
			stt++;
			var rate = (email.TotalClicked > 0 ? Math.Round((double)email.TotalClicked / email.TotalSent * 100, 2) : 0) + "%";
			var title = email.EmailTitle.Length > 50 ? email.EmailTitle.Substring(0, 50) + "..." : email.EmailTitle;
			<tr>
				<td>@stt</td>
				<td>@title</td>
				<td>
					<input value="@email.EmailContent" type="hidden" class="email_content" />
					<input value="@email.EmailTitle" type="hidden" class="email_title" />
					<a href="javascript:;" class="label color-blue email view_content">View</a>
				</td>
				<td>@email.CreatedTime</td>
				<td>@email.CreatedName</td>	
				<td>
					@if (email.TotalSent > 0)
					{
						<a href="@Url.Action("Detail", "Email", new { emailId = email.Id })">@email.TotalSent</a>
					}
					else
					{
						@email.TotalSent
					}
				</td>
				<td>@email.TotalClicked / @rate</td>
				<td>
					@if (email.Status == 0)
					{
						@ViewResources.Sent
					}
					else if (email.Status == 1)
					{
						@ViewResources.New
					}
				</td>
				<td>
					@if (email.Status == 1)
					{
						<a href="@Url.Action("Edit", "Email", new { emailId = @email.Id })" class="label color-green edit-email" data-emailid="@email.Id">@ViewResources.Edit</a>
						<a href="javascript:;" class="label color-red delete-email" data-emailid="@email.Id">@ViewResources.Delete</a>
						<a href="javascript:;" class="label color-blue send-email" data-emailid="@email.Id">@ViewResources.SendEmail</a>
					}
				</td>
			</tr>
	}
	@if (Model.Emails.Count == 0)
	{
		<tr>
			<th class="nodata_table" colspan="9">@ViewResources.EmptyData</th>
		</tr>
	}

</table>
@{
	int CurrentPage = Convert.ToInt32(Model.Paging.CurrentPage);
	int TotalPages = Convert.ToInt32(Model.Paging.TotalPages);

	var pageLast = Model.Paging.TotalPages;
	var pageNext = CurrentPage + 1;
	var pagePrev = CurrentPage - 1;
	var checkPrev = CurrentPage > 1 ? "paging" : "0";
	var checkNext = CurrentPage < TotalPages ? "paging" : "0";
}

@if (TotalPages > 1)
{
	<div class="pagination">
		<a href="javascript:;" data-page="1" class="icon-pagination icon-page-first paging"></a>
		<a href="javascript:;" data-page="@pagePrev" class="icon-pagination icon-chevron-left @checkPrev"></a>
		<ul class="main-pagination">
			@{ var front = (CurrentPage - 1 > 2) ? 2 : CurrentPage - 1;
				front = (CurrentPage - 1 == 3) ? 3 : front;
				var back = (TotalPages - CurrentPage > 2) ? 2 : TotalPages - CurrentPage;
				back = (TotalPages - CurrentPage == 3) ? 3 : back;

				if (CurrentPage - 4 >= 1)
				{
					<li class="items-pagination"><a href="javascript:;" data-page="1" class="item paging">1</a></li>
					<li class="items-pagination"><a class="item">...</a></li>
				}

				for (var i = CurrentPage - front; i <= CurrentPage + back; i++)
				{
					var active = i == CurrentPage ? "active" : "";
					<li class="items-pagination @active"><a href="javascript:;" data-page="@i" class="item paging">@i</a></li>
				}

				if (CurrentPage + 4 <= TotalPages)
				{
					<li class="items-pagination"><a class="item">...</a></li>
					<li class="items-pagination"><a href="javascript:;" data-page="@pageLast" class="item paging">@Model.Paging.TotalPages</a></li>
				} }
		</ul>
		<a href="javascript:;" data-page="@pageNext" class="icon-pagination icon-chevron-right @checkNext"></a>
		<a href="javascript:;" data-page="@pageLast" class="icon-pagination icon-page-last paging"></a>
	</div>
}