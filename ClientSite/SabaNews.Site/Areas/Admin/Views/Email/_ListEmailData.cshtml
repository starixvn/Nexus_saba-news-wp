@using SabaNews.Resources;
<table class="custom-table text-center">
	<tr>
		<th width="3%">@ViewResources.STT</th>
		<th width="12%">@ViewResources.Subject</th>
		<th width="10%">@ViewResources.Content</th>
		<th width="15%">@ViewResources.CreatedDate</th>
		<th width="10%">@ViewResources.CreatedBy</th>
		<th width="10%">@ViewResources.Sendings</th>
		<th width="10%">@ViewResources.Clicks / @ViewResources.Percentage</th>
		<th width="10%">@ViewResources.Status</th>
		<th width="17%">@ViewResources.Action</th>
	</tr>

	@{ var stt = (Model.Paging.CurrentPage - 1) * Model.Paging.PageSize; }
	@foreach (var email in Model.Emails)
	{
		stt++;
		var rate = (email.TotalClicked > 0 ? Math.Round((double)email.TotalClicked / email.TotalSent * 100, 2) : 0) + "%";
		var title = email.EmailTitle.Length > 50 ? email.EmailTitle.Substring(0, 50) + "..." : email.EmailTitle;
		var createdDate = SabaNews.Core.Helper.DateTimeUtilize.ChangeTimeZoneToClient(email.CreatedDate);
		<tr>
			<td>@stt</td>
			<td class="text-left">@title</td>
			<td>
				<input value="@email.EmailContent" type="hidden" class="email_content" />
				<input value="@email.EmailTitle" type="hidden" class="email_title" />
				<a href="javascript:;" class="label label-blue email view_content">View</a>
			</td>
			<td>@createdDate</td>
			<td class="text-left">@email.CreatedName</td>
			<td class="text-right">
				@if (email.TotalSent > 0)
				{
					<a href="@Url.Action("Detail", "Email", new { emailId = email.Id })">@email.TotalSent</a>
				}
				else
				{
					@email.TotalSent
				}
			</td>
			<td class="text-right">@email.TotalClicked / @rate</td>
			<td>
				@if (email.Status == 0)
				{
					@ViewResources.Sent
				}
				else if (email.Status == 1)
				{
					@ViewResources.New
				}
			</td>
			<td>
				@if (email.Status == 1)
				{
					<a href="@Url.Action("Edit", "Email", new { emailId = @email.Id })" class="label label-green edit-email" data-emailid="@email.Id">@ViewResources.Edit</a>
					<a href="javascript:;" class="label label-red delete-email" data-emailid="@email.Id">@ViewResources.Delete</a>
					<a href="javascript:;" class="label label-blue send-email" data-emailid="@email.Id">@ViewResources.SendEmail</a>
				}
			</td>
		</tr>
	}
	@if (Model.Emails.Count == 0)
	{
		<tr>
			<th class="nodata_table" colspan="9">@ViewResources.EmptyData</th>
		</tr>
	}
</table>

@(await Component.InvokeAsync("Paging", new { model = Model.Paging }))
