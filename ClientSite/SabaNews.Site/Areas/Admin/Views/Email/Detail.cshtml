@using SabaNews.Resources;
@{
	Layout = "_AdminLayout";
}


@section TopHeader{
	@ViewResources.ListDetailElectronicDirectMail
}


@section Title{
	@ViewResources.ListDetailElectronicDirectMail
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/admin_email.min.css" asp-append-version="true">
}
.
@section Scripts{
	<script src="~/minify/js/admin_email_detail.min.js" asp-append-version="true"></script>
}
<section>
	<div class="block block-email">
		<div class="controls">
			<div class="constrols_list_sendmail line">
				<p><a href="@Url.Action("Index", "Email")"><i class="icon-arrow-left"></i><span>@ViewResources.BackToEmailList</span></a></p>
				<div class="form_search">
					<div class="row">
						<div class="col-md-3 form-group">
							<label>Email</label>
							<input class="form-control" name="search" value="" placeholder="Search Email..." type="text" />
						</div>
						<div class="col-md-3 form-group">
							<label>User Interaction</label>
							<select class="form-control" name="filterClicked">
								<option value="-1">All</option>
								<option value="0">None</option>
								<option value="1">Clicked</option>
							</select>
						</div>
						<div class="col-md-3 form-group">
							<label>@ViewResources.Status</label>
							<select class="form-control" name="status">
								<option value="-1">All</option>
								<option value="0">Successful</option>
								<option value="1">Failed</option>

							</select>
						</div>
						<div class="col-xs-6 form-group">
							<label>&nbsp;</label>
							<button type="button" class="btn btn-primary search_email_detail">@ViewResources.Submit</button>
						</div>
					</div>
				</div>

				<div class="detail_header">
					<h3 class="detail_title">Title: @Model.Email.EmailTitle</h3>
					<p class="detail_content">Content: <a class="label color-blue" data-toggle="modal" data-target="#ViewEmailContent" href="javascript:;">View</a></p>
				</div>

				<div class="list_detail_content"></div>
			</div>
		</div>
	</div>

	<div class="modal" id="ViewEmailContent" style="display:none">
		<div class="modal-content">
			<div class="modal-warning">
				<div class="modal-title">
					<h2 class="title">@Model.Email.EmailTitle</h2>
					<button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>

				<div class="modal-body ck-content">
					@Html.Raw(Model.Email.EmailContent)
				</div>
			</div>
		</div>
	</div>

	<div class="modal" id="NoticeModal" style="display:none">
		<div class="modal-content">
			<div class="modal-warning">
				<div class="modal-title">
					<h2 class="title">@ViewResources.Announcement</h2>
					<button type="button" class="close close-announcement" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>

				<div class="modal-body">

				</div>
			</div>
		</div>
	</div>
</section>
<script>
	var eId = '@Model.Email.Id';
</script>

