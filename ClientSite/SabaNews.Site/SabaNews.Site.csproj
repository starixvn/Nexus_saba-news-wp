<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net5.0</TargetFramework>
        <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
        <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <CodeAnalysisRuleSet>SabaNews.Site.ruleset</CodeAnalysisRuleSet>
        <UserSecretsId>7bd90000-e358-45af-8b41-6c80f24f6e42</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <Content Remove="compilerconfig.json" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="App_Data\SpNames.AWS.xml" />
        <None Remove="App_Data\SpNames.Development.xml" />
        <None Remove="App_Data\SpNames.LOCAL.xml" />
        <None Remove="App_Data\SpNames.LOCAL_1.xml" />
        <None Remove="App_Data\SpNames.PROD.xml" />
        <None Remove="App_Data\SpNames.UAT.xml" />
        <None Remove="App_Data\SpNames.xml" />
        <None Remove="Views\Profile\ViewContent.html" />
    </ItemGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="wwwroot\styles\pages\admin\admin.css" />
        <_ContentIncludedByDefault Remove="wwwroot\styles\pages\Euro2020\detail.css" />
        <_ContentIncludedByDefault Remove="wwwroot\styles\pages\Euro2020\video.css" />
        <_ContentIncludedByDefault Remove="wwwroot\styles\pages\maintenance.css" />
        <_ContentIncludedByDefault Remove="wwwroot\styles\pages\profile\sendmail_detail.css" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\.sonarlint\sabanews\CSharp\SonarLint.xml" Link="SonarLint.xml" />
        <Content Include="App_Data\SpNames.AWS.xml">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.LOCAL_1.xml">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.LOCAL.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.Development.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.PROD.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.UAT.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="EmailTemplates\ConfirmEmail.txt">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="EmailTemplates\ResetPassword.txt">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Areas\Admin\Views\Email\ViewContent.html" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
        <PackageReference Include="Fanex.Data" Version="4.2.2" />
        <PackageReference Include="Fanex.Data.MySql" Version="4.2.2" />
        <PackageReference Include="Fanex.Data.Repository" Version="4.2.2" />
        <PackageReference Include="Fanex.Logging" Version="2.0.1" />
        <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.0.0" />
        <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
        <PackageReference Include="Fanex.Logging.Sentry" Version="1.0.6" />
        <PackageReference Include="HangFire.Redis.StackExchange" Version="1.8.4" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="5.0.3" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="5.0.4" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.TagHelpers" Version="2.2.0" />
        <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="5.0.2" />
        <PackageReference Include="NLog.Web.AspNetCore" Version="4.11.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="5.0.1" />
        <PackageReference Include="TimeZoneConverter" Version="3.4.0" />
        <PackageReference Include="Wangkanai.Detection" Version="3.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="wwwroot\minify\js\" />
        <Folder Include="wwwroot\minify\styles\" />
        <Folder Include="wwwroot\uploads\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="compilerconfig.json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SabaNews.Resources\SabaNews.Resources.csproj" />
        <ProjectReference Include="..\SabaNews.Core\SabaNews.Core.csproj" />
        <ProjectReference Include="..\SabaNews.Models\SabaNews.Models.csproj" />
        <ProjectReference Include="..\SabaNews.Services\SabaNews.Services.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="EmailTemplates\SendEDM.html">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="LogFiles\logs.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="LogFiles\LogTrackingSP.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="LogFiles\TrackingSP.txt">
