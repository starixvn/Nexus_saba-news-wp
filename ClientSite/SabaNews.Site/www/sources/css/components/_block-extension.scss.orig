.livescore-soccer-extension {
    padding-left: 1.6rem;

    @include tableMobile {
        display: none;
    }

    .leagues {
        background: $primary-bg;
        border: 1px solid $border-color;
        padding: 2.4rem 0 1.6rem;
        border-radius: 3px;

        &-title {
            background-color: #fffdf9;
            position: relative;
            margin-left: 2.4rem;

            span {
                font-weight: bold;
                font-size: 2rem;
                line-height: 2.7rem;
                color: #f12f19;
                text-transform: uppercase;
                background-color: #fffdf9;
                padding-left: 1rem;

                @include tableMobile {
                    font-size: 1.6rem
                }
            }

            &:after {
                content: "";
                display: block;
                background: #f12f19;
                position: absolute;
                left: 0;
                top: 2px;
                width: 0.3rem;
                height: 2rem;
                z-index: 9;
            }
        }

        &-main {
            margin-top: 1.6rem;
        }

