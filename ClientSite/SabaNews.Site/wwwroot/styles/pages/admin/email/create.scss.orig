>>>>>>> 000 - add custom ck editor


.ck.ck-editor__main > .ck-editor__editable:not(.ck-focused), .ck.ck-content.ck-editor__editable.ck-rounded-corners.ck-editor__editable_inline.ck-focused {
    border-top: 1px solid #E4E4E4;
    box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.1);
    border-bottom: none;
    border-right: none;
    border-left: none;
    border-bottom-left-radius: 5px !important;
    border-bottom-right-radius: 5px !important;
}

.ck-toolbar {
    border: none !important;
    box-shadow: 0px 1px 12px rgba(0, 0, 0, 0.1);
    border-top-left-radius: 5px !important;
    border-top-right-radius: 5px !important;
    background: $color-fff !important;
}

.ck-content {
    font-size: 1.6rem;
    padding: 0 1.2rem !important;
}

.main-list {
    width: 100%;
    max-width: 70rem;

    .form-input {
        position: relative;

        .custom-input {
            width: 100%;
            cursor: unset;
        }

        .tip {
            position: absolute;
            z-index: 9999999999;
            top: 7.5rem;
            right: -5rem;
            transform: translateX(-50%);
            height: 2.5rem;
            line-height: 2.5rem;
            background: #17191a;
            color: #fff;
            font-size: 1.2rem;
            text-decoration: none;
            white-space: nowrap;
            padding: 0 1rem;
            border-radius: 3px;
            display: none;
        }

        .help-block {
            color: #ED3F2B;
            font-size: 1.4rem;
            margin-top: .5rem;
        }
    }
}

.group_raw_link {
    margin-top: 2rem;
    display: none;

    .raw_link {
        line-height: 2.5rem;
    }

    .copy-link {
        cursor: pointer;
        position: absolute;
        top: 3.5rem;
        right: 1rem;
        text-decoration: none
    }

    .copy-link {
        text-decoration: none;

        .icon-link {
            &:before {
                font-size: 2rem;
            }
        }
    }
}
