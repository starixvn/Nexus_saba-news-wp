  .skeleton-vertical__datetime {
    display: initial;
    line-height: 2rem;
    height: 2rem;
    background: #d9d9d9;
    width: 7rem;
    display: block;
    border-radius: 20px;
    margin-left: 1.5rem;
    position: relative;
    overflow: hidden; }
    .skeleton-vertical__datetime:before {
      position: absolute;
      content: "";
      height: 100%;
      width: 100%;
      background-image: linear-gradient(to right, #d9d9d9 0%, rgba(0, 0, 0, 0.05) 20%, #d9d9d9 40%, #d9d9d9 100%);
      background-repeat: no-repeat;
      background-size: 450px 400px;
      animation: shimmer 1s linear infinite; }
  .skeleton-vertical__description {
    margin: .3rem 0;
    line-height: 1.9rem;
    height: 2rem;
    background: #d9d9d9;
    width: 90%;
    display: block;
    border-radius: 10px;
    margin: 0 auto;
    position: relative;
    overflow: hidden; }
    .skeleton-vertical__description:before {
      position: absolute;
      content: "";
      height: 100%;
      width: 100%;
      background-image: linear-gradient(to right, #d9d9d9 0%, rgba(0, 0, 0, 0.05) 20%, #d9d9d9 40%, #d9d9d9 100%);
      background-repeat: no-repeat;
      background-size: 450px 400px;
      animation: shimmer 1s linear infinite; }
    @media screen and (max-width: 1024px) {
      .skeleton-vertical__description {
        font-size: 1.2rem;
        line-height: 2rem; } }

@keyframes shimmer {
  0% {
    background-position: -450px 0; }
  100% {
    background-position: 450px 0; } }

.lazy {
  position: absolute; }

.thumb {
  background-color: #cccccc;
  width: 100%;
  display: block;
  position: relative; }

