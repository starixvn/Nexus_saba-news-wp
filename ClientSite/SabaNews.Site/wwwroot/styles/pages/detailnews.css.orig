.comment-post {
  padding: 2rem 0; }
  .comment-post .add_comment, .comment-post .add_sub_comment {
    color: #fff;
    padding: 1rem 4rem;
    background: #9f224e;
    border: none;
    margin-top: 2rem;
    font-weight: bold;
    border-radius: 3px; }
  .comment-post .heading-post-comment {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    line-height: 2.3rem; }
    .comment-post .heading-post-comment h3 {
      display: inline-block;
      font-weight: bold; }
  .comment-post form {
    margin: 1rem 0; }
    .comment-post form .comment-content-box {
      border: 1px solid #BDBDBD;
      border-radius: 3px;
      position: relative;
      padding: 1rem 0 1rem 0;
      background-color: #fff; }
      .comment-post form .comment-content-box textarea {
        resize: none;
        font-weight: 400;
        background: #fff;
        border: none;
        width: 100%;
        height: 3rem;
        color: #333;
        overflow: hidden;
        padding: .5rem 3.7rem 0 1.5rem;
        font-family: Open Sans, sans-serif; }
      .comment-post form .comment-content-box .note-text-count {
        font-weight: 400;
        color: #757575;
        background: #fff;
        padding: 1rem 1.5rem 0 1.5rem;
        width: 100%;
        display: none; }
  .comment-post .filter_comment {
    color: #ccc;
    padding-bottom: 1rem;
    border-bottom: 1px solid #E0E0E0; }
    .comment-post .filter_comment a {
      position: relative;
      font-weight: 400;
      color: #333;
      margin-right: 2rem;
      text-decoration: none; }
      .comment-post .filter_comment a:after {
        content: '';
        width: 100%;
        height: .1rem;
        background: transparent;
        position: absolute;
        bottom: -1.4rem;
        left: 0; }
    .comment-post .filter_comment .active {
      color: #9f224e;
      font-weight: 700; }
      .comment-post .filter_comment .active:after {
        background: #9f224e; }
  .comment-post .list_comments .comment_item {
    margin-top: 2rem; }
    .comment-post .list_comments .comment_item .group-comment {
      display: flex;
      align-items: flex-start;
      flex-wrap: nowrap;
      justify-content: flex-start;
      flex-direction: row; }
      .comment-post .list_comments .comment_item .group-comment .avatar {
        margin: 0 1rem 0 0;
        width: 3.6rem;
        height: 3.6rem;
        background: #e5e5e5;
        line-height: 3.6rem;
        text-align: center;
        color: #fff;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 1.8rem;
        overflow: hidden;
        border-radius: 50%; }
        .comment-post .list_comments .comment_item .group-comment .avatar img {
          width: 100%;
          height: 100%;
          object-fit: cover; }
      .comment-post .list_comments .comment_item .group-comment .user-comment {
        width: 90%; }
        .comment-post .list_comments .comment_item .group-comment .user-comment .controls-comment {
          margin-right: 2rem; }
          .comment-post .list_comments .comment_item .group-comment .user-comment .controls-comment:last-child {
            margin-right: 0; }
          .comment-post .list_comments .comment_item .group-comment .user-comment .controls-comment a {
            text-decoration: none;
            color: #828282; }
        .comment-post .list_comments .comment_item .group-comment .user-comment .nick-name {
          margin-right: .5rem; }
          .comment-post .list_comments .comment_item .group-comment .user-comment .nick-name a {
            color: #04416D;
            text-decoration: none;
            font-weight: bold; }
        .comment-post .list_comments .comment_item .group-comment .user-comment .group-sub-comment {
          margin-top: 2rem;
          padding-left: 1rem;
          border-left: 1px solid #e5e5e5; }
          .comment-post .list_comments .comment_item .group-comment .user-comment .group-sub-comment .child-comment {
            display: flex;
            margin-bottom: 2rem; }
            .comment-post .list_comments .comment_item .group-comment .user-comment .group-sub-comment .child-comment:last-child {
              margin-bottom: 0; }
            .comment-post .list_comments .comment_item .group-comment .user-comment .group-sub-comment .child-comment .sub-comment {
              width: 90%; }
          .comment-post .list_comments .comment_item .group-comment .user-comment .group-sub-comment .controls {
            margin: 1rem 0 0 0; }
          .comment-post .list_comments .comment_item .group-comment .user-comment .group-sub-comment .controls-reply a {
            color: #076db6;
            font-size: 1.3rem;
            font-weight: bold; }
    .comment-post .list_comments .comment_item .toggle-like a {
      display: inline-flex;
      align-items: center;
      text-decoration: none; }
      .comment-post .list_comments .comment_item .toggle-like a .total_like {
        margin-right: .3rem; }
      .comment-post .list_comments .comment_item .toggle-like a .icon-like:before {
        font-size: 1.6rem; }
    .comment-post .list_comments .comment_item .active-like .icon-like:before {
      color: #076DB6; }
  .comment-post .pagination {
    display: flex;
    justify-content: flex-end;
    width: 100%; }
    .comment-post .pagination a {
      color: #000;
      float: left;
      padding: .8rem 1.6rem;
      text-decoration: none;
      transition: background-color .3s;
      border: 1px solid #ddd; }
      .comment-post .pagination a:hover:not(.active) {
        background-color: #ddd; }
    .comment-post .pagination .active {
      background-color: #4CAF50;
      color: #fff;
      border: 1px solid #4CAF50; }
    .comment-post .pagination .btn-page {
      padding: 0;
      margin: 0 .5rem;
      text-align: center;
      font-size: 1.5rem;
      font-weight: 700;
      color: #333;
      transition: width 0.25s;
      width: 4rem;
      height: 4rem;
      border-radius: 3px;
      border: 1px solid #828282; }
  .comment-post .get_more {
    display: none; }
  .comment-post .show_get_more_comment {
    width: 100%;
    text-align: center;
    background: #f7f7f7;
    padding: 0 2rem;
    height: 48px;
    color: #076DB6;
    cursor: pointer;
    font-size: 1.7rem; }
    .comment-post .show_get_more_comment:hover:not(.active) {
      background-color: #087CCE;
      color: #fff; }

