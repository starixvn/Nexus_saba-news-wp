        border-top: 1px solid #999999;
        padding-top: 2rem; }
        @media screen and (max-width: 1024px) {
          .fixed-social .social .item-social:nth-child(3) {
            border-top: none; } }
    @media screen and (max-width: 1024px) {
      .fixed-social .social .icon-mobile {
        margin-right: 1rem;
