.event-txt a {
  color: #0066CC !important; }

.modal-body .custom-checkbox-container {
  display: block;
  position: relative;
  padding-left: 3rem;
  cursor: pointer;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
  font-size: 1.4rem;
  color: #2F2F2F;
  line-height: 2.2rem;
  position: absolute;
  bottom: 50px;
  right: 50%;
  transform: translate(50%, -50%);
  font-weight: 700; }
  @media (max-width: 767px) {
    .modal-body .custom-checkbox-container {
      bottom: 25px;
      right: 50%;
      left: auto; } }

.modal-body .custom-checkbox-container input {
  position: absolute;
  opacity: 0;
  cursor: pointer;
  height: 0;
  width: 0; }

.modal-body .checkmark {
  position: absolute;
  left: 5px;
  top: 2px;
  height: 1.8rem;
  width: 1.8rem;
  background-color: transparent;
  border: 2px solid #2F2F2F;
  border-radius: 3px; }

.modal-body .custom-checkbox-container input:checked ~ .checkmark {
  background-color: transparent !important; }

.modal-body .checkmark:after {
  content: "";
  position: absolute;
  display: none; }

.modal-body .custom-checkbox-container input:checked ~ .checkmark:after {
  display: block; }

.modal-body .custom-checkbox-container .checkmark:after {
  left: 5px;
  top: 1px;
  width: 5px;
  height: 10px;
  border: solid #2F2F2F;
  border-width: 0 2px 2px 0;
  -webkit-transform: rotate(45deg);
  -ms-transform: rotate(45deg);
  transform: rotate(45deg); }

