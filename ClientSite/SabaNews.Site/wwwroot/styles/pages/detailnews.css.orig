      border-radius: 4px 0 0 4px; }

.poll-name {
  background: #13B307;
  padding: 10px;
  color: #fff;
  line-height: 21px;
  text-align: center;
  font-weight: 600; }

.main-div-of-the-poll-answer {
  vertical-align: top;
  overflow: hidden;
  position: relative; }

