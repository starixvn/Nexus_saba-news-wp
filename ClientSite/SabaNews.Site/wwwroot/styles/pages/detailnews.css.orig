.main-social {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  justify-content: space-between;
  flex-direction: row; }
  .main-social .social {
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    justify-content: center;
    flex-direction: row;
    margin: 1.6rem 0 1.6rem 0; }
    .main-social .social .item-social {
      margin-right: 1rem; }
      .main-social .social .item-social:first-child {
        font-size: 1.6rem;
        line-height: 2.4rem;
        color: #454545; }
      .main-social .social .item-social .item {
        text-decoration: none;
        color: #454545;
        font-size: 1.5rem; }
        .main-social .social .item-social .item .icon-social {
          font-size: 2.4rem; }
  .main-social .left-social .item-social:last-child {
    border: 1px solid #BEBEBE;
    box-sizing: border-box;
    border-radius: 5px;
    padding: .4rem 1rem .4rem .8rem; }
