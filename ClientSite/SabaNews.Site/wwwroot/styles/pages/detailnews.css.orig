      stroke: #2B89CC;
      fill: #2B89CC; }
  .main-social .left-social .item-social .intent {
    display: flex;
    align-items: center; }
    .main-social .left-social .item-social .intent .svg-bookmark {
      margin-right: .8rem; }

.icon-social:before {
  color: #828282; }

.fixed-social {
  position: sticky;
  top: 8rem;
  display: table;
  width: 4rem;
  text-align: center;
  opacity: 1;
  transition: .3s all ease-in-out;
  visibility: visible; }
  @media screen and (max-width: 1024px) {
    .fixed-social {
      position: fixed;
      left: 0;
      width: 100%;
      background: #FFFDF9;
      height: 4.4rem;
      top: 0;
      z-index: 999999;
      box-shadow: 0px 4px 5px rgba(0, 0, 0, 0.16);
      display: none; } }
  .fixed-social .social {
    display: inherit; }
    @media screen and (max-width: 1024px) {
      .fixed-social .social {
        margin: 0; } }
    .fixed-social .social .item-social {
      margin-right: 0;
      padding-bottom: 1.2rem; }
