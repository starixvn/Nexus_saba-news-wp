  padding-bottom: 65%; }

.thumb-56 {
  padding-bottom: 56%; }

.thumb-50 {
  padding-bottom: 50%; }

.thumb-52 {
  padding-bottom: 52%; }

.thumb-44 {
  padding-bottom: 44%; }

.thumb-40 {
  padding-bottom: 40%; }

