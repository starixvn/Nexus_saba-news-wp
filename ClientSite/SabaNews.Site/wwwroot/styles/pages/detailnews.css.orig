.block {
  margin-bottom: 2rem; }
  @media screen and (max-width: 1024px) {
    .block {
      margin-bottom: 0;
      padding-bottom: 1.6rem; } }
  .block__title {
    margin-bottom: 1.2rem;
    position: relative;
    padding-left: 1rem; }
    @media screen and (max-width: 1024px) {
      .block__title {
        margin-bottom: .9rem; } }
    .block__title::after {
      content: "";
      display: block;
      background: #F12F19;
      position: absolute;
      left: 0;
      top: 2px;
      width: .3rem;
      height: 2rem;
      z-index: 0; }
    .block__title a {
      font-weight: bold;
      font-size: 2rem;
      line-height: 2.7rem;
      color: #F12F19;
      text-decoration: none;
      text-transform: uppercase;
      background-color: #FFFDF9;
      position: relative;
      z-index: 9;
      padding-right: 1rem;
      line-height: 1; }
      .block__title a:hover {
        color: #cb200c; }
      @media screen and (max-width: 1024px) {
        .block__title a {
          font-size: 1.6rem; } }

button {
  outline: none;
  border: 0;
  padding: 0; }

.btn-play-video {
  height: 8rem;
  width: 8rem;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  justify-content: center;
  flex-direction: column;
  border-radius: 50%;
  position: absolute;
  transform: translate(50%, -50%);
  right: 50%;
  top: 50%;
  cursor: pointer; }
  @media screen and (max-width: 1024px) {
    .btn-play-video {
      height: 4.6rem;
      width: 4.6rem; } }
  .btn-play-video span {
    font-size: 4.6rem;
    color: #fff; }
    @media screen and (max-width: 1024px) {
      .btn-play-video span {
        font-size: 2rem; } }

.btn-custom-admin {
  cursor: pointer;
  width: 11.3rem;
  height: 4rem;
  border-radius: 5px;
