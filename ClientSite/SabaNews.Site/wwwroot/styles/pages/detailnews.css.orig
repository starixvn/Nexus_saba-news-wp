    .block-extension {
      padding-left: 1rem; } }
  @media (max-width: 767px) {
    .block-extension {
      padding: 0;
      padding-top: 2.4rem; } }

.pollevent {
  width: 40rem;
  margin: 2.5rem auto;
  font-size: 1.4rem; }
  @media (max-width: 767px) {
    .pollevent {
      width: 100%; } }

.poll-element {
  width: 100%;
  cursor: pointer;
  background: #FFFDF9;
  border: 1px solid #D1D1D1;
  box-sizing: border-box;
  border-radius: 3px;
  padding: 0.1rem 0.8rem;
  margin-bottom: 1rem; }
  .poll-element.active {
    border: 1px solid #294579;
    box-sizing: border-box;
    box-shadow: 3px 4px 9px 1px rgba(200, 200, 200, 0.25); }

.radio-input {
  visibility: hidden;
  position: absolute;
  top: 0;
  left: 0; }

.radio-label {
  position: relative;
  padding-left: 2.8rem;
  cursor: pointer;
  font-weight: bold;
  color: #9EA2AB; }
  .radio-label:after {
    content: "";
    display: block;
    position: absolute;
    left: 6px;
    top: 0;
    width: .8rem;
    height: 1.2rem; }

.radio-border {
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  position: absolute;
  left: 0;
  top: -2px;
  border: 2px solid #9EA2AB; }

.radio-input:checked + .radio-label .radio-border {
  border: 2px solid #294579 !important;
  background: #294579 !important; }

.radio-input:checked + .radio-label {
  color: #294579; }

.radio-input:checked + .radio-label:after {
  border: solid white;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg); }

.poll-section {
  margin-bottom: 1rem; }
  .poll-section .poll-content {
    background: #FFFDF9;
    padding: 1.6rem;
    border: 1px solid #223453; }
    .poll-section .poll-content .poll-question {
      color: #4F4F4F;
      font-weight: bold;
      line-height: 2.4rem; }
    .poll-section .poll-content .choose-poll {
      margin-top: 1.2rem; }
    .poll-section .poll-content .poll-action {
      line-height: 1;
      align-items: center;
      display: flex;
      justify-content: space-between; }
      .poll-section .poll-content .poll-action .btn-vote {
        background: #F12F19;
        border-radius: 3px;
        padding: 1rem 2rem;
        color: #FFFFFF;
        font-weight: bold;
        font-size: 1.3rem;
        line-height: 1.5rem;
        cursor: pointer; }
      .poll-section .poll-content .poll-action .btn-result {
        background: transparent;
        border-bottom: 1px solid;
        height: 2rem;
        color: #F12F19;
        font-weight: bold;
        font-size: 1.3rem;
        cursor: pointer; }
    .poll-section .poll-content .total-result {
      margin: 1.5rem 0 .5rem 0; }
      .poll-section .poll-content .total-result .total-count, .poll-section .poll-content .total-result .total-date {
        display: flex; }
        .poll-section .poll-content .total-result .total-count p, .poll-section .poll-content .total-result .total-date p {
          margin-bottom: 1rem;
          line-height: 1;
          color: #4F4F4F;
          margin-right: .5rem;
          font-weight: bold; }
  .poll-section .poll-name {
    background: #223453;
    padding: 1.2rem 1rem;
    color: #FFFDF9;
    line-height: 2.4rem;
    text-align: center;
    font-weight: bold;
    font-size: 1.8rem; }

.list-result {
  margin-top: 1.2rem; }
  .list-result .result-element {
    margin-bottom: 1.2rem;
    line-height: 1;
    background: #FFFDF9;
    border: 1px solid #D1D1D1;
    box-sizing: border-box;
    border-radius: 4px;
    padding: 1rem; }
    .list-result .result-element .top-result {
      margin-bottom: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center; }
      .list-result .result-element .top-result span {
