.title-care {
  padding-top: 3rem;
  border-top: 1px solid #828282; }
  .title-care::after {
    display: none; }

.card-vertical-highlight [class*="card-vertical__"]:not(.card-vertical__image) {
  padding: 0 !important;
  overflow: hidden;
  position: relative; }

.card-vertical-highlight .card-vertical__title {
  font-size: 2.8rem;
  line-height: 3.8rem; }
  @media screen and (max-width: 1024px) {
    .card-vertical-highlight .card-vertical__title {
      font-size: 2.4rem;
      line-height: 3.2rem; } }

.card-vertical-highlight .card-vertical__image {
  display: none; }

.card-horizontal, .skeleton-horizontal {
  margin-bottom: 2rem;
  display: grid;
  grid-template-columns: 30.5rem 1fr;
  grid-template-rows: 17rem;
  grid-gap: 2rem; }
  @media screen and (max-width: 1024px) {
    .card-horizontal, .skeleton-horizontal {
      display: grid;
      grid-template-columns: 20.5rem 1fr;
      grid-template-rows: 12rem;
      grid-gap: 1.2rem; } }
  @media (max-width: 767px) {
    .card-horizontal, .skeleton-horizontal {
      display: grid;
      grid-template-columns: 16.5rem 1fr;
      grid-template-rows: auto;
      grid-gap: 1.2rem;
      margin-bottom: 1.2rem; } }
  .card-horizontal__image, .skeleton-horizontal__image {
    height: 100%; }
    @media screen and (max-width: 1024px) {
      .card-horizontal__image, .skeleton-horizontal__image {
        height: 9.3rem; } }

.skeleton-vertical .skeleton-vertical__image {
  height: 39.3rem; }

.hidden-detail .main-menu {
  padding-top: 0 !important; }

#announcement {
  display: none; }
  #announcement .modal-auth {
    position: relative; }
    #announcement .modal-auth .modal-warning {
      padding: 3rem; }
      #announcement .modal-auth .modal-warning .heading-warning {
        padding-bottom: 2rem;
        border-bottom: 1px solid #e5e5e5;
        text-align: center;
        color: #333;
        font-size: 1.8rem;
        font-weight: 700; }
      #announcement .modal-auth .modal-warning .content {
        text-align: center;
        margin: 2rem 0; }
    #announcement .modal-auth .close-login {
      position: absolute;
      top: -1.6rem;
      right: -1.6rem;
      z-index: 999999;
      cursor: pointer;
      color: #4F4F4F;
      width: 3.2rem;
      height: 3.2rem;
      background: #fff;
      border-radius: 50%;
      line-height: 3.2rem;
      font-size: 3rem;
      outline: none; }
      @media screen and (max-width: 1024px) {
        #announcement .modal-auth .close-login {
          right: 0; } }
      #announcement .modal-auth .close-login:focus {
        outline: none; }

.button-social-menu {
  width: 2.8rem;
  height: 3rem;
  transform: rotate(0);
  transition: .5s ease-in-out;
  cursor: pointer;
  display: none;
  position: relative; }
  @media screen and (max-width: 1024px) {
    .button-social-menu {
      display: block;
      position: absolute;
      left: 1rem;
      top: .8rem;
      z-index: 9999999999999999; } }
  .button-social-menu .line-mb {
    display: block;
    position: absolute;
    height: .2rem;
    width: 70%;
    background: #081224;
    opacity: 1;
    transform: rotate(0);
    transition: .25s ease-in-out;
    border-radius: 1rem; }
    .button-social-menu .line-mb:nth-child(1) {
      top: .8rem; }
    .button-social-menu .line-mb:nth-child(2) {
      top: 1.4rem; }
    .button-social-menu .line-mb:nth-child(3) {
      top: 2rem; }

.mb-singe-page {
  display: none; }
  @media screen and (max-width: 1024px) {
    .mb-singe-page {
      position: fixed;
      background: #fff;
      height: 100%;
      width: 100%;
      top: 0;
      left: 0;
      z-index: 9999999999; } }
  .mb-singe-page .close-socical {
    cursor: pointer;
    position: absolute;
    top: 1.8rem;
    left: 1rem; }
    .mb-singe-page .close-socical .icon-close:before {
      font-size: 2.4rem; }
  .mb-singe-page .social-provider {
    list-style: none; }
    .mb-singe-page .social-provider .languages-box {
      right: 1rem;
      left: auto; }
      @media only screen and (min-width: 1024px) and (max-width: 1366px) {
        .mb-singe-page .social-provider .languages-box {
          position: absolute;
          top: 1.5rem; } }
      @media screen and (max-width: 1024px) {
        .mb-singe-page .social-provider .languages-box .languages-list {
          left: -6rem; } }
  .mb-singe-page .main-menu {
    display: flex;
    flex-wrap: wrap;
    padding-top: 7rem; }
    .mb-singe-page .main-menu .menu-item {
      width: 100%;
      order: 2;
      border-bottom: 1px solid #E0E0E0;
      text-align: left; }
      .mb-singe-page .main-menu .menu-item:first-child {
        border-top: 1px solid #E0E0E0;
        margin-top: 1.5rem; }
      .mb-singe-page .main-menu .menu-item:nth-last-child(2) {
        border-bottom: none; }
        .mb-singe-page .main-menu .menu-item:nth-last-child(2) a {
          border: none; }
      .mb-singe-page .main-menu .menu-item .item {
        text-decoration: none;
        display: block;
        padding: 1.6rem 1.2rem;
        font-weight: 600;
        transition: color .2s ease;
        line-height: 1.7rem;
        color: #4F4F4F; }
        .mb-singe-page .main-menu .menu-item .item:hover {
          color: #F12F19; }
    .mb-singe-page .main-menu .search-input {
      order: 1;
      width: 100%;
      margin: 0 1rem; }

.active-mb-social {
  display: block; }

.detail-content-table {
  margin-bottom: 2rem; }
  .detail-content-table ul {
    list-style: none;
    margin: 0;
    width: 50%;
    padding: 0 1.5rem; }
  .detail-content-table li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e5e5e5;
    padding: .8rem 0; }
    .detail-content-table li:last-child {
      border-bottom: none; }
  .detail-content-table .date, .detail-content-table .name, .detail-content-table .place, .detail-content-table [class*="tab-"] {
    color: #222;
    text-align: center;
    width: 10rem; }
  .detail-content-table .tab-success, .detail-content-table .tab-danger, .detail-content-table .tab-warning {
    color: #fff;
    font-weight: 700;
    padding: .5rem;
    border-radius: 5px;
    width: 13rem; }
  .detail-content-table .name, .detail-content-table .place {
    padding: 0 1.2rem;
    width: 100%; }
  .detail-content-table .name {
    text-align: right; }
  .detail-content-table .place {
    text-align: left; }
  .detail-content-table date {
    width: 23rem; }
  .detail-content-table .tab-success {
    background: #A2CC90; }
  .detail-content-table .tab-danger {
    background: #BB5555; }
  .detail-content-table .tab-warning {
    background: #E5B05E; }
  .detail-content-table .child-table {
    margin-bottom: 2rem;
    width: 100%;
    max-width: 50rem;
    margin: 0 auto; }
    .detail-content-table .child-table:first-child .tab-success, .detail-content-table .child-table:first-child .tab-danger, .detail-content-table .child-table:first-child .tab-warning {
      background-color: transparent;
      color: #222; }
    .detail-content-table .child-table .heading-detail {
      color: #7C8BC4;
      font-size: 1.8rem;
      margin-top: 2rem;
      padding-bottom: .5rem;
      margin-bottom: 1.5rem;
      position: relative; }
      .detail-content-table .child-table .heading-detail:after {
        content: "";
        display: block;
        width: 100%;
        height: .2rem;
        background: #02B8F7;
        position: absolute;
        bottom: 0;
        left: 0; }

.ul1 {
