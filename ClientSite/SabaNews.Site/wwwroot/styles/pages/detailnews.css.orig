            font-size: 2rem; }
          .fixed-social .social .icon-mobile a .icon-back {
            border: none; } }
    @media screen and (max-width: 1024px) and (max-width: 1024px) {
      .fixed-social .social .icon-mobile a svg {
        width: 1rem; } }

.active-scroll-mobile {
