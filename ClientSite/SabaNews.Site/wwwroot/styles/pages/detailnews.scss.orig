    span {
        width: 90%;

        @include Mobile {
            width: 80%;
        }
    }

    .euro-number {
        color: #fff;
        // display: inline-block;
        //  padding: 0 18px;
        margin-right: 10px;
        // height: 4.7rem;
        line-height: 47px;
        font-size: 2.4rem;
        position: inherit;
        z-index: 9999;
        width: 10%;
        display: flex;
        align-items: center;
        justify-content: center;

        @include Mobile {
            width: 20%;
        }
    }
}
.instagram-media{
    margin : 2rem auto !important;
}



@media screen and (min-width: 320px) {
    .detail-content-table ul {
        width: 100%;
        padding: 0;
    }

    .detail-content-table ul li span {
        font-size: 1.2rem;
    }
}

@media screen and (min-width: 768px) {
    .detail-content-table ul li span {
        font-size: 1.6rem;
    }
}

@media screen and (min-width: 1024px) {
    .detail-content-table ul li span {
        font-size: 1.6rem;
    }
}


.wapper.active-fixed, .wapper.active-fixed {
    .fixed-social {
        @include Mobile {
            z-index: 10008;
            display: flex;
            justify-content: flex-end;
        }
    }

    .top-header {
        position: fixed;
        z-index: 10005;
        top: 0;
    }
}

.hidden-detail {
    .fixed-social {
        @include Mobile {
            z-index: 10008;
            display: flex;
            justify-content: flex-end;
        }
    }

    .top-header {
        position: fixed;
        z-index: 10005;
        top: 0;
        .group-menu {
            .nav-menu {
                .main-menu {
                    display: flex;
                    padding-top: 6.6rem;
                }
            }
        }
    }
}



