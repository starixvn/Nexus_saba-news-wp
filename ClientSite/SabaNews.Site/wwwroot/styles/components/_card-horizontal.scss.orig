.card-horizontal {
    @include grid(19.5rem 1fr, 11rem, 1.2rem);
    overflow: hidden;

    @include tableMobile {
        @include grid(13.5rem 1fr, none, 1.2rem);
    }

    @include Mobile {
        margin-bottom: 1.2rem;
        padding-bottom: 1.2rem;

        &:last-child {
            margin-bottom: 0;
        }
    }

    &__image {
        @include tableMobile {
            height: 7.2rem;
        }

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    &__content {
        .title {
            font-weight: bold;
            font-size: $font-size-title;
            text-decoration: none;
            color: $color-text;
            transition: color .3s ease;
            display: block;

            .comment {
                display: inline-flex;
                align-items: center;
                margin-left: 1rem;
                vertical-align: middle;

                .number {
                    color: #2B89CC;
                    font-weight: normal;
                    font-style: normal;
                    font-size: 1.3rem;
                    margin-left: .3rem;
                }
            }

            &:hover {
                color: $color-title-hover;
            }
        }

        .datetime {
            font-size: $font-size-datetime;
            color: $color-datetime;

            @include tableMobile {
                margin-top: -.2rem;
            }
        }

        .description {
<<<<<<< HEAD
