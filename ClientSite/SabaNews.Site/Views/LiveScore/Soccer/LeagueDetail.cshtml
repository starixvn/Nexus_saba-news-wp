@using SabaNews.Livescore.Models.Match
@model GetMatchBySeasonParams
@section Styles{
    <link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true" />
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/livescore/soccer/league-detail.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/livescore/soccer/league-detail.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts{
    <script type="text/javascript">
        window.getMatchByStageParams = {
            date: '@Model.Date.ToString("yyyy-MM-dd")',
            leagueId: @Model.LeagueId,
            seasonId: @Model.SeasonId,
            selectedTab: '@Model.SelectedTab'
        };
    </script>
    <script src="~/js/livescore/livescore.js" asp-append-version="true"></script>
    <environment include="Development">
        <script src="~/js/dev/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/league-detail.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/pages/livescore/soccer/league-detail.chunk.js" asp-append-version="true"></script>
    </environment>
}
@{
    var title = "title";
    var description = "description";
    if(Model.SelectedTab == "" || Model.SelectedTab == "tong-hop" || Model.SelectedTab == "general")
    {
        title = "Livescore  " + Model.LeagueName;
        description = $" Cập nhật LTĐ, KQBD, link xem trực tiếp Livescore {Model.LeagueName} nhanh và chính xác nhất trên SABA VN";
    }
    else if(Model.SelectedTab == "lich-thi-dau" || Model.SelectedTab == "fixtures")
    {
        title = "Lịch thi đấu " + Model.LeagueName;
        description = $"Xem lịch thi đấu {Model.LeagueName} mới nhất trên SABA VN. LTĐ và xem trực tiếp các trận đấu {Model.LeagueName} được cập nhất liên tục cho độc giả.";
    }
    else if(Model.SelectedTab == "lich-thi-dau" || Model.SelectedTab == "fixtures")
    {
        title = "KQBĐ trực tuyến " + Model.LeagueName;
        description = $"Xem KQBĐ trực tuyến {Model.LeagueName}. Cập nhật kết quả bóng đá và tỉ số trận đấu {Model.LeagueName} chính xác nhất trên SABA VN.";
    }
    else
    {
        title = "Livescore  " + Model.LeagueName;
        description = $" Cập nhật LTĐ, KQBD, link xem trực tiếp Livescore {Model.LeagueName} nhanh và chính xác nhất trên SABA VN";
    }
}
@section Metadata {
    <meta name="robots" content="index,follow,noarchive,max-image-preview:large" />
    <meta name="description" content='@description' />
    <link rel="canonical" href="@ViewBag.Link" />
}
@section Title{
    @title
}
@(await Component.InvokeAsync("Menu", new { CategorySlug = "home-page" }))
<div id="app-container"></div>
@await Html.PartialAsync(ViewResources.SidebarBannerView)