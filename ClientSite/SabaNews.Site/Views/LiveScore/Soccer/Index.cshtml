@using SabaNews.Models.ViewModel.Posts
@model PageViewModel
@{
    var selectedEventDate = (DateTime?)ViewBag.EventDate;
}
@section Styles {
    <link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true" />
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/livescore/soccer/index.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/livescore/soccer/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <script type="text/javascript">
        window.selectedEventDate = '@selectedEventDate?.ToString("yyyy-MM-dd")';
        window.isLivePage = false;
    </script>
    <environment include="Development">
        <script src="~/js/livescore/livescore.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/livescore/livescore.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/pages/livescore/soccer/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
@section Metadata {
    <meta name="description" content='@Model.Header.Description' />
    <meta property="og:description" content='@Model.Category.OgDescription' />
    <meta property="og:title" content='@Model.Category.OgTitle' />
    <meta name="robots" content="noindex, follow,noarchive,max-image-preview:large" />
    <link rel="canonical" href="@Model.Category.Url">
}
@section Title {
    @Model.Header.Title
}
@(await Component.InvokeAsync("Menu", new { CategorySlug = Model.Header.CategorySlug }))
<h1 style="display: none;">Lịch thi đấu bóng đá hôm nay</h1>
<div id="app-container"></div>
@await Html.PartialAsync(ViewResources.SidebarBannerView)
@section Schema {
<script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebPage",
        "id": "@Model.Category.Url",
        "url": "@Model.Category.Url",
        "name": "@Model.Header.Title",
        "description": "@Model.Header.Description",
        "publisher": {
            "@@type": "Organization",
            "name": "SABAVN Sports",
            "logo": {
            "@@type": "ImageObject",
            "url": "https://www.sabavn.net/images/sabasports.svg"
            }
        },
        "inLanguage": "vi-VN",
        "isPartOf": {
            "@@type": "Website",
            "name": "SABAVN.net",
            "url": "https://www.sabavn.net/"
        }
    }
    </script>
}