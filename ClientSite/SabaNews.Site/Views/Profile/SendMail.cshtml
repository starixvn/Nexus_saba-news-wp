@section Title{
	@ViewBag.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/profile_sendmail.min.css" asp-append-version="true">
}

@section Scripts{
	<script src="~/js/ckeditor5/build/ckeditor.js"></script>
	<script src="~/js/lib/config_ckeditor.js"></script>
	<script src="~/js/profile/sendmail.js" asp-append-version="true"></script>
}
	
@(await Component.InvokeAsync("Menu"))
<section class="main">
	<div class="container profile-container">
		<div class="block block-main">
			@(await Component.InvokeAsync("LeftMenuProfile", new { page = ViewBag.Page }))
		</div>
		<div class="block block-email">
			<div class="controls">
				<div class="controls__sendmail">
					<h2 class="block__title"><a>@ViewResources.SendEmail </a></h2>
					<div class="sendmail">
						<div class="group-tab">
							<form id="form-sendmail">
								<input type="hidden" name="baseUrl" id="baseUrl" value="@ViewBag.BaseUrl" />
								<input type="hidden" name="baseUrl" id="returnUrl" value="" />
								<ul class="error summary-eror"></ul>
								<div class="form-group  email_title">
									<label>@ViewResources.EmailTitle</label>
									<input type="text" class="input-form" placeholder="" name="emailTitle" />
									<p class="help-block"></p>
								</div>
								
								<div class="form-group email_link">
									<label>@ViewResources.ReturnLink</label>
									<input type="text" class="input-form" placeholder="" name="emailReturnLink" />
									<p class="raw_link" style="display: none">Raw link: <span></span></p>
									<p class="help-block"></p>
								</div>
								<div class="form-group email_content">
									<label>@ViewResources.EmailContent</label>
									<textarea id="emailContent" name="emailContent" class="input-form"></textarea>
									<p class="help-block"></p>
								</div>
								<button type="submit" class="btn-send-mail">Send</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>


	<div class="modal" id="ViewEmailContent" style="display:none">
		<div class="modal-content">
			<div class="modal-warning">
				<div class="modal-title">
					<h2 class="title"></h2>
					<button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>

				<div class="modal-body ck-content">
				</div>
			</div>
		</div>
	</div>


	<div class="modal" id="NoticeModal" style="display:none">
		<div class="modal-content">
			<div class="modal-warning">
				<div class="modal-title">
					<h2 class="title">@ViewResources.Announcement</h2>
					<button type="button" class="close close-notice" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>

				<div class="modal-body">
				</div>
			</div>
		</div>
	</div>

</section>

