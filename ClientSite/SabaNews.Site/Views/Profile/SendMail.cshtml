@(await Component.InvokeAsync("Menu"))
<section class="main">
	<div class="container profile-container">
		<div class="block block-main">
			@await Html.PartialAsync("_LeftMenu", new { User = Model })
		</div>
		<div class="block block-extension">
			<div class="controls">
				<h2 class="block__title"><a>@ViewResources.Send_Mail </a></h2>
				<div class="sendmail">
					<div class="group-tab">
						<form id="form-sendmail">
							<p class="error summary-eror"></p>
							<div class="form-modal">
								<label>Email title</label>
								<input type="text" class="input-form" placeholder="" name="emailTitle" />
							</div>
							<div class="form-modal">
								<label>Email Return link</label>
								<input type="text" class="input-form" placeholder="" name="emailReturnLink" />
							</div>
							<div class="form-modal">
								<label>Email Content</label>
								<textarea id="emailContent" name="emailContent" class="input-form"></textarea>
							</div>
							<button type="submit" class="btn-send-mail">Gửi</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>