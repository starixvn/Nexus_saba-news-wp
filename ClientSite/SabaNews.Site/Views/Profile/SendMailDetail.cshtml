@section Title{
	@ViewBag.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/profile_sendmail_detail.min.css" asp-append-version="true">
}

@section Scripts{
	<script src="~/js/profile/sendmail.js" asp-append-version="true"></script>
}

@(await Component.InvokeAsync("Menu"))
<section class="main">
	<div class="container profile-container">
		<div class="block block-main">
			@(await Component.InvokeAsync("LeftMenuProfile", new { page = ViewBag.Page }))
		</div>
		<div class="block block-email">
			<div class="controls">
				<div class="constrols_list_sendmail line">
					@if (Model.Count == 0)
					{
						<h1>Không có email nào được gửi đi </h1>
					}
					else
					{
						<h1>Danh sách email đã gửi với tiêu đề: @ViewBag.EmailTitle </h1>
						<p><a data-toggle="modal" data-target="#ViewEmailContent" href="javascript:;">Xem nội dung</a></p>
						<table>
							<tr>
								<th>STT</th>
								<th>Email được gửi</th>
								<th>Ngày gửi</th>
								<th>Tương tác</th>
								<th>Trạng thái</th>
							</tr>
							@{ var stt = 0; }
							@foreach (var detail in Model)
							{
								stt++;
								<tr>
									<td>@stt</td>
									<td>@detail.EmailAddress</td>
									<td>@detail.SendMailTime</td>
									<td>@Html.Raw(detail.IsUserClicked == 1 ? "<b>Đã tương tác</b>" : "Chưa tương tác")</td>
									<td>@(detail.Status == 0 ? "Gửi thành công" : "Gửi thất bại") </td>
								</tr>
							}
						</table>

						<div class="modal" id="ViewEmailContent" style="display:none">
							<div class="modal-content">
								<div class="modal-warning">
									<div class="modal-title">
										<h2 class="title">@ViewBag.EmailTitle</h2>
										<button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
											<span aria-hidden="true">&times;</span>
										</button>
									</div>

									<div class="modal-body ck-content">
										@Html.Raw(ViewBag.EmailContent)
									</div>
								</div>
							</div>
						</div>
					}
				</div>

			</div>
		</div>
	</div>

	

</section>

