@section Title{
	@Model.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/profile.min.css" asp-append-version="true">
}

@section Scripts{
	<script src="~/minify/js/update_profile.min.js" asp-append-version="true"></script>
}

<div class="auth-form">
	<div class="modal" id="resetPasswordSuccesful" style="display:none">
		<div class="modal-content modal-auth">
			<div class="modal-warning">
				<button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
				<div class="modal-body modal-resetpass">
				</div>
			</div>

		</div>
	</div>

	<div class="modal" id="DisconnectSuccessful" style="display:none">
		<div class="modal-content modal-auth">
			<div class="modal-warning">
				<button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
				<div class="tab-content" id="nav-tabContent">
					<h3 class="heading-warning">@ViewResources.Message</h3>
					<hr />
					<h3 class="content"></h3>
				</div>
			</div>
		</div>
	</div>

	<div class="modal" id="ErrorConnectSocial" style="display:none">
		<div class="modal-content modal-auth">
			<div class="modal-warning">
				<button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
				<div class="tab-content" id="nav-tabContent">
					<h3 class="heading-warning">@ViewResources.Message</h3>
					<hr />
					<h3 class="content">
						@ViewResources.ErrorConnectSocial
					</h3>
				</div>
			</div>
		</div>
	</div>
</div>

@(await Component.InvokeAsync("Menu"))
<section class="main">
	<div class="container profile-container">
		<div class="block block-main">
			@(await Component.InvokeAsync("LeftMenuProfile", new { page = Model.Page }))
		</div>
		<div class="block block-extension">
			<div class="controls">
				<h2 class="block__title">@ViewResources.MyAccount</h2>
				<div class="controls__choose">
					<div class="title">@ViewResources.ProfilePhoto</div>
					<form enctype="multipart/form-data" method="post" id="uploadPhoto">
						<div class="input-upload">
							<input type="file" class="input-file" id="act-upload" name="photo">
							<span class="txt-img"><i class="icon-upload"></i> @ViewResources.ProfileUploadNewPhoto</span>
							<div class="img-upload">
								<img id="review_photo" src="#" alt="review photo" width="150" style="display:none" />
								<p class="error photo-error"></p>
								<button type="submit" name="" class="save-img">Lưu hình ảnh</button>
								<button type="button" class="cancel-upload icon-close" style="display:none"></button>
							</div>
						</div>
					</form>
				</div>

				<div class="controls__account line">
					<div class="title">@ViewResources.ProfileAccount</div>
					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">@ViewResources.Email</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill">
									<ul class="txt-fill">
										<li class="txt-feild">@Model.User.Email</li>
									</ul>
								</div>
							</div>
							<div class="box-edit-form">
								<div class="title">Đổi email</div>
								<input type="password" name="password" value="" class="input-edit" placeholder="Nhập mật khẩu" />
								<input type="email" name="email" value="" class="input-edit" placeholder="Nhập email" />
								<button class="btn-submit-edit">@ViewResources.Save</button>
								<span class="close-edit icon-close"></span>
							</div>
						</div>
					</div>

					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">@ViewResources.ProfilePhone</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill phone-section">
									<ul class="txt-fill">
										@if (Model.User.Phone != null)
										{
											<li class="txt-feild">@Model.User.Phone</li>
										}
										else
										{
											<li>@ViewResources.ProfilePhoneValidate</li>
										}

									</ul>
								</div>
								<a href="#" class="action social-action">@(Model.User.Phone == null ?  ViewResources.Add : ViewResources.Change)</a>
							</div>
							<div class="box-edit-form" id="form_update_phone">
								<div class="title">@ViewResources.ProfilePhoneUpdateTitle</div>
								<input type="number" name="phone" value="" class="input-edit" placeholder="Nhập số điện thoại" />
								<p class="error phone-error">Vui lòng nhập số điện thoại</p>
								<button class="btn-submit-edit btn-save-phone btn-disabled" data-phone="@Model.User.Phone" disabled>@ViewResources.Save</button>
								<span class="close-edit icon-close"></span>
							</div>
							<p class="commitment">@ViewResources.SabasportsCommitmentSecureInfo</p>
						</div>
					</div>

					@if (Model.User.Password != "")
					{
						<div class="group-table">
							<div class="left-table">
								<div class="label-fill">@ViewResources.Password</div>
							</div>
							<div class="right-table">
								<div class="box-control">
									<input type="password" name="password" readonly value="@Model.User.Password" class="input-password" />
									<a href="#" class="action social-action">@ViewResources.ChangePassword</a>
								</div>
								<div class="box-edit-form" id="form_update_password">
									<div class="title">@ViewResources.ChangePassword</div>
									<div class="input-form">
										<input type="password" name="oldpassword" value="" class="input-edit" placeholder="Nhập mật khẩu cũ" />
										<p class="error error-password old-password-length-error">@ViewResources.ValidateLengthOldPassword</p>
										<p class="error error-password old-password-error"></p>
										<a href="#" class="event-pass show-old-pass"><i class="icon-show"></i></a>
										<a href="#" class="event-pass hide-old-pass" style="display: none"><i class="icon-hide"></i></a>
									</div>
									<div class="input-form">
										<input type="password" name="newpassword" value="" class="input-edit" placeholder="Tạo mật khẩu mới" />
										<p class="error error-password new-password-length-error">@ViewResources.ValidateLengthNewPassword</p>
										<a href="#" class="event-pass show-new-pass"><i class="icon-show"></i></a>
										<a href="#" class="event-pass hide-new-pass" style="display: none"><i class="icon-hide"></i></a>
									</div>
									<button class="btn-submit-edit btn-save-password btn-disabled" disabled>@ViewResources.Save</button>
									<p class="forgot-pass"><a href="javascript:;" id="profile-forgot-password">@ViewResources.ForgotPassword</a></p>
									<span class="close-edit icon-close"></span>
								</div>
							</div>
						</div>

					}

				</div>



				<div class="controls__account line">
					<div class="title">@ViewResources.ProfilePersonalInfo</div>
					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">@ViewResources.Name</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill name-section">
									<ul class="txt-fill">
										<li class="txt-feild">@Model.User.Name</li>
									</ul>
								</div>
								<a href="#" class="action social-action">@ViewResources.Change</a>
							</div>
							<div class="box-edit-form" id="form_update_name">
								<div class="title">Họ và tên</div>
								<input type="text" name="name" value="" class="input-edit" placeholder="Nhập họ và tên" />
								<p class="error name-error">@ViewResources.ValidateName</p>
								<button class="btn-submit-edit btn-save-name btn-disabled" disabled data-name="@Model.User.Name">@ViewResources.Save</button>
								<span class="close-edit icon-close"></span>
							</div>
							<p class="commitment">@ViewResources.ProfileShowWhenComment</p>
						</div>
					</div>

					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">@ViewResources.ProfileGender</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill gender-section">
									<ul class="txt-fill">
										@{ var disabled = "disabled"; }
										@if (Model.User.Gender != null)
										{
											disabled = "";
											<li class="txt-feild">@Model.User.Gender</li>
										}
										else
										{
											<li>@ViewResources.ProfileNoSelected</li>
										}

									</ul>
								</div>
								<a href="#" class="action social-action">@(Model.User.Gender == null ?  ViewResources.Add : ViewResources.Change)</a>
							</div>
							<div class="box-edit-form" id="form_update_gender">
								<div class="title">@ViewResources.ProfileGender</div>
								<form>
									<div class="radio-group">
										<div class="item-radio">
											<input type="radio" id="male" name="gender" value="Nam" @(Model.User.Gender == "Nam" ? "checked" : "")>
											<label for="male">@ViewResources.Male</label>
										</div>
										<div class="item-radio">
											<input type="radio" id="female" name="gender" value="Nữ" @(Model.User.Gender == "Nữ" ? "checked" : "")>
											<label for="female">@ViewResources.Female</label>
										</div>
										<div class="item-radio">
											<input type="radio" id="other" name="gender" value="Khác" @(Model.User.Gender == "Khác" ? "checked" : "")>
											<label for="other">@ViewResources.Other</label>
										</div>
									</div>
								</form>
								<button class="btn-submit-edit btn-save-gender btn-@disabled" @disabled data-gender="@Model.User.Gender">@ViewResources.Save</button>
								<p class="error gender-error">@ViewResources.ValidateGender</p>
								<span class="close-edit icon-close"></span>
							</div>
							<p class="commitment">@ViewResources.SabasportsCommitmentSecureInfo</p>
						</div>
					</div>

					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">@ViewResources.Option</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill subscribe-section">
									<input type="hidden" name="current_subscribe" id="current_subscribe" value="@Model.User.IsSubscribe" />
									<input type="checkbox" id="isSubscribe" name="isSubscribe" @(Model.User.IsSubscribe == 1 ? "checked" : "" ) />
									<span>@ViewResources.FollowSabaSports</span>
								</div>
							</div>
						</div>
					</div>


				</div>

				<div class="controls__account line social-network">
					<div class="title">Mạng xã hội</div>
					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">
								<span class="icon-social icon-detail_facebook"></span>
								<span class="txt txt-fb">Facebook</span>
							</div>
						</div>
						@{
							var isConnectFacebook = (Model.User.LoginType != null && Model.User.LoginType.Contains(ViewResources.Facebook)) ? true : false;
							var isConnectGoogle = (Model.User.LoginType != null && Model.User.LoginType.Contains(ViewResources.Google)) ? true : false;
						}
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill">
									<ul class="txt-fill">
										<li class="@(isConnectFacebook ? "" : "validate" )">@(isConnectFacebook ? ViewResources.Connecting : ViewResources.NoConnect )</li>
									</ul>
								</div>
								@if (isConnectFacebook)
								{
									<a href="javascript:;" data-id="@Model.User.Id" data-type="@ViewResources.Facebook" class="social-action disconnect_social_login">@ViewResources.Disconnect</a>
								}
								else
								{
									<a href="ExternalAuthentication/Login?Provider=Facebook&returnUrl=/Profile" class="social-action connect">@ViewResources.Connect</a>
								}
							</div>
						</div>
					</div>
					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">
								<span class="icon-google-color"></span>
								<span class="txt">Google</span>
							</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill">
									<ul class="txt-fill">
										<li class="@(isConnectGoogle ? "" : "validate" )">@(isConnectGoogle ? ViewResources.Connecting : ViewResources.NoConnect )</li>
									</ul>
								</div>
								@if (isConnectGoogle)
								{
									<a href="javascript:;" class="social-action disconnect_social_login" data-id="@Model.User.Id" data-type="@ViewResources.Google">@ViewResources.Disconnect</a>
								}
								else
								{
									<a href="ExternalAuthentication/Login?Provider=Google&returnUrl=/Profile" class="social-action connect">@ViewResources.Connect</a>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<partial name="_LayoutChangeDomain" />
</section>

<script>
	var email = '@Model.User.Email';
	var errorConnectSocial = '@Model.ErrorConnectEmail';
</script>