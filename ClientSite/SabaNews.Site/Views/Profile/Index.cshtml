@section Title{
	@ViewBag.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/profile.min.css" asp-append-version="true">
}

@section Scripts{
	<script src="~/js/profile/update_profile.js" asp-append-version="true"></script>
}

<div class="modal fade" id="resetPasswordSuccesful" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-md" role="document">
		<div class="modal-content">
			<div class="modal-body">

			</div>
		</div>
	</div>
</div>

<section class="main">

	<div class="container profile-container">
		<div class="block block-main">
			<div class="profile">
				@if (Model.Photo == null)
				{
					<div class="profile__avatar">@Model.Name.Substring(0, 1)</div>
				}
				else if(Model.Photo.ToLower().Contains("https://") || Model.Photo.ToLower().Contains("http://"))
				{
					<div class="profile__avatar"><img src="@Model.Photo" width="300" /></div>
				}
				else 
				{
					<div class="profile__avatar"><img src="/upload/@Model.Photo" width="300" /></div>
				}
				<div class="profile__name">@Model.Name</div>
				<div class="profile__date">
					<p>Tham gia từ</p>
					<p><i class="icon-birthday"></i> @Model.RegisterDate.ToString("dd/MM/yyyy")</p>
				</div>
				<ul class="profile__control">
					<li><a href="@Url.Action("ListSavedPosts", "Profile")">@ViewResources.SavedPost @(Model.HandleSavePosts.Count > 0 ? "(" + Model.HandleSavePosts.Count + ")" : "" )</a></li>
				</ul>
				<ul class="profile__nav">
					<li class="active-control"><a href="javascript:;">@ViewResources.MyAccount</a></li>
					<li><a href="javascript:;" class="profile_logout">@ViewResources.Exit</a></li>
				</ul>
			</div>
		</div>
		<div class="block block-extension">
			<div class="controls">
				<h2 class="block__title"><a>@ViewResources.MyAccount </a></h2>
				<div class="controls__choose">
					<div class="title">@ViewResources.ProfilePhoto</div>
                    <form enctype="multipart/form-data" method="post" id="uploadPhoto">
                        <div class="input-upload">
                            <input type="file" class="input-file" id="act-upload" name="photo">
                            <span class="txt-img"><i class="icon-upload"></i> @ViewResources.ProfileUploadNewPhoto</span>
                            <div class="img-upload">
                                <img id="review_photo" src="#" alt="review photo" width="150" style="display:none" />
                                <p class="error photo-error"></p>
                                <button type="submit" name="" class="save-img">Lưu hình ảnh</button>
                            </div>
                        </div>
                    </form>

				</div>

				<div class="controls__account line">
					<div class="title">@ViewResources.ProfileAccount</div>
					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">@ViewResources.Email</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill">
									<ul class="txt-fill">
										<li class="txt-feild">@Model.Email</li>
									</ul>
								</div>
							</div>
							<div class="box-edit-form">
								<div class="title">Đổi email</div>
								<input type="password" name="password" value="" class="input-edit" placeholder="Nhập mật khẩu" />
								<input type="email" name="email" value="" class="input-edit" placeholder="Nhập email" />
								<button class="btn-submit-edit">Lưu lại</button>
								<span class="close-edit">close</span>
							</div>
						</div>
					</div>

					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">@ViewResources.ProfilePhone</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill phone-section">
									<ul class="txt-fill">
										@if (Model.Phone != null)
										{
											<li class="txt-feild">@Model.Phone</li>
										}
										else
										{
											<li class="validate">@ViewResources.ProfilePhoneValidate <i class="icon-validate"></i></li>
										}

									</ul>
								</div>
								<a href="#" class="action">@(Model.Phone == null ?  ViewResources.Add : ViewResources.Change)</a>
							</div>
							<div class="box-edit-form" id="form_update_phone">
								<div class="title">@ViewResources.ProfilePhoneUpdateTitle</div>
								<input type="number" name="phone" value="" class="input-edit" placeholder="Nhập số điện thoại" />
								<p class="error phone-error">Vui lòng nhập số điện thoại</p>
								<button class="btn-submit-edit btn-save-phone btn-disabled" data-phone="@Model.Phone" disabled>@ViewResources.Save</button>
								<span class="close-edit">@ViewResources.Close</span>
							</div>
							<p class="commitment">@ViewResources.SabasportsCommitmentSecureInfo</p>
						</div>
					</div>

					@if (Model.Password != "")
					{
						<div class="group-table">
							<div class="left-table">
								<div class="label-fill">@ViewResources.Password</div>
							</div>
							<div class="right-table">
								<div class="box-control">
									<input type="password" name="password" readonly value="@Model.Password" class="input-password" />
									<a href="#" class="action">@ViewResources.ChangePassword</a>
								</div>
								<div class="box-edit-form" id="form_update_password">
									<div class="title">@ViewResources.ChangePassword</div>
                                    <div class="input-form">
                                        <input type="password" name="oldpassword" value="" class="input-edit" placeholder="Nhập mật khẩu cũ" />
                                        <p class="error error-password old-password-length-error">Mật khẩu cũ tối thiểu 6 kí tự</p>
                                        <p class="error error-password old-password-error"></p>
                                        <a href="#" class="event-pass show-old-pass"><i class="icon-show"></i></a>
                                        <a href="#" class="event-pass hide-old-pass" style="display: none"><i class="icon-hide"></i></a>
                                    </div>
                                    <div class="input-form">
                                        <input type="password" name="newpassword" value="" class="input-edit" placeholder="Tạo mật khẩu mới" />
                                        <p class="error error-password new-password-length-error">Mật khẩu mới tối thiểu 6 kí tự</p>
                                        <a href="#" class="event-pass show-new-pass"><i class="icon-show"></i></a>
                                        <a href="#" class="event-pass hide-new-pass" style="display: none"><i class="icon-hide"></i></a>
                                    </div>
									<button class="btn-submit-edit btn-save-password btn-disabled" disabled>@ViewResources.Save</button>
									<p class="forgot-pass"><a href="javascript:;" id="profile-forgot-password">@ViewResources.ForgotPassword</a></p>
									<span class="close-edit">@ViewResources.Close</span>
								</div>
							</div>
						</div>

					}

				</div>



				<div class="controls__account line">
					<div class="title">@ViewResources.ProfilePersonalInfo</div>
					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">@ViewResources.Name</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill name-section">
									<ul class="txt-fill">
										<li class="txt-feild">@Model.Name</li>
									</ul>
								</div>
								<a href="#" class="action">@ViewResources.Change</a>
							</div>
							<div class="box-edit-form" id="form_update_name">
								<div class="title">Họ và tên</div>
								<input type="text" name="name" value="" class="input-edit" placeholder="Nhập họ và tên" />
								<p class="error name-error">Vui lòng nhập tên</p>
								<button class="btn-submit-edit btn-save-name btn-disabled" disabled data-name="@Model.Name">@ViewResources.Save</button>
								<span class="close-edit">@ViewResources.Close</span>
							</div>
							<p class="commitment">@ViewResources.ProfileShowWhenComment</p>
						</div>
					</div>

					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">@ViewResources.ProfileGender</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill gender-section">
									<ul class="txt-fill">
										@{ var disabled = "disabled"; }
										@if (Model.Gender != null)
										{
											disabled = "";
											<li class="txt-feild">@Model.Gender</li>
										}
										else
										{
											<li class="validate">@ViewResources.ProfileNoSelected <i class="icon-validate"></i></li>
										}

									</ul>
								</div>
								<a href="#" class="action">@(Model.Gender == null ?  ViewResources.Add : ViewResources.Change)</a>
							</div>
							<div class="box-edit-form" id="form_update_gender">
								<div class="title">@ViewResources.ProfileGender</div>
								<form>
									<div class="radio-group">
										<div class="item-radio">
											<input type="radio" id="male" name="gender" value="Nam" @(Model.Gender == "Nam" ? "checked" : "")>
											<label for="male">@ViewResources.Male</label>
										</div>
										<div class="item-radio">
											<input type="radio" id="female" name="gender" value="Nữ" @(Model.Gender == "Nữ" ? "checked" : "")>
											<label for="female">@ViewResources.Female</label>
										</div>
										<div class="item-radio">
											<input type="radio" id="other" name="gender" value="Khác" @(Model.Gender == "Khác" ? "checked" : "")>
											<label for="other">@ViewResources.Other</label>
										</div>
									</div>
								</form>
								<button class="btn-submit-edit btn-save-gender btn-@disabled" @disabled data-gender="@Model.Gender">@ViewResources.Save</button>
								<p class="error gender-error">Vui lòng chọn giới tính</p>
								<span class="close-edit">@ViewResources.Close</span>
							</div>
							<p class="commitment">@ViewResources.SabasportsCommitmentSecureInfo</p>
						</div>
					</div>


				</div>

				<div class="controls__account line">
					<div class="title">Mạng xã hội</div>
					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">Facebook</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill">
									<ul class="txt-fill">
										<li class="validate">Chưa liên kết</li>
									</ul>
								</div>
								<a href="#" class="action">Liên kết</a>
							</div>
						</div>
					</div>
					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">Google</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill">
									<ul class="txt-fill">
										<li class="validate">Chưa liên kết</li>
									</ul>
								</div>
								<a href="#" class="action">Liên kết</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	var email = '@Model.Email';
</script>