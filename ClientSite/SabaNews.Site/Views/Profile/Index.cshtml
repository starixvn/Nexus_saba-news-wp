@section Title{
	@ViewResources.NotFoundPostMsg
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/profile.min.css" asp-append-version="true">
}



<section class="main">

	<div class="container profile-container">
		<div class="block block-main">
			<div class="profile">
				<div class="profile__avatar">J</div>
				<div class="profile__name">Jimmy</div>
				<div class="profile__date">
					<p>Tham gia từ</p>
					<p>01/01/1970</p>
				</div>
				<ul class="profile__control">
					<li><a href="#">@ViewResources.NewsSaved</a></li>
				</ul>
				<ul class="profile__nav">
					<li class="active-control"><a href="#">@ViewResources.MyAccount</a></li>
					<li><a href="#">Thoát</a></li>
				</ul>
			</div>
		</div>
		<div class="block block-extension">
			<div class="controls">
				<h2 class="block__title"><a>@ViewResources.MyAccount </a></h2>
				<div class="controls__choose">
					<div class="title">Ảnh đại diện</div>
					<div class="input-upload">
						<input type="file" class="input-file" id="act-upload">
						<span class="txt-img">Tải lên ảnh đại diện mới</span>
					</div>
				</div>

				<div class="controls__account line">
					<div class="title">Tài Khoản</div>
					<div class="group-table">
						<div class="left-table">
							<div class="label-fill">Email</div>
						</div>
						<div class="right-table">
							<div class="box-control">
								<div class="main-fill">
									<ul class="txt-fill">
										<li class="email">jimmynguyen@gmail.com</li>
										<li class="validate">Chưa xác thực</li>
									</ul>
									<p class="comfirm"><a href="#" class="action">Xác thực ngay</a></p>
								</div>
								<a href="#" class="action">Thay Đổi</a>
							</div>
							<div class="box-edit-form">
								sdkfjoisdhfoidsh
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>