@using SabaNews.Core.Constants;

@{
	ViewBag.Page = ViewBag.Page != null ? ViewBag.Page : "";
}

<div class="profile">
	@if (Model.User.Photo == null)
	{
		<div class="profile__avatar">@Model.User.Name.Substring(0, 1) </div>
	}
	else if (Model.User.Photo.ToLower().Contains("https://") || Model.User.Photo.ToLower().Contains("http://"))
	{
		<div class="profile__avatar"><img class="profile_image" loading="lazy" src="@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></div>
	}
	else
	{
		<div class="profile__avatar"><img class="profile_image" loading="lazy" src="/upload/@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></div>
	}

	<div class="profile__name">@Model.User.Name</div>
	<div class="profile__date">
		<p>Tham gia từ @Model.User.RegisterDate.ToString("dd/MM/yyyy")</p>
	</div>
	<ul class="profile__control">
		<li class="@(ViewBag.Page == Constants.ProfileListPostsPage ? "active-control" : "")">
			<a href="@Url.Action("ListSavedPosts", "Profile")">@ViewResources.SavedPost @(@Model.User.HandleSavePosts.Count > 0 ? "(" + @Model.User.HandleSavePosts.Count + ")" : "" )</a>
		</li>
		<li class="@(ViewBag.Page == Constants.ProfileIndexPage ? "active-control" : "")">
			<a href="@Url.Action("Index", "Profile")">@ViewResources.MyAccount</a>
		</li>

		@if (Model.User.Role == Constants.AdministratorRole)
		{
			<li class="@(ViewBag.Page == Constants.ProfileSendMailPage ? "active-control" : "")"><a href="@Url.Action("SendMail", "Profile")">@ViewResources.Send_Mail</a></li>
		}
		<li><a href="javascript:;" class="profile_logout">@ViewResources.Exit</a></li>
	</ul>
</div>
