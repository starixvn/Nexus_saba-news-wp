@using SabaNews.Core.Constants;
@model SabaNews.Models.ViewModel.Profile.LeftMenuViewModel;
@{
	var page = Model.Page != null ? Model.Page : "";
}

<div class="profile">
	<div class="profile__group">
		@if (Model.User.Photo == null)
		{
			<div class="profile__avatar">@Model.User.Name.Substring(0, 1) </div>
		}
		else if (Model.User.Photo.ToLower().Contains("https://") || Model.User.Photo.ToLower().Contains("http://"))
		{
			<div class="profile__avatar"><img class="profile_image" loading="lazy" src="@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></div>
		}
		else
		{
			<div class="profile__avatar"><img class="profile_image" loading="lazy" src="/uploads/@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></div>
		}

		<div class="name-and-date">
			<div class="profile__name">@Model.User.Name</div>
			<div class="profile__date">
				<p>Tham gia từ @Model.User.RegisterDate.ToString("dd/MM/yyyy")</p>
			</div>
		</div>
	</div>
	<ul class="profile__control">
		<li class="@(page == Constants.ProfileIndexPage ? "active-control" : "")">
			<a href="@Url.Action("Index", "Profile")">
				<i class="icon-profile icon-profile-circle"></i>
				@ViewResources.MyAccount
			</a>
		</li>
		<li class="@(page == Constants.ProfileListPostsPage ? "active-control" : "")">
			<a href="@Url.Action("ListSavedPosts", "Profile")">
				<i class="icon-profile icon-Bookmark2"></i>
				@ViewResources.SavedPost @(@Model.User.HandleSavePosts.Count > 0 ? "(" + @Model.User.HandleSavePosts.Count + ")" : "" )
			</a>
		</li>
		@if (Model.User.Role == Role.Administrator)
		{
			<li class="@(page == "admin" ? "active-control" : "")">
				<a href="~/Admin/Statistic/Index">
					<i class="icon-profile icon-setting-3"></i>
					@ViewResources.Administration
				</a>
			</li>
		}
		<li>
			<a href="~/Auth/Logout?returnUrl=/" class="profile_logout">
				<i class="icon-profile icon-logout1"></i>
				@ViewResources.Logout
			</a>
		</li>
	</ul>
</div>
