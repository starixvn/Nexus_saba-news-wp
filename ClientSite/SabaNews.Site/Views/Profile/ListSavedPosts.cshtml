@section Title{
    @Model.Title
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/profile.min.css" asp-append-version="true">
}

@section Scripts{
    <script src="~/minify/js/update_profile.min.js" asp-append-version="true"></script>
}

@(await Component.InvokeAsync("Menu"))
<section class="main">

	<div class="container profile-container">
		<div class="block block-main">
			@(await Component.InvokeAsync("LeftMenuProfile", new { page = Model.Page }))
		</div>
		<div class="block block-extension">
			<div class="controls">
				<h2 class="block__title"><a>@ViewResources.SavedPost </a></h2>
				@if (Model.Posts.Length == 0)
				{
					<p>@ViewResources.NoSavedPosts</p>
				}
				@if (Model.ToDayPost != null)
				{
					<div class="controls__datetime">
						<h4 class="time-save">@ViewResources.Today</h4>
					</div>
					<hr />
				}
				@{ var isCheck = false; }
				@foreach (var post in Model.Posts)
				{
					if (isCheck)
					{
						isCheck = false;
						<hr />
					}
					if (!isCheck && Model.ToDayPost != null && post.ID == Model.ToDayPost.PostID)
					{
						isCheck = true;
					}
					<div class="controls__news">
						<div class="card-horizontal">
							<a href="@Url.Action("Single", "Post", new { slug =  post.Slug})" class="card-horizontal__image">
								<img asp-append-version="true" loading="lazy" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" />
							</a>
							<div class="card-horizontal__content">
								<a href="@Url.Action("Single", "Post", new { slug =  post.Slug})" class="title">@post.PostTitle </a>
								<p class="description">
									@post.PostExcerpt
								</p>
								<div class="social-control">
									<div class="time">
										@post.PostTime
									</div>
									<div class="group-icon">
										<a class="icon save remove_save_post" href="javascript:;" data-postid="@post.ID">
											<svg width="14" height="18" viewBox="0 0 14 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="svg-bookmark">
												<path d="M1.01 2.00062V2C1.01 1.44575 1.4588 1 2 1H12C12.5477 1 13 1.45228 13 2V16.4835L7.39392 14.0809L7 13.912L6.60608 14.0809L1.00095 16.4831L1.01 2.00062Z" stroke="#999999" stroke-width="2"></path>
											</svg>
										</a>
										@if (post.CommentCount > 0)
										{
											<a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="icon comment">
												<i class="icon-mode_comment_full"></i>
											</a>
											<span class="number">@post.CommentCount</span>
										}
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
	@await Html.PartialAsync(ViewResources.SidebarBannerView)
</section>