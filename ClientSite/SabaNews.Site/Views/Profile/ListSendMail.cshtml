@section Title{
	@ViewBag.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/profile_sendmail.min.css" asp-append-version="true">
}

@section Scripts{
	<script src="~/js/profile/email.js" asp-append-version="true"></script>
}

@(await Component.InvokeAsync("Menu"))
<section class="main">
	<div class="container profile-container">
		<div class="block block-main">
			@(await Component.InvokeAsync("LeftMenuProfile", new { page = ViewBag.Page }))
		</div>
		<div class="block block-email">
			<div class="controls">
				<div class="constrols_list_sendmail line">
					<h2 class="block__title"><a>@ViewResources.ListEmailSent </a></h2>
					<table>
						<tr>
							<th>@ViewResources.STT</th>
							<th>@ViewResources.Title</th>
							<th>@ViewResources.SendDate</th>
							<th>@ViewResources.NumberSent</th>
							<th>@ViewResources.NumberClicked</th>
							<th>@ViewResources.Content</th>
						</tr>
						@{ var stt = 0; }
						@foreach (var email in Model.Emails)
						{
							stt++;
							var rate = (email.TotalClicked > 0 ? Math.Round((double)email.TotalClicked / email.TotalSent * 100, 2) : 0) + "%";
							<tr>
								<td>@stt</td>
								<td>@email.EmailTitle</td>
								<td>@email.SendMailTime</td>
								<td>
									@if (email.TotalSent > 0)
									{
										<a href="@Url.Action("SendMailDetail", "Profile", new { emailId = email.Id })">@email.TotalSent</a>
									}
									else
									{
										@email.TotalSent
									}
								</td>
								<td>@email.TotalClicked / @rate</td>
								<td>
									<input value="@email.EmailContent" type="hidden" class="email_content" />
									<input value="@email.EmailTitle" type="hidden" class="email_title" />
									<a href="javascript:;" class="email view_content">View</a>
								</td>
							</tr>
						}
					</table>
				</div>
				@{ int CurrentPage = Convert.ToInt32(Model.ViewData.CurrentPage);
					int TotalPages = Convert.ToInt32(Model.ViewData.TotalPages);
					var linkLast = Url.Action("ListSendMail", "Profile", new { page = Model.ViewData.TotalPages });
					var linkFirst = Url.Action("ListSendMail", "Profile", new { page = 1 });
					var linkNext = Url.Action("ListSendMail", "Profile", new { page = CurrentPage + 1 });
					var linkPrev = Url.Action("ListSendMail", "Profile", new { page = CurrentPage - 1 });

					linkPrev = CurrentPage > 1 ? linkPrev : "javascript:;";
					linkNext = CurrentPage < TotalPages ? linkNext : "javascript:;"; }
				@if (TotalPages > 1)
				{
					<div class="pagination">
						<a href="@linkFirst" class="icon-pagination icon-page-first"></a>
						<a href="@linkPrev" class="icon-pagination icon-chevron-left"></a>
						<ul class="main-pagination">
							@{ var front = (CurrentPage - 1 > 2) ? 2 : CurrentPage - 1;
								front = (CurrentPage - 1 == 3) ? 3 : front;
								var back = (TotalPages - CurrentPage > 2) ? 2 : TotalPages - CurrentPage;
								back = (TotalPages - CurrentPage == 3) ? 3 : back;

								if (CurrentPage - 4 >= 1)
								{
									<li class="items-pagination"><a href="@linkFirst" class="item">1</a></li>
									<li class="items-pagination"><a class="item">...</a></li>
								}

								for (var i = CurrentPage - front; i <= CurrentPage + back; i++)
								{
									var link = Url.Action("ListSendMail", "Profile", new { page = i });

									var active = i == CurrentPage ? "active" : "";
									<li class="items-pagination @active"><a href="@link" class="item">@i</a></li>
								}

								if (CurrentPage + 4 <= TotalPages)
								{
									<li class="items-pagination"><a class="item">...</a></li>
									<li class="items-pagination"><a href="@linkLast" class="item">@Model.ViewData.TotalPages</a></li>
								} }
						</ul>
						<a href="@linkNext" class="icon-pagination icon-chevron-right"></a>
						<a href="@linkLast" class="icon-pagination icon-page-last"></a>
					</div>}
			</div>
		</div>
	</div>
	
	<div class="modal" id="ViewEmailContent" style="display:none">
		<div class="modal-content">
			<div class="modal-warning">
				<div class="modal-title">
					<h2 class="title"></h2>
					<button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>

				<div class="modal-body ck-content">
				</div>
			</div>
		</div>
	</div>

</section>

