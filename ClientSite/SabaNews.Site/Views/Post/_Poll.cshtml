@{
	string[] ListColors = new string[] { "#25A3B5", "#E1C0BF", "#CB2723", "#CB2723", "#2AD8C4" };
	var colorIndex = -1;
}

<div class="poll-main-div-@Model.Question.Id poll-section @(Model.IsUserVoted ? "hide-poll" : "show-poll")">
	<div class="poll-name">@Model.Question.Name</div>
	<div class="poll-content">
		<div class="poll-question">@Model.Question.Question</div>
		@{
			var i = 0;
		}
		@foreach (var poll in Model.Polls)
		{
			i++;
			<div class="poll-element">
				<span class="radio-or-select-span"><input class="poll-inputs" type="radio" name="poll-radio-@Model.Question.Id" value="@poll.AnswerName"></span>
				<div class="div-only-answer">
					<div class="polllabel"><span class="poll-answer-title">@poll.Answer</span></div>
				</div>
			</div>
		}
		<div class="poll-action" >
			<button data-questid="@Model.Question.Id" class="btn-vote vote-answer">@ViewResources.Vote</button>
			<button data-questid="@Model.Question.Id" class="btn-result view-result">@ViewResources.ViewResult</button>
		</div>

	</div>

</div>


<div class="poll-result-@Model.Question.Id poll-section @(Model.IsUserVoted ? "show-poll" : "hide-poll")">
	<div class="poll-name">@ViewResources.VoteResult</div>
	<div class="poll-content">
		<div class="poll-question">@Model.Question.Question</div>
		<table class="vote-result">
			<tr>
				<td width="40%"></td>
				<td width="60%"></td>
			</tr>
			@foreach (var poll in Model.Polls)
			{
				colorIndex++;
				if (colorIndex > ListColors.Length - 1)
				{
					colorIndex = 0; 
				}
				var percent = Model.TotalVotes > 0 ? Math.Round(poll.Vote * 100.0 / Model.TotalVotes, 2) : 0;
				<tr>
					<td align="right">@poll.Answer</td>
					<td align="left">
						<div style="background:@ListColors[colorIndex]; width:@(percent/2.0 + "%"); height: 13px; float: left; margin:10px 0;"></div>&nbsp;@(percent + "% (" + poll.Vote + " phiếu)"  )
					</td>
				</tr>
			}
			<tr class="total">
				<td align="right">@ViewResources.Sum</td>
				<td align="left">@(Model.TotalVotes + " Phiếu")</td>
			</tr>
			<tr class="total">
				<td align="right">@ViewResources.UpdateTime</td>
				<td align="left">@SabaNews.Core.Helper.DateTimeUtilize.FormatDateTimeByVNLanguage(DateTime.UtcNow)</td>
			</tr>
		</table>
		@if (!Model.IsUserVoted)
		{
			<div class="poll-action">
				<button data-questid="@Model.Question.Id" class="btn-vote vote-section">@ViewResources.Vote</button>
			</div>
		}
	</div>
	
	
</div>
