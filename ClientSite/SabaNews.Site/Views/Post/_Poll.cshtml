@{
	string[] ListColors = new string[] { "#25A3B5", "#E1C0BF", "#CB2723", "#CB2723", "#2AD8C4" };
	var colorIndex = -1;
}

<div class="poll-main-div-@Model.Question.Id poll-section @(Model.IsUserVoted ? "hide-poll" : "show-poll")">
	<div class="poll-name">@Model.Question.Name</div>
	<div class="poll-content">
		<div class="poll-question">@Model.Question.Question</div>
		@{
			var i = 0;
		}
    <div class="choose-poll">
        @foreach (var poll in Model.Polls)
        {
            i++;
			<div class="poll-element">
				<input type=radio id="poll-radio-@poll.AnswerName" class="radio-input" name="poll-radio-@Model.Question.Id" value="@poll.AnswerName">
				<label for="poll-radio-@poll.AnswerName" class="radio-label"> <span class="radio-border"></span> @poll.Answer </label>
			</div>
        }
    </div>
		<div class="poll-action" >
			<button data-questid="@Model.Question.Id" class="btn-vote vote-answer">@ViewResources.Vote</button>
			<button data-questid="@Model.Question.Id" class="btn-result view-result">@ViewResources.ViewResult</button>
		</div>

	</div>

</div>


<div class="poll-result-@Model.Question.Id poll-section @(Model.IsUserVoted ? "show-poll" : "hide-poll")">
	<div class="poll-name">@ViewResources.VoteResult</div>
    <div class="poll-content">
        <div class="poll-question">@Model.Question.Question</div>
        @foreach (var poll in Model.Polls)
        {
            colorIndex++;
            if (colorIndex > ListColors.Length - 1)
            {
                colorIndex = 0;
            }
            var percent = Model.TotalVotes > 0 ? Math.Round(poll.Vote * 100.0 / Model.TotalVotes, 2) : 0;
            <div class="list-result">
                <div class="result-element">
                    <div class="top-result">
                        <span class="country-list">@poll.Answer</span>
                        <span class="percent">@(percent + "% (" + poll.Vote + " phiếu)"  )</span>
                    </div>
                    <div class="bar">
                        <div class="bar-inner" style="width:@(percent/2.0 + "%")"></div>
                    </div>
                </div>
            </div>
        }
        <div class="total-result">
            <div class="total-count">
                <p>@ViewResources.Sum :</p>
                <p>@(Model.TotalVotes + " Phiếu")</p>
            </div>
            <div class="total-date">
                <p>@ViewResources.UpdateTime : </p>
                <p>@SabaNews.Core.Helper.DateTimeUtilize.FormatDateTimeByVNLanguage(DateTime.UtcNow)</p>
            </div>
        </div>


        @*<table class="vote-result">
            <tr>
                <td width="40%"></td>
                <td width="60%"></td>
            </tr>
