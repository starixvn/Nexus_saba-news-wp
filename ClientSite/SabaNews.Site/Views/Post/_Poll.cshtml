<div class="poll_main_div_@Model.Question.Id poll_section @(Model.IsUserVoted ? "hide_poll" : "show_poll")">
	<div class="poll_name">@Model.Question.Name</div>
	<div class="poll_content">
		<div class="poll_question">@Model.Question.Question</div>
		@{
			var i = 0;
		}
		@foreach (var poll in Model.Polls)
		{
			i++;
			<div class="poll_element">
				<span class="radio_or_select_span"><input class="poll_inputs" type="radio" name="poll_radio_@Model.Question.Id" value="@poll.AnswerName"></span>
				<div class="div_only_answer">
					<div class="polllabel"><span class="poll_answer_title">@poll.Answer</span></div>
				</div>
			</div>
		}
		<div class="poll_action" >
			<button data-questid="@Model.Question.Id" class="btn_vote vote_answer">Bình chọn</button>
			<button data-questid="@Model.Question.Id" class="btn_result view_result">Xem kết quả</button>
		</div>

	</div>

</div>


<div class="poll_result_@Model.Question.Id poll_section @(Model.IsUserVoted ? "show_poll" : "hide_poll")">
	<div class="poll_name">Kết quả bình chọn</div>
	<div class="poll_content">
		<div class="poll_question">@Model.Question.Question</div>
		<table class="vote_result">
			<tr>
				<td width="40%"></td>
				<td width="60%"></td>
			</tr>
			@foreach (var poll in Model.Polls)
			{
				var percent = Model.TotalVotes > 0 ? Math.Round(poll.Vote * 100.0 / Model.TotalVotes, 2) : 0;
				<tr>
					<td align="right">@poll.Answer</td>
					<td align="left"> @(percent + "% (" + poll.Vote + " phiếu)"  )</td>
				</tr>
			}
			<tr class="total">
				<td align="right">Tổng cộng</td>
				<td align="left">@(Model.TotalVotes + " Phiếu")</td>
			</tr>
			<tr class="total">
				<td align="right">Thời gian cập nhật</td>
				<td align="left">@SabaNews.Core.Helper.DateTimeUtilize.ChangeTimeZoneToClient(DateTime.UtcNow)</td>
			</tr>
		</table>
		@if (!Model.IsUserVoted)
		{
			<div class="poll_action">
				<button data-questid="@Model.Question.Id" class="btn_vote vote_section">Bình Chọn</button>
			</div>
		}
	</div>
	
	
</div>
