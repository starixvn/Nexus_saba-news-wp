@using SabaNews.Core.Constants;
@{
    var schemaBreadcrum = "";
    var position = 2;
    schemaBreadcrum += "{";
    schemaBreadcrum +="\"@type\":\"ListItem\",";
    schemaBreadcrum +="\"position\":\"1\",";
    schemaBreadcrum +=$"\"item\": {{\"@id\": \"{Model.DomainUrl}\", \"name\": \"Sabavn\" }}";
    schemaBreadcrum += "},";
    foreach(var cate in Model.CateParents)
    {
        if(cate.Slug != Constants.NewPostSlug)
        {
            schemaBreadcrum += "{";
            schemaBreadcrum +="\"@type\":\"ListItem\",";
            schemaBreadcrum +=$"\"position\":\"{position}\",";
            schemaBreadcrum +=$"\"item\": {{\"@id\": \"{Model.DomainUrl + cate.Slug + CategoryKey.Suffix}\", \"name\": \"{cate.Name}\" }}";
            schemaBreadcrum += "},";
            position++;
        }
    }
    schemaBreadcrum = schemaBreadcrum.TrimEnd(',');
}
@section Schema {
    @if(Model.IsVideo)
    {
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "VideoObject",
            "name": "@Model.SinglePost.SeoTitle",
            "description": "@Model.SinglePost.SeoDescription",
            "thumbnailUrl": [
                "@Model.SinglePost.FeatureImage"
            ],
            "uploadDate": "@Html.Raw(Model.SinglePost.PostDate.ToString("yyyy-MM-ddTHH:mm:sszzz"))",
    using OfficeOpenXml.FormulaParsing.Excel.Functions.Math;
            "interactionStatistic": {
                "@@type": "InteractionCounter",
                "interactionType": "https://schema.org/WatchAction",
                "userInteractionCount": @Model.SinglePost.VideoViews
            },
            "embedUrl": "@SabaNews.Site.Extensions.PostHelper.GetVideoLink(@Model.SinglePost.PostContent)",
            "publisher": {
                "@@type": "Organization",
                "name": "SABA Sports",
                "logo": {
                "@@type": "ImageObject",
                "url": "https://www.sabavn.net/images/sabasports.svg",
                "width": 600,
                "height": 60
                }
            }@if(!string.IsNullOrEmpty(Model.SinglePost.CustomSchema))
            {
                @Html.Raw($",{Model.SinglePost.CustomSchema}")
            }
        }
        </script>
    }
    else if(Model.SinglePost.SchemaType == "NewsArticle")
    {
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "NewsArticle",
             "mainEntityOfPage": {
                "@@type": "WebPage",
                "@@id": "@Model.AbsoluteUrl"
            },
            "headline": "@Model.SinglePost.SeoTitle",
            "description": "@Model.SinglePost.SeoDescription",
            "image": "@Model.SinglePost.FeatureImage",
            "datePublished": "@Html.Raw(Model.SinglePost.PostDate.ToString("yyyy-MM-ddTHH:mm:sszzz"))",
            "dateModified": "@Html.Raw(Model.SinglePost.PostDateModified.ToString("yyyy-MM-ddTHH:mm:sszzz"))",
            "author": {
                "@@type": "Person",
                "name": "@Model.SinglePost.Author"
            },
            "publisher": {
                "@@type": "Organization",
                "name": "SABA Sports",
                "logo": {
                "@@type": "ImageObject",
                "url": "https://www.sabavn.net/images/sabasports.svg"
                }
            }@if(!string.IsNullOrEmpty(Model.SinglePost.CustomSchema))
            {
                @Html.Raw($",{Model.SinglePost.CustomSchema}")
            }
        }
        </script>
    }
    else
    {
        <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "Article",
            "headline": "@Model.SinglePost.SeoTitle",
            "description": "@Model.SinglePost.SeoDescription",
            "author": {
                "@@type": "Person",
                "name": "@Model.SinglePost.Author"
            },
            "datePublished": "@Html.Raw(Model.SinglePost.PostDate.ToString("yyyy-MM-ddTHH:mm:sszzz"))",
            "dateModified": "@Html.Raw(Model.SinglePost.PostDateModified.ToString("yyyy-MM-ddTHH:mm:sszzz"))",
            "image": "@Model.SinglePost.FeatureImage",
            "publisher": {
                "@@type": "Organization",
                "name": "SABA Sports",
                "logo": {
                "@@type": "ImageObject",
                "url": "https://www.sabavn.net/images/sabasports.svg"
                }
            }@if(!string.IsNullOrEmpty(Model.SinglePost.CustomSchema))
            {
                @Html.Raw($",{Model.SinglePost.CustomSchema}")
            }
        }
        </script>
    }

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement":
        [
            @Html.Raw(schemaBreadcrum)
        ]

    }
    </script>
}

@{
    string currentSlug = Model.CateInfo.Slug as string ?? string.Empty;
}

@section Metadata {
    <meta name="description"
        content='@(Model.SinglePost.SeoDescription != "" ? Model.SinglePost.SeoDescription : @Model.SinglePost.SeoTitle )' />
    <meta property="og:url" content='@Model.AbsoluteUrl' />
    <meta property="og:description" content="@Model.SinglePost.SeoDescription" />
    <meta property="og:title" content='@Model.SinglePost.SeoTitle' />
    <meta property="og:image" content='@Model.SinglePost.FeatureImage' />
    <link rel="canonical" href="@Model.AbsoluteUrl" />
    <link rel="alternate" href="@Model.AbsoluteUrl" hreflang="vi-vn" />

    @if (Model.IsIndex)
    {
        <meta name="robots" content="index, follow,noarchive,max-image-preview:large" />
    }
    else {
        <meta name="robots" content="noindex, follow,noarchive,max-image-preview:large" />
    }
}

@section Title{
    @Model.SinglePost.SeoTitle
}


