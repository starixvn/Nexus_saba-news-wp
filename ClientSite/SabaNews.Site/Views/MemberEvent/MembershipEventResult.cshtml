
@section Title{
    Kết quả sự kiện Rước Lộc Tân Niên
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/membership-event.min.css" asp-append-version="true">

}
@section Scripts{
    <script src="~/minify/js/membership-event.min.js" asp-append-version="true"></script>
}


<body class="result-page">
    <div class="wrapper-menu-event"></div>
    <div class="wrapper-header wrapper-result">
        <div class="flower-result">
            <div class="flower-result-img"><img src="~/images/event/chill.png"></div>
            <div class="flower-result-img"><img src="~/images/event/chill.png"></div>
        </div>
        <div class="banner-result">
            <img src="~/images/event/result-banner.png" alt="result-banner" class="img-res" />
        </div>
        <div class="img-event-position img-event-position-1"><img src="~/images/event/img3.png" alt="Alternate Text" /></div>
        <div class="header-menu">
            <div class="logo-event">
                <a href="@Url.Action("Index", "Home")">
                    <img src="~/images/event/logo.png" alt="saba-sports" asp-append-version="true">
                </a>
            </div>
            @if (Model.IsLogin)
            {
                <div class="after-login">
                    <ul class="users auth-section">
                        @if (Model.User.Photo == null)
                        {
                            <li class="avatar">@Model.User.Name.Substring(0, 1)</li>
                        }
                        else if (Model.User.Photo.ToLower().Contains("https://") || Model.User.Photo.ToLower().Contains("http://"))
                        {
                            <li class="avatar"><img class="profile_image" loading="lazy" src="@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></li>
                        }
                        else
                        {
                            <li class="avatar"><img class="profile_image" loading="lazy" src="/uploads/@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></li>
                        }
                        @*<li class="avatar"><img src="~/images/sabasports.svg" alt="saba-sports" asp-append-version="true"></li>*@
                        <li class="name">@Model.User.Name</li>
                    </ul>
                    <div class="profile-login">
                        <ul class="users-login-review">
                            @if (Model.User.Photo == null)
                            {
                                <li class="users-login-avatar">@Model.User.Name.Substring(0, 1)</li>
                            }
                            else if (Model.User.Photo.ToLower().Contains("https://") || Model.User.Photo.ToLower().Contains("http://"))
                            {
                                <li class="users-login-avatar"><img loading="lazy" src="@Model.User.Photo" data-name="@Model.User.Name.Substring(0, 1)" asp-append-version="true" /></li>
                            }
                            else
                            {
                                <li class="users-login-avatar"><img class="profile_image" loading="lazy" src="/uploads/@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" asp-append-version="true" /></li>
                            }
                            <li class="users-name"><a href="#">@Model.User.Name</a></li>
                        </ul>
                        <ul class="list-profile">
                            @if (Model.IsAdmin)
                            {
                                <li>
                                    <a class="item" href="~/Admin/Statistic/Index">@ViewResources.Administration</a>
                                </li>
                            }
                            <li><a href="@Url.Action("ListSavedPosts", "Profile")">Tin đã lưu</a></li>
                            <li><a href="@Url.Action("Index", "Profile")">Tài Khoản của tôi</a></li>
                            <li class="auth-logout"><a href="~/Auth/Logout?returnUrl=@Context.Request.Path">Đăng xuất <i class="icon-logout"></i></a></li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="login auth-input">
                    <a href="javascript:;" class="btn btn-event auth-login">Đăng Nhập</a>
                </div>
            }
        </div>
        <ul class="header-nav-event">
            <li>
                <a href="@Url.Action("MembershipEvent", "MemberEvent")" class="active">
                    <i class="icon icon-event-home btn-home"></i>
                    <span>Sự Kiện</span>
                </a>
            </li>
        </ul>
        <div class="toggle-mobile-event">
            <i class="icon icon-menu-event"></i>
        </div>
    </div>
    <div class="main">
        <div class="main-result">
            <div class="thank-users">
                <a href="#">Saba.vn</a> xin chân thành cảm ơn Quý độc giả đã tham gia chương trình minigame "Rước Lộc Tân Niên". Căn cứ vào 3 số đuôi của Giải Đặc Biệt từ kết quả xổ số miền Bắc ngày 28/02/2022 là <a target="_blank" href="https://xoso.com.vn/xsmb-28-02-2022.html">075</a>, chúng tôi đã tìm ra được những độc giả may mắn trúng thưởng như sau:
            </div>
            <div class="last-result-event">
                <div class="item-result">
                    <img src="~/images/event/item1.png" alt="item-1" class="img-res" />
                    <div class="user-final">
                        <p class="email">owb***ice@gmail.com</p>
                        <p class="name">Số may mắn: 052</p>
                        <p class="date">14/02/2022 13:55:16</p>
                    </div>
                </div>
                <div class="item-result">
                    <img src="~/images/event/item2.png" alt="item-2" class="img-res" />
                    <div class="user-final">
                        <p class="email">lon***009@gmail.com</p>
                        <p class="name">Số may mắn: 101</p>
                        <p class="date">21/02/2022 04:37:14</p>
                    </div>
                    <div class="user-final">
                        <p class="email">cuo***106@gmail.com</p>
