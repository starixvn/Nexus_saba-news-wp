            </div>
            <div class="img-event-position img-event-position-2"><img src="~/images/event/img6.png" alt="Alternate Text" /></div>
            <div class="img-event-position img-event-position-3"><img src="~/images/event/lixi.png" alt="Alternate Text" /></div>
            <div class="img-event-position img-event-position-4"><img src="~/images/event/img2.png" alt="Alternate Text" /></div>
        </div>
    </div>
</body>



<div class="auth-form">
    <div class="modal" id="register" style="display:none">
        <div class="modal-content modal-auth">
            <div class="modal-warning">
                <button type="button" class="close-event" data-dismiss="modal" aria-label="Close">
                    <i class="icon icon-close-event"></i>
                </button>
                <div class="modal-body register">
                    <div class="heading-modal-event">nhập số may mắn</div>
                    <p class="text-event-modal">Bạn có muốn nhập con số may mắn này không ?</p>
                    <ul>
                        <li><a href="#nhap-so-may-man" class="btn btn-event btn-accept active">đồng ý</a></li>
                        <li><a href="#" class="btn btn-event btn-outline-event">bỏ qua</a></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>

