                    </div>
                </div>
                <div class="item-result">
                    <img src="~/images/event/item3.png" alt="item-3" class="img-res" />
                    <div class="user-final">
                        <p class="email">chu***p86@gmail.com</p>
                        <p class="name">Số may mắn: 123</p>
                        <p class="date">15/02/2022 07:38:45</p>
                    </div>
                    <div class="user-final">
                        <p class="email">tap***lot@gmail.com</p>
                        <p class="name">Số may mắn: 123</p>
                        <p class="date">23/02/2022 02:13:04</p>
                    </div>
