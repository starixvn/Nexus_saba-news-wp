@using SabaNews.Resources
@{
    var count = 0;
    var total = ViewBag.Total != null ? ViewBag.Total : 0;
}


<div class="king-soccer">
    <div class="title-section">
        <div class="dots"><span></span><span></span><span class="dots-items"></span></div>

        <h2><a href="#">Bảng Xếp Hạng</a></h2>
        <div class="dots"><span class="dots-items"></span><span></span><span></span></div>
    </div>
    <div class="wc-table wc-table-king-soccer">
        <div class="wc-table-header">
            <div class="wc-table-cell cell-participant">
                <i class="icon-chevron-left" id="btn-back-standing"></i>
                @ViewResources.Board @Model.GroupName.Substring(0, 1)
                <i class="icon-chevron-right" data-total="@total" id="btn-next-standing"></i>
            </div>
            <div class="wc-table-cell cell-rank">@ViewResources.Battle</div>
            <div class="wc-table-cell cell-rank">@ViewResources.FairPlay</div>
            <div class="wc-table-cell cell-rank">@ViewResources.Point</div>
        </div>

        <div class="wc-table-body">
            @foreach (var item in Model.Standings)
            {
                count++;
                <div class="wc-table-row">
                    <div class="wc-table-cell cell-participant">
                        <ul class="team">
                            <li class="number">@count</li>
                            <li class="team-logo"><img src="@item.Icon" /></li>
                            <li class="team-name">@item.TeamFullNameEN</li>
                        </ul>
                    </div>
                    <div class="wc-table-cell cell-rank">@item.Total</div>
                    <div class="wc-table-cell cell-rank">@item.GoalDiff</div>
                    <div class="wc-table-cell cell-rank">@item.Points</div>
                </div>
            }
        </div>
    </div>
</div>
