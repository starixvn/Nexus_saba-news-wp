@foreach (var post in Model)
{
    <div class="post-items post-hot">
        <div class="hover-image">
            <a href=@Url.Action("StoryPostDetail", "WorldCup2022", new { slug = post.Slug })>
                <img src=@post.FeatureImage alt=@post.PostTitle class="img-res" />
            </a>
            <div class="title-hot">
                <p>@post.PostTitle</p>
                <p class="date-time">@post.PostTime</p>
            </div>
        </div>
    </div>
}