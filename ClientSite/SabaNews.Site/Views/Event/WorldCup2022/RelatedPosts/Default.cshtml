@using SabaNews.Core.Constants;
@using DeviceDetectorNET;

@{
    var detector = new DeviceDetector(Context.Request.Headers["User-Agent"].ToString());
    detector.Parse();
    bool isMobile = detector.IsMobile();
   
}

<div class="block__content page-items-box">

    <div class="title-section">
        <h2>@ViewResources.RelatedPosts</h2>
        <div class="dots"><span class="dots-items"></span><span></span><span></span></div>
    </div>
    @foreach (var post in Model)
    {
        string featureImg = isMobile ? post.GetImageBySize(ImageWidth.Width768) : post.FeatureImage;
        <div class="post card-horizontal card-horizontal-highlight">
            <a href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = post.Slug })" class="card-horizontal__image">
                <picture>
                    <source srcset="@Url.Content(featureImg)" type="image/webp" class="img-res">
                    <source srcset="@Url.Content(featureImg)" type="image/jpeg" class="img-res">
                    <img loading="lazy" src="@Url.Content(featureImg)" alt="@post.PostTitle" class="img-res img-block">
                </picture>
            </a>
            <div class="card-horizontal__content">
                <a class="title" href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = post.Slug })">@post.PostTitle</a>
                <p class="datetime">
                    <span>@post.PostTime</span>
                </p>
                <p class="description">@post.PostExcerpt</p>
            </div>
        </div>
    }
</div>