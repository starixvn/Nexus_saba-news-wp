@using static SabaNews.Site.Extensions.LivescoreHelper
@using DeviceDetectorNET;
@{
    var detector = new DeviceDetector(Context.Request.Headers["User-Agent"].ToString());
    detector.Parse();
    bool isMobile = detector.IsMobile();
    bool isDesktop = detector.IsDesktop();
}
<div class="king-soccer">
    <div class="title-section">
        <div class="dots"><span></span><span></span><span class="dots-items"></span></div>

        <h2><a>Vua Phá Lưới</a></h2>
        <div class="dots"><span class="dots-items"></span><span></span><span></span></div>
    </div>
    <div class="wc-table wc-table-king-soccer" id="Hidden1">
        <div class="wc-table-header">
            <div class="wc-table-cell cell-participant">TOP 10</div>
            <div class="wc-table-cell cell-rank">Bàn thắng</div>
            <div class="wc-table-cell cell-rank">Kiến tạo</div>
        </div>

        <div class="wc-table-body">
            @foreach (var item in Model)
            {
                var oriLogo = GetTeamIcon(item.TeamLogo);
                var playerName = GetTopScorersPlayerName(item);
                <div class="wc-table-row">
                    <div class="wc-table-cell cell-participant">
                        <ul class="team">
                            <li class="number">@item.Top </li>
                            <li class="team-logo"><img src="@(item.TeamLogoVN ?? oriLogo)" /></li>
                            <li class="team-name" tabindex="0" data-toggle="tooltip" title="@(playerName.Length > (isMobile? 15 : 22) ? playerName : "")">@playerName</li>
                        </ul>
                    </div>

                    <div class="wc-table-cell cell-rank">@item.Goals</div>
                    <div class="wc-table-cell cell-rank">@item.Assists</div>
                </div>
            }
        </div>
    </div>
</div>
