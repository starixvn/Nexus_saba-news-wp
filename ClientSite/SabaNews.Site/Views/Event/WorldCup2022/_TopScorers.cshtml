<div class="king-soccer">
    <h1 class="wc-heading-box"> Vua Phá Lưới </h1>
    <div class="wc-table wc-table-king-soccer">
        <div class="wc-table-header">
            <div class="wc-table-cell cell-participant">TOP 10</div>
            <div class="wc-table-cell cell-rank">Bàn thắng</div>
            <div class="wc-table-cell cell-rank">Kiến tạo</div>
        </div>

        <div class="wc-table-body">
            @foreach (var item in Model)
            {
                <div class="wc-table-row">
                    <div class="wc-table-cell cell-participant">
                        <ul class="team">
                            <li class="number">@item.Top </li>
                            <li class="team-logo"><img src="@item.TeamLogo"/></li>
                            <li class="team-name">@item.PlayerFullNameEN</li>
                        </ul>
                    </div>
                    <div class="wc-table-cell cell-rank">@item.Goals</div>
                    <div class="wc-table-cell cell-rank">@item.Assists</div>
                </div>              
            }
        </div>
    </div>
</div>