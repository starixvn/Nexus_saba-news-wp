@using SabaNews.Core.Constants
@using DeviceDetectorNET;
@section Title {
    @Model.Header.Title
}

@section Metadata {
    <meta name="description" content='@Model.Header.Description' />
    <meta property="og:description" content='@Model.Header.Description' />
    <meta property="og:title" content='@Model.Header.Title' />
}

@{
    var detector = new DeviceDetector(Context.Request.Headers["User-Agent"].ToString());
    detector.Parse();
    bool isMobile = detector.IsMobile();
    bool isDesktop = detector.IsDesktop();
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/home.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/styles/lastestnews.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/styles/worldcup2022.min.css" asp-append-version="true">
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/livescore/soccer/world-cup/fixture.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/livescore/soccer/world-cup/fixture.chunk.css" asp-append-version="true" />
    </environment>
}

@section Scripts{
    <environment include="Development">
        <script src="~/js/livescore/livescore.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/world-cup/fixture.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/livescore/livescore.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/pages/livescore/soccer/world-cup/fixture.chunk.js" asp-append-version="true"></script>
    </environment>
    <script>
        window.slug = '@Model.CategorySlug';
        window.paging = {
            page: '@Model.Paging.CurrentPage',
            pageSize: '@Model.Paging.PageSize',
            totalPages: '@Model.Paging.TotalPages'
        };
        window.isVideo = false;
        window.type = '@Model.Header.Controller';
    </script>
    <script src="~/minify/js/lastestnews.min.js" asp-append-version="true"></script>
}

@(await Component.InvokeAsync("HeaderWorldCup", new { cateSlug = Model.Header.Slug }))
<section class="worldcup-lastest-news">
    <div class="banner-euro-mobile banner-mobile-top"></div>
    <div id="worldcup-fixture"></div>
    <div class="wc-page-main">
        <div class="container">
            <div class="title-section">
                <div class="dots"><span></span><span></span><span class="dots-items"></span></div>
                <h2>@(Model.Header.Title == WorldCup2022.TitleLastestNews ? WorldCup2022.LastestNews : WorldCup2022.Commentary)</h2>
                <div class="dots"><span class="dots-items"></span><span></span><span></span></div>
            </div>
        </div>

        @if (Model.Posts.Count > 0)
        {
            <div class="container">
                <div class="pages-main-hot">
                    <div class="page-items-hot">
                        <div class="post-items post-hot">
                            <div class="hover-image">
                                <a href=@Url.Action("PostDetailWC", "WorldCup2022", new { slug = Model.Posts[0].Slug })>
                                    <img src="@Url.Content(Model.Posts[0].FeatureImage)" alt="@Model.Posts[0].PostTitle" asp-append-version="true" loading="lazy" class="img-res lazy" />
                                </a>
                                <div class="title-hot">
                                    <h3><a href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = Model.Posts[0].Slug })">@Model.Posts[0].PostTitle</a></h3>
                                   
                                    @if (!isMobile)
                                    {
                                        <p>@Html.Raw(Model.Posts[0].PostExcerpt)</p>
                                        <p class="datetime">@Model.Posts[0].PostTime</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="page-hot-right">
                        @{
                            int postIndexhot = 0;

                            foreach (var post in Model.Posts)
                            {
                                {
                                    postIndexhot++;
                                    if (postIndexhot <= 1)
                                    {
                                        continue;
                                    }
                                    if (postIndexhot == 4 && isMobile)
                                    {
                                        <div class="banner-mobile banner-mobile-center"></div>
                                        <div id="standingWC" data-isMobile="@isMobile"></div>
                                        <div id="topScorersWC" data-more="true"></div>
                                    }
                                    if (postIndexhot <= 4)
                                    {
                                        <div class="post card-horizontal">
                                            <a class="title ishow-pc" href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = post.Slug })">@post.PostTitle</a>
                                            <a href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = post.Slug })" class="card-horizontal__image thumb thumb-52">
                                                <picture>
                                                    <source srcset="@Url.Content(post.FeatureImage)" type="image/webp" class="img-res">
                                                    <source srcset="@Url.Content(post.FeatureImage)" type="image/jpeg" class="img-res">
                                                    <img asp-append-version="true" loading="lazy" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" class="img-res img-block lazy">
                                                </picture>
                                            </a>
                                            <div class="card-horizontal__content">
                                                <a class="title ishow-mobile" href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = post.Slug })">@post.PostTitle</a>
                                                <p class="description">@Html.Raw(post.PostExcerpt)</p>
                                                <p class="datetime">
                                                    <span>@post.PostTime</span>
                                                </p>
                                            </div>
                                        </div>
                                        continue;
                                    }
                                    break;
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        }

        <div class="page-main page-grid">
            <div class="page-main-items">
                <div id="news-grid" class="news-grid">
                    @{
                        int postIndex = 0;
                        foreach (var post in Model.Posts)
                        {
                            {
                                postIndex++;
                                if (postIndex <= 4)
                                {
                                    continue;
                                }
                            }

                            <div class="post card-horizontal">
                                <a href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = post.Slug })" class="card-horizontal__image thumb thumb-52">
                                    <picture>
                                        <source srcset="@Url.Content(post.FeatureImage)" type="image/webp" class="img-res">
                                        <source srcset="@Url.Content(post.FeatureImage)" type="image/jpeg" class="img-res">
                                        <img asp-append-version="true" loading="lazy" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" class="img-res img-block lazy">
                                    </picture>
                                </a>
                                <div class="card-horizontal__content">
                                    <a class="title" href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = post.Slug })">@post.PostTitle</a>
                                    <p class="description">@Html.Raw(post.PostExcerpt)</p>
                                    <p class="datetime">
                                        <span>@post.PostTime</span>
                                    </p>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (Model.Paging.TotalPages > 1)
                {
                    <div class="loading-page">
                        <div class="lds-ellipsis">
                            <div></div><div></div><div></div><div></div>
                        </div>
                    </div>
                }
            </div>
            <div class="page-items-right">
                @if (isDesktop)
                {
                    <div class="sticky-position">
                        <div id="standingWC" data-ismobile="@isMobile" class="page-items-box"></div>
                        <div id="topScorersWC" data-more="true" class="page-items-box"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
@await Html.PartialAsync(ViewResources.SidebarBannerView)