        <div class="wc-block-hotnews">
            <div class="container">
                <div class="title-section">
                    <div class="dots"><span></span><span></span><span class="dots-items"></span></div>
                    <h2><a href="@Url.Action("LastestNews", "WorldCup2022")">Tin Mới Nhất</a></h2>
                    <div class="dots"><span class="dots-items"></span><span></span><span></span></div>
                </div>
                <div class="gird-hot-news">
                    @if (Model.LastestNews.Count > 0)
                    {
                        var firstPost = Model.LastestNews[0];
                        <div class="post-items post-items-1 post-hot">
                            <div class="hover-image">
                                <a href="@Url.Action("Single", "Post", new { slug = firstPost.Slug })">
                                    <img src=@firstPost.FeatureImage alt=@firstPost.PostTitle class="img-res" asp-append-version="true" loading="lazy" />
                                </a>
                                <div class="title-hot">
                                    <h1><a href="@Url.Action("Single", "Post", new { slug = firstPost.Slug })">@firstPost.PostTitle</a></h1>
                                    <p><a href="@Url.Action("Single", "Post", new { slug = firstPost.Slug })">@firstPost.PostExcerpt</a></p>
                                </div>
                            </div>
                        </div>
                    }

                    @{
                        int lastestPostIndex = 0;
                        foreach (var post in Model.LastestNews)
                        {
                            {
                                lastestPostIndex++;
                                if (lastestPostIndex <= 1)
                                {
                                    continue;
                                }
                            }
                            <div class="post-items post-items-@lastestPostIndex">
                                <div class="hover-image">
                                    <a href="@Url.Action("Single", "Post", new { slug = post.Slug })"><img src=@post.FeatureImage alt=@post.PostTitle class="img-res" /></a>
                                </div>
                                <div class="title">
                                    <h2><a href="@Url.Action("Single", "Post", new { slug = post.Slug })">@post.PostTitle</a></h2>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="view-more">
                    <a href="@Url.Action("LastestNews", "WorldCup2022")">Xem thêm <i class="icon-next-wc"></i></a>
                </div>
            </div>
        </div>

