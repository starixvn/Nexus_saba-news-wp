@using SabaNews.Core.Constants;
@using DeviceDetectorNET;

@{
    var detector = new DeviceDetector(Context.Request.Headers["User-Agent"].ToString());
    detector.Parse();
    bool isMobile = detector.IsMobile();

}

<div class="title-section">
    <div class="dots"><span></span><span></span><span class="dots-items"></span></div>
    <h2><a href="@Url.Action("LastestNews", "WorldCup2022")">@ViewData[ViewResources.ViewDataHeadTitle]</a></h2>
    <div class="dots"><span class="dots-items"></span><span></span><span></span></div>
</div>
<div class="block__content">
    <div class="block-item">
        @foreach (var post in Model.Posts)
        {
            <div class="post card-vertical">
                @if (Model.Posts.IndexOf(post) == 0)
                {
                    string featureImg = isMobile ? post.GetImageBySize(ImageWidth.Width768) : post.FeatureImage;
                    <a href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = post.Slug })" class="card-vertical__image thumb thumb-65">
                        <picture>
                            <source srcset="@Url.Content(featureImg)" type="image/webp" class="img-res">
                            <source srcset="@Url.Content(featureImg)" type="image/jpeg" class="img-res">
                            <img asp-append-version="true" loading="lazy" src="@Url.Content(featureImg)" alt="@post.PostTitle" class="img-res img-block lazy">
                        </picture>
                    </a>}
                <a class="card-vertical__title" href="@Url.Action("PostDetailWC", "WorldCup2022", new { slug = post.Slug })">@post.PostTitle</a>
                <p class="card-vertical__datetime">
                    <span>@post.PostTime</span>
                </p>
            </div>
        }
    </div>

</div>
