@using SabaNews.Core.Constants;
<meta name="description" content='@Model.Header.Description' />
<meta name="robots" content="noarchive">
<meta property="og:description" content='@Model.Category.OgDescription' />
<meta property="og:title" content='@Model.Category.OgTitle' />
<meta property="og:image" content='@Model.Category.OgImage' />

@section Title{
    @Model.Header.Title
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/euro2020_video.min.css" asp-append-version="true">
}

@section Scripts{
	<script src="~/minify/js/swiper.min.js" asp-append-version="true"></script>
}

<div class="page">
    @(await Component.InvokeAsync("HeaderEvent", new { page = Constants.Euro2020VideoSlug }))
    <div class="main-content">
        <div class="container">
            <h2 class="block__title"><span class="text-title">@Model.Header.HeadTitle</span></h2>
            <div class="block__content">
                <div class="block__swipper">
                    <div class="swiper-container">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <div class="img-item hover-image">
                                    <input type="hidden" name="iframe_value" value="@Model.Posts[0].PostContent" />
                                    <picture>
                                        <source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/webp">
                                        <source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/jpeg">
                                        <img loading="lazy" src="@Url.Content(Model.Posts[0].FeatureImage)" alt="@Model.Posts[0].PostTitle">
                                    </picture>
                                    <div class="btn-play-video" post-id="@Model.Posts[0].ID">
                                        <span class="icon-play"></span>
                                    </div>
                                </div>
                                <div class="play_video"></div>
                                <div class="content-box">
                                    <h4 class="title-box"><a href="@Url.Action("Single", "Post", new { slug = Model.Posts[0].Uri })" class="heading">@Model.Posts[0].PostTitle</a></h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="block__video">
                    @for (int i = 1; i < Model.Posts.Length; i++)
                    {
                        <div class="card-vertical card-vertical-highlight">
                            <a href="@Url.Action("Single", "Post", new { slug = Model.Posts[i].Uri })" class="card-vertical__image hover-image">
                                <picture>
                                    <source srcset="@Url.Content(Model.Posts[i].FeatureImage)" type="image/webp" class="img-res">
                                    <source srcset="@Url.Content(Model.Posts[i].FeatureImage)" type="image/jpeg" class="img-res">
                                    <img loading="lazy" src="@Url.Content(Model.Posts[i].FeatureImage)" alt="@Model.Posts[i].PostTitle" class="img-res img-block">
                                </picture>
                            </a>
                            <a href="@Url.Action("Single", "Post", new { slug = Model.Posts[i].Uri })" class="card-vertical__title text-description">@Model.Posts[i].PostTitle</a>
                            <p class="card-vertical__datetime">
                                <span>
                                    @Model.Posts[i].PostTime
                                    @if (Model.Posts[i].CommentCount > 0)
                                    {
                                        <a href="@Url.Action("Single", "Post", new { slug =  Model.Posts[i].Uri})#comment" class="comment"><i class="icon-mode_comment"></i> <i class="number">@Model.Posts[i].CommentCount</i></a>
                                    }
                                </span>
                            </p>
                        </div>
                    }
                </div>

                @{ int CurrentPage = Convert.ToInt32(Model.Paging.CurrentPage);
                    int TotalPages = Convert.ToInt32(Model.Paging.TotalPages);
                    var linkLast = Url.Action("Video", "Euro2020", new { page = Model.Paging.TotalPages });
                    var linkFirst = Url.Action("Video", "Euro2020", new { page = 1 });
                    var linkNext = Url.Action("Video", "Euro2020", new { page = CurrentPage + 1 });
                    var linkPrev = Url.Action("Video", "Euro2020", new { page = CurrentPage - 1 });

                    linkPrev = CurrentPage > 1 ? linkPrev : "javascript:;";
                    linkNext = CurrentPage < TotalPages ? linkNext : "javascript:;"; }
                @if (TotalPages > 1)
                {
                    <div class="pagination">
                        <a href="@linkFirst" class="icon-pagination icon-page-first"></a>
                        <a href="@linkPrev" class="icon-pagination icon-chevron-left"></a>
                        <ul class="main-pagination">
                            @{ var front = (CurrentPage - 1 > 2) ? 2 : CurrentPage - 1;
                                front = (CurrentPage - 1 == 3) ? 3 : front;
                                var back = (TotalPages - CurrentPage > 2) ? 2 : TotalPages - CurrentPage;
                                back = (TotalPages - CurrentPage == 3) ? 3 : back;

                                if (CurrentPage - 4 >= 1)
                                {
                                    <li class="items-pagination"><a href="@linkFirst" class="item">1</a></li>
                                    <li class="items-pagination"><a class="item">...</a></li>
                                }

                                for (var i = CurrentPage - front; i <= CurrentPage + back; i++)
                                {
                                    var link = Url.Action("Video", "Euro2020", new { page = i });

                                    var active = i == CurrentPage ? "active" : "";
                                    <li class="items-pagination @active"><a href="@link" class="item">@i</a></li>
                                }

                                if (CurrentPage + 4 <= TotalPages)
                                {
                                    <li class="items-pagination"><a class="item">...</a></li>
                                    <li class="items-pagination"><a href="@linkLast" class="item">@Model.Paging.TotalPages</a></li>
                                } }
                        </ul>
                        <a href="@linkNext" class="icon-pagination icon-chevron-right"></a>
                        <a href="@linkLast" class="icon-pagination icon-page-last"></a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>