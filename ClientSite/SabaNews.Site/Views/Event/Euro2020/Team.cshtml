@using SabaNews.Core.Constants;

<meta name="description" content='@Model.Header.Description' />
<meta name="robots" content="noarchive">
<meta property="og:description" content='@Model.Category.OgDescription' />
<meta property="og:title" content='@Model.Category.OgTitle' />
<meta property="og:image" content='@Model.Category.OgImage' />

@section Title{
	@Model.Header.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/euro2020_team.min.css" asp-append-version="true">
}

@section Scripts{
}


<div class="page">
	@(await Component.InvokeAsync("HeaderEvent", new { page = Constants.Euro2020TeamSlug }))
	<div class="main-content">
			<div class="container">
				<h2 class="block__title"><span class="text-title">@Model.Header.HeadTitle</span></h2>

				<div class="block__content">
					@foreach (var post in Model.Posts)
					{
						var arrTeamInfo = post.PostExcerpt.Split('-');
						var teamName = arrTeamInfo[0];
						var teamFlag = arrTeamInfo[arrTeamInfo.Length - 1].Trim().ToLower();

						<a class="team" href="@Url.Action("Single", "Post", new { slug = post.Uri  })">
							<span class="flag-@teamFlag"></span>
							<span class="name">@teamName</span>
						</a>

					}
				</div>
			</div>
	</div>
</div>
