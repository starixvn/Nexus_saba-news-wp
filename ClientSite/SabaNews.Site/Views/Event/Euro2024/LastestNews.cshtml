@using SabaNews.Core.Constants
@using static SabaNews.Site.Extensions.DeviceHelper;
@{
    Layout = "_LayoutEuro2024";
}
@section Title {
    @Model.Header.Title
}

@section Metadata {
    <meta name="description" content='@Model.Header.Description' />
    <meta property="og:description" content='@Model.Header.Description' />
    <meta property="og:title" content='@Model.Header.Title' />
}

@{
    var isMobile = IsMobile(Context.Request.Headers["User-Agent"].ToString());
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/euro-lastestnews.min.css" asp-append-version="true">
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/livescore/soccer/euro-2024/fixture.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/livescore/soccer/euro-2024/fixture.chunk.css" asp-append-version="true" />
    </environment>
}

@section Scripts{
    <script>
        window.slug = '@Model.CategorySlug';
        window.paging = {
            page: '@Model.Paging.CurrentPage',
            pageSize: '@Model.Paging.PageSize',
            totalPages: '@Model.Paging.TotalPages'
        };
        window.isVideo = false;
        window.type = '@Model.Header.Controller';
    </script>
    <environment include="Development">
        <script src="~/js/dev/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/euro-2024/fixture.chunk.js" asp-append-version="true"></script>
        <script src="~/js/event/euro2024/scroll.js" asp-append-version="true"></script>
        <script src="~/js/event/euro2024/lastestnews.js" asp-append-version="true"></script>
        <script src="~/js/event/euro2024/euro2024.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/pages/livescore/soccer/euro-2024/fixture.chunk.js" asp-append-version="true"></script>
        <script src="~/minify/js/euro-2024-lastestnews.min.js" asp-append-version="true"></script>
    </environment>
}

@(await Component.InvokeAsync("HeaderEuro2024", new { cateSlug = Model.Header.Slug }))
<section class="euro2024-lastest-news">
    <div class="banner-euro-mobile banner-mobile-top"></div>
    <div id="euro-fixture"></div>
    <div class="euro-page-main">
        <div class="container">
            <div class="bg-block">
                <div class="block-heading">
                    <h2 class="block-heading-text">
                        @Model.Header.HeadTitle
                    </h2>
                </div>
                @if (Model.Posts.Count > 0){
                    <div class="pages-main-hot">
                        <div class="page-items-hot">
                            <div class="block-items block-items-vertical block-items-vertical-hot">
                                <div class="block-items-img hover-image"> 
                                    <a href=@Url.Action("Article", "Euro2024", new { slug = Model.Posts[0].Uri })>
                                        <img src="@Url.Content(Model.Posts[0].FeatureImage)" alt="@Model.Posts[0].PostTitle" asp-append-version="true" loading="lazy" class="img-res lazy" />
                                    </a>
                                </div>
                                <div class="group-title-hot">
                                    <h2 class="block-items-heading">
                                        <a href="@Url.Action("Article", "Euro2024", new { slug = Model.Posts[0].Uri })">@Model.Posts[0].PostTitle</a>
                                    </h2>
                                    <div class="block-heading-description">
                                        <p>@Html.Raw(Model.Posts[0].PostExcerpt)</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="page-hot-right">
                            @{
                                var postIndexhot = 0;

                                foreach (var post in Model.Posts)
                                {
                                    {
                                        postIndexhot++;
                                        if (postIndexhot <= 1)
                                        {
                                            continue;
                                        }
                                        if (postIndexhot <= 4)
                                        {
                                            <div class="block-items block-items-horizontal block-items-horizontal-hot">
                                                <a  class="block-items-heading ishow-pc" href="@Url.Action("Article", "Euro2024", new { slug = post.Uri })">@post.PostTitle</a>
                                                <div class="block-items-img hover-image"> 
                                                    <a href="@Url.Action("Article", "Euro2024", new { slug = post.Uri })" class="card-horizontal__image thumb thumb-52">
                                                        <picture>
                                                            <source srcset="@Url.Content(post.FeatureImage)" type="image/webp" class="img-res">
                                                            <source srcset="@Url.Content(post.FeatureImage)" type="image/jpeg" class="img-res">
                                                            <img asp-append-version="true" loading="lazy" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" class="img-res img-block lazy">
                                                        </picture>
                                                    </a>
                                                </div>
                                                <div class="group-title-hot">
                                                    <h2 class="block-items-heading ishow-mobile">
                                                        <a href="@Url.Action("Article", "Euro2024", new { slug = post.Uri })">@post.PostTitle</a>
                                                    </h2>
                                                    <div class="block-heading-description">
                                                        @post.PostExcerpt
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="ishow-mobile">
                <div data-ismobile="@isMobile" class="euro-top-standing sticky-box"></div>
            </div>
            <div class="page-grid">
                <div class="page-items-left">
                    <div id="news-grid" class="news-grid">
                        @{
                            var index = 0;
                            foreach (var post in Model.Posts)
                            {
                                index++;
                                if (index == 9 && isMobile)
                                {
                                    <div class="ishow-mobile">
                                        <div class="euro-top-scorer sticky-box"></div>
                                    </div>
                                }
                                if (index <= 4)
                                {
                                    continue;
                                }
                                <div class="block-items block-items-horizontal">
                                    <div class="block-items-img hover-image"> 
                                        <a href="@Url.Action("Article", "Euro2024", new { slug = post.Uri })" class="card-horizontal__image thumb thumb-52">
                                            <picture>
                                                <source srcset="@Url.Content(post.FeatureImage)" type="image/webp" class="img-res">
                                                <source srcset="@Url.Content(post.FeatureImage)" type="image/jpeg" class="img-res">
                                                <img asp-append-version="true" loading="lazy" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" class="img-res img-block lazy">
                                            </picture>
                                        </a>
                                    </div>
                                    <div class="group-title-hot">
                                        <h2 class="block-items-heading">
                                            <a href="@Url.Action("Article", "Euro2024", new { slug = post.Uri })">@post.PostTitle</a>
                                        </h2>
                                        <div class="block-heading-description">
                                            @post.PostExcerpt
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <div class="loading-page">
                        <div class="lds-ellipsis">
                            <div></div><div></div><div></div><div></div>
                        </div>
                    </div>
                </div>
                <div class="page-items-right">
                    <div class="sticky-position ishow-pc">
                        <div class="sticky-position">
                            <div data-ismobile="@isMobile" class="euro-top-standing sticky-box">
                            </div>
                            <div class="euro-top-scorer sticky-box"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
