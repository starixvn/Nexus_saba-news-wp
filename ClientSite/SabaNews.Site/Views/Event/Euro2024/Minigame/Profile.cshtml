@using System.Text;
@using static SabaNews.Site.Extensions.LivescoreHelper;
@using static SabaNews.Site.Extensions.EuroHelper;
@using SabaNews.Site.Extensions;
@{
    Layout = "_LayoutEuro2024";
}
@section Title {
    @Model.Header.Title
}

@section Metadata {
    <meta name="description" content='@Model.Header.Description' />
    <meta property="og:description" content='@Model.Header.Description' />
    <meta property="og:title" content='@Model.Header.Title' />
}
@{
    var countStageActive = GetCountStageActiveMinigame(Model.Matches);
    var countStageEnd = GetCountStageEndMinigame(Model.Matches);
}

@section Styles {
    <link rel="stylesheet" href="~/minify/styles/euro2024-minigame.min.css" asp-append-version="true">

    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/livescore/soccer/euro-2024/minigame-profile.chunk.css"
            asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/livescore/soccer/euro-2024/minigame-profile.chunk.css"
            asp-append-version="true" />
    </environment>
}

@section Scripts {
    <environment include="Development">
        <script src="~/js/dev/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/euro-2024/minigame-profile.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/pages/livescore/soccer/euro-2024/minigame-profile.chunk.js" asp-append-version="true"></script>
    </environment>
    <script src="~/js/event/euro2024/minigame.js" asp-append-version="true"></script>
}

@(await Component.InvokeAsync("HeaderEuro2024" , new { cateSlug = Model.Header.Slug }))
<section class="worldcup-lastest-news minigame-section">
    @await Html.PartialAsync("~/Views/Event/Euro2024/Minigame/_MenuBar.cshtml", new MenuBarViewComponent { IsLogin = Model.IsLogin, CountStageActive = countStageActive, CountStageEnd = countStageEnd, SlugActive = "MinigameProfile" })
    <div class="statistic-grid">
        <div class="wraper-minigame-table profile-wraper-tablle">
            <div class="block-heading"><h2 class="block-heading-text">Dự đoán của tôi</h2></div>
            <ul class="auth-provider auth-minigame">
                @if (Model.User.Photo == null)
                {
                    <li class="avatar-user">@Model.User.Name.Substring(0, 1)</li>
                }
                else if (Model.User.Photo.ToLower().Contains("https://") ||
                Model.User.Photo.ToLower().Contains("http://"))
                {
                    <li class="avatar-user"><img class="profile_image" loading="lazy" src="@Model.User.Photo" width="300"
                            data-name="@Model.User.Name.Substring(0, 1)" /></li>
                }
                else
                {
                    <li class="avatar-user"><img class="profile_image" loading="lazy" src="/uploads/@Model.User.Photo"
                            width="300" data-name="@Model.User.Name.Substring(0, 1)" /></li>
                }
                <li class="auth-displayname"><a class="item">@Model.User.Name</a></li>
            </ul>
            <div id="app-container"></div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Views/Event/Euro2024/Minigame/_Guide.cshtml")
