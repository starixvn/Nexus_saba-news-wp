<ul class="header-nav-event">
        <li>
            <a href="@Url.Action("Minigame", "Euro2024")" class="btn-home @(Model.SlugActive == "Minigame" ? "active" : "")">
                <i class="icon icon-minigame_home"></i>
                <span>Sự Kiện</span>
            </a>
        </li>
        <li>
            <a href="javascript:;" class="click-number-rule btn-nav-guide">
                <i class="icon icon-minigame_guide"></i>
                <span>Thể Lệ</span>
            </a>
        </li>
        <li>
            <a href="@Url.Action("Minigame", "Euro2024")#stage-minigame" class="click-list-rigister @(Model.SlugActive == "MinigameStage" ? "active" : "")">
                <i class="icon icon-minigame_connect"></i>
                <span>Tham Gia Dự Đoán</span>
            </a>
        </li>
        @{
            if (Model.IsLogin)
            {
                <li>
                    <a href=@Url.Action("MinigameProfile", "Euro2024") class="click-my-prediction @(Model.SlugActive == "MinigameProfile" ? "active" : "")">
                        <i class="icon icon-minigame_my_fav"></i>
                        <span>Dự Đoán Của Tôi</span>
                    </a>
                </li>
            }
            if (Model.CountStageActive > 0)
            {
                <li>
                    <a href="@Url.Action("Minigame", "Euro2024")#minigame-standing" class="click-list-standing " >
                        <i class="icon icon-minigame_standing"></i>
                        <span>Bảng Xếp Hạng</span>
                    </a>
                </li>
            }
            if (Model.CountStageEnd > 0)
            {
                <li>
                    <a href="@Url.Action("Minigame", "Euro2024")#minigame-winners" class="click-list-result">
                        <i class="icon icon-minigame_list_user"></i>
                        <span>Danh Sách Trúng Thưởng</span>
                    </a>
                </li>
            }
        }
    </ul>