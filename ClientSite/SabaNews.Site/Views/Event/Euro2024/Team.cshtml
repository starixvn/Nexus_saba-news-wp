@using static SabaNews.Site.Extensions.LivescoreHelper
@using SabaNews.Core.Constants;
@using SabaNews.Core.Helper;
@{
    Layout = "_LayoutEuro2024";
}
@section Title {
    @Model.Header.Title
}

@section Metadata {
    <meta name="description" content='@Model.Header.Description' />
    <meta property="og:description" content='@Model.Header.Description' />
    <meta property="og:title" content='@Model.Header.Title' />
}


@section Styles{
    <link rel="stylesheet" href="~/minify/styles/euro2024-team.min.css" asp-append-version="true">
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/livescore/soccer/euro-2024/fixture.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/livescore/soccer/euro-2024/fixture.chunk.css" asp-append-version="true" />
    </environment>
}

@section Scripts{
    <script src="~/js/livescore/livescore.js" asp-append-version="true"></script>
    <environment include="Development">
        <script src="~/js/dev/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/euro-2024/fixture.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/pages/livescore/soccer/euro-2024/fixture.chunk.js" asp-append-version="true"></script>
    </environment>
    <script src="~/minify/js/worldcup2022-match.min.js" asp-append-version="true"></script>
}
@(await Component.InvokeAsync("HeaderEuro2024", new { cateSlug = Model.Header.Slug }))



<section class="euro-team">
    @await Html.PartialAsync(ViewResources.SidebarBannerView)
    <div id="euro-fixture"></div>
    <div class="euro-page-main">
        <div class="container">
            <div class="block-heading">
                <h2 class="block-heading-text">
                    Đội Tuyển
                </h2>
            </div>
            <div class="main-team">
                @foreach (var team in Model.Teams)
                {
                    var icon = GetTeamIcon(team.Icon);
                    var teamName = GetGeneralName(team.TeamNameEN, team.TeamFullNameEN, team.TeamNameVN);
                    <div class="team">
                        <div class="team-logo"><a href="@Url.Action("TeamDetail", "Euro2024", new { teamName = Helper.GetSlug(teamName), teamId = team.TeamId })"><img src=@(string.IsNullOrEmpty(team.IconVN) ? icon : team.IconVN) alt="Alternate Text" /></a></div>
                        <div class="team-name">@teamName</div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
