@using static SabaNews.Site.Extensions.DeviceHelper;
@{
    if (Model.Header.Controller == "Tag")
    {
        var description = "MỚI NHẤT: ";
        int i = 0;
        foreach (var post in Model.Posts)
        {
            i++;
            if (i == 3)
            {
                var titleArr = post.PostTitle.Split(' ');
                var title = titleArr.Length > 2 ? titleArr[0] + " " + titleArr[1] + "..." : post.PostTitle;
                description = string.Concat(description, title);
                break;
            }
            else
            {
                description = string.Concat(description, post.PostTitle, "; ");
            }
        }
        Model.Category.OgDescription = description;
        Model.Header.Description = description;
    }

    var isMobile = IsMobile(Context.Request.Headers["User-Agent"].ToString());
    var slug1 = Model.Slugs != null ? Model.Slugs.Slug1 : null;
    var slug2 = Model.Slugs != null ? Model.Slugs.Slug2 : null;
    var slug3 = Model.Slugs != null ? Model.Slugs.Slug3 : null;
}

@section Scripts {
    <script>
        window.slugs = {
            slug1: '@slug1',
            slug2: '@slug2',
            slug3: '@slug3'
        };
        window.paging = {
            page: '@Model.Paging.CurrentPage',
            pageSize: '@Model.Paging.PageSize',
            totalPages: '@Model.Paging.TotalPages'
        };
        window.isVideo = false;
        window.keyword = '@Model.Header.Keyword';
        window.type = '@Model.Header.Controller';
    </script>
    <script src="~/minify/js/blog.min.js" asp-append-version="true"></script>
    
}
@section Metadata {
    <meta name="description" content='@Model.Header.Description' />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@ViewResources.SiteName" />
    <meta http-equiv="REFRESH" content="1800" />
    @if (Model.Category != null)
    {
        <meta name="robots" content="noarchive">
        <link rel="canonical" href="@Model.Category.Url">
        <meta property="og:site_name" content="@ViewResources.SiteName" />
        <meta property="og:type" content="website" />
        <meta property="og:url" itemprop="url" content="@Model.Category.Url" />
        <meta property="og:description" content='@Model.Category.OgDescription' />
        <meta property="og:title" content='@Model.Category.OgTitle' />
        <meta property="og:image" content='@Model.Category.OgImage' />
        <meta name="twitter:card" value="summary" />
        <meta name="twitter:url" content="@Model.Category.Url" />
        <meta name="twitter:title" content="@Model.Category.OgTitle">
        <meta name="twitter:description" content="@Model.Category.OgDescription">
        <meta name="twitter:image" content="@Model.Category.OgImage" />
    }
    else if (Model.Header.Controller == "Tag")
    {
        <meta name="robots" content="noarchive">
    }
    else if (Model.Header.Controller == "Search")
    {
        <meta name="robots" content="noindex, nofollow">
    }
}

@section Title{
    @Model.Header.Title
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}

@(await Component.InvokeAsync("Menu", new { CategorySlug = Model.Header.ActiveCategory, Slugs = Model.Slugs }))
<section class="main">
    <div class="base-container medium-container">
        @if (Model.Header.Controller != "category")
        {
            <h1 class="block__title title-new-page"><a>@Model.HeadTitle</a></h1>
        }
        @if (Model.Menus != null)
        {
            if (!isMobile)
            {
                <div class="group-sub-category">
                    <div class="sub-category">
                        <h1 class="heading-category"><a>@Model.HeadTitle</a></h1>
                        @foreach (var menu in Model.GetSubMenu(Model.Slugs.Slug1))
                        {
                            <h2 class="sub-item @(Model.Slugs.Slug2 == menu.CateSlug ? "active" : "")"><a href="@Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = menu.CateSlug, slug3 = (string)null })">@menu.MenuTitle</a></h2>
                        }
                    </div>
                    <div class="sub-category">
                        @foreach (var menu in Model.GetSubMenu(Model.Slugs.Slug2))
                        {
                            <h2 class="sub-item @(Model.Slugs.Slug3 == menu.CateSlug ? "active" : "")"><a href="@Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = Model.Slugs.Slug2, slug3 = menu.CateSlug })">@menu.MenuTitle</a></h2>
                        }
                    </div>
                </div>
            }
            else
            {
                var subMenu = Model.GetSubMenu(Model.Header.Slug);
                if (Model.Slugs.Slug3 != null)
                {
                    var menu = Model.GetMenuDetail(Model.Slugs.Slug3);
                    var coMenu = Model.GetCoMenu(Model.Slugs.Slug3);
                    var menuLink = Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = Model.Slugs.Slug2, slug3 = Model.Slugs.Slug3 });
                    <div class="menu-select single-select-menu">
                        <a href="@menuLink">@menu.MenuTitle</a>
                        <select class="select_ad"   onChange="window.location.href=this.value">
                            @foreach (var item in coMenu)
                            {

                                var selected = menu.PostId == item.PostId ? "selected" : "";
                                var subLink = $"/tin-the-thao/{Model.Slugs.Slug1}/{Model.Slugs.Slug2}/{item.CateSlug}";
                                <!option class="@selected" @selected value="@subLink">@item.MenuTitle</!option>
                            }
                        </select>
                    </div>
                }
                else if(subMenu.Count > 0)
                {
                    <div class="sub-category">
                        @foreach (var menu in subMenu)
                        {
                            var link = Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = menu.CateSlug, slug3 = Model.Slugs.Slug3 });
                            if (Model.Slugs.Slug2 != null)
                            {
                                link = Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = Model.Slugs.Slug2, slug3 = menu.CateSlug });
                            }
                            <h2 class="sub-item @(Model.Header.Slug == menu.CateSlug ? "active" : "")"><a href="@link">@menu.MenuTitle</a></h2>
                        }
                    </div>
                }
            }
        }
    </div>
    <div class="container medium-container">
        <div class="block block-main block-category">
            <div id="category-grid" class="block__content">
                <div class="skeleton skeleton-horizontal skeleton-horizontal-highlight">
                    <a class="skeleton-horizontal__image"></a>
                    <div class="text-skeleton">
                        <a class="skeleton-horizontal__title"></a>
                        <p class="skeleton-horizontal__description text-description"></p>
                        <p class="skeleton-horizontal__datetime"></p>
                    </div>
                </div>
                <div class="post card-horizontal card-horizontal-highlight">
                    <a href="@Url.Action("Single", "Post", new { slug = Model.Posts[0].Slug })" class="card-horizontal__image thumb thumb-56 hover-image">
                        <picture>
                            <source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/webp" class="img-res">
                            <source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/jpeg" class="img-res">
                            <img asp-append-version="true" loading="lazy" src="@Url.Content(Model.Posts[0].FeatureImage)" alt="@Model.Posts[0].PostTitle" class="img-res img-block lazy">
                        </picture>
                    </a>
                    <div class="card-horizontal__content">
                        <h2><a class="title" href="@Url.Action("Single", "Post", new { slug = Model.Posts[0].Slug })">@Model.Posts[0].PostTitle</a></h2>
                        <p class="description">@Html.Raw(Model.Posts[0].PostExcerpt)</p>
                        <p class="datetime">
                            <span>@Model.Posts[0].PostTime</span>
                            @if (Model.Posts[0].CommentCount > 0)
                            {
                                <a href="@Url.Action("Single", "Post", new { slug = Model.Posts[0].Slug })#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.Posts[0].CommentCount</i></a>
                            }
                        </p>
                    </div>
                </div>
                @{
                    int postIndex = 0;
                    foreach (var post in Model.Posts)
                    {
                        {
                            postIndex++;
                            if (postIndex <= 1)
                            {
                                continue;
                            }
                        }
                        <div class="post card-horizontal">
                            <a href="@Url.Action("Single", "Post", new { slug = post.Slug })" class="card-horizontal__image thumb thumb-52 hover-image">
                                <picture>
                                    <source srcset="@Url.Content(post.FeatureImage)" type="image/webp" class="img-res">
                                    <source srcset="@Url.Content(post.FeatureImage)" type="image/jpeg" class="img-res">
                                    <img asp-append-version="true" loading="lazy" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" class="img-res img-block lazy">
                                </picture>
                            </a>
                            <div class="card-horizontal__content">
                                @if(postIndex <= 3)
                                {
                                    <h2><a class="title" href="@Url.Action("Single", "Post", new { slug = post.Slug })">@post.PostTitle</a></h2>
                                }
                                else if(postIndex > 3 && Model.Header.Controller == "Tag")
                                {
                                    <h3><a class="title" href="@Url.Action("Single", "Post", new { slug = post.Slug })">@post.PostTitle</a></h3>
                                }
                                else
                                {
                                    <a class="title" href="@Url.Action("Single", "Post", new { slug = post.Slug })">@post.PostTitle</a>
                                }
                                <p class="description">@Html.Raw(post.PostExcerpt)</p>
                                <p class="datetime">
                                    <span>@post.PostTime</span>
                                    @if (post.CommentCount > 0)
                                    {
                                        <a href="@Url.Action("Single", "Post", new { slug = post.Slug })#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>
                                    }
                                </p>
                            </div>
                        </div>
                        @if(postIndex == 3)
                        {
                            <div class="ads-insite show-pc banner-left"></div>
                            <div class="ads-insite show-mobile banner-mobile-top"></div>
                        }
                        else if(postIndex == 8)
                        {
                            <div class="ads-insite show-mobile banner-mobile-center"></div>
                        }
                        <div class="skeleton skeleton-horizontal">
                            <a class="skeleton-horizontal__image"></a>
                            <div class="text-skeleton">
                                <a class="skeleton-horizontal__title"></a>
                                <p class="skeleton-horizontal__description text-description"></p>
                                <p class="skeleton-horizontal__datetime"></p>
                            </div>
                        </div>
                    }
                }
            </div>
            @if (Model.Posts.Count == Model.Paging.PageSize)
            { 
                <div class="loading-page">
                    <div class="lds-ellipsis">
                        <div></div><div></div><div></div><div></div>
                    </div>
                </div>
            }
        </div>
        <div class="banner-scroll banner-mobile-bottom" style="display: none;"></div>
        @await Html.PartialAsync(ViewResources.SidebarPostView, new PostComponentViewModel { CateSlug = @Model.Header.ActiveCategory })
    </div>
</section>