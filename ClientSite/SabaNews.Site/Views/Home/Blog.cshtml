@section Metadata {
	<meta name="description" content='@Model.ViewData.Description' />
	@if (Model.Category != null)
	{
		<meta name="robots" content="noarchive">
		<meta property="og:description" content='@Model.Category.OgDescription' />
		<meta property="og:title" content='@Model.Category.OgTitle' />
		<meta property="og:image" content='@Model.Category.OgImage' />
	}
	else if (Model.ViewData.Controller == "Tag")
	{
		<meta name="robots" content="noarchive">
	}
	else if (Model.ViewData.Controller == "Search")
	{
		<meta name="robots" content="noindex,nofollow">
	}
}

@section Title{
	@Model.ViewData.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}

@{
	ViewData["CategorySlug"] = Model.ViewData.ActiveCategory;
}

@(await Component.InvokeAsync("Menu"))
<section class="main">
	<div class="container">
		<div class="block block-main">
			<h2 class="block__title"><a>@(Model.ViewData.HeadTitle != null ? Model.ViewData.HeadTitle : Model.Posts[0].Categories)</a></h2>
			@if (Model.ViewData.Slug == ViewResources.FootballSlug || Model.ViewData.IsChildren)
			{
				<ul class="sub-category">
					<li class="sub-item @(Model.ViewData.Slug == ViewResources.FootballInsideSlug ? "active" : "")"><a href="@Url.Action("Category", "Home", new { slug = ViewResources.FootballInsideSlug})">@ViewResources.FootballInside</a></li>
					<li class="sub-item @(Model.ViewData.Slug == ViewResources.FootballOutsideSlug ? "active" : "")"><a href="@Url.Action("Category", "Home", new { slug = ViewResources.FootballOutsideSlug})">@ViewResources.FootballOutside</a></li>
				</ul>

			}
			<div class="block__content">
				<div class="card-horizontal card-horizontal-highlight">
					<a href="@Url.Action("Single", "Home", new { slug = Model.Posts[0].Slug })" class="card-horizontal__image thumb thumb-56">
						<picture>
							<source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/webp" class="img-res">
							<source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/jpeg" class="img-res">
							<img loading="lazy" src="@Url.Content(Model.Posts[0].FeatureImage)" alt="@Model.Posts[0].PostTitle" class="img-res img-block lazy">
						</picture>
					</a>
					<div class="card-horizontal__content">
						<a class="title" href="@Url.Action("Single", "Home", new { slug = Model.Posts[0].Slug })">@Model.Posts[0].PostTitle</a>
						<p class="description">@Model.Posts[0].PostExcerpt</p>
						<p class="datetime">
							<span>@Model.Posts[0].PostTime</span>
							@if (Model.Posts[0].CommentCount > 0)
							{
								<a href="@Url.Action("Single", "Home", new { slug = Model.Posts[0].Slug  })#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.Posts[0].CommentCount</i></a>
							}
						</p>
					</div>
				</div>
				@for (int i = 1; i < Model.Posts.Length; i++)
				{
					<div class="card-horizontal">
						<a href="@Url.Action("Single", "Home", new { slug = Model.Posts[i].Slug })" class="card-horizontal__image thumb thumb-52">
							<picture>
								<source srcset="@Url.Content(Model.Posts[i].FeatureImage)" type="image/webp" class="img-res">
								<source srcset="@Url.Content(Model.Posts[i].FeatureImage)" type="image/jpeg" class="img-res">
								<img loading="lazy" src="@Url.Content(Model.Posts[i].FeatureImage)" alt="@Model.Posts[i].PostTitle" class="img-res img-block lazy">
							</picture>
						</a>
						<div class="card-horizontal__content">
							<a class="title" href="@Url.Action("Single", "Home", new { slug = Model.Posts[i].Slug })">@Model.Posts[i].PostTitle</a>
							<p class="description">@Model.Posts[i].PostExcerpt</p>
							<p class="datetime">
								<span>@Model.Posts[i].PostTime</span>
								@if (Model.Posts[i].CommentCount > 0)
								{
									<a href="@Url.Action("Single", "Home", new { slug = Model.Posts[i].Slug  })#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.Posts[i].CommentCount</i></a>
								}
							</p>

						</div>
					</div>
				}
				@{
					int CurrentPage = Model.ViewData.CurrentPage;
					int TotalPages = Model.ViewData.TotalPages;
					var linkLast = Url.Action("Category", "Home", new { page = Model.ViewData.TotalPages });
					var linkFirst = Url.Action("Category", "Home", new { page = 1 });
					var linkNext = Url.Action("Category", "Home", new { page = CurrentPage + 1 });
					var linkPrev = Url.Action("Category", "Home", new { page = CurrentPage - 1 });
					if (Model.ViewData.Controller == "Search")
					{
						linkLast = Url.Action("Search", "Home", new { keyword = Model.ViewData.Keyword, page = Model.ViewData.TotalPages });
						linkFirst = Url.Action("Search", "Home", new { keyword = Model.ViewData.Keyword, page = 1 });
						linkNext = Url.Action("Search", "Home", new { keyword = Model.ViewData.Keyword, page = CurrentPage + 1 });
						linkPrev = Url.Action("Search", "Home", new { keyword = Model.ViewData.Keyword, page = CurrentPage - 1 });
					}
					else if (Model.ViewData.Controller == "Tag")
					{
						linkLast = Url.Action("Tag", "Home", new { tagname = Model.ViewData.Tag, page = Model.ViewData.TotalPages });
						linkFirst = Url.Action("Tag", "Home", new { tagname = Model.ViewData.Tag, page = 1 });
						linkNext = Url.Action("Tag", "Home", new { tagname = Model.ViewData.Tag, page = CurrentPage + 1 });
						linkPrev = Url.Action("Tag", "Home", new { tagname = Model.ViewData.Tag, page = CurrentPage - 1 });
					}
					else if (Model.ViewData.Controller == "DateSearch")
					{
						linkLast = Url.Action("DateSearch", "Home", new { date = Model.ViewData.DateSearch, page = Model.ViewData.TotalPages });
						linkFirst = Url.Action("DateSearch", "Home", new { date = Model.ViewData.DateSearch, page = 1 });
						linkNext = Url.Action("DateSearch", "Home", new { date = Model.ViewData.DateSearch, page = CurrentPage + 1 });
						linkPrev = Url.Action("DateSearch", "Home", new { date = Model.ViewData.DateSearch, page = CurrentPage - 1 });
					}

					linkPrev = CurrentPage > 1 ? linkPrev : "javascript:;";
					linkNext = CurrentPage < TotalPages ? linkNext : "javascript:;";
				}
				@if (TotalPages > 1)
				{
					<div class="pagination">
						<a href="@linkFirst" class="icon-pagination icon-page-first"></a>
						<a href="@linkPrev" class="icon-pagination icon-chevron-left"></a>
						<ul class="main-pagination">
							@{
								var front = (CurrentPage - 1 > 2) ? 2 : CurrentPage - 1;
								front = (CurrentPage - 1 == 3) ? 3 : front;
								var back = (TotalPages - CurrentPage > 2) ? 2 : TotalPages - CurrentPage;
								back = (TotalPages - CurrentPage == 3) ? 3 : back;

								if (CurrentPage - 4 >= 1)
								{
									<li class="items-pagination"><a href="@linkFirst" class="item">1</a></li>
									<li class="items-pagination"><a class="item">...</a></li>
								}

								for (var i = CurrentPage - front; i <= CurrentPage + back; i++)
								{
									var link = Url.Action("Category", "Home", new { page = i });
									if (Model.ViewData.Controller == "Search")
									{
										link = Url.Action("Search", "Home", new { keyword = Model.ViewData.Keyword, page = i });
									}
									else if (Model.ViewData.Controller == "Tag")
									{
										link = Url.Action("Tag", "Home", new { tagname = Model.ViewData.Tag, page = i });
									}
									else if (Model.ViewData.Controller == "DateSearch")
									{
										link = Url.Action("DateSearch", "Home", new { date = Model.ViewData.DateSearch, page = i });
									}
									var active = i == CurrentPage ? "active" : "";
									<li class="items-pagination @active"><a href="@link" class="item">@i</a></li>
								}

								if (CurrentPage + 4 <= TotalPages)
								{
									<li class="items-pagination"><a class="item">...</a></li>
									<li class="items-pagination"><a href="@linkLast" class="item">@Model.ViewData.TotalPages</a></li>
								}
							}
						</ul>
						<a href="@linkNext" class="icon-pagination icon-chevron-right"></a>
						<a href="@linkLast" class="icon-pagination icon-page-last"></a>
					</div>
				}
			</div>
		</div>
		@if (Model.ViewData.Slug != null)
		{
			@(await Component.InvokeAsync("Sidebar", new { cateSlug = Model.ViewData.Slug }))
		}
		else
		{
			@(await Component.InvokeAsync("Sidebar"))
		}

	</div>
</section>