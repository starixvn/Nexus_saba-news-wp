@using static SabaNews.Site.Extensions.DeviceHelper;
@section Metadata {
    <meta name="description" content='@Model.Header.Description' />
    <meta property="og:description" content='@Model.Category.OgDescription' />
    <meta property="og:title" content='@Model.Category.OgTitle' />
    <meta property="og:image" content='@Model.Category.OgImage' />
    <meta name="robots" content="noarchive">
}

@section Title{
    @Model.Header.Title
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/video.min.css" asp-append-version="true">
}

@section Scripts {
    <script>
        window.slugs = {
            slug1: '@Model.Header.Slug'
        };
        window.paging = {
            page: '@Model.Paging.CurrentPage',
            pageSize: '@Model.Paging.PageSize',
            totalPages: '@Model.Paging.TotalPages'
        };
        window.isVideo = true;
        window.type = '@Model.Header.Controller';

    </script>
    <script src="~/js/post/blog.js" asp-append-version="true"></script>
    <script src="~/minify/js/swiper.min.js" asp-append-version="true"></script>
}

@{
    bool isMobile = IsMobile(Context.Request.Headers["User-Agent"].ToString());
}

@(await Component.InvokeAsync("Menu", new { page = "video-page", CategorySlug = Model.Header.Slug, Slugs = Model.Slugs }))
<section class="main">
    <div class="base-container">
        @if (!isMobile)
        {
            <h2 class="block__title title-new-page"><a>@(Model.Header.HeadTitle != null ? Model.Header.HeadTitle : Model.Posts[0].Categories)</a></h2>
        }
        @if (Model.Menus != null)
        {
            if (!isMobile)
            {
                <ul class="sub-category">
                    @foreach (var menu in Model.GetSubMenu(Model.Slugs.Slug1))
                    {
                        <li class="sub-item @(Model.Slugs.Slug2 == menu.CateSlug ? "active" : "")"><a href="@Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = menu.CateSlug, slug3 = (string)null })">@menu.MenuTitle</a></li>
                    }
                </ul>
                <ul class="sub-category last">
                    @foreach (var menu in Model.GetSubMenu(Model.Slugs.Slug2))
                    {
                        <li class="sub-item @(Model.Slugs.Slug3 == menu.CateSlug ? "active" : "")"><a href="@Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = Model.Slugs.Slug2, slug3 = menu.CateSlug })">@menu.MenuTitle</a></li>
                    }
                </ul>
            }
            else
            {
                var subMenu = Model.GetSubMenu(Model.Header.Slug);
                if (Model.Slugs.Slug3 != null)
                {
                    var menu = Model.GetMenuDetail(Model.Slugs.Slug3);
                    var coMenu = Model.GetCoMenu(Model.Slugs.Slug3);
                    var menuLink = Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = Model.Slugs.Slug2, slug3 = Model.Slugs.Slug3 });
                    <div class="menu-select single-select-menu">
                        <a href="@menuLink">@menu.MenuTitle</a>
                        <select class="select_ad" onChange="window.location.href=this.value">
                            @foreach (var item in coMenu)
                            {

                                var selected = menu.PostId == item.PostId ? "selected" : "";
                                var subLink = $"/tin-the-thao/{Model.Slugs.Slug1}/{Model.Slugs.Slug2}/{item.CateSlug}";
                                <!option class="@selected" @selected value="@subLink">@item.MenuTitle</!option>
                            }
                        </select>
                    </div>
                }
                else if (subMenu.Count > 0)
                {
                    <ul class="sub-category">
                        @foreach (var menu in subMenu)
                        {
                            var link = Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = menu.CateSlug, slug3 = Model.Slugs.Slug3 });
                            if (Model.Slugs.Slug2 != null)
                            {
                                link = Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = Model.Slugs.Slug2, slug3 = menu.CateSlug });
                            }
                            <li class="sub-item @(Model.Header.Slug == menu.CateSlug ? "active" : "")"><a href="@link">@menu.MenuTitle</a></li>
                        }
                    </ul>
                }
            }
        }
    </div>
    <div class="container">
        <div class="block block-main">
            
            <div class="block__swipper">
                <div class="swiper-container">
                    <div class="skeleton skeleton-swiper-slide">
                        <div class="img-item"></div>
                        <div class="content-box"></div>
                    </div>
                    <div class="post swiper-wrapper">
                        <div class="swiper-slide">
                            <div class="img-item">
                                <input type="hidden" name="iframe_value" value="@Model.Posts[0].PostContent" />
                                <picture>
                                    <source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/webp">
                                    <source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/jpeg">
                                    <img asp-append-version="true" loading="lazy" src="@Url.Content(Model.Posts[0].FeatureImage)" alt="@Model.Posts[0].PostTitle">
                                </picture>
                                <div class="btn-play-video" post-id="@Model.Posts[0].ID">
                                    <span class="icon-play"></span>
                                </div>
                            </div>
                            <div class="play_video"></div>
                            <div class="content-box">
                                <h4 class="title-box"><a href="@Url.Action("Single", "Post", new { slug = Model.Posts[0].Slug })" class="heading">@Model.Posts[0].PostTitle</a></h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="category-grid" class="block__video">
                @{
                    int postIndex = 0;
                    foreach (var post in Model.Posts)
                    {
                        {
                            postIndex++;
                            if (postIndex <= 1)
                            {
                                continue;
                            }
                        }
                        <div class="post card-vertical card-vertical-highlight">
                            <a href="@Url.Action("Single", "Post", new { slug = post.Slug })" class="card-vertical__image thumb">
                                <picture>
                                    <source srcset="@Url.Content(post.FeatureImage)" type="image/webp" class="img-res">
                                    <source srcset="@Url.Content(post.FeatureImage)" type="image/jpeg" class="img-res">
                                    <img asp-append-version="true" loading="lazy" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" class="img-res img-block lazy">
                                </picture>
                            </a>
                            <a href="@Url.Action("Single", "Post", new { slug = post.Slug })" class="card-vertical__title text-description">@post.PostTitle</a>
                            <p class="card-vertical__datetime">
                                <span>
                                    @post.PostTime
                                    @if (post.CommentCount > 0)
                                    {
                                        <a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment"></i> <i class="number">@post.CommentCount</i></a>
                                    }
                                </span>
                            </p>
                        </div>
                        <div class="skeleton skeleton-vertical">
                            <a class="skeleton-vertical__image"></a>
                            <a class="skeleton-vertical__title"></a>
                            <p class="skeleton-vertical__description text-description"></p>
                        </div>
                    }
                }
            </div>
            <div class="loading-page">
                <div class="lds-ellipsis">
                    <div></div><div></div><div></div><div></div>
                </div>
            </div>
        </div>
        @await Html.PartialAsync(ViewResources.SidebarPostView, new PostComponentViewModel { CateSlug = Model.Header.Slug })
    </div>
    @await Html.PartialAsync(ViewResources.SidebarBannerView)
</section>