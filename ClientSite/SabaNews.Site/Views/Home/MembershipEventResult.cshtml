
@section Title{
    MembershipEvent Result
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/membership-event.min.css" asp-append-version="true">

}
@section Scripts{
    <script src="~/minify/js/membership-event.min.js" asp-append-version="true"></script>
}


<body>
    <div class="wrapper-menu-event"></div>
    <div class="wrapper-header wrapper-result">
        <div class="flower-result">
            <div class="flower-result-img"><img src="~/images/event/chill.png"></div>
            <div class="flower-result-img"><img src="~/images/event/chill.png"></div>
        </div>
        <div class="banner-result">
            <img src="~/images/event/result-banner.png" alt="result-banner" class="img-res" />
        </div>

        <div class="header-menu">
            <div class="logo-event">
                <a href="@Url.Action("Index", "Home")">
                    <img src="~/images/event/logo.png" alt="saba-sports" asp-append-version="true">
                </a>
            </div>
            <div class="after-login result-login">
                <ul class="users">
                    <li class="avatar"><img src="~/images/sabasports.svg" alt="saba-sports" asp-append-version="true"></li>
                    <li class="name">Saba Sport</li>
                </ul>
            </div>
        </div>
        <ul class="header-nav-event">
            <li>
                <a href="#" class="active">
                    <i class="icon icon-event-home"></i>
                    <span>Trang Chủ</span>
                </a>
            </li>
            <li>
                <a href="#nhap-so-may-man" class="click-number-event">
                    <i class="icon icon-field-number"></i>
                    <span>Nhập Số May Mắn</span>
                </a>
            </li>
            <li>
                <a href="#danh-sach-tham-gia" class="click-list-rigister">
                    <i class="icon icon-list-event"></i>
                    <span>Danh Sách Tham Gia</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("MembershipEventResult", "Home")">
                    <i class="icon icon-list-event-true"></i>
                    <span>Danh Sách Trúng Giải</span>
                </a>
            </li>
        </ul>
        <div class="toggle-mobile-event">
            <i class="icon icon-menu-event"></i>
        </div>
    </div>
    <main role="main">
        <div class="main-result">
            <div class="thank-users">
                <a href="#">Saba.vn</a> xin chân thành cảm ơn Quý độc giả đã tham gia chương trình minigame "Rước Lộc Tân Niên". Căn cứ vào 3 số đuôi của Giải Đặc Biệt từ kết quả xổ số miền Bắc ngày 28/02/2022 (link), chúng tôi đã tìm ra được những độc giả may mắn trúng thưởng như sau:
            </div>
            <div class="last-result-event">
                <div class="item-result">
                    <img src="~/images/event/item1.png" alt="item-1" class="img-res" />
                    <div class="user-final">
                       <p class="name">Nguyễn Văn ABC XYZ</p>
                       <p class="email">abc******xyz@gmail.com</p>
                    </div>
                </div>
                <div class="item-result">
                    <img src="~/images/event/item2.png" alt="item-2" class="img-res" />
                    <div class="user-final">
                        <p class="name">Nguyễn Văn ABC XYZ</p>
                        <p class="email">abc******xyz@gmail.com</p>
                    </div>
                    <div class="user-final">
                        <p class="name">Nguyễn Văn ABC XYZ</p>
                        <p class="email">abc******xyz@gmail.com</p>
                    </div>
                </div>
                <div class="item-result">
                    <img src="~/images/event/item3.png" alt="item-3" class="img-res" />
                    <div class="user-final">
                        <p class="name">Nguyễn Văn ABC XYZ</p>
                        <p class="email">abc******xyz@gmail.com</p>
                    </div>
                    <div class="user-final">
                        <p class="name">Nguyễn Văn ABC XYZ</p>
                        <p class="email">abc******xyz@gmail.com</p>
                    </div>
                    <div class="user-final">
                        <p class="name">Nguyễn Văn ABC XYZ</p>
                        <p class="email">abc******xyz@gmail.com</p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>



<div class="auth-form">
    <div class="modal" id="register" style="display:none">
        <div class="modal-content modal-auth">
            <div class="modal-warning">
                <button type="button" class="close-event" data-dismiss="modal" aria-label="Close">
                    <i class="icon icon-close-event"></i>
                </button>
                <div class="modal-body register">
                    <div class="heading-modal-event">nhập số may mắn</div>
                    <p class="text-event-modal">Bạn có muốn nhập con số may mắn này không ?</p>
                    <ul>
                        <li><a href="#nhap-so-may-man" class="btn btn-event btn-accept active">đồng ý</a></li>
                        <li><a href="#" class="btn btn-event btn-outline-event">bỏ qua</a></li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>

