@using static SabaNews.Site.Extensions.DeviceHelper;
@using SabaNews.Core.Constants;
@section Schema {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebPage",
        "id": "@Model.Category.Url",
        "url": "@Model.Category.Url",
        "name": "@Model.Header.Title",
        "description": "@Model.Header.Description",
        "publisher": {
            "@@type": "Organization",
            "name": "SABAVN Sports",
            "logo": {
            "@@type": "ImageObject",
            "url": "https://www.sabavn.net/images/sabasports.svg"
            }
        },
        "inLanguage": "vi-VN",
        "isPartOf": {
            "@@type": "Website",
            "name": "SABAVN.net",
            "url": "https://www.sabavn.net/"
        }@if(!string.IsNullOrEmpty(Model.Category.CustomSchema))
            {
                @Html.Raw($",{Model.Category.CustomSchema}")
            }
    }
</script>
}
@{
    var isMobile = IsMobile(Context.Request.Headers["User-Agent"].ToString());
    var item1 = Model.MenuItems != null ? Model.MenuItems.Item1 : null;
    var item2 = Model.MenuItems != null ? Model.MenuItems.Item2: null;
    var item3 = Model.MenuItems != null ? Model.MenuItems.Item3 : null;
    string currentSlug = Model.Slug as string ?? string.Empty;
    bool isExcludedCategory = Constants.ExcludedCategories.Contains(currentSlug, StringComparer.OrdinalIgnoreCase);
}

@section Metadata {
    <meta name="description" content='@Model.Header.Description' />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@ViewResources.SiteName" />
    <meta http-equiv="REFRESH" content="1800" />
    <meta property="og:site_name" content="@ViewResources.SiteName" />
    <meta property="og:type" content="website" />
    <meta property="og:url" itemprop="url" content="@Model.Category.Url" />
    <meta property="og:description" content='@Model.Category.OgDescription' />
    <meta property="og:title" content='@Model.Category.OgTitle' />
    <meta property="og:image" content='@Model.Category.OgImage' />
    <meta name="twitter:card" value="summary" />
    <meta name="twitter:url" content="@Model.Category.Url" />
    <meta name="twitter:title" content="@Model.Category.OgTitle">
    <meta name="twitter:description" content="@Model.Category.OgDescription">
    <meta name="twitter:image" content="@Model.Category.OgImage" />
    <link rel="canonical" href="@Model.Category.Url">

    @if (isExcludedCategory)
    {
        <meta name="robots" content="index, follow,noarchive,max-image-preview:large" />
    }
    else {
        <meta name="robots" content="noindex, follow,noarchive,max-image-preview:large" />
    }
}

@section Scripts {
    <script>
        window.slug = '@Model.Slug'
        window.paging = {
            page: '@Model.Paging.CurrentPage',
            pageSize: '@Model.Paging.PageSize',
            totalPages: '@Model.Paging.TotalPages'
        };
        window.isVideo = false;
        window.keyword = '@Model.Header.Keyword';
        window.type = '@Model.Header.Controller';
        window.leagueId ='@Model.Category.LeagueId';
        window.seasonId = '@Model.Category.SeasonId';
    </script>
    <script src="~/minify/js/blog.min.js" asp-append-version="true"></script>
    @if(Model.Category.LeagueId > 0)
    {
        <environment include="Development">
        <script src="~/js/dev/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/category/standing.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/category/fixture.chunk.js" asp-append-version="true"></script>
        </environment>
        <environment exclude="Development">
            <script src="~/js/pro/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
            <script src="~/js/pro/lib/react-vendor.chunk.js" asp-append-version="true"></script>
            <script src="~/js/pro/pages/livescore/soccer/category/standing.chunk.js" asp-append-version="true"></script>
            <script src="~/js/pro/pages/livescore/soccer/category/fixture.chunk.js" asp-append-version="true"></script>
        </environment>
    }
}

@section Title{
    @Model.Header.Title
}

@section Styles{
    @if(Model.Category.LeagueId > 0)
    {
        <environment include="Development">
            <link rel="stylesheet" media="all" href="~/css/dev/pages/livescore/soccer/category/standing.chunk.css" asp-append-version="true" />
            <link rel="stylesheet" media="all" href="~/css/dev/pages/livescore/soccer/category/fixture.chunk.css" asp-append-version="true" />
        </environment>
        <environment exclude="Development">
            <link rel="stylesheet" media="all" href="~/css/pro/pages/livescore/soccer/category/standing.chunk.css" asp-append-version="true" />
            <link rel="stylesheet" media="all" href="~/css/pro/pages/livescore/soccer/category/fixture.chunk.css" asp-append-version="true" />
        </environment>
    }
    <link rel="stylesheet" media="all" href="~/minify/styles/news.min.css" asp-append-version="true">
}

@(await Component.InvokeAsync("Menu", new { CategorySlug = Model.Header.ActiveCategory, MenuItems = Model.MenuItems }))
<section class="main">
    <div class="base-container medium-container">
        @if (Model.Menus != null)
        {
             var subMenu = Model.GetSubMenu(Model.Slug);
            if (item3 > 0)
            {
                var menu = Model.GetMenuDetail(item3);
                var coMenu = Model.GetCoMenu(item3);
                <div class="menu-select single-select-menu show-on-mobile">
                    <a href="@Url.Action("Category", "Home", new { slug = Model.Slug + CategoryKey.Suffix })">@menu.MenuTitle</a>
                    <select class="select_ad"   onChange="window.location.href=this.value">
                        @foreach (var item in coMenu)
                        {

                            var selected = menu.PostId == item.PostId ? "selected" : "";
                            <!option class="@selected" @selected value="@getMenuLink(item)">@item.MenuTitle</!option>
                        }
                    </select>
                </div>
            }
            else if(subMenu.Count > 0)
            {
                <div class="sub-category show-on-mobile">
                    @foreach (var menu in subMenu)
                    {
                        var link = @getMenuLink(menu);
                        <h2 class="sub-item @(Model.Slug == menu.CateSlug ? "active" : "")"><a href="@link">@menu.MenuTitle</a></h2>
                    }
                </div>
            }
            <div class="group-sub-category show-on-pc">
                <div class="sub-category parent-sub">
                    <h1 class="heading-category count-wrap"><a href="@Url.Action("Category", "Home", new { slug = Model.Header.ActiveCategory + CategoryKey.Suffix })">@Model.HeadTitle</a></h1>
                    <div class="group-parent-sub">
                        @foreach (var menu in Model.GetSubMenu(item1))
                        {
                            <h2 class="sub-item @(item2 == menu.PostId ? "active" : "")"><a href="@getMenuLink(menu)">@menu.MenuTitle</a></h2>
                        }
                    </div>
                    <span class="button-dropdown-category"><i class="icon-button-dot"></i></span>
                    <div class="list-dropdown-category">
                    </div>
                </div>
                <div class="sub-category child-sub">
                    @foreach (var menu in Model.GetSubMenu(item2))
                    {
                        <h2 class="sub-item @item3 @(item3 == menu.PostId ? "active" : "")"><a href="@getMenuLink(menu)">@menu.MenuTitle</a></h2>
                    }
                </div>
            </div>
        }
    </div>
    <div class="container medium-container">
        <div class="block block-main block-category">
            <div id="category-grid" class="block__content">
                <div class="card-horizontal card-horizontal-highlight none-border-mobile">
                    <a href="@Url.Action("Single", "Post", new { slug = Model.Posts[0].Uri })" class="card-horizontal__image thumb thumb-56 hover-image">
                        <picture>
                            <source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/webp" class="img-res">
                            <source srcset="@Url.Content(Model.Posts[0].FeatureImage)" type="image/jpeg" class="img-res">
                            <img asp-append-version="true" data-original="@Url.Content(Model.Posts[0].FeatureImage)" src="@Url.Content(Model.Posts[0].FeatureImage)" alt="@Model.Posts[0].PostTitle" class="img-res img-block lazy">
                            <noscript>
                                <img asp-append-version="true" src="@Url.Content(Model.Posts[0].FeatureImage)" alt="@Model.Posts[0].PostTitle" class="img-res img-block lazy">
                            </noscript>
                        </picture>
                    </a>
                    <div class="card-horizontal__content">
                        <h2><a class="title" href="@Url.Action("Single", "Post", new { slug = Model.Posts[0].Uri })">@Model.Posts[0].PostTitle</a></h2>
                        <p class="description">@Html.Raw(Model.Posts[0].PostExcerpt)</p>
                        <p class="datetime">
                            <span>@Model.Posts[0].PostTime</span>
                            @if (Model.Posts[0].CommentCount > 0)
                            {
                                <a href="@Url.Action("Single", "Post", new { slug = Model.Posts[0].Uri })#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.Posts[0].CommentCount</i></a>
                            }
                        </p>
                    </div>
                </div>
                @{
                    int postIndex = 0;
                    foreach (var post in Model.Posts)
                    {
                        var classHeading = "";
                        postIndex++;
                        if (postIndex <= 1)
                        {
                            continue;
                        }
                        if(postIndex <= 3)
                        {
                            classHeading = "none-border-mobile";
                        }
                        <div class="card-horizontal @classHeading">
                            <input hidden class="page-1" value="@post.ID" />
                            <a href="@Url.Action("Single", "Post", new { slug = post.Uri })" class="card-horizontal__image thumb thumb-52 hover-image">
                                <picture>
                                    <source srcset="@Url.Content(post.FeatureImage)" type="image/webp" class="img-res">
                                    <source srcset="@Url.Content(post.FeatureImage)" type="image/jpeg" class="img-res">
                                    <img asp-append-version="true" data-original="@Url.Content(post.FeatureImage)" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" class="img-res img-block lazy">
                                    <noscript>
                                        <img asp-append-version="true" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" class="img-res img-block lazy">
                                    </noscript>
                                </picture>
                            </a>
                            <div class="card-horizontal__content">
                                @if(postIndex <= 3)
                                {
                                    <h2><a class="title" href="@Url.Action("Single", "Post", new { slug = post.Uri })">@post.PostTitle</a></h2>
                                }
                                else
                                {
                                    <a class="title" href="@Url.Action("Single", "Post", new { slug = post.Uri })">@post.PostTitle</a>
                                }
                                <p class="description">@Html.Raw(post.PostExcerpt)</p>
                                <p class="datetime">
                                    <span>@post.PostTime</span>
                                    @if (post.CommentCount > 0)
                                    {
                                        <a href="@Url.Action("Single", "Post", new { slug = post.Uri })#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>
                                    }
                                </p>
                            </div>
                        </div>
                        @if(postIndex == 3)
                        {
                            <div class="ads-insite show-pc banner-left"></div>
                            <div class="ads-insite show-mobile banner-mobile-top">
                            </div>
                        }
                        else if(postIndex == 8)
                        {
                            <div class="ads-insite show-mobile banner-mobile-center"></div>
                        }
                    }
                }
            </div>
            @if (Model.Posts.Count == Model.Paging.PageSize)
            {
                <div class="loading-page">
                    <div class="lds-ellipsis">
                        <div></div><div></div><div></div><div></div>
                    </div>
                </div>
            }
        </div>
        <div class="banner-scroll banner-mobile-bottom" style="display: none;"></div>
        <div class="block block-extension">
            @await Html.PartialAsync(ViewResources.SidebarPostView, new PostComponentViewModel { CateSlug = @Model.Header.ActiveCategory })
            <div id="fixture-category"></div>
            <div id="standing-category"></div>
            <div class="video-sidebar"></div>
        </div>
    </div>
</section>

@functions {
    private string getMenuLink(Menu menu)
    {
        var link = Url.Action("Category", "Home", new {slug =  menu.CateSlug + CategoryKey.Suffix});
        if(!String.IsNullOrEmpty(menu.CustomLink))
        {
            link = menu.CustomLink;
        }
        return link;
    }
}