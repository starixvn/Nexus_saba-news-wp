
@section Title{
    MembershipEvent
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/membership-event.min.css" asp-append-version="true">

}
@section Scripts{
    <script src="~/minify/js/membership-event.min.js" asp-append-version="true"></script>
}


<body>
    <section class="wrapper-header">
        <div class="header-menu">
            <div class="logo-event">
                <a href="@Url.Action("Index", "Home")">
                    <img src="~/images/event/logo.png" alt="saba-sports" asp-append-version="true">
                </a>
            </div>
            <div class="login">
                <a href="#" class="btn btn-event">Đăng Nhập</a>
            </div>
        </div>
        <div class="header-control">
            <ul>
                <li><a href="#" class="btn btn-event">Thể Lệ</a></li>
                <li><a href="#" class="btn btn-event active">Tham Gia</a></li>
            </ul>
        </div>
    </section>
</body>




