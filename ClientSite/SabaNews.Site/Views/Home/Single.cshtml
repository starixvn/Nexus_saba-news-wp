@using Wangkanai.Detection.Services;
@using Wangkanai.Detection.Models;
@using SabaNews.Models.ViewModel;

@inject IDetectionService DetectionService
@{ 
    bool isMobile = DetectionService.Device.Type == Device.Mobile;
    bool isTablet = DetectionService.Device.Type == Device.Tablet;
    bool isDesktop = DetectionService.Device.Type == Device.Desktop; 
}

@section Metadata {
    <meta name="description" content='@Model.SinglePost.PostExcerpt' />
    <meta property="og:description" content='@Model.SinglePost.PostExcerpt' />
    <meta property="og:title" content='@Model.SinglePost.PostTitle' />
    <meta property="og:image" content='@Model.SinglePost.FeatureImage' />
}

@section Title{
    @Model.SinglePost.PostTitle
}

@section Scripts{
	<script src="~/js/comment.js" asp-append-version="true"></script>
}
@section Styles{
    <link rel="stylesheet" href="~/minify/styles/detailnews.min.css" asp-append-version="true">
	<style>
		.clearfix {
			clear: both;
		}
		#comment {
			padding: 20px 0;
		}
		.comment-content-box {
			border: 1px solid #bdbdbd;
			border-radius: 3px;
			position: relative;
			padding: 10px 0 10px 0;
			background-color: #fff;
		}

		.comment form textarea {
			width: 100%;
			resize: none;
			font: 400 15px/150% arial;
			background: #fff;
			border: none;
			width: 100%;
			height: 58px;
			color: #666 !important;
			overflow: hidden;
			padding: 5px 37px 0 15px;
		}
		.ykien {
			margin-bottom:15px;
			font-size: 15px;
			line-height: 23px;
		}

		.ykien h3 {
			display: inline-block;
			font-weight: bold;
		}
		.note-text-count {
			font: 400 13px arial;
			color: #757575;
			background: #fff;
			padding: 10px 15px 0 15px;
			width: 100%;
			display: none;
		}

		.comment form {
			margin-bottom: 15px;
		}
		.comment form .add_comment, .comment form .add_sub_comment {
			color: #fff;
			padding: 10px 40px;
			background: #9F224E !important;
			float: right;
			border: none;
			margin-top: 20px;
			font-weight: bold;
			border-radius: 3px;
			
		}

		.comment form .add_comment:hover, .comment form .add_sub_comment:hover {
			cursor: pointer;
			background: #B52759;
		}

		.filter_comment {
			color: #ccc;
			padding-bottom: 10px;
			border-bottom: 1px solid #E0E0E0;
		}
		.filter_comment a {
			position: relative;
			font: 400 15px/17px arial;
			color: #222;
			margin-right: 20px;
			text-decoration: none;
		}
		.filter_comment a:after {
			content: '';
			width: 100%;
			height: 1px;
			background: transparent;
			position: absolute;
			bottom: -14px;
			left: 0;
		}
		.filter_comment a.active:after {
			background: #9f224e;
		}
		.filter_comment a.active {
			color: #9f224e !important;
			font-weight: 700;
		}
		.nickname {
			color: #04416D;
			padding-right: 5px;
			font-weight: bold;
		}

		.comment_item {
			margin-top: 20px;
		}

		.comment_item .block_like_web a {
			color: #757575;
			margin-right: 20px;
			text-decoration: none;
		}

		.count-reply {
			width: 100%;
			margin-top: 10px;
		}

		.count-reply a {
			color: #076DB6;
			font-size: 13px;
			padding-left: 20px;
			font-weight: 700;
			background: url(images/favicon/Reply.svg) no-repeat left center;
		}
		.comment_item a.link_thich .ic-like {
			width: 16px !important;
			height: 16px !important;
			background: url(images/favicon/Thumb-Up-Normal.svg) no-repeat 0 0 !important;
			display: inline-block;
			vertical-align: middle;
		}

		.comment_item a.link_thich:hover .ic-like {
			background: url(images/favicon/Thumb-Up-Active.svg) no-repeat 0 0 !important;
		}
		.comment_item a.link_thich.unlike .ic-like {
			width: 16px !important;
			height: 16px !important;
			background: url(images/favicon/Thumb-Up-Active.svg) no-repeat 0 0 !important;
			display: inline-block;
			vertical-align: middle;
		}
		.comment_item a.link_thich.unlike {
			color: #076DB6 !important;
		}

		.comment_item a.link_thich:hover .ic-like {
			background: url(images/favicon/Thumb-Up-Active.svg) no-repeat 0 0 !important;
		}
		.comment_item a.link_thich.unlike .ic-like {
			width: 16px !important;
			height: 16px !important;
			background: url(images/favicon/Thumb-Up-Active.svg) no-repeat 0 0 !important;
			display: inline-block;
			vertical-align: middle;
		}
		.sub_comment {
			padding: 0 0 0 56px;
			width: 100%;
			position: relative;
		}

		.pagination {
			float: right;
			display: inline-block;
		}

			.pagination a {
				color: black;
				float: left;
				padding: 8px 16px;
				text-decoration: none;
				transition: background-color .3s;
				border: 1px solid #ddd;
			}

				.pagination a.active {
					background-color: #4CAF50;
					color: white;
					border: 1px solid #4CAF50;
				}

				.pagination a:hover:not(.active) {
					background-color: #ddd;
				}
		.btn-page.type_page {
			-moz-appearance: none;
			-webkit-appearance: none;
			padding: 0;
			margin: 0 5px;
			text-align: center;
			font-size: 15px;
			font-weight: 700;
			color: #222;
			min-width: 40px !important;
			max-width: 99.99% !important;
			transition: width 0.25s;
			float: left;
			width: 20px;
			height: 40px;
			border-radius: 3px;
			border: 1px solid #757575;
		}
	</style>
}

<section class="main">
    <div class="container detail-container">
        <div class="main-social fixed-social">
            <ul class="social">
                <li class="item-social">
                    <a href=""
                       data-count="facebook" target="_blank"
                       rel="nofollow"
                       class="item intent facebook">
                        <i class="icon-social icon-detail_facebook"></i>
                    </a>
                </li>
                <li class="item-social">
                    <a href="#"
                       rel="nofollow"
                       class="item intent tele">
                        <i class="icon-social icon-link"></i>
                    </a>
                </li>
                <li class="item-social">
                    <a href="#" class="item intent">
                        <svg width="14" height="18" viewBox="0 0 14 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="svg-bookmark">
                            <path d="M1.01 2.00062V2C1.01 1.44575 1.4588 1 2 1H12C12.5477 1 13 1.45228 13 2V16.4835L7.39392 14.0809L7 13.912L6.60608 14.0809L1.00095 16.4831L1.01 2.00062Z" stroke="#999999" stroke-width="2" />
                        </svg>
                    </a>
                </li>
                <li class="item-social">
                    <a href="#"
                       class="item intent">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="svg-comment">
                            <path d="M16.991 1.8V1.80056L16.9987 15.5844L15.1071 13.6929L14.8142 13.4H14.4H1.8C1.36228 13.4 1 13.0377 1 12.6V1.8C1 1.36228 1.36228 1 1.8 1H16.2C16.6312 1 16.991 1.35575 16.991 1.8Z" stroke="#999999" stroke-width="2" />
                        </svg>
                    </a>
                </li>
                <li class="item-social">
                    <a href="#"
                       class="item intent">
                        <i class="icon-social icon-back"></i>
                    </a>
                </li>
            </ul>
        </div>
        <div class="block block-main">
            <div class="card-vertical card-vertical-highlight">
                <div class="single card-vertical__video">
                    @if (Convert.ToBoolean(ViewData["video"]))
                    {
                        <input type="hidden" name="iframe_value" value="@Model.SinglePost.PostContent" />
                        <picture>
                            <source srcset="@Url.Content(Model.SinglePost.FeatureImage)" type="image/webp" class="img-res">
                            <source srcset="@Url.Content(Model.SinglePost.FeatureImage)" type="image/jpeg" class="img-res">
                            <img loading="lazy" src="@Url.Content(Model.SinglePost.FeatureImage)" alt="@Model.SinglePost.PostTitle" class="img-res img-block">
                        </picture>
                        <div class="btn-play-video">
                            <span class="icon-play"></span>
                        </div>
                    }
                </div>
                <div class="single play_video"></div>
                <a class="card-vertical__title">@Model.SinglePost.PostTitle</a>
                <p class="card-vertical__datetime">@Model.SinglePost.PostTime</p>
            </div>
            @if (!Convert.ToBoolean(ViewData["video"]))
            {
                <div class="content">
                    @Html.Raw(Model.SinglePost.PostContent)
                </div>
            }

            <ul class="block-list">
                @foreach (var post in Model.RelatedPosts)
                {

                    <li class="list-item"><a href="@Url.Action("Single", "Home", new { slug = post.Slug })" class="item"><i class="icon-content icon-@Model.SinglePost.Type"></i> @post.PostTitle</a></li>
                }
            </ul>

            @{
                var absoluteLink = ViewData["BaseUrl"] + Url.Action("Single", "Home", new { slug = @Model.SinglePost.Slug });
            }
            @if (isMobile || isTablet)
            {
                <div class="share_button" style=""><button class="superwebshare_prompt"><span>Chia sẻ</span></button></div>
            }
            else
            {






                <div class="main-social">
                    <ul class="social left-social">
                        <li class="item-social">
                            <a href="#"
                               class="item intent">
                                <i class="icon-social icon-back"></i>
                            </a>
                        </li>
                        <li class="item-social">
                            <a href="#" class="item intent active">
                                <svg width="14" height="18" viewBox="0 0 14 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="svg-bookmark">
                                    <path d="M0.51 2.00031V2C0.51 1.17287 1.1794 0.5 2 0.5H12C12.8239 0.5 13.5 1.17614 13.5 2V17.2417L7.19696 14.5404L7 14.456L6.80304 14.5404L0.500474 17.2415L0.51 2.00031Z" fill="none" stroke="#999999" />
                                </svg>
                                Lưu Tin
                            </a>
                        </li>
                    </ul>
                    <ul class="social right-social">
                        <li class="item-social">Chia sẻ:</li>
                        <li class="item-social">
                            <a href="http://www.facebook.com/sharer/sharer.php?u=@absoluteLink"
                               data-count="facebook" target="_blank"
                               rel="nofollow"
                               class="item intent facebook">
                                <i class="icon-social icon-detail_facebook"></i>
                            </a>
                        </li>
                        <li class="item-social">
                            <a href="#"
                               rel="nofollow" class="item">
                                <i class="icon-social icon-email"></i>
                            </a>
                        </li>
                        <li class="item-social">
                            <a href="#"
                               rel="nofollow"
                               class="item intent tele">
                                <i class="icon-social icon-link"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            }

            <ul class="tag-post">
                @if (Model.SinglePost.Tags != null && Model.SinglePost.TagsSlug != null)
                {
                    var tags_slug = Model.SinglePost.TagsSlug.Split(',');
                    var tags = Model.SinglePost.Tags.Split(',');
                    @for (var i = 0; i < tags.Length; i++)
                    {
                        <li class="tag-item"><a href="@Url.Action("Tag", "Home", new { tagname = tags_slug[i].Trim() })" class="tag">@tags[i]</a></li>
                    }
                }
            </ul>
			<input name="postID" id="postID" type="hidden" value="@Model.SinglePost.ID" />
			<div class="comment" id="comment">
               
            </div>
            <h2 class="block__title title-care"><a>CÓ THỂ BẠN QUAN TÂM</a></h2>
            <div class="block__content">
                @foreach (var post in Model.RandomRelatedPosts)
                {
                    <div class="card-horizontal card-horizontal-highlight">
                        <a href="@Url.Action("Single", "Home", new { slug = post.Slug })" class="card-horizontal__image">
                            <picture>
                                <source srcset="@Url.Content(post.FeatureImage)" type="image/webp" class="img-res">
                                <source srcset="@Url.Content(post.FeatureImage)" type="image/jpeg" class="img-res">
                                <img loading="lazy" src="@Url.Content(post.FeatureImage)" alt="@post.PostTitle" class="img-res img-block">
                            </picture>
                        </a>
                        <div class="card-horizontal__content">
                            <a class="title" href="@Url.Action("Single", "Home", new { slug = post.Slug })">@post.PostTitle</a>
                            <p class="datetime">
								<span>@post.PostTime</span>
								@if (post.CommentCount > 0)
								{ 
									<a href="@Url.Action("Single", "Home", new { slug = post.Slug  })#comment" class="comment"><i class="icon-mode_comment"></i> <i class="number">@post.CommentCount</i></a>
								}
							</p>
                            <p class="description">@post.PostExcerpt</p>
                        </div>
                    </div>
                }
            </div>
        </div>
        @(await Component.InvokeAsync("Sidebar", new { postID = Model.SinglePost.ID }))
    </div>
</section>
<script>
	var data = {
		isLogin : true,
		postID : @Model.SinglePost.ID
	}
</script>

<script>
    var checkScroll = function () {
        var el = document.querySelector('.title-care');
        var main = document.querySelector('.fixed-social');
        if (el !== null) {
            var top_of_obj = el.offsetTop - 600;
            var top_of_window = window.scrollY;
            if (top_of_window > top_of_obj) {
                main.classList.add('active-nav')
            } else {
                main.classList.remove('active-nav')
            }
        }
    }
    window.addEventListener('scroll', function () { checkScroll() })
</script>