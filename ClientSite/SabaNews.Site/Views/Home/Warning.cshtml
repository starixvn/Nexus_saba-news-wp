@using SabaNews.Core.Constants;
@section Metadata {
	<meta name="description" content='@ViewData[Constants.ViewDataDescription]' />
	<meta property="og:description" content='@Model.Category.OgDescription' />
	<meta property="og:title" content='@Model.Category.OgTitle' />
	<meta property="og:image" content='@Model.Category.OgImage' />
}

@section Title{
	@ViewData[Constants.ViewDataTitle]
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}

<section class="main">
	<div class="container">
		<div class="block block-main">
			<h2 class="block__title"><a>Cảnh báo</a></h2>
			<div class="block__content">
				<div class="match-schedule">@Html.Raw(@Model.Post.PostContent)</div>
			</div>
		</div>
		@(await Component.InvokeAsync("Sidebar"))
	</div>
</section>