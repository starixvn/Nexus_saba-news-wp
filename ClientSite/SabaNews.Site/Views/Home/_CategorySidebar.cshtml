@using SabaNews.Core.Constants;
<div class="block__content">
    <h3 class="block__title"><a href="@Url.Action("Category", "Home", new {slug = ViewBag.Slug + CategoryKey.Suffix} )">Nhận định bóng đá</a></h3>
    @foreach (var post in Model)
    {
        string featureImg = post.FeatureImage;
        <div class="post card-horizontal card-horizontal-highlight">
            <a href="@Url.Action("Single", "Post", new { slug = post.Uri })" class="card-horizontal__image hover-image">
                <picture>
                    <source srcset="@Url.Content(featureImg)" type="image/webp" class="img-res">
                    <source srcset="@Url.Content(featureImg)" type="image/jpeg" class="img-res">
                    <img data-original="@Url.Content(featureImg)" src="@Url.Content(featureImg)" alt="@post.PostTitle" class="img-res img-block lazy">
                    <noscript>
                        <img src="@Url.Content(featureImg)" alt="@post.PostTitle" class="img-res img-block lazy">
                    </noscript>
                </picture>
            </a>
            <div class="card-horizontal__content">
                <h3><a class="title" href="@Url.Action("Single", "Post", new { slug = post.Uri })">@post.PostTitle</a></h3>
            </div>
        </div>
    }
</div>