@using SabaNews.Core.Constants;
@section Metadata {
	<meta name="robots" content="noindex,nofollow">
}

@section Title{
	THÔNG BÁO THAY ĐỔI TÊN MIỀN WEBSITE
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}
@(await Component.InvokeAsync("Menu"))

<section class="main">
	<div class="container">
		<div class="block block-main">
			<h2 class="block__title">
				<a>THÔNG BÁO THAY ĐỔI TÊN MIỀN WEBSITE</a>
			</h2>
			<div class="block__content">
				<div class="warning content">
					<h6><em>Kính gửi Quý khách hàng,</em></h6>
					<p>Trước hết, chúng tôi xin chân thành cảm ơn Quý khách hàng đã đồng hành cùng <strong>SABA Sports</strong> trong suốt thời gian qua.</p>
					<p>Chúng tôi xin thông báo về việc thay đổi tên miền website như sau:</p>
					<p>Nhằm mục đích giúp Quý khách hàng dễ dàng hơn trong việc tìm kiếm và ghi nhớ tên miền, từ ngày 12 tháng 12 năm 2021, SABA Sports (phiên bản Tiếng Việt) chính thức thay đổi tên miền website từ <strong>vn.sabasports.com</strong> sang <strong>saba.vn</strong>. Do đó, Quý khách hàng vui lòng cập nhật lại địa chỉ truy cập website mới của chúng tôi để có thể tiếp tục theo dõi các tin tức thể thao và nhận định mới nhất. </p>

					<p>Các bài viết trên <strong>vn.sabasports.com</strong> vẫn sẽ được giữ nguyên khi đổi sang tên miền mới <strong>saba.vn</strong>.</p>
					<p>Chúng tôi hy vọng sẽ tiếp tục nhận được sự tin tưởng, ủng hộ và đồng hành của Quý khách trong thời gian tới.</p>
					<p>Trân trọng.</p>
				</div>
			</div>
		</div>
		@(await Component.InvokeAsync("Sidebar"))
	</div>
	<div class="ads ads-left"><a href="@Url.Action("ChangeDomain", "Home")"><img loading="lazy" src="~/images/ads.png" asp-append-version="true" class="img-res"></a></div>
</section>