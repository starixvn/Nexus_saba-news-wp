@using Microsoft.Extensions.Configuration;
@inject IConfiguration configuration

@{
    var baseUrl = configuration.GetValue<string>("BaseUrl");
    var link = Context.Request.Path.ToString().Substring(1);
    var canonicalLink = @baseUrl + @link;
}
@section Title{
	@ViewResources.NotFoundPostMsg
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/notfound.min.css" asp-append-version="true">
}

@section Metadata {
    <link rel="canonical" href="@canonicalLink" >
}

@(await Component.InvokeAsync("Menu"))
<section class="main">
    <div class="notfound-container">
        <div class="img-notfound">
            <img src="~/images/404.png" alt="not-found" class="img-res" width="277" height="224" />
        </div>
        <div class="text-notfound">
            Trang bạn đang tìm không tồn tại, hãy tìm kiếm kết quả hoặc trở về trang chủ!
        </div>
        <form action="" method="post" class="form-notfound">
            <input type="text" placeholder="ĐƯỢC CẢI TIẾN BỞI Google">
            <button class="search-button">
                <i class="icon-search"></i>
            </button>
        </form>
        <div class="back-to-home">
            <a href="#">Quay lại trang chủ</a>
        </div>
        @await Html.PartialAsync(ViewResources.RelatedPostView, new PostComponentViewModel { PostId =
            0 })
    </div>
    @* <div class="container medium-container">
        <div class="block block-main">
            <h1 class="block__title title-new-page" style="margin-bottom: 1rem;"><a>404 </a></h1>
            <div class="block__content">
                <h4>@ViewResources.NotFoundPostMsg</h4>
            </div>
        </div>
        @await Html.PartialAsync(ViewResources.RelatedPostView, new PostComponentViewModel { PostId =
            0 })
    </div> *@
</section>