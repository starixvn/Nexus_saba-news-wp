@using SabaNews.Core.Constants;
@using static SabaNews.Site.Extensions.DeviceHelper;
@{
    bool isMobile = IsMobile(Context.Request.Headers["User-Agent"].ToString());
}

@section Metadata {
    <meta name="robots" content="noarchive">
    <meta name="description" content='@Model.Header.Description' />
    <meta property="og:description" content='@Model.Category.OgDescription' />
    <meta property="og:title" content='@Model.Category.OgTitle' />
    <meta property="og:image" content='@Model.Category.OgImage' />
    <meta name="google-site-verification" content="-nfg3Xmoj-uNWx8LoRDPWPKXW56elXGwsXTMTnes3xk" />
    <meta name='dmca-site-verification' content='L21LWUJKSGlUVmFvaFhNYzBBVXc1dz090' />
    <link rel="canonical" href="@Model.Url" />
    <link rel="alternate" href="@Model.Url" hreflang="vi-vn" />
    <link rel="alternate" type="application/rss+xml" href="@Model.RSSUrl" title='@Model.Header.Title' />
}

@section Title {
    @Model.Header.Title
}

@section Styles{
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/livescore/soccer/homepage/fixture.chunk.css"
        asp-append-version="true" />
        <link rel="stylesheet" href="~/css/dev/pages/livescore/soccer/homepage/standing.chunk.css"
        asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/livescore/soccer/homepage/fixture.chunk.css"
        asp-append-version="true" />
        <link rel="stylesheet" href="~/css/pro/pages/livescore/soccer/homepage/standing.chunk.css"
        asp-append-version="true" />
    </environment>
    <link rel="stylesheet" href="~/minify/styles/home.min.css" asp-append-version="true">
}

@section Scripts {
    <script src="~/js/livescore/livescore.js" asp-append-version="true"></script>
    <environment include="Development">
        <script src="~/js/dev/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/homepage/fixture.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/homepage/standing.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/pages/livescore/soccer/homepage/fixture.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/pages/livescore/soccer/homepage/standing.chunk.js" asp-append-version="true"></script>
    </environment>
    <script src="~/minify/js/home.min.js" asp-append-version="true"></script>
}

@(await Component.InvokeAsync("Menu", new { page = "home-page", CategorySlug = "/" }))
<section class="main">
    <div class="container">
        <div class="block">
            <div class="block-columns">
                <div class="columns columns-left">
                    <div class="block-news-hot">
                        <ul class="card-hightlight-text">
                            @{
                                int newPostIndex = 0;
                                foreach (var item in Model.NewPosts)
                                {
                                    newPostIndex++;
                                    if (newPostIndex <= 4)
                                    {
                                        continue;
                                    }
                                    <li><a href="@Url.Action("Single", "Post", new { slug =  item.Slug })">@item.PostTitle</a>
                                    </li>
                                }
                            }
                        </ul>
                        <div class="box-vertical box-vertical-hightlight">
                            @{
                                var firstPost = Model.NewPosts[0];
                                string firstImgUrl = firstPost.FeatureImage;
                                <a href="@Url.Action("Single", "Post", new { slug =  firstPost.Slug})" class="box-vertical-image hover-image">
                                    <img src="@Url.Content(firstImgUrl)" class="img-res" />
                                </a>
                                <div class="box-vertical-content">
                                    <h1><a href="#">@firstPost.PostTitle</a></h1>
                                    <p>@firstPost.PostExcerpt</p>
                                </div>
                            }
                        </div>
                        <div class="block-news-hot-child">
                            @{
                                newPostIndex = 0;
                                foreach (var item in Model.NewPosts)
                                {
                                    newPostIndex++;
                                    if (newPostIndex < 5 && newPostIndex > 1)
                                    {
                                        <div class="box-vertical">
                                            <a href="@Url.Action("Single", "Post", new { slug =  item.Slug })" class="box-vertical-image hover-image">
                                                <img src="@Url.Content(item.FeatureImage)" class="img-res" />
                                            </a>
                                            <div class="box-vertical-content">
                                                <h3>
                                                    <a href="#">@item.PostTitle</a>
                                                </h3>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                    <div class="ads-insite">
                        <a href="#"><img src="~/images/ads-1.png" class="img-res show-pc" /></a>
                        <a href="#"><img src="~/images/mobile-ads.png" class="img-res show-mobile" /></a>
                    </div>
                </div>
                <div class="columns columns-right">
                    <div id="fixture-homepage"></div>
                    <div id="standing-homepage"></div>
                </div>
            </div>
        </div>
        <div class="block block-guess">
            <h2 class="block__title">
                <a href="@Url.Action("Category", "Home", new { slug1 = Constants.GuessSlug })">@ViewResources.Guess
                    <span class="marked-icon"></span></a>
            </h2>
            <div class="block__content">
                <div class="swiper-guess">
                    <div class="swiper-wrapper scroll-snap">
                        @foreach (var post in Model.GuessPosts)
                        {
                            <div class="box-vertical swiper-slide scroll-snap-items">
                                <a href="@Url.Action("Single", "Post", new { slug = post.Slug  })"
                                    class="box-vertical-image hover-image">
                                    <img src="@Url.Content(post.FeatureImage)" class="img-res" />
                                </a>
                                <div class="box-vertical-content">
                                    <h2><a
                                            href="@Url.Action("Single", "Post", new { slug = post.Slug  })">@post.PostTitle</a>
                                    </h2>
                                </div>
                            </div>
                        }
                        @{
                            if(isMobile){
                                <a>Xem Them</a>
                            }
                        }
                    </div>
                </div>
                <div class="swiper-button swiper-button-next"><span class="icon-slide icon-chevron-right"></span></div>
                <div class="swiper-button swiper-button-prev"><span class="icon-slide icon-chevron-left"></span></div>
                <div class="swiper-pagination"></div>
            </div>
        </div>
        <div class="block block-last-page">
            <div class="block-columns">
                <div class="columns columns-left">
                    <div class="block block-video">
                        <h2 class="block__title">
                            <a href="@Url.Action("Video", "Home")" class="none-bg">@ViewResources.Video</a>
                        </h2>
                        <div class="group-video">
                            <div class="box-vertical">
                                @{
                                    var numVideos = 0;
                                    foreach (var post in Model.VideoPosts)
                                    {
                                        numVideos++;
                                        var display = numVideos == 1 ? "block" : "none";
                                        <div style="display:@display;" class="box-play-home-video" id="slide-@post.ID">
                                            <input type="hidden" name="iframe_value" value="@post.PostContent" />
                                            <div class="img-item">
                                                <a class="box-vertical-image hover-image">
                                                    <img src="@Url.Content(post.FeatureImage)" class="img-res" />
                                                    <div class="btn-play-video" post-id="@post.ID">
                                                        <span class="icon-play"></span>
                                                    </div>
                                                </a>
                                            </div>
                                            <div style="display:none;" class="play_video"></div>
                                            <div class="box-vertical-content">
                                                <h4>
                                                    <a href="@Url.Action("Single", "Post", new { slug = post.Slug })">@post.PostTitle</a>
                                                </h4>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="block-child-video scroll-snap slide-video">
                                @foreach (var post in Model.VideoPosts)
                                {
                                    <div class="box-horizontal scroll-snap-items card-item">
                                        <a href="javascript:;" data-id="@post.ID" class="image-home-slider box-horizontal-image hover-none-16-9">
                                            <img src="@Url.Content(post.FeatureImage)" class="img-res" />
                                        </a>
                                        <div class="box-horizontal-content">
                                            <h5>
                                                <a
                                                    href="@Url.Action("Single", "Post", new { slug = post.Slug })">@post.PostTitle</a>
                                            </h5>
                                        </div>
                                    </div>
                                }
                                @{
                                    if(isMobile){
                                        <a>Xem Them</a>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    <div class="block block-event block-columns-border">
                        <div class="block-event-item item-league">
                            <h2 class="block__title">
                                <a href="@Model.FootballNewCategory[0].Url" class="none-bg">@Model.FootballNewCategory[0].Category</a>
                            </h2>
                            <div class="box-vertical">
                                <a href="@Url.Action("Single", "Post", new { slug =  Model.LeaguePosts[0][0].Slug })" class="box-vertical-image hover-image">
                                    <img src="@Url.Content(Model.LeaguePosts[0][0].FeatureImage)" class="img-res" />
                                </a>
                                <div class="box-vertical-content">
                                    <h2><a href="@Url.Action("Single", "Post", new { slug =  Model.LeaguePosts[0][0].Slug })">@Model.LeaguePosts[0][0].PostTitle</a></h2>
                                    <ul class="list-event-title">
                                        @{
                                            var LeaguePostsIndex = 0;
                                            foreach(var post in Model.LeaguePosts[0]){
                                                LeaguePostsIndex++;
                                                if(LeaguePostsIndex <= 1){
                                                    continue;
                                                }
                                                <li><a href="@Url.Action("Single", "Post", new { slug =  post.Slug })">@post.PostTitle</a></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="block-event-item item-league">
                            <h2 class="block__title">
                                <a href="@Model.FootballNewCategory[1].Url" class="none-bg">@Model.FootballNewCategory[1].Category</a>
                            </h2>
                            <div class="box-vertical">
                                <a href="@Url.Action("Single", "Post", new { slug =  Model.LeaguePosts[1][0].Slug })" class="box-vertical-image hover-image">
                                    <img src="@Url.Content(Model.LeaguePosts[1][0].FeatureImage)" class="img-res" />
                                </a>
                                <div class="box-vertical-content">
                                    <h2><a href="@Url.Action("Single", "Post", new { slug =  Model.LeaguePosts[1][0].Slug })">@Model.LeaguePosts[1][0].PostTitle</a></h2>
                                    <ul class="list-event-title">
                                        @{
                                            var LeaguePostsCenterIndex = 0;
                                            foreach(var post in Model.LeaguePosts[1]){
                                                LeaguePostsCenterIndex++;
                                                if(LeaguePostsCenterIndex <= 1){
                                                    continue;
                                                }
                                                <li><a href="@Url.Action("Single", "Post", new { slug =  post.Slug })">@post.PostTitle</a></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="block-event-item item-league">
                            <h2 class="block__title">
                                <a href="@Model.FootballNewCategory[2].Url" class="none-bg">@Model.FootballNewCategory[2].Category</a>
                            </h2>
                            <div class="box-vertical">
                                <a href="@Url.Action("Single", "Post", new { slug =  Model.LeaguePosts[2][0].Slug })" class="box-vertical-image hover-image">
                                    <img src="@Url.Content(Model.LeaguePosts[2][0].FeatureImage)" class="img-res" />
                                </a>
                                <div class="box-vertical-content">
                                    <h2><a href="@Url.Action("Single", "Post", new { slug =  Model.LeaguePosts[2][0].Slug })">@Model.LeaguePosts[2][0].PostTitle</a></h2>
                                    <ul class="list-event-title">
                                        @{
                                            var LeaguePostsLeftIndex = 0;
                                            foreach(var post in Model.LeaguePosts[2]){
                                                LeaguePostsLeftIndex++;
                                                if(LeaguePostsLeftIndex <= 1){
                                                    continue;
                                                }
                                                <li><a href="@Url.Action("Single", "Post", new { slug =  post.Slug })">@post.PostTitle</a></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="block block-behind">
                        <h2 class="block__title">
                            <a href="@Url.Action("Category", "Home", new { slug1 = Constants.BackstageSlug   })" class="none-bg">@ViewResources.Backstage</a>
                        </h2>
                        <div class="block-columns-border">
                            <div class="block-event-item">
                                <div class="box-vertical">
                                    <a href="@Url.Action("Single", "Post", new { slug =  Model.BackstagePosts[0].Slug })" class="box-vertical-image hover-image">
                                        <img src="@Url.Content(Model.BackstagePosts[0].FeatureImage)" class="img-res" />
                                    </a>
                                    <div class="box-vertical-content">
                                        <h4><a href="@Url.Action("Single", "Post", new { slug =  Model.BackstagePosts[0].Slug })">@Model.BackstagePosts[0].PostTitle</a></h4>
                                        <p>@Model.BackstagePosts[0].PostExcerpt</p>
                                    </div>
                                </div>
                            </div>
                            <div class="block-event-item">
                                @{
                                    var BackstagePostsPostIndex = 0;
                                    foreach (var post in Model.BackstagePosts)
                                    {
                                        BackstagePostsPostIndex++;
                                        if(BackstagePostsPostIndex <= 1){
                                            continue;
                                        }
                                        <div class="box-horizontal">
                                            <a href="@Url.Action("Single", "Post", new { slug =  post.Slug })" class="box-horizontal-image hover-none-16-9">
                                                <img src="@Url.Content(post.FeatureImage)" class="img-res" />
                                            </a>
                                            <div class="box-horizontal-content">
                                                <h5>
                                                    <a href="@Url.Action("Single", "Post", new { slug =  post.Slug })">@post.PostTitle</a>
                                                </h5>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="block block-event block-columns-border none-bottom-spacing">
                        <div class="block-event-item item-league">
                            <h2 class="block__title">
                                <a href="@Url.Action("Category", "Home", new { slug1 = Constants.TransferSlug  })" class="none-bg">@ViewResources.Transfer</a>
                            </h2>
                            <div class="box-vertical">
                                <a href="@Url.Action("Single", "Post", new { slug =  Model.TransferPosts[0].Slug })" class="box-vertical-image hover-image">
                                    <img src="@Url.Content(Model.TransferPosts[0].FeatureImage)" class="img-res" />
                                </a>
                                <div class="box-vertical-content">
                                    <h2><a href="@Url.Action("Single", "Post", new { slug =  Model.TransferPosts[0].Slug })">@Model.TransferPosts[0].PostTitle</a></h2>
                                    <ul class="list-event-title">
                                        @{
                                            var TransferPostIndex = 0;
                                            foreach (var post in Model.TransferPosts)
                                            {
                                                TransferPostIndex++;
                                                if (TransferPostIndex <= 1)
                                                {
                                                    continue;
                                                }
                                                <li><a href="@Url.Action("Single", "Post", new { slug =  post.Slug })">@post.PostTitle</a></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="block-event-item item-league">
                            <h2 class="block__title">
                                <a href="@Url.Action("Category", "Home", new { slug1 = Constants.OtherPostSlug  })" class="none-bg">@ViewResources.OtherPosts</a>
                            </h2>
                            <div class="box-vertical">
                                <a href="@Url.Action("Single", "Post", new { slug =  Model.OtherPosts[0].Slug })" class="box-vertical-image hover-image">
                                    <img src="@Url.Content(Model.OtherPosts[0].FeatureImage)" class="img-res" />
                                </a>
                                <div class="box-vertical-content">
                                    <h2><a href="@Url.Action("Single", "Post", new { slug =  Model.OtherPosts[0].Slug })">@Model.OtherPosts[0].PostTitle</a></h2>
                                    <ul class="list-event-title">
                                        @{
                                            var OtherPostIndex = 0;
                                            foreach (var post in Model.OtherPosts)
                                            {
                                                OtherPostIndex++;
                                                if (OtherPostIndex <= 1)
                                                {
                                                    continue;
                                                }
                                                <li><a href="@Url.Action("Single", "Post", new { slug =  post.Slug })">@post.PostTitle</a></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="columns columns-right">
                    <div class="ads-insite">
                        <a href="#"><img src="~/images/300x600.png" class="img-res img-res show-pc" /></a>
                        <a href="#"><img src="~/images/mobile-ads.png" class="img-res show-mobile" /></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* @await Html.PartialAsync(ViewResources.SidebarBannerView) *@
</section>

