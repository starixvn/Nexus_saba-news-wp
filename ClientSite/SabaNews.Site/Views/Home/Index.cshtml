@using SabaNews.Core.Constants;
@using Wangkanai.Detection.Services;
@using Wangkanai.Detection.Models;
@inject IDetectionService DetectionService
@{ bool isMobile = DetectionService.Device.Type == Device.Mobile;
	bool isTablet = DetectionService.Device.Type == Device.Tablet;
	bool isDesktop = DetectionService.Device.Type == Device.Desktop; }

@section Metadata {
	<meta name="robots" content="noarchive">
	<meta name="description" content='@Model.Header.Description' />
	<meta property="og:description" content='@Model.Category.OgDescription' />
	<meta property="og:title" content='@Model.Category.OgTitle' />
	<meta property="og:image" content='@Model.Category.OgImage' />
	<meta name="google-site-verification" content="qclhhfdvNuHCkvjeP9cAwDohzBQhSMNCvdwA2ytnjo0" />
	<meta name='dmca-site-verification' content='eEV4ejk3T21jaUplMkdrUlQ2cXB3Z3M2eW96MFVjUHZ1V1NjVm80VHREMD01' />
	<link rel="canonical" href="@Model.Url" />
	<link rel="alternate" href="@Model.Url" hreflang="vi-vn" />
	<link rel="alternate" type="application/rss+xml" href="@Model.RSSUrl" title='@Model.Header.Title' />
}

@section Title {
	@Model.Header.Title.
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/home.min.css" asp-append-version="true">
}

@(await Component.InvokeAsync("Menu", new { page = "home-page" }))
<section class="main">
	<div class="colums-main">
		<div class="banner"><img loading="lazy" src="~/images/banner.jpg"></div>
		@if (isMobile || isTablet)
		{
			<div class="banner-euro-mobile">
				<a href="@Url.Action("Tag", "Home", new { tagname =  Constants.OlympicTokyoTag })"><img src="~/images/GDN_375x200.png" /></a>
			</div>}
		<div class="block block-hot-news">
			<div class="container">
				<h2 class="block__title"><a href="@Url.Action("Category", "Home")">@ViewResources.RecentsPost</a></h2>
				<div class="block__content">
					<custom-image>
					</custom-image>
					<div class="card-vertical card-vertical-highlight">
						<a href="@Url.Action("Single", "Post", new { slug =  Model.NewPosts[0].Slug})" class="card-vertical__image">
							@{ short imgSize = isMobile || isTablet ? ImageWidth.Width500 : ImageWidth.Width768;
								string firstImgUrl = Model.NewPosts[0].GetImageBySize(imgSize);

								<picture>
									<source srcset="@Url.Content(firstImgUrl)" type="image/webp" class="img-res">
									<source srcset="@Url.Content(firstImgUrl)" type="image/jpeg" class="img-res">
									<img asp-append-version="true" loading="lazy" src="@Url.Content(firstImgUrl)" alt="@Model.NewPosts[0].PostTitle" class="img-res img-block">
								</picture> }
						</a>
						<a href="@Url.Action("Single", "Post", new { slug =  Model.NewPosts[0].Slug })" class="card-vertical__title">@Model.NewPosts[0].PostTitle</a>
						<p class="card-vertical__description text-description">
							@Model.NewPosts[0].PostExcerpt
							@if (Model.NewPosts[0].CommentCount > 0)
							{
								<a href="@Url.Action("Single", "Post", new { slug =  Model.NewPosts[0].Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.NewPosts[0].CommentCount</i></a>}
						</p>
						@*<p class="card-vertical__datetime">
								@if (Model.NewPosts[0].CommentCount > 0)
								{
								<a href="@Url.Action("Single", "Post", new { slug =  Model.NewPosts[0].Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.NewPosts[0].CommentCount</i></a>
								}
							</p>*@
					</div>
					<div class="card-horizontal-section">
						@for (int i = 1; i < Model.NewPosts.Length; i++)
						{
							<div class="card-title-wrapper card-item-@i">
								<a class="title" href="@Url.Action("Single", "Post", new { slug =  Model.NewPosts[i].Slug })">@Model.NewPosts[i].PostTitle</a>
								<a href="@Url.Action("Single", "Post", new { slug =  Model.NewPosts[i].Slug })" class="card-horizontal__image">
									@{ string featuredImg = Model.NewPosts[i].GetImageBySize(ImageWidth.Width300);

										<picture>
											<source srcset="@Url.Content(featuredImg)" type="image/webp" class="img-res">
											<source srcset="@Url.Content(featuredImg)" type="image/jpeg" class="img-res">
											<img loading="lazy" src="@Url.Content(featuredImg)" alt="@Model.NewPosts[i].PostTitle" class="img-res img-block">
										</picture> }
								</a>
								<div class="sub-content">
									<p class="description">
										@Model.NewPosts[i].PostExcerpt
										@if (Model.NewPosts[i].CommentCount > 0)
										{
											<a href="@Url.Action("Single", "Post", new { slug =  Model.NewPosts[i].Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.NewPosts[i].CommentCount</i></a>}
									</p>
									@*<p class="datetime">
											@if (Model.NewPosts[i].CommentCount > 0)
												{
											<a href="@Url.Action("Single", "Post", new { slug =  Model.NewPosts[i].Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.NewPosts[i].CommentCount</i></a>
												}
										</p>*@
								</div>
							</div>}
					</div>
				</div>
			</div>
		</div>
		<div class="banner-mobile"><img loading="lazy" src="~/images/banner-mobile.jpg"></div>
		<div class="block block-video">
			<div class="container">
				<h2 class="block__title"><a href="@Url.Action("Video", "Home")">@ViewResources.Video</a></h2>
				<div class="block__content flex-video">
					<div class="swiper-video">
						<div class="swiper-container">
							<div class="swiper-wrapper">
								@foreach (var post in Model.VideoPosts)
								{
									<div class="swiper-slide" id="slide-@post.ID">
										<input type="hidden" name="iframe_value" value="@post.PostContent" />
										<div class="img-item">
											@{ string videoImg = post.GetImageBySize(isDesktop ? ImageWidth.Width768 : ImageWidth.Width500);
												<picture>
													<source srcset="@Url.Content(videoImg)" type="image/webp">
													<source srcset="@Url.Content(videoImg)" type="image/jpeg">
													<img loading="lazy" src="@Url.Content(videoImg)" alt="@post.PostTitle">
												</picture> }

											<div class="btn-play-video">
												<span class="icon-play"></span>
											</div>
										</div>
										<div class="play_video"></div>
										<div class="content-box">
											<h3 class="title-box"><a href="@Url.Action("Single", "Post", new { slug = post.Slug })" class="heading">@post.PostTitle</a></h3>
										</div>
									</div>}
							</div>
							<div class="swiper-button swiper-button-next"><span class="icon-slide icon-chevron-right"></span></div>
							<div class="swiper-button swiper-button-prev"><span class="icon-slide icon-chevron-left"></span></div>
							<div class="swiper-pagination"></div>
						</div>
					</div>
					<div class="slide-video">
						@foreach (var post in Model.VideoPosts)
						{
							<div class="card-horizontal card-item">
								<a href="javascript:;" data-id="@post.ID" class="image-slider card-horizontal__image">
									@{ string videoDesktopImg = post.GetImageBySize(ImageWidth.Width300);

										<picture>
											<source srcset="@Url.Content(videoDesktopImg)" type="image/webp" class="img-res">
											<source srcset="@Url.Content(videoDesktopImg)" type="image/jpeg" class="img-res">
											<img loading="lazy" src="@Url.Content(videoDesktopImg)" alt="@post.PostTitle" class="img-res img-block">
										</picture> }
								</a>
								<div class="card-horizontal__content">
									<p class="datetime">
										<a href="@Url.Action("Single", "Post", new { slug = post.Slug })" data-id="@post.ID" class="title">
											@post.PostTitle
										</a>
										@if (post.CommentCount > 0)
										{
											<a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
									</p>
								</div>
							</div>}
					</div>
				</div>
			</div>
		</div>

		<div class="block block-soccer">
			<div class="container">
				<h2 class="block__title"><a href="@Url.Action("Category", "Home", new { slug = Constants.FootballSlug })">@ViewResources.Football</a></h2>
				<div class="block__content">
					@foreach (var post in Model.FootballPosts)
					{
						<div class="card-vertical">
							<a href="@Url.Action("Single", "Post", new { slug = post.Slug })" class="card-vertical__image">
								@{ string footballImg = post.GetImageBySize(ImageWidth.Width300);
									<picture>
										<source srcset="@Url.Content(footballImg)" type="image/webp" class="img-res">
										<source srcset="@Url.Content(footballImg)" type="image/jpeg" class="img-res">
										<img loading="lazy" src="@Url.Content(footballImg)" alt="@post.PostTitle" class="img-res img-block">
									</picture> }
							</a>
							<p class="card-vertical__datetime">
								<a href="@Url.Action("Single", "Post", new { slug = post.Slug  })" class="card-vertical__title">@post.PostTitle</a>
								@if (post.CommentCount > 0)
								{
									<a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
							</p>
						</div>}
				</div>
			</div>
		</div>

		<div class="block block-guess">
			<div class="container">
				<h2 class="block__title"><a href="@Url.Action("Category", "Home", new { slug = Constants.GuessSlug })">@ViewResources.Guess</a><span class="marked-icon"></span></h2>
				<div class="block__content">
					@foreach (var post in Model.GuessPosts)
					{
						<div class="card-vertical">
							<a href="@Url.Action("Single", "Post", new { slug = post.Slug  })" class="card-vertical__image">
								@{ short imgGuessSize = isMobile ? ImageWidth.Width300 : ImageWidth.Width500;
									string guessImgUrl = post.GetImageBySize(imgGuessSize);

									<picture>
										<source srcset="@Url.Content(guessImgUrl)" type="image/webp" class="img-res">
										<source srcset="@Url.Content(guessImgUrl)" type="image/jpeg" class="img-res">
										<img loading="lazy" src="@Url.Content(guessImgUrl)" alt="@post.PostTitle" class="img-res img-block">
									</picture> }
							</a>
							<div class="group group-mobile">
								<p class="card-vertical__datetime">
									<a href="@Url.Action("Single", "Post", new { slug = post.Slug  })" class="card-vertical__title">@post.PostTitle</a>
									@if (post.CommentCount > 0)
									{
										<a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
								</p>
							</div>
						</div>}
				</div>
			</div>
		</div>

		<div class="group-blocks group-change-column">
			<div class="container">
				<div class="block block-behind">
					<h2 class="block__title"><a href="@Url.Action("Category", "Home", new { slug = Constants.BackstageSlug })">@ViewResources.Backstage</a></h2>
					<div class="block__content">
						<div class="card-horizontal card-horizontal-highlight card-item-1">
							<a href="@Url.Action("Single", "Post", new { slug = Model.BackstagePosts[0].Slug  })" class="card-horizontal__image">
								@{ short backstageSize = ImageWidth.Width300;
									if (isMobile)
									{
										backstageSize = ImageWidth.Width500;
									}

									if (isDesktop)
									{
										backstageSize = ImageWidth.Width768;
									}
									string backstageImg = Model.BackstagePosts[0].GetImageBySize(backstageSize);

									<picture>
										<source srcset="@Url.Content(backstageImg)" type="image/webp" class="img-res">
										<source srcset="@Url.Content(backstageImg)" type="image/jpeg" class="img-res">
										<img loading="lazy" src="@Url.Content(backstageImg)" alt="@Model.BackstagePosts[0].PostTitle" class="img-res img-block">
									</picture> }
							</a>
							<div class="card-horizontal__content">
								<a class="title" href="@Url.Action("Single", "Post", new { slug = Model.BackstagePosts[0].Slug  })">@Model.BackstagePosts[0].PostTitle</a>
								<p class="description">
									@Model.BackstagePosts[0].PostExcerpt
									@if (Model.BackstagePosts[0].CommentCount > 0)
									{
										<a href="@Url.Action("Single", "Post", new { slug =  Model.BackstagePosts[0].Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.BackstagePosts[0].CommentCount</i></a>}
								</p>
								@*<p class="datetime">
										@if (Model.BackstagePosts[0].CommentCount > 0)
										{
										<a href="@Url.Action("Single", "Post", new { slug =  Model.BackstagePosts[0].Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.BackstagePosts[0].CommentCount</i></a>
										}
									</p>*@
							</div>
						</div>
						@for (int i = 1; i < Model.BackstagePosts.Length; i++)
						{
							<div class="card-vertical card-vertical-highlight card-item-@(i+1)">
								<a href="@Url.Action("Single", "Post", new { slug = Model.BackstagePosts[i].Slug  })" class="card-vertical__image">
									@{ backstageSize = ImageWidth.Width300;
										backstageImg = Model.BackstagePosts[i].GetImageBySize(backstageSize);

										<picture>
											<source srcset="@Url.Content(backstageImg)" type="image/webp" class="img-res">
											<source srcset="@Url.Content(backstageImg)" type="image/jpeg" class="img-res">
											<img loading="lazy" src="@Url.Content(backstageImg)" alt="@Model.BackstagePosts[i].PostTitle" class="img-res img-block">
										</picture> }
								</a>
								<p class="card-vertical__datetime">
									<a class="card-vertical__title" href="@Url.Action("Single", "Post", new { slug = Model.BackstagePosts[i].Slug  })">@Model.BackstagePosts[i].PostTitle</a>
									@if (Model.BackstagePosts[i].CommentCount > 0)
									{
										<a href="@Url.Action("Single", "Post", new { slug =  Model.BackstagePosts[i].Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@Model.BackstagePosts[i].CommentCount</i></a>}
								</p>
							</div>}
					</div>
				</div>
				<div class="block block-transfer">
					<h2 class="block__title">
						<a href="@Url.Action("Category", "Home", new { slug = Constants.TransferSlug })">@ViewResources.Transfer</a>
					</h2>
					<div class="block__content">
						@foreach (var post in Model.TransferPosts)
						{
							<div class="card-horizontal">
								<a href="@Url.Action("Single", "Post", new { slug = post.Slug  })" class="card-horizontal__image">
									@{ string transferImg = post.GetImageBySize(ImageWidth.Width300); }
									<picture>
										<source srcset="@Url.Content(transferImg)" type="image/webp" class="img-res">
										<source srcset="@Url.Content(transferImg)" type="image/jpeg" class="img-res">
										<img loading="lazy" src="@Url.Content(transferImg)" alt="@post.PostTitle" class="img-res img-block">
									</picture>
								</a>
								<div class="card-horizontal__content">
									<p class="datetime">
										<a class="title" href="@Url.Action("Single", "Post", new { slug = post.Slug  })">@post.PostTitle</a>
										@if (post.CommentCount > 0)
										{
											<a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
									</p>
								</div>
							</div>}
					</div>
				</div>
			</div>
		</div>

		<div class="block block-others">
			<div class="container">
				<h2 class="block__title"><a href="@Url.Action("Category", "Home", new { slug = Constants.OtherPostSlug  })">@ViewResources.OtherPosts</a></h2>
				<div class="block__content">
					<div class="card-vertical card-vertical-highlight">
						<a href="@Url.Action("Single", "Post", new { slug =  Model.OtherPosts[0].Slug })" class="card-vertical__image">
							@{ short otherImgSize = isMobile || isTablet ? ImageWidth.Width500 : ImageWidth.Width768;
								string otherFirstImgUrl = Model.OtherPosts[0].GetImageBySize(imgSize); }
							<picture>
								<source srcset="@Url.Content(otherFirstImgUrl)" type="image/webp" class="img-res">
								<source srcset="@Url.Content(otherFirstImgUrl)" type="image/jpeg" class="img-res">
								<img asp-append-version="true" loading="lazy" src="@Url.Content(otherFirstImgUrl)" alt="@Model.OtherPosts[0].PostTitle" class="img-res img-block">
							</picture>
						</a>
						<a href="@Url.Action("Single", "Post", new { slug =  Model.OtherPosts[0].Slug })" class="card-vertical__title">@Model.OtherPosts[0].PostTitle</a>

						@*<p class="card-vertical__datetime">@Model.OtherPosts[0].PostTime</p>*@
					</div>
					<div class="list-card">
						@for (int i = 1; i < Model.OtherPosts.Length; i++)
						{
							string otherImg = Model.OtherPosts[i].GetImageBySize(ImageWidth.Width300);
							<div class="card-vertical">
								<a href="@Url.Action("Single", "Post", new { slug =  Model.OtherPosts[i].Slug })" class="card-vertical__image">
									<picture>
										<source srcset="@Url.Content(otherImg)" type="image/webp" class="img-res">
										<source srcset="@Url.Content(otherImg)" type="image/jpeg" class="img-res">
										<img asp-append-version="true" loading="lazy" src="@Url.Content(otherImg)" alt="@Model.OtherPosts[i].PostTitle" class="img-res img-block">
									</picture>
								</a>
								<a href="@Url.Action("Single", "Post", new { slug =  Model.OtherPosts[i].Slug })" class="card-vertical__title">@Model.OtherPosts[i].PostTitle</a>
							</div>}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>