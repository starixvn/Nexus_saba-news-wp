@using SabaNews.Core.Constants;
@using DeviceDetectorNET;
@{
    var detector = new DeviceDetector(Context.Request.Headers["User-Agent"].ToString());
    detector.Parse();
    bool isMobile = detector.IsMobile();
    bool isDesktop = detector.IsDesktop();
}

@section Metadata {
    <meta name="robots" content="noarchive">
    <meta name="description" content='@Model.Header.Description' />
    <meta property="og:description" content='@Model.Category.OgDescription' />
    <meta property="og:title" content='@Model.Category.OgTitle' />
    <meta property="og:image" content='@Model.Category.OgImage' />
    <meta name="google-site-verification" content="-nfg3Xmoj-uNWx8LoRDPWPKXW56elXGwsXTMTnes3xk" />
    <meta name='dmca-site-verification' content='L21LWUJKSGlUVmFvaFhNYzBBVXc1dz090' />
    <link rel="canonical" href="@Model.Url" />
    <link rel="alternate" href="@Model.Url" hreflang="vi-vn" />
    <link rel="alternate" type="application/rss+xml" href="@Model.RSSUrl" title='@Model.Header.Title' />
}

@section Title {
    @Model.Header.Title
}

@section Styles{
     <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/livescore/soccer/fixture-homepage.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/livescore/soccer/fixture-homepage.chunk.css" asp-append-version="true" />
    </environment>
    <link rel="stylesheet" href="~/minify/styles/home.min.css" asp-append-version="true">
}

@section Scripts {
    <script src="~/js/livescore/livescore.js" asp-append-version="true"></script>
    <environment include="Development">
        <script src="~/js/dev/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/dev/pages/livescore/soccer/fixture-homepage.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/lib/lang-vi-VN.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/lib/react-bootstrap-vendor.chunk.js" asp-append-version="true"></script>
        <script src="~/js/pro/pages/livescore/soccer/fixture-homepage.chunk.js" asp-append-version="true"></script>
    </environment>
    <script src="~/minify/js/swiper.min.js" asp-append-version="true"></script>
}

@(await Component.InvokeAsync("Menu", new { page = "home-page", CategorySlug = "/" }))
<section class="main">
    <div class="colums-main">

        <div class="banner banner-desktop-center"></div>
        @if (isMobile)
        {
            <div class="banner-euro-mobile banner-mobile-top"></div>
            @*<div class="skeleton-mobile skeleton-banner">r
                <div class="skeleton-banner-mobile"></div>
            </div>*@
        }

        <div class="fixture-home-page">
            <div class="container">
                <div id="fixture-homepage"></div>
            </div>
        </div>

        <div class="block block-hot-news">
            <div class="container">
                <h2 class="block__title"><a href="@Url.Action("Category", "Home")">@ViewResources.RecentsPost </a></h2>
                <div class="block__content">
                    <div class="group-hight-light">
                        @{
                            var firstPost = Model.NewPosts[0];
                            <div class="post card-vertical card-vertical-highlight">
                                <a href="@Url.Action("Single", "Post", new { slug =  firstPost.Slug})" class="card-vertical__image">
                                    @{ //short imgSize = isMobile || isTablet ? ImageWidth.Width500 : ImageWidth.Width768;
                                        string firstImgUrl = firstPost.FeatureImage;

                                        <picture>
                                            <source srcset="@Url.Content(firstImgUrl)" type="image/webp" class="img-res">
                                            <source srcset="@Url.Content(firstImgUrl)" type="image/jpeg" class="img-res">
                                            <img asp-append-version="true" loading="lazy" src="@Url.Content(firstImgUrl)" alt="@firstPost.PostTitle" class="img-res img-block">
                                        </picture> }
                                </a>
                                <div class="group-title-home">
                                    <a href="@Url.Action("Single", "Post", new { slug =  firstPost.Slug })" class="card-vertical__title">@firstPost.PostTitle</a>
                                    <p class="card-vertical__description text-description">
                                        @Html.Raw(firstPost.PostExcerpt)
                                        @if (firstPost.CommentCount > 0)
                                        {
                                            <a href="@Url.Action("Single", "Post", new { slug =  firstPost.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@firstPost.CommentCount</i></a>}
                                    </p>
                                </div>
                            </div>

                        }
                        <div class="skeleton skeleton-vertical">
                            <a class="skeleton-vertical__image"></a>
                            <a class="skeleton-vertical__title"></a>
                            <p class="skeleton-vertical__description text-description"></p>
                        </div>
                    </div>



                    <div class="card-horizontal-section">
                        @{
                            int newPostIndex = 0;
                            foreach (var item in Model.NewPosts)
                            {
                                {
                                    newPostIndex++;
                                    if (newPostIndex <= 1)
                                    {
                                        continue;
                                    }
                                }
                                <div class="post card-title-wrapper card-item-@newPostIndex">
                                    <a class="title" href="@Url.Action("Single", "Post", new { slug =  item.Slug })">@item.PostTitle</a>
                                    <a href="@Url.Action("Single", "Post", new { slug =  item.Slug })" class="card-horizontal__image">
                                        @{ string featuredImg = item.FeatureImage;

                                            <picture>
                                                <source srcset="@Url.Content(featuredImg)" type="image/webp" class="img-res">
                                                <source srcset="@Url.Content(featuredImg)" type="image/jpeg" class="img-res">
                                                <img asp-append-version="true" loading="lazy" src="@Url.Content(featuredImg)" alt="@item.PostTitle" class="img-res img-block">
                                            </picture> }
                                    </a>
                                    <div class="sub-content">
                                        <p class="description">
                                            @Html.Raw(item.PostExcerpt)
                                            @if (item.CommentCount > 0)
                                            {
                                                <a href="@Url.Action("Single", "Post", new { slug =  item.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@item.CommentCount</i></a>}
                                        </p>
                                    </div>
                                </div>

                                <div class="skeleton skeleton-horizontal">
                                    <a class="skeleton-horizontal__image"></a>
                                    <a class="skeleton-horizontal__title"></a>
                                    <p class="skeleton-horizontal__description text-description"></p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        


        <div class="banner-mobile banner-mobile-center"></div>
        @*<div class="skeleton-mobile skeleton-banner">
            <div class="skeleton-banner-mobile"></div>
        </div>*@
        <div class="block block-video">
            <div class="container">
                <h2 class="block__title"><a href="@Url.Action("Video", "Home")">@ViewResources.Video</a></h2>
                <div class="block__content flex-video">
                    <div class="swiper-video">
                        <div class="skeleton skeleton-swiper-slide">
                            <div class="img-item"></div>
                            <div class="content-box"></div>
                        </div>
                        <div class="swiper-container">
                            <div class="swiper-wrapper">
                                @foreach (var post in Model.VideoPosts)
                                {
                                    <div class="post swiper-slide" id="slide-@post.ID">
                                        <input type="hidden" name="iframe_value" value="@post.PostContent" />
                                        <div class="img-item">
                                            @{ string videoImg = post.FeatureImage;
                                                <picture>
                                                    <source srcset="@Url.Content(videoImg)" type="image/webp">
                                                    <source srcset="@Url.Content(videoImg)" type="image/jpeg">
                                                    <img asp-append-version="true" loading="lazy" src="@Url.Content(videoImg)" alt="@post.PostTitle">
                                                </picture> }

                                            <div class="btn-play-video" post-id="@post.ID">
                                                <span class="icon-play"></span>
                                            </div>
                                        </div>
                                        <div class="play_video"></div>
                                        <div class="content-box">
                                            <h3 class="title-box"><a href="@Url.Action("Single", "Post", new { slug = post.Slug })" class="heading">@post.PostTitle</a></h3>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="swiper-button swiper-button-next"><span class="icon-slide icon-chevron-right"></span></div>
                            <div class="swiper-button swiper-button-prev"><span class="icon-slide icon-chevron-left"></span></div>
                            <div class="swiper-pagination"></div>
                        </div>
                    </div>
                    <div class="slide-video">
                        @foreach (var post in Model.VideoPosts)
                        {
                            <div class="post card-horizontal card-item">
                                <a href="javascript:;" data-id="@post.ID" class="image-slider card-horizontal__image">
                                    @{ string videoDesktopImg = post.FeatureImage;

                                        <picture>
                                            <source srcset="@Url.Content(videoDesktopImg)" type="image/webp" class="img-res">
                                            <source srcset="@Url.Content(videoDesktopImg)" type="image/jpeg" class="img-res">
                                            <img asp-append-version="true" loading="lazy" src="@Url.Content(videoDesktopImg)" alt="@post.PostTitle" class="img-res img-block">
                                        </picture> }
                                </a>
                                <div class="card-horizontal__content">
                                    <p class="datetime">
                                        <a href="@Url.Action("Single", "Post", new { slug = post.Slug })" data-id="@post.ID" class="title">
                                            @post.PostTitle
                                        </a>
                                        @if (post.CommentCount > 0)
                                        {
                                            <a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
                                    </p>
                                </div>
                            </div>
                            <div class="skeleton skeleton-horizontal">
                                <a class="skeleton-horizontal__image"></a>
                                <div class="text-skeleton">
                                    <a class="skeleton-horizontal__title"></a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="block block-soccer">
            <div class="container">
                <h2 class="block__title"><a href="@Url.Action("Category", "Home", new { slug1 = Constants.FootballSlug })">@ViewResources.Football</a></h2>
                <div class="block__content">
                    @foreach (var post in Model.FootballPosts)
                    {
                        <div class="post card-vertical">
                            <a href="@Url.Action("Single", "Post", new { slug = post.Slug })" class="card-vertical__image">
                                @{ string footballImg = post.FeatureImage;
                                    <picture>
                                        <source srcset="@Url.Content(footballImg)" type="image/webp" class="img-res">
                                        <source srcset="@Url.Content(footballImg)" type="image/jpeg" class="img-res">
                                        <img asp-append-version="true" loading="lazy" src="@Url.Content(footballImg)" alt="@post.PostTitle" class="img-res img-block">
                                    </picture> }
                            </a>
                            <p class="card-vertical__datetime">
                                <a href="@Url.Action("Single", "Post", new { slug = post.Slug  })" class="card-vertical__title">@post.PostTitle</a>
                                @if (post.CommentCount > 0)
                                {
                                    <a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
                            </p>
                        </div>
                        <div class="skeleton skeleton-vertical">
                            <a class="skeleton-vertical__image"></a>
                            <a class="skeleton-vertical__title"></a>
                        </div>

                    }
                </div>
            </div>
        </div>

        <div class="block block-guess">
            <div class="container">
                <h2 class="block__title"><a href="@Url.Action("Category", "Home", new { slug1 = Constants.GuessSlug })">@ViewResources.Guess</a><span class="marked-icon"></span></h2>
                <div class="block__content">
                    @foreach (var post in Model.GuessPosts)
                    {
                        <div class="post card-vertical">
                            <a href="@Url.Action("Single", "Post", new { slug = post.Slug  })" class="card-vertical__image">
                                @{ //short imgGuessSize =ImageWidth.Width500;
                                    string guessImgUrl = post.FeatureImage;

                                    <picture>
                                        <source srcset="@Url.Content(guessImgUrl)" type="image/webp" class="img-res">
                                        <source srcset="@Url.Content(guessImgUrl)" type="image/jpeg" class="img-res">
                                        <img asp-append-version="true" loading="lazy" src="@Url.Content(guessImgUrl)" alt="@post.PostTitle" class="img-res img-block">
                                    </picture> }
                            </a>
                            <div class="group group-mobile">
                                <p class="card-vertical__datetime">
                                    <a href="@Url.Action("Single", "Post", new { slug = post.Slug  })" class="card-vertical__title">@post.PostTitle</a>
                                    @if (post.CommentCount > 0)
                                    {
                                        <a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
                                </p>
                            </div>
                        </div>
                        <div class="skeleton skeleton-vertical">
                            <a class="skeleton-vertical__image"></a>
                            <a class="skeleton-vertical__title"></a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="banner-mobile banner-mobile-bottom"></div>
        @*<div class="skeleton-mobile skeleton-banner">
            <div class="skeleton-banner-mobile"></div>
        </div>*@

        <div class="group-blocks group-change-column">
            <div class="container">
                <div class="block block-behind">
                    <h2 class="block__title"><a href="@Url.Action("Category", "Home", new { slug1 = Constants.BackstageSlug })">@ViewResources.Backstage</a></h2>
                    <div class="block__content">
                        <div class="skeleton skeleton-horizontal">
                            <a class="skeleton-horizontal__image"></a>
                            <div class="text-skeleton">
                                <a class="skeleton-horizontal__title"></a>
                                <p class="skeleton-horizontal__description text-description"></p>
                            </div>
                        </div>
                        @{
                            var firstBackStagePost = Model.BackstagePosts[0];
                        }
                        <div class="post card-horizontal card-horizontal-highlight card-item-1">
                            <a href="@Url.Action("Single", "Post", new { slug = firstBackStagePost.Slug  })" class="card-horizontal__image">
                                @{ //short backstageSize = isDesktop ? ImageWidth.Width768 : ImageWidth.Width500;
                                    string backstageImg = firstBackStagePost.FeatureImage;

                                    <picture>
                                        <source srcset="@Url.Content(backstageImg)" type="image/webp" class="img-res">
                                        <source srcset="@Url.Content(backstageImg)" type="image/jpeg" class="img-res">
                                        <img asp-append-version="true" loading="lazy" src="@Url.Content(backstageImg)" alt="@firstBackStagePost.PostTitle" class="img-res img-block">
                                    </picture> }
                            </a>
                            <div class="card-horizontal__content">
                                <a class="title" href="@Url.Action("Single", "Post", new { slug = firstBackStagePost.Slug  })">@firstBackStagePost.PostTitle</a>
                                <p class="description">
                                    @Html.Raw(firstBackStagePost.PostExcerpt)
                                    @if (firstBackStagePost.CommentCount > 0)
                                    {
                                        <a href="@Url.Action("Single", "Post", new { slug =  firstBackStagePost.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@firstBackStagePost.CommentCount</i></a>}
                                </p>
                            </div>
                        </div>
                        @{
                            int backstagePostIndex = 0;
                            foreach (var post in Model.BackstagePosts)
                            {
                                {
                                    backstagePostIndex++;
                                    if (backstagePostIndex <= 1)
                                    {
                                        continue;
                                    }
                                }

                                <div class="post card-vertical card-vertical-highlight card-item-@backstagePostIndex ">
                                    <a href="@Url.Action("Single", "Post", new { slug = post.Slug  })" class="card-vertical__image">
                                        @{// backstageSize = ImageWidth.Width500;
                                            backstageImg = post.FeatureImage;

                                            <picture>
                                                <source srcset="@Url.Content(backstageImg)" type="image/webp" class="img-res">
                                                <source srcset="@Url.Content(backstageImg)" type="image/jpeg" class="img-res">
                                                <img asp-append-version="true" loading="lazy" src="@Url.Content(backstageImg)" alt="@post.PostTitle" class="img-res img-block">
                                            </picture> }
                                    </a>
                                    <p class="card-vertical__datetime">
                                        <a class="card-vertical__title" href="@Url.Action("Single", "Post", new { slug = post.Slug  })">@post.PostTitle</a>
                                        @if (post.CommentCount > 0)
                                        {
                                            <a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
                                    </p>
                                </div>
                                <div class="skeleton skeleton-vertical">
                                    <a class="skeleton-vertical__image"></a>
                                    <a class="skeleton-vertical__title"></a>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="block block-transfer">
                    <h2 class="block__title">
                        <a href="@Url.Action("Category", "Home", new { slug1 = Constants.TransferSlug })">@ViewResources.Transfer</a>
                    </h2>
                    <div class="block__content">
                        @foreach (var post in Model.TransferPosts)
                        {
                            <div class="post card-horizontal">
                                <a href="@Url.Action("Single", "Post", new { slug = post.Slug  })" class="card-horizontal__image">
                                    @{ string transferImg = post.FeatureImage; }
                                    <picture>
                                        <source srcset="@Url.Content(transferImg)" type="image/webp" class="img-res">
                                        <source srcset="@Url.Content(transferImg)" type="image/jpeg" class="img-res">
                                        <img asp-append-version="true" loading="lazy" src="@Url.Content(transferImg)" alt="@post.PostTitle" class="img-res img-block">
                                    </picture>
                                </a>
                                <div class="card-horizontal__content">
                                    <p class="datetime">
                                        <a class="title" href="@Url.Action("Single", "Post", new { slug = post.Slug  })">@post.PostTitle</a>
                                        @if (post.CommentCount > 0)
                                        {
                                            <a href="@Url.Action("Single", "Post", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
                                    </p>
                                </div>
                            </div>
                            <div class="skeleton skeleton-horizontal">
                                <a class="skeleton-horizontal__image"></a>
                                <div class="text-skeleton">
                                    <a class="skeleton-horizontal__title"></a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="block block-others">
            <div class="container">
                <h2 class="block__title"><a href="@Url.Action("Category", "Home", new { slug1 = Constants.OtherPostSlug  })">@ViewResources.OtherPosts</a></h2>
                <div class="block__content">
                    <div class="post card-vertical card-vertical-highlight">
                        <a href="@Url.Action("Single", "Post", new { slug =  Model.OtherPosts[0].Slug })" class="card-vertical__image">
                            @{ short otherImgSize = isMobile ? ImageWidth.Width500 : ImageWidth.Width768;
                                string otherFirstImgUrl = Model.OtherPosts[0].FeatureImage; }
                            <picture>
                                <source srcset="@Url.Content(otherFirstImgUrl)" type="image/webp" class="img-res">
                                <source srcset="@Url.Content(otherFirstImgUrl)" type="image/jpeg" class="img-res">
                                <img asp-append-version="true" loading="lazy" src="@Url.Content(otherFirstImgUrl)" alt="@Model.OtherPosts[0].PostTitle" class="img-res img-block">
                            </picture>
                        </a>
                        <a href="@Url.Action("Single", "Post", new { slug =  Model.OtherPosts[0].Slug })" class="card-vertical__title">@Model.OtherPosts[0].PostTitle</a>
                    </div>

                    <div class="skeleton skeleton-vertical">
                        <a class="skeleton-vertical__image"></a>
                        <a class="skeleton-vertical__title"></a>
                    </div>

                    <div class="list-card">
                        @{
                            var OtherPostIndex = 0;
                            foreach (var post in Model.OtherPosts)
                            {
                                {
                                    OtherPostIndex++;
                                    if (OtherPostIndex <= 1)
                                    {
                                        continue;
                                    }
                                }
                                string otherImg = post.FeatureImage;
                                <div class="post card-vertical">
                                    <a href="@Url.Action("Single", "Post", new { slug =  post.Slug })" class="card-vertical__image">
                                        <picture>
                                            <source srcset="@Url.Content(otherImg)" type="image/webp" class="img-res">
                                            <source srcset="@Url.Content(otherImg)" type="image/jpeg" class="img-res">
                                            <img asp-append-version="true" loading="lazy" src="@Url.Content(otherImg)" alt="@post.PostTitle" class="img-res img-block">
                                        </picture>
                                    </a>
                                    <a href="@Url.Action("Single", "Post", new { slug =  post.Slug })" class="card-vertical__title">@post.PostTitle</a>
                                </div>
                                <div class="skeleton skeleton-vertical">
                                    <a class="skeleton-vertical__image"></a>
                                    <a class="skeleton-vertical__title"></a>
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
    @await Html.PartialAsync(ViewResources.SidebarBannerView)
</section>

