@section Metadata {
	<meta name="description" content='@Model.Header.Description' />
	<meta property="og:description" content='@Model.Category.OgDescription' />
	<meta property="og:title" content='@Model.Category.OgTitle' />
	<meta property="og:image" content='@Model.Category.OgImage' />
}

@section Title{
	@Model.Header.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}

@(await Component.InvokeAsync("Menu", new { CategorySlug = Model.Header.CategorySlug }))
<section class="main">
    <div class="container">
        <div class="block block-main">
            <h2 class="block__title"><a>Lịch Thi Đấu</a></h2>
            <div class="block__content">
                <div class="match-schedule">@Html.Raw(@Model.Post.PostContent)</div>
            </div>
        </div>
        @await Html.PartialAsync(ViewResources.SidebarPostView, new PostComponentViewModel { })
    </div>
    @await Html.PartialAsync(ViewResources.SidebarBannerView)
</section>

<div class="auth-form event-modal-home">
    <div class="modal" id="EventModal" style="display:none">
        <div class="modal-content modal-auth event-modal-home">
            <div class="modal-warning">
                <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="modal-body">
                    <div class="img-pc"><a href="@Url.Action("MembershipEvent", "Event")"><img src="~/images/event/popup-home-pc.png" alt="Alternate Text" class="img-res" /></a></div>
                    <div class="img-mobile"><a href="@Url.Action("MembershipEvent", "Event")"><img src="~/images/event/popup-home-mobile.png" alt="Alternate Text" class="img-res" /></a></div>
                    <label class="custom-checkbox-container">
                        <input type="checkbox" id="isHidePopupEvent" />
                        <span class="checkmark"></span>
                        Không hiển thị nữa
                    </label>
                </div>
            </div>

        </div>
    </div>
</div>