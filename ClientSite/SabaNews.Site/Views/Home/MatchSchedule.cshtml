@section Metadata {
	<meta name="description" content='@Model.Header.Description' />
	<meta property="og:description" content='@Model.Category.OgDescription' />
	<meta property="og:title" content='@Model.Category.OgTitle' />
	<meta property="og:image" content='@Model.Category.OgImage' />
}

@section Title{
	@Model.Header.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}

@(await Component.InvokeAsync("Menu", new { CategorySlug = Model.Header.CategorySlug }))
<section class="main">
	<div class="container">
		<div class="block block-main">
			<h2 class="block__title"><a>Lịch Thi Đấu</a></h2>
			<div class="block__content">
				<div class="match-schedule">@Html.Raw(@Model.Post.PostContent)</div>
			</div>
		</div>
		@(await Component.InvokeAsync("Sidebar"))
	</div>
	<div class="ads ads-left"><a href="@Url.Action("ChangeDomain", "Home")"><img loading="lazy" src="~/images/ads.png" asp-append-version="true" class="img-res"></a></div>
</section>