@using SabaNews.Core.Constants;

<meta name="description" content='@Model.ViewData.Description' />
<meta name="robots" content="noarchive">
<meta property="og:description" content='@Model.Category.OgDescription' />
<meta property="og:title" content='@Model.Category.OgTitle' />
<meta property="og:image" content='@Model.Category.OgImage' />

@section Title{
	@Model.ViewData.Title
}

@section Styles{
	<link rel="stylesheet" href="~/styles/pages/Euro2020/schedule.css" asp-append-version="true">
}

@section Scripts{
	<script src="~/js/euro2020/euro2020.js" asp-append-version="true"></script>
}


<div class="page">
	@(await Component.InvokeAsync("HeaderEvent"))
	<div class="main-content">
		<div class="container">
			<h2 class="block__title"><span class="text-title">@Model.ViewData.HeadTitle</span></h2>
			<div class="block__content">
				<ul class="sub-category">
					@foreach (var post in Model.Posts)
					{
						<li class="sub-item"><a href="javascript:;" data-slug="@post.Slug" class="tab-data">@post.PostTitle</a></li>
					}
				</ul>

                <div class="post_content">
                    <div class="date-block">
                        <div class="date-title">
                            Thứ 7, 12/06/2021
                        </div>
                        <div class="date-content">
                            <div class="match">
                                <div class="main-info">
                                    <div class="home-team"><span class="name">Italia</span><span class="flag-italia"></span></div>
                                    <div class="time">14:00</div>
                                    <div class="away-team"><span class="flag-portugal"></span><span class="name">Bồ Đào Nha</span></div>
                                </div>
                                <div class="extra-info"><span class="time-live">79'</span></div>
                            </div>
                            <div class="match">
                                <div class="main-info">
                                    <div class="home-team"><span class="name">Italia</span><span class="flag-italia"></span></div>
                                    <div class="result">14:00</div>
                                    <div class="away-team"><span class="flag-portugal"></span><span class="name">Bồ Đào Nha</span></div>
                                </div>
                            </div>
                            <div class="match">
                                <div class="main-info">
                                    <div class="home-team"><span class="name">Italia</span><span class="flag-italia"></span></div>
                                    <div class="result">14:00</div>
                                    <div class="away-team"><span class="flag-portugal"></span><span class="name">Bồ Đào Nha</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="date-block">
                        <div class="date-title">
                            Thứ 2, 14/06/2021
                        </div>
                        <div class="date-content">
                            <div class="match">
                                <div class="main-info">
                                    <div class="home-team"><span class="name">Italia</span><span class="flag-italia"></span></div>
                                    <div class="result">14:00</div>
                                    <div class="away-team"><span class="flag-portugal"></span><span class="name">Bồ Đào Nha</span></div>
                                </div>
                            </div>
                            <div class="match">
                                <div class="main-info">
                                    <div class="home-team"><span class="name">Italia</span><span class="flag-italia"></span></div>
                                    <div class="result">14:00</div>
                                    <div class="away-team"><span class="flag-portugal"></span><span class="name">Bồ Đào Nha</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
			</div>
		</div>
	</div>
</div>

