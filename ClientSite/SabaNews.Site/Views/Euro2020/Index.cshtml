@using SabaNews.Core.Constants;
@using Wangkanai.Detection.Services;
@using Wangkanai.Detection.Models;
@inject IDetectionService DetectionService
@{
	bool isMobile = DetectionService.Device.Type == Device.Mobile;
	bool isTablet = DetectionService.Device.Type == Device.Tablet;
	bool isDesktop = DetectionService.Device.Type == Device.Desktop;

}
<meta name="description" content='@Model.ViewData.Description' />
<meta name="robots" content="noarchive">
<meta property="og:description" content='@Model.Category.OgDescription' />
<meta property="og:title" content='@Model.Category.OgTitle' />
<meta property="og:image" content='@Model.Category.OgImage' />

@section Title{
    @Model.ViewData.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/euro2020_home.min.css" asp-append-version="true">
}

@section Scripts {
	<script src="~/js/euro2020/home.js" asp-append-version="true"></script>
}


<div class="page">
	@(await Component.InvokeAsync("HeaderEvent"))
	<div class="main-content">
		<div class="block block-head">
			<div class="container">
				<div class="block lastest-news">
					<h2 class="block__title"><a href="">@ViewResources.HotNews</a></h2>
					<div class="block__content">

						<div class="card-vertical card-highlight">
							<a href="@Url.Action("Single", "Home", new { slug =  Model.HotNews[0].Slug})" class="card-vertical__image">
								@{
									short imgSize = isMobile || isTablet ? ImageWidth.Width500 : ImageWidth.Width768;
									string firstImgUrl = Model.HotNews[0].GetImageBySize(imgSize);
								}
								<picture>
									<source srcset="@firstImgUrl" type="image/webp" class="img-res">
									<source srcset="@firstImgUrl" type="image/jpeg" class="img-res">
									<img asp-append-version="true" loading="lazy" src="@firstImgUrl" alt="" class="img-res img-block">
								</picture>
							</a>
							<div class="card-content">
								<a href="@Url.Action("Single", "Home", new { slug =  Model.HotNews[0].Slug})" class="card__title">@Model.HotNews[0].PostTitle</a>
								<p class="card__description text-description">@Model.HotNews[0].PostExcerpt</p>
								<p class="card__datetime">@Model.HotNews[0].PostTime</p>
							</div>
						</div>
						@for (int i = 1; i < Model.HotNews.Length; i++)
						{
							string featuredImg = Model.HotNews[i].GetImageBySize(ImageWidth.Width300);
							<div class="card-vertical">
								<a href="@Url.Action("Single", "Home", new { slug =  Model.HotNews[i].Slug})" class="card-vertical__image">
									<picture>
										<source srcset="@featuredImg" type="image/webp" class="img-res">
										<source srcset="@featuredImg" type="image/jpeg" class="img-res">
										<img asp-append-version="true" loading="lazy" src="@featuredImg" alt="" class="img-res img-block">
									</picture>
								</a>
								<a href="@Url.Action("Single", "Home", new { slug =  Model.HotNews[i].Slug})" class="card-vertical__title">@Model.HotNews[i].PostTitle</a>
								<p class="card-vertical__datetime">@Model.HotNews[i].PostTime</p>
							</div>
						}
					</div>
				</div>
				<div class="board">
					<h2 class="block__title"><a href="">Bảng xếp hạng</a></h2>
					<div class="block__content">
						<ul class="tab-lists">
							@foreach (var post in Model.Ranking)
							{
								<li class="tab-item active" data-tab="tab-@post.PostSeoTitle.ToLower()"><a href="javascript:;" class="tab-link">@post.PostSeoTitle.ToUpper()</a></li>
							}
						</ul>
						<div class="total_ranking">
							@Html.Raw(Model.TotalRanking.PostContent)
						</div>
					</div>
				</div>
				<div class="guess-block">
					<h2 class="block__title"><a href="">@ViewResources.Guess</a></h2>
					<div class="block__content">
						@foreach (var post in Model.Identify)
						{
							string featuredImg = post.GetImageBySize(ImageWidth.Width300);
							<div class="card-vertical">
								<a href="@Url.Action("Single", "Home", new { slug =  post.Slug})" class="card-vertical__image">
									<picture>
										<source srcset="@featuredImg" type="image/webp" class="img-res">
										<source srcset="@featuredImg" type="image/jpeg" class="img-res">
										<img asp-append-version="true" loading="lazy" src="@featuredImg" alt="" class="img-res img-block">
									</picture>
								</a>
								<a href="@Url.Action("Single", "Home", new { slug =  post.Slug})" class="card-vertical__title">@post.PostTitle</a>
								<p class="card-vertical__datetime">@post.PostTime</p>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
		<div class="block block-video">
			<div class="container">
				<h2 class="block__title"><a href="@Url.Action("Video", "Home")">@ViewResources.Video</a></h2>
				<div class="block__content flex-video">
					<div class="swiper-video">
						<div class="swiper-container">
							<div class="swiper-wrapper">
								@foreach (var post in Model.Videos)
								{
									<div class="swiper-slide" id="slide-@post.ID">
										<input type="hidden" name="iframe_value" value="@post.PostContent" />
										<div class="img-item">
											@{

												string videoImg = post.GetImageBySize(isDesktop ? ImageWidth.Width768 : ImageWidth.Width500);
												<picture>
													<source srcset="@Url.Content(videoImg)" type="image/webp">
													<source srcset="@Url.Content(videoImg)" type="image/jpeg">
													<img loading="lazy" src="@Url.Content(videoImg)" alt="@post.PostTitle">
												</picture>
											}

											<div class="btn-play-video">
												<span class="icon-play"></span>
											</div>
										</div>
										<div class="play_video"></div>
										<div class="content-box">
											<h3 class="title-box"><a href="@Url.Action("Single", "Home", new { slug = post.Slug })" class="heading">@post.PostTitle</a></h3>
										</div>
									</div>}
							</div>
							<div class="swiper-button swiper-button-next"><span class="icon-slide icon-chevron-right"></span></div>
							<div class="swiper-button swiper-button-prev"><span class="icon-slide icon-chevron-left"></span></div>
							<div class="swiper-pagination"></div>
						</div>
					</div>
					<div class="slide-video">
						@foreach (var post in Model.Videos)
						{
							<div class="card-horizontal card-item">
								<a href="javascript:;" data-id="@post.ID" class="image-slider card-horizontal__image">
									@{
										string videoDesktopImg = post.GetImageBySize(ImageWidth.Width300);

										<picture>
											<source srcset="@Url.Content(videoDesktopImg)" type="image/webp" class="img-res">
											<source srcset="@Url.Content(videoDesktopImg)" type="image/jpeg" class="img-res">
											<img loading="lazy" src="@Url.Content(videoDesktopImg)" alt="@post.PostTitle" class="img-res img-block">
										</picture>
									}
								</a>
								<div class="card-horizontal__content">
									<a href="@Url.Action("Single", "Home", new { slug = post.Slug })" data-id="@post.ID" class="title">@post.PostTitle</a>
									<p class="datetime">
										@post.PostTime
										@if (post.CommentCount > 0)
										{
											<a href="@Url.Action("Single", "Home", new { slug =  post.Slug})#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>
										}
									</p>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
		<div class="block block-general-section">
			<div class="container">
				<h2 class="block__title"><a href="">@ViewResources.Overview</a></h2>
				<div class="block__content">
					<a class="box team" href="#">
						<picture>
							<source srcset="~/images/euro2020/team_img.png" type="image/webp" class="img-res">
							<source srcset="~/images/euro2020/team_img.png" type="image/jpeg" class="img-res">
							<img src="~/images/euro2020/team_img.png" alt="" class="img-res img-block">
						</picture>
						<div class="logo-box">
							<span class="logo-small team-logo"></span>
						</div>
						<div class="text">Đội tuyển</div>
					</a>
					<a class="box stadium" href="#">
						<picture>
							<source srcset="~/images/euro2020/stadium_img.png" type="image/webp" class="img-res">
							<source srcset="~/images/euro2020/stadium_img.png" type="image/jpeg" class="img-res">
							<img src="~/images/euro2020/stadium_img.png" alt="" class="img-res img-block">
						</picture>
						<div class="logo-box">
							<span class="logo-small stadium-logo"></span>
						</div>
						<div class="text">Sân vận động</div>
					</a>
					<a class="box ball" href="#">
						<picture>
							<source srcset="~/images/euro2020/ball_img.png" type="image/webp" class="img-res">
							<source srcset="~/images/euro2020/ball_img.png" type="image/jpeg" class="img-res">
							<img src="~/images/euro2020/ball_img.png" alt="" class="img-res img-block">
						</picture>
						<div class="logo-box">
							<span class="logo-small ball-logo"></span>
						</div>
						<div class="text">Bóng</div>
					</a>
					<a class="box mascot" href="#">
						<picture>
							<source srcset="~/images/euro2020/mascot_img.png" type="image/webp" class="img-res">
							<source srcset="~/images/euro2020/mascot_img.png" type="image/jpeg" class="img-res">
							<img src="~/images/euro2020/mascot_img.png" alt="" class="img-res img-block">
						</picture>
						<div class="logo-box">
							<span class="logo-small mascot-logo"></span>
						</div>
						<div class="text">Linh vật</div>
					</a>
					<a class="box record" href="#">
						<picture>
							<source srcset="~/images/euro2020/record_img.png" type="image/webp" class="img-res">
							<source srcset="~/images/euro2020/record_img.png" type="image/jpeg" class="img-res">
							<img src="~/images/euro2020/record_img.png" alt="" class="img-res img-block">
						</picture>
						<div class="logo-box">
							<span class="logo-small record-logo"></span>
						</div>
						<div class="text">Kỷ lục</div>
					</a>
					<a class="box top-goal-scorer" href="#">
						<picture>
							<source srcset="~/images/euro2020/top_soccer_img.png" type="image/webp" class="img-res">
							<source srcset="~/images/euro2020/top_soccer_img.png" type="image/jpeg" class="img-res">
							<img src="~/images/euro2020/top_soccer_img.png" alt="" class="img-res img-block">
						</picture>
						<div class="logo-box">
							<span class="logo-small goal_soccer-logo"></span>
						</div>
						<div class="text">Vua phá lưới</div>
					</a>
				</div>
			</div>
		</div>
	</div>
</div>

</div>

