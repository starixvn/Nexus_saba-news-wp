@using SabaNews.Core.Constants;

<meta name="description" content='@Model.ViewData.Description' />
<meta name="robots" content="noarchive">
<meta property="og:description" content='@Model.Category.OgDescription' />
<meta property="og:title" content='@Model.Category.OgTitle' />
<meta property="og:image" content='@Model.Category.OgImage' />

@section Title{
	@Model.ViewData.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/euro2020_home.min.css" asp-append-version="true">
}

@section Scripts{
}


<div class="page">
	@(await Component.InvokeAsync("HeaderEvent"))
	<div class="main-content">
		<div class="block__content">
			<div class="container">
				<h2 class="block__title"><a href="">@Model.ViewData.HeadTitle</a></h2>

				<div class="block__content">
					@foreach (var post in Model.Posts)
					{
						var arrTeamInfo = post.PostSeoTitle.Split('-');
						var teamName = arrTeamInfo[0];
						var teamFlag = arrTeamInfo[arrTeamInfo.Length - 1].Trim().ToLower();
						<div class="card-vertical">
							<div class="group group-mobile">
								<a href="@Url.Action("Single", "Home", new { slug = post.Slug  })" class="card-vertical__title"><span class="flag-@teamFlag"></span> @teamName - @teamFlag </a>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>
