@using SabaNews.Core.Constants;
<meta name="description" content='@Model.ViewData.Description' />
<meta name="robots" content="noarchive">
<meta property="og:description" content='@Model.Category.OgDescription' />
<meta property="og:title" content='@Model.Category.OgTitle' />
<meta property="og:image" content='@Model.Category.OgImage' />

@section Title{
	@Model.ViewData.Title
}


@section Styles{
	<link rel="stylesheet" href="~/minify/styles/euro2020.min.css" asp-append-version="true">
}

@section Scripts{
}

@(await Component.InvokeAsync("Menu"))

<section class="main">
	<div class="container">
		<div class="block block-main">
			@await Html.PartialAsync("_SubCategory")
			<div class="block__content">
				<h4>@Model.ViewData.HeadTitle</h4>


				<div class="container">
					<div class="block__content">
						@foreach (var post in Model.Posts)
						{
							<div class="card-vertical">
								<a href="@Url.Action("Single", "Home", new { slug = post.Slug  })" class="card-vertical__image">
									@{
										short flagSize = ImageWidth.Width300;
										string flagImage = post.GetImageBySize(flagSize);

										<picture>
											<source srcset="@Url.Content(flagImage)" type="image/webp" class="img-res">
											<source srcset="@Url.Content(flagImage)" type="image/jpeg" class="img-res">
											<img loading="lazy" src="@Url.Content(flagImage)" alt="@post.PostTitle" class="img-res img-block">
										</picture>
									}
								</a>
								<div class="group group-mobile">
									<a href="@Url.Action("Single", "Home", new { slug = post.Slug  })" class="card-vertical__title">@(post.PostSeoTitle != "" ? post.PostSeoTitle : post.PostTitle) </a>
								</div>
							</div>
						}
					</div>
				</div>


			</div>
		</div>
</section>

<script>

</script>