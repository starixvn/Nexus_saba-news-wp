                        </div>
                        <div class="row">
                            <div class="col"><span class="number number-5">5</span><span class="flag-croatia"></span><span class="country">Croatia</span></div>
                            <div class="col">0</div>
                            <div class="col">0</div>
                            <div class="col">0</div>
                            <div class="col">0</div>
                            <div class="col">0</div>
                            <div class="col point">0</div>
                        </div>
                    </div>

                    <div class="">
                        <h2 class="block__title"><span class="text-title">Lịch thi đấu</span></h2>
                    </div>
                </div>
			</div>
	</div>
</div>
