@using SabaNews.Core.Constants;
@using Wangkanai.Detection.Services;
@using Wangkanai.Detection.Models;
@inject IDetectionService DetectionService
@{
	bool isMobile = DetectionService.Device.Type == Device.Mobile;
	bool isTablet = DetectionService.Device.Type == Device.Tablet;
	bool isDesktop = DetectionService.Device.Type == Device.Desktop;
}

<meta name="description" content='@Model.ViewData.Description' />
<meta name="robots" content="noarchive">
<meta property="og:description" content='@Model.Category.OgDescription' />
<meta property="og:title" content='@Model.Category.OgTitle' />
<meta property="og:image" content='@Model.Category.OgImage' />

@section Title{
	@Model.ViewData.Title
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/euro2020_ranking.min.css" asp-append-version="true">
}

@section Scripts{
	<script src="~/js/euro2020/euro2020.js" asp-append-version="true"></script>
}


<div class="page">
	@(await Component.InvokeAsync("HeaderEvent"))
	<div class="main-content">
		<div class="container">
			<h2 class="block__title"><span class="text-title">@Model.ViewData.HeadTitle</span></h2>

			<div class="block__content">
                <div class="block">
                    <span class="previous"></span>
                    <span class="next"></span>
					<ul class="sub-category">
						@{
							var first = true;

						}

						@foreach (var post in Model.Posts)
						{
							var active = "";
							var hideTab = "";
							if (first)
							{
								active = "active";
							}
							if (isMobile & !first)
							{
								hideTab = "hide-tab";
							}
							first = false;
							<li class="sub-item @hideTab"><a href="javascript:;" data-slug="@post.Slug" class="tab-data  @active">@post.PostTitle</a></li>
						}

					</ul>
					<div class="post_content">
						@Html.Raw(Model.Posts[0].PostContent)
					</div>
                    
                </div>
                <div id="table-scroll-main" class="block table-scroll">
                    <div class="table-wrap">
                        <table class="main-table">
                            <thead>
                                <tr>
                                    <th class="fixed-side" scope="col">Thứ tự các đội xếp thứ 3</th>
                                    <th class="col">Trận</th>
                                    <th class="col">Thắng</th>
                                    <th class="col">Hòa</th>
                                    <th class="col">Thua</th>
                                    <th class="col">Hiệu số</th>
                                    <th class="col">Điểm</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fixed-side"><span class="number number-1">1</span><span class="flag-turkey"></span><span class="country">Thổ Nhĩ Kỳ</span></td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                </tr>
                                <tr>
                                    <td class="fixed-side"><span class="number number-2">2</span><span class="flag-switzerland"></span><span class="country">Thụy Sỹ</span></td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                </tr>
                                <tr>
                                    <td class="fixed-side"><span class="number number-3">3</span><span class="flag-italia"></span><span class="country">Ý</span></td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                </tr>
                                <tr>
                                    <td class="fixed-side"><span class="number number-4">4</span><span class="flag-wales"></span><span class="country">Xứ Wales</span></td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                </tr>
                                <tr>
                                    <td class="fixed-side"><span class="number number-5">5</span><span class="flag-croatia"></span><span class="country">Croatia</span></td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>0</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
			</div>
		</div>
	</div>
</div>
