<div class="modal auth-register" id="authModal" tabindex="-1" role="dialog">
    <div class="modal-content modal-auth">
        <div class="modal-body">
            <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <div class="main-auth">
                <a href="#" class="auth-logo">
                    <img src="/images/auth-logo.svg" alt="auth logo" />
                </a>
                <div class="register-action">
                    <div class="group-heading">
                        <div class="title">Tạo tài khoản</div>
                        <div class="slogan">Chào mừng bạn đến với SABAVN.NET</div>
                    </div>
                    <form id="form-register">
                        <div class="box-auth">
                            <div class="box-auth-child">
                                <div class="form-group-auth name-group">
                                    <label class="label-auth">@ViewResources.Name</label>
                                    <div class="group-input-auth">
                                        <input type="text" class="input-auth" placeholder="@ViewResources.Name" name="name" />
                                    </div>
                                    <div class="validate-error"></div>
                                </div>
                            </div>
                            <div class="box-auth-child">
                                <div class="form-group-auth email-group">
                                    <label class="label-auth">Email</label>
                                    <div class="group-input-auth">
                                        <input type="email" name="email" class="input-auth" placeholder="Email" autocomplete="new-email">
                                    </div>
                                    <div class="validate-error"></div>
                                </div>
                            </div>
                        </div>
                        <div class="box-auth">
                            <div class="box-auth-child">
                                <div class="form-group-auth password-group">
                                    <label class="label-auth">@ViewResources.Password</label>
                                    <div class="group-input-auth">
                                        <input type="password" name="password" class="input-auth" placeholder="@ViewResources.Password" autocomplete="new-password">
                                        <span class="toggle-pass">
                                            <i class="icon-form icon-show"></i>
                                            <i class="icon-form icon-hide" style="display: none"></i>
                                        </span>
                                    </div>
                                    <div class="validate-error"></div>
                                </div>
                            </div>
                            <div class="box-auth-child">
                                <div class="form-group-auth confirm-password-group">
                                    <label class="label-auth">@ViewResources.ConfirmPassword</label>
                                    <div class="group-input-auth">
                                        <input type="password" name="confirmPassword" class="input-auth" placeholder="@ViewResources.ConfirmPassword"  autocomplete="new-confirmPassword">
                                        <span class="toggle-pass">
                                            <i class="icon-form icon-show"></i>
                                            <i class="icon-form icon-hide" style="display: none"></i>
                                        </span>
                                    </div>
                                    <div class="validate-error"></div>
                                </div>
                            </div>
                        </div>
                        <div class="box-auth">
                            <div class="box-auth-child">
                                <div class="form-group-auth phone-group">
                                    <label class="label-auth">Số điện Thoại</label>
                                    <div class="group-input-auth">
                                        <input type="number" name="phone" class="input-auth" placeholder="Số điện Thoại">
                                    </div>
                                     <div class="validate-error"></div>
                                </div>
                            </div>
                            <div class="box-auth-child">
                                <div class="form-group-auth year-group">
                                    <label class="label-auth">Năm sinh</label>
                                    <div class="group-input-auth">
                                        <select class="input-auth select-auth" name="birthday">
                                            <option value="" selected>chọn năm sinh</option>
                                            @for(int i = 1990 ;  i <= DateTime.Now.Year ; i++)
                                            {
                                                <option class="color-other">@i</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="box-auth">
                             <div class="box-auth-child">
                                <div class="submit-auth captcha">
                                    <form action="" method="POST">
                                        <div class="g-recaptcha"  data-sitekey="6Lc_0iIqAAAAABwLiZGn7mLKk955WasDv7nf4sT4" data-action="LOGIN"></div>
                                    </form>
                                </div>
                             </div>
                              <div class="box-auth-child">
                                <div class="submit-auth">
                                    <button class="submit submit-register" type="button" >Tạo tài khoản</button>
                                </div>
                                <div class="group-question">
                                    Bạn đã có tài khoản? <a href="#">Đăng nhập ngay</a>
                                </div>
                              </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>