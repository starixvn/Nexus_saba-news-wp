@model bool

@section Title{
    @ViewResources.ResetPassword
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}

@section Scripts{
    <script src="~/minify/js/reset-password.min.js" asp-append-version="true"></script>
}
@(await Component.InvokeAsync("Menu"))
<section class="main">
    <div class="container">
        <div class="block  block-main">
            <div class="block__content block__title">
                <div class="reset-page">
                    <div class="reset-success" style="display:none">
                        <h3>Đổi mật khẩu thành công</h3>
                        <div class="auth-input">Bấm vào <span style="color:rgb(0,0,255); cursor: pointer; text-decoration:underline" class="auth-login" data-returnUrl="/">đây</span> để đăng nhập</div>
                    </div>
                    <div class="reset-action">
                        @if (Model)
                        {
                            <h3>@ViewResources.ResetPassword</h3>
                            <p>@ViewResources.InputNewPassword</p>
                            <form id="form-reset-password" class="mb-3">

                                <input type="hidden" name="id" value="@ViewBag.UserId" />
                                <input type="hidden" name="token" value="@ViewBag.Token" />
                                <p class="error summary-eror"></p>
                                <div class="form-modal">
                                    <input type="password" name="password" class="input-form" id="password" placeholder="@ViewResources.Password">
                                    <span class="toggle-pass">
                                        <i class="icon-form icon-show"></i>
                                        <i class="icon-form icon-hide" style="display: none"></i>
                                    </span>
                                </div>
                                <div class="form-modal">
                                    <input type="password" name="confirmPassword" class="input-form" placeholder="@ViewResources.ConfirmPassword">
                                    <span class="toggle-pass">
                                        <i class="icon-form icon-show"></i>
                                        <i class="icon-form icon-hide" style="display: none"></i>
                                    </span>
                                </div>
                                <button type="submit" class="btn-resetpass">@ViewResources.ResetPassword</button>
                            </form>
                        }
                        else
                        {
                            <h3>@ViewResources.ExpiredLink</h3>
                            <p>@ViewResources.IncorrectLinkForResetPassword</p>
                        }
                    </div>
                </div>
            </div>
        </div>
        @(await Component.InvokeAsync("Sidebar"))
    </div>
</section>