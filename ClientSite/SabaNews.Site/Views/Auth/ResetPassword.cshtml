@using SabaNews.Core.Constants;
@model bool

@section Title{
    @Constants.ResetPassword
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}

@section Scripts{
    <script src="~/minify/js/reset-password.min.js" asp-append-version="true"></script>
}

<section class="main">
    <div class="container">
        <div class="block block-main">
            <h2 class="block__title"><a></a></h2>
            <div class="block__content">
                <h4>@Constants.ResetPassword</h4>
            </div>
        </div>
        @(await Component.InvokeAsync("Sidebar"))
    </div>
    <div class="modal fade" id="resetModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>@(Model ? Constants.ResetPassword : Constants.ExpiredLink)</h3>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    @if (Model)
                    {
                        <p>Nhập mật khẩu mới</p>
                        <form id="form-reset-password" class="mb-3">
                            <input type="hidden" name="id" value="@ViewBag.UserId" />
                            <div class="form-group">
                                <input type="password" name="password" class="form-control" id="password" placeholder="Mật khẩu">
                            </div>
                            <div class="form-group">
                                <input type="password" name="confirmPassword" class="form-control" placeholder="Xác nhận mật khẩu">
                            </div>
                            <button type="submit" class="btn btn-primary">Đồng ý</button>
                        </form>
                    }
                    else
                    {
                        <p>Link đổi mật khẩu không đúng</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>