@model bool

@section Title{
    @ViewResources.ResetPassword
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/reset-password.min.css" asp-append-version="true">
}

@section Scripts{
    @* <script src="~/minify/js/reset-password.min.js" asp-append-version="true"></script> *@
    <script src="~/js/auth/reset-password.js" asp-append-version="true"></script>
}
@(await Component.InvokeAsync("Menu"))
<section class="main">
    <div class="container">
        <div class="reset-page">
            <div class="reset-action reset-success" style="display:none">
                <div class="reset-page-modal">
                    <div class="reset-page-modal-header">
                        <h3>Đổi mật khẩu thành công</h3>
                    </div>
                    <div class="reset-page-modal-body">
                        <div class="auth-input">Bấm vào <span class="auth-login" data-returnUrl="/">đây</span> để đăng nhập</div>
                    </div>
                </div>
            </div>
            <div class="reset-action">
                @if (Model)
                {
                    <div class="reset-page-modal">
                        <div class="reset-page-modal-header">
                            @* <h3>@ViewResources.ResetPassword</h3> *@
                            <h3>Tạo mật khẩu mới</h3>
                        </div> 
                        <div class="reset-page-modal-body">
                            <div class="validate-error summary-eror"></div>
                            <form id="form-reset-password">
                                <input type="hidden" name="id" value="@ViewBag.UserId" />
                                <input type="hidden" name="token" value="@ViewBag.Token" />
                                <div class="form-group-auth password">
                                    <div class="group-input-auth">
                                        <label class="label-auth">Mật khẩu</label>
                                        <div class="group-label-input">
                                            <input type="password" name="password" id="password" class="input-auth" placeholder="Nhập mật khẩu" autocomplete="new-password">
                                            <span class="toggle-pass">
                                                <i class="icon-form icon-show"></i>
                                                <i class="icon-form icon-hide" style="display: none"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="validate-error"></div>
                                </div>
                                <div class="form-group-auth new-password">
                                    <div class="group-input-auth">
                                        <label class="label-auth">Nhập lại mật khẩu</label>
                                        <div class="group-label-input">
                                            <input type="password" name="confirmPassword" id="confirmPassword" class="input-auth" placeholder="Nhập lại mật khẩu" autocomplete="new-confirmPassword">
                                            <span class="toggle-pass">
                                                <i class="icon-form icon-show"></i>
                                                <i class="icon-form icon-hide" style="display: none"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="validate-error"></div>
                                </div>
                                <div class="submit-auth">
                                    <button type="submit" class="btn-resetpass">Đổi mật khẩu</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="reset-page-modal">
                        <div class="reset-page-modal-header">
                           <h3>@ViewResources.ExpiredLink</h3>
                        </div> 
                        <div class="reset-page-modal-body">
                            <p class="auth-input">@ViewResources.IncorrectLinkForResetPassword</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>