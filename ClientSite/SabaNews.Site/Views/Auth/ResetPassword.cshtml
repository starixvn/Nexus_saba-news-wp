@using SabaNews.Core.Constants;
@model bool

@section Title{
    @ViewResources.ResetPassword
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}

@section Scripts{
    <script src="~/minify/js/reset-password.min.js" asp-append-version="true"></script>
}

<section class="main">
    <div class="container">
        <div class="block block-main">
            <h2 class="block__title"><a></a></h2>
            <div class="block__content">
                <h3>@(Model ? ViewResources.ResetPassword : ViewResources.ExpiredLink)</h3>
                <div class="reset-page">
                    @if (Model)
                    {
                        <p>@ViewResources.InputNewPassword</p>
                        <form id="form-reset-password" class="mb-3">
                            <input type="hidden" name="id" value="@ViewBag.UserId" />
                            <input type="hidden" name="token" value="@ViewBag.Token" />
                            <p class="error summary-eror"></p>
                            <div class="form-group">
                                <input type="password" name="password" class="form-control" id="password" placeholder="@ViewResources.Password">
                            </div>
                            <div class="form-group">
                                <input type="password" name="confirmPassword" class="form-control" placeholder="@ViewResources.ConfirmPassword">
                            </div>
                            <button type="submit" class="btn btn-primary">@ViewResources.ResetPassword</button>
                        </form>
                    }
                    else
                    {
                        <p>@ViewResources.IncorrectLinkForResetPassword</p>
                    }
                </div>
            </div>
        </div>
        @(await Component.InvokeAsync("Sidebar"))
    </div>
</section>