@model bool

@section Title{
    @ViewResources.ResetPassword
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/reset-password.min.css" asp-append-version="true">
}

@section Scripts{
    <script src="~/minify/js/reset-password.min.js" asp-append-version="true"></script>
}
@(await Component.InvokeAsync("Menu"))
<section class="main">
    <div class="container">
        <div class="reset-page">
            <div class="reset-success" style="display:none">
                <h3>Đổi mật khẩu thành công</h3>
                <div class="auth-input">Bấm vào <span style="color:rgb(0,0,255); cursor: pointer; text-decoration:underline" class="auth-login" data-returnUrl="/">đây</span> để đăng nhập</div>
            </div>
            <div class="reset-action">
                @if (Model)
                {
                    <div class="reset-action-header">
                        @* <h3>@ViewResources.ResetPassword</h3> *@
                        <h3>Tạo mật khẩu mới</h3>
                    </div> 
                    <div class="validate-error summary-eror"></div>
                    <div class="reset-action-body">
                        <form id="form-reset-password">
                            <input type="hidden" name="id" value="@ViewBag.UserId" />
                            <input type="hidden" name="token" value="@ViewBag.Token" />
                            <div class="form-group-auth password">
                                <label class="label-auth">Mật khẩu</label>
                                <div class="group-input-auth">
                                    <input type="password" name="password" id="password" class="input-auth" placeholder="@ViewResources.Password" autocomplete="new-password">
                                    <span class="toggle-pass">
                                        <i class="icon-form icon-show"></i>
                                        <i class="icon-form icon-hide" style="display: none"></i>
                                    </span>
                                </div>
                                <div class="validate-error"></div>
                            </div>
                            <div class="form-group-auth password">
                                <label class="label-auth">Nhập lại mật khẩu</label>
                                <div class="group-input-auth">
                                    <input type="password" name="confirmPassword" id="confirmPassword" class="input-auth" placeholder="@ViewResources.ConfirmPassword" autocomplete="new-confirmPassword">
                                    <span class="toggle-pass">
                                        <i class="icon-form icon-show"></i>
                                        <i class="icon-form icon-hide" style="display: none"></i>
                                    </span>
                                </div>
                                <div class="validate-error"></div>
                            </div>
                            <button type="submit" class="btn-resetpass">@ViewResources.ResetPassword</button>
                        </form>
                    </div>
                }
                else
                {
                    <h3>@ViewResources.ExpiredLink</h3>
                    <p>@ViewResources.IncorrectLinkForResetPassword</p>
                }
            </div>
        </div>
    </div>
</section>