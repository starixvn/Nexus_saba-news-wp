@model bool

@section Title{
	@ViewResources.ConfirmEmail
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}
@(await Component.InvokeAsync("Menu"))
<section class="main">
	<div class="container">
		<div class="block block-main">
			<div class="block__content block__title">
				<h3>@(Model ? ViewResources.ConfirmEmail : ViewResources.ExpiredLink)</h3>
				<p>@(Model ? ViewResources.ConfirmEmailSuccessfully : ViewResources.IncorrectLinkForConfirmEmail)</p>
			</div>
		</div>
		@(await Component.InvokeAsync("Sidebar"))
	</div>
</section>