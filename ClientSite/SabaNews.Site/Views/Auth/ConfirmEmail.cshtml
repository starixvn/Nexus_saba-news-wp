@model bool

@section Title{
	@ViewResources.ConfirmEmail
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}
@(await Component.InvokeAsync("Menu"))
<section class="main">
    <div class="container">
        <div class="block block-main">
            <div class="block__content block__title">
                @if (Model)
                {
                    <h3>@ViewResources.ConfirmEmailSuccessfully</h3>
                    <div class="auth-input">Bấm vào <span style="color:rgb(0,0,255); cursor: pointer; text-decoration:underline" class="auth-login" data-returnUrl="/">đây</span> để đăng nhập</div>
                }
                else
                {
                    <h3>@ViewResources.ExpiredLink</h3>
                    <div>@ViewResources.IncorrectLinkForConfirmEmail</div>
                }
            </div>
        </div>
        @await Html.PartialAsync(ViewResources.SidebarPostView, new PostComponentViewModel { })
    </div>
</section>