@using SabaNews.Core.Constants;
@model bool

@section Title{
    @Constants.ConfirmEmail
}

@section Styles{
    <link rel="stylesheet" href="~/minify/styles/news.min.css" asp-append-version="true">
}

@section Scripts{
    <script src="~/minify/js/confirm-email.min.js" asp-append-version="true"></script>
}

<section class="main">
    <div class="container">
        <div class="block block-main">
            <h2 class="block__title"><a></a></h2>
            <div class="block__content">
                <h4>@Constants.ConfirmEmail</h4>
            </div>
        </div>
        @(await Component.InvokeAsync("Sidebar"))
    </div>
    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>@(Model ? Constants.ConfirmEmail : Constants.ExpiredLink)</h3>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>@(Model ? "Xác thực email thành công" : "Link xác thực email không đúng")</p>
                </div>
            </div>
        </div>
    </div>
</section>