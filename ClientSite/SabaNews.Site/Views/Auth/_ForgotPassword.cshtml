<div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h3>@ViewResources.ResetPassword</h3>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <p>@ViewResources.InputEmailForResetPassword</p>
            <form id="form-forgot-password" class="mb-3">
                <p class="error summary-eror"></p>
                <div class="form-group">
                    <input type="email" name="email" class="form-control" placeholder="@ViewResources.Email" required>
                </div>
                <button type="submit" class="btn btn-primary">@ViewResources.ResetPassword</button>
            </form>
        </div>
    </div>
</div>
