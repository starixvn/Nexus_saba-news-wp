<div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content modal-auth">
        <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        <div class="modal-body modal-resetpass">
            <div class="form-resetpass">
                <h3 class="heading-resetpass">@ViewResources.ResetPassword</h3>
                <p class="form-title">@ViewResources.InputEmailForResetPassword</p>
                <form id="form-forgot-password" class="mb-3">
                    <p class="error summary-eror"></p>
                    <div class="form-modal">
                        <input type="email" name="email" class="input-form" placeholder="@ViewResources.Email" required>
                    </div>
                    <button type="submit" class="btn-resetpass">@ViewResources.ResetPassword</button>
                </form>
            </div>
        </div>
    </div>
</div>
