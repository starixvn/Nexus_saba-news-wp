@section Title{
	@ViewResources.NotFoundPostMsg
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/profile.min.css" asp-append-version="true">
}

<section class="main">

    <div class="container profile-container">
        <div class="block block-main">
            <div class="profile">
                <div class="profile__avatar">J</div>
                <div class="profile__name">Jimmy</div>
                <div class="profile__date">
                    <p>Tham gia từ</p>
                    <p>18/03/2021</p>
                </div>
                <ul class="profile__control">
                    <li><a href="#">Hoạt động bình luận</a></li>
                    <li><a href="#">Tin đã lưu (1)</a></li>
                    <li><a href="#">Tin đã xem</a></li>
                </ul>
                <ul class="profile__nav">
                    <li class="active-control"><a href="#">Tài khoản của tôi</a></li>
                    <li><a href="#">Thoát</a></li>
                </ul>
            </div>
        </div>
        <div class="block block-extension">
            <div class="controls">
                <h2 class="block__title"><a>@ViewResources.MyAccount </a></h2>
                <div class="controls__choose">
                    <div class="title">Ảnh đại diện</div>
                    <div class="input-upload">
                        <input type="file" class="input-file" id="act-upload">
                        <span class="txt-img">Tải lên ảnh đại diện mới</span>
                    </div>
                </div>

                <div class="controls__account line">
                    <div class="title">Tài Khoản</div>
                    <div class="group-table">
                        <div class="left-table">
                            <div class="label-fill">Email</div>
                        </div>
                        <div class="right-table">
                            <div class="box-control">
                                <div class="main-fill">
                                    <ul class="txt-fill">
                                        <li class="txt-feild">jimmynguyen@gmail.com</li>
                                        <li class="validate">Chưa xác thực</li>
                                    </ul>
                                </div>
                                <a href="#" class="action">Thay Đổi</a>
                            </div>
                            <div class="box-edit-form">
                                <div class="title">Đổi email</div>
                                <input type="password" name="password" value="" class="input-edit" placeholder="Nhập mật khẩu" />
                                <input type="email" name="email" value="" class="input-edit" placeholder="Nhập email" />
                                <button class="btn-submit-edit">Lưu lại</button>
                                <span class="close-edit">close</span>
                            </div>
                            <p class="comfirm"><a href="#" class="action">Xác thực ngay</a></p>
                        </div>
                    </div>

                    <div class="group-table">
                        <div class="left-table">
                            <div class="label-fill">Điện thoại</div>
                        </div>
                        <div class="right-table">
                            <div class="box-control">
                                <div class="main-fill">
                                    <ul class="txt-fill">
                                        <li class="txt-feild">0123456789</li>
                                        <li class="validate">Chưa xác thực</li>
                                    </ul>
                                </div>
                                <a href="#" class="action">Thêm</a>
                            </div>
                            <div class="box-edit-form">
                                <div class="title">Số điện thoại</div>
                                <input type="number" name="phone" value="" class="input-edit" placeholder="Nhập số điện thoại" />
                                <button class="btn-submit-edit">Lưu lại</button>
                                <span class="close-edit">close</span>
                            </div>
                            <p class="commitment">Sabasport cam kết bảo mật thông tin này</p>
                        </div>
                    </div>


                    <div class="group-table">
                        <div class="left-table">
                            <div class="label-fill">Mật khẩu</div>
                        </div>
                        <div class="right-table">
                            <div class="box-control">
                                <input type="password" name="password" value="" class="input-password" />
                                <a href="#" class="action">Đổi mật khẩu</a>
                            </div>
                            <div class="box-edit-form">
                                <div class="title">Đổi mật khẩu</div>
                                <input type="password" name="oldpassword" value="" class="input-edit" placeholder="Nhập mật khẩu cũ" />
                                <input type="password" name="newpassword" value="" class="input-edit" placeholder="Tạo mật khẩu mới" />
                                <button class="btn-submit-edit">Lưu lại</button>
                                <p class="forgot-pass"><a href="#">Lấy lại mật khẩu</a></p>
                                <span class="close-edit">close</span>
                            </div>
                        </div>
                    </div>

                </div>



                <div class="controls__account line">
                    <div class="title">Thông tin cá nhân</div>
                    <div class="group-table">
                        <div class="left-table">
                            <div class="label-fill">Họ và tên</div>
                        </div>
                        <div class="right-table">
                            <div class="box-control">
                                <div class="main-fill">
                                    <ul class="txt-fill">
                                        <li class="txt-feild">Jimmy Nguyen</li>
                                        <li class="validate">Chưa có tên</li>
                                    </ul>
                                </div>
                                <a href="#" class="action">Thêm</a>
                            </div>
                            <div class="box-edit-form">
                                <div class="title">Họ và tên</div>
                                <input type="text" name="name" value="" class="input-edit" placeholder="Nhập họ và tên" />
                                <button class="btn-submit-edit">Lưu lại</button>
                                <span class="close-edit">close</span>
                            </div>
                            <p class="commitment">Hiển thị khi bạn tham gia bình luận</p>
                        </div>
                    </div>

                    <div class="group-table">
                        <div class="left-table">
                            <div class="label-fill">Giới tính</div>
                        </div>
                        <div class="right-table">
                            <div class="box-control">
                                <div class="main-fill">
                                    <ul class="txt-fill">
                                        <li class="txt-feild">Nam</li>
                                        <li class="validate">Chưa Lựa chọn</li>
                                    </ul>
                                </div>
                                <a href="#" class="action">Thêm</a>
                            </div>
                            <div class="box-edit-form">
                                <div class="title">Giới tính</div>
                                <div class="radio-group">
                                    <div class="item-radio">
                                        <input type="radio" id="male" name="gender" value="male">
                                        <label for="male">Nam</label>
                                    </div>
                                    <div class="item-radio">
                                        <input type="radio" id="female" name="gender" value="female">
                                        <label for="female">Nữ</label>
                                    </div>
                                    <div class="item-radio">
                                        <input type="radio" id="other" name="gender" value="other">
                                        <label for="other">Khác</label>
                                    </div>
                                </div>
                                <button class="btn-submit-edit">Lưu lại</button>
                                <span class="close-edit">close</span>
                            </div>
                            <p class="commitment">Sabasport cam kết bảo mật thông tin này</p>
                        </div>
                    </div>


                </div>

                <div class="controls__account line">
                    <div class="title">Mạng xã hội</div>
                    <div class="group-table">
                        <div class="left-table">
                            <div class="label-fill">Facebook</div>
                        </div>
                        <div class="right-table">
                            <div class="box-control">
                                <div class="main-fill">
                                    <ul class="txt-fill">
                                        <li class="validate">Chưa liên kết</li>
                                    </ul>
                                </div>
                                <a href="#" class="action">Liên kết</a>
                            </div>
                        </div>
                    </div>
                    <div class="group-table">
                        <div class="left-table">
                            <div class="label-fill">Google</div>
                        </div>
                        <div class="right-table">
                            <div class="box-control">
                                <div class="main-fill">
                                    <ul class="txt-fill">
                                        <li class="validate">Chưa liên kết</li>
                                    </ul>
                                </div>
                                <a href="#" class="action">Liên kết</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>