@section Title{
	@ViewResources.NotFoundPostMsg
}

@section Styles{
	<link rel="stylesheet" href="~/minify/styles/profile.min.css" asp-append-version="true">
}

<section class="main">

    <div class="container profile-container">
        <div class="block block-main">
            <div class="profile">
                <div class="profile__avatar">J</div>
                <div class="profile__name">Jimmy</div>
                <div class="profile__date">
                    <p>Tham gia từ</p>
                    <p>18/03/2021</p>
                </div>
                <ul class="profile__control">
                    <li><a href="#">Hoạt động bình luận</a></li>
                    <li><a href="#">Tin đã lưu (1)</a></li>
                    <li><a href="#">Tin đã xem</a></li>
                </ul>
                <ul class="profile__nav">
                    <li class="active-control"><a href="#">Tài khoản của tôi</a></li>
                    <li><a href="#">Thoát</a></li>
                </ul>
            </div>
        </div>
        <div class="block block-extension">
            <div class="profile">
                <h2 class="block__title"><a>@ViewResources.MyAccount </a></h2>
                <div class="block__content">
                    <h4>Content</h4>
                </div>
            </div>
        </div>
    </div>

