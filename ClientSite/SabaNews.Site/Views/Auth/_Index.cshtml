<div class="modal fade" id="authModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <nav>
                    <ul class="nav nav-tabs nav-justified" id="nav-tab" role="tablist">
                        <li class="nav-item nav-link">
                            <a id="nav-login-tab" data-toggle="tab" href="#nav-login" role="tab" aria-controls="nav-login" aria-selected="true">Đăng nhập</a>
                        </li>
                        <li class="nav-item nav-link">
                            <a id="nav-register-tab" data-toggle="tab" href="#nav-register" role="tab" aria-controls="nav-register" aria-selected="false">Tạo tài khoản</a>
                        </li>
                    </ul>
                </nav>
                <div class="tab-content" id="nav-tabContent">
                    <div class="tab-pane fade show active" id="nav-login" role="tabpanel" aria-labelledby="nav-login-tab">
                        <div class="row mb-3 mt-3">
                            <div class="col-7">
                                <p>Đăng nhập với email</p>
                                <form id="form-login">
                                    <p class="error summary-eror"></p>
                                    <div class="form-group">
                                        <input type="email" name="email" class="form-control" placeholder="Email">
                                    </div>
                                    <div class="form-group">
                                        <input type="password" name="password" class="form-control" placeholder="Mật khẩu">
                                    </div>
                                    <button type="submit" class="btn btn-primary">Đăng nhập</button>
                                </form>
                                <a href="javascript:;" id="forgot-password">Quên mật khẩu</a>
                            </div>
                            <div class="col-5">
                                Social login
                                <a class="btn btn-danger social-login" href="ExternalAuthentication/GoogleLogin?returnUrl=">Google</a>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="nav-register" role="tabpanel" aria-labelledby="nav-register-tab">
                        <div class="row mb-3 mt-3">
                            <div class="col-7">
                                <p>Tạo tài khoản</p>
                                <form id="form-register">
                                    <p class="error summary-eror"></p>
                                    <div class="form-group">
                                        <input type="text" class="form-control" placeholder="Tên" name="name" />
                                    </div>
                                    <div class="form-group">
                                        <input type="email" class="form-control" placeholder="Email" name="email" />
                                    </div>
                                    <div class="form-group">
                                        <input type="password" id="password" class="form-control" placeholder="Mật khẩu" name="password" />
                                    </div>
                                    <div class="form-group">
                                        <input type="password" class="form-control" placeholder="Xác nhận mật khẩu" name="confirmPassword" />
                                    </div>
                                    <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
                                </form>
                            </div>
                            <div class="col-5">
                                Social login
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('.social-login').each(function (i, v) {
            var href = $(this).attr("href") + window.location.pathname;
            $(this).attr("href", href);
        });
    });
</script>