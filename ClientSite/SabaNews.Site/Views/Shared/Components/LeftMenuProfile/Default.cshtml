@using SabaNews.Core.Constants;

@{
	ViewBag.Page = ViewBag.Page != null ? ViewBag.Page : "";
}

<div class="profile">
	@if (Model.Photo == null)
	{
		<div class="profile__avatar">@Model.Name.Substring(0, 1) </div>
	}
	else if (Model.Photo.ToLower().Contains("https://") || Model.Photo.ToLower().Contains("http://"))
	{
		<div class="profile__avatar"><img class="profile_image" loading="lazy" src="@Model.Photo" width="300" data-name="@Model.Name.Substring(0, 1)" /></div>
	}
	else
	{
		<div class="profile__avatar"><img class="profile_image" loading="lazy" src="/upload/@Model.Photo" width="300" data-name="@Model.Name.Substring(0, 1)" /></div>
	}

	<div class="profile__name">@Model.Name</div>
	<div class="profile__date">
		<p>Tham gia từ @Model.RegisterDate.ToString("dd/MM/yyyy")</p>
	</div>
	<ul class="profile__control">
		<li class="@(ViewBag.Page == Constants.ProfileListPostsPage ? "active-control" : "")">
			<a href="@Url.Action("ListSavedPosts", "Profile")">@ViewResources.SavedPost @(@Model.HandleSavePosts.Count > 0 ? "(" + @Model.HandleSavePosts.Count + ")" : "" )</a>
		</li>
		<li class="@(ViewBag.Page == Constants.ProfileIndexPage ? "active-control" : "")">
			<a href="@Url.Action("Index", "Profile")">@ViewResources.MyAccount</a>
		</li>

		@if (Model.Role == Constants.AdministratorRole)
		{
			<li class="@(ViewBag.Page == Constants.ProfileSendMailPage ? "active-control" : "")"><a href="@Url.Action("Create", "Email")">@ViewResources.SendEmail</a></li>
			<li class="@(ViewBag.Page == Constants.ProfileListSendMailPage ? "active-control" : "")"><a href="@Url.Action("Index", "Email")">@ViewResources.ListSentMail</a></li>
		}
		<li><a href="javascript:;" class="profile_logout">@ViewResources.Exit</a></li>
	</ul>
</div>
