@using sabanews.Constants;
<div class="block block-extension">
	<h2 class="block__title"><a href="@Url.Action("Category", "Home", new { parent = Constants.CategorySlug})">Tin mới nhất</a></h2>
	<div class="block__content">
		<div class="block-item">
			@foreach (var post in Model.Posts)
			{
				<div class="card-vertical">
					<a class="card-vertical__title" href="@Url.Action("Single", "Home", new { slug = post.Slug })">@post.PostTitle</a>
					<p class="card-vertical__datetime">@post.PostTime</p>
				</div>
			}
		</div>
		<div class="block block-calendar">
			<div class="box-calendar">
				@{
					var nextMonth = Model.CurrentMonth + 1;
					var prevMonth = Model.CurrentMonth - 1;
					int nextYear = Model.CurrentYear;
					int prevYear = Model.CurrentYear;
					if (nextMonth > 12)
					{
						nextMonth = 1;
						nextYear++;
					}
					else
					{
						nextMonth = nextMonth < 10 ? "0" + nextMonth : nextMonth;
					}
					if (prevMonth < 1)
					{
						prevMonth = 12;
						prevYear--;
					}
					else
					{
						prevMonth = prevMonth < 10 ? "0" + prevMonth : prevMonth;
					}

				}
				<a href="@Url.Action("DateSearch", "Home", new { date = prevYear + "-" +prevMonth })" class="btn btn-left-calendar icon-arrow-left"></a>
				<div class="date-year">Tháng @Model.CurrentMonth Năm @Model.CurrentYear</div>
				<a href="@Url.Action("DateSearch", "Home", new { date =  nextYear + "-" + nextMonth })" class="btn btn-right-calendar icon-arrow-right"></a>
			</div>
			<table class="table-calendar">
				<thead>
					<tr>
						<th scope="col" title="Monday">T2</th>
						<th scope="col" title="Tuesday">T3</th>
						<th scope="col" title="Wednesday">T4</th>
						<th scope="col" title="Thursday">T5</th>
						<th scope="col" title="Friday">T6</th>
						<th scope="col" title="Saturday">T7</th>
						<th scope="col" title="Sunday">CN</th>
					</tr>
				</thead>
				<tbody>
					@{
						var colSpan = Model.FirstDayOfWeek - 1;
						var dayOfFirstWeek = 8 - Model.FirstDayOfWeek;
						var month = Model.CurrentMonth >= 10 ? Model.CurrentMonth : "0" + Model.CurrentMonth;
						int weeks = (int)Math.Ceiling((Model.Days - 1) / 7.0);

					}
					<tr>
						<td colspan="@colSpan">&nbsp;</td>
					</tr>
					@for (int week = 0; week <= weeks; week++)
					{
						var start = dayOfFirstWeek + 1 + (week - 1) * 7;
						start = start < 1 ? 1 : start;
						var end = (start + 7 > Model.Days) ? Model.Days + 1 : start + 7;
						<tr>
							@if (week == 0 && colSpan > 0)
							{
								end = end - colSpan;
								<td colspan="@colSpan">&nbsp;</td>
							}
							@for (int day = start; day < end; day++)
							{
								var date = Model.CurrentYear + "-" + month + "-" + (day < 10 ? "0" + day.ToString() : day.ToString());
								<td class="@(day < Model.CurrentDay ? "lastday" : "") @date" id="@(day == Model.CurrentDay ? "today" : "")">
									@if (day <= Model.CurrentDay)
									{
										<a href="@Url.Action("DateSearch", "Home", new { date = date })" class="@(day <= Model.CurrentDay ? "prev" : "")">@day</a>
									}
									else
									{
										@day
									}

								</td>
							}
						</tr>
					}
				</tbody>
			</table>

		</div>
	</div>
</div>
