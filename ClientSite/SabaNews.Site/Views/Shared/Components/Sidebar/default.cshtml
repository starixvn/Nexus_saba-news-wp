@using Wangkanai.Detection.Services;
@using Wangkanai.Detection.Models;
@using SabaNews.Core.Constants;
@inject IDetectionService DetectionService
@{
    bool isMobile = DetectionService.Device.Type == Device.Mobile;
}

<div class="block block-extension">
    <div class="block-sticky">
        <h2 class="block__title"><a href="@Url.Action("Category", "Home")">@ViewData[ViewResources.ViewDataHeadTitle]</a></h2>
        <div class="block__content">
            <div class="block-item">
                @foreach (var post in Model.Posts)
                {
                    <div class="post card-vertical">
                        @if (Model.Posts.IndexOf(post) == 0)
                        {
                            string featureImg = isMobile ? post.GetImageBySize(ImageWidth.Width768) : post.FeatureImage;
                            <a href="@Url.Action("Single", "Post", new { slug = post.Slug })" class="card-vertical__image thumb thumb-65">
                                <picture>
                                    <source srcset="@Url.Content(featureImg)" type="image/webp" class="img-res">
                                    <source srcset="@Url.Content(featureImg)" type="image/jpeg" class="img-res">
                                    <img asp-append-version="true" loading="lazy" src="@Url.Content(featureImg)" alt="@post.PostTitle" class="img-res img-block lazy">
                                </picture>
                            </a>}
                        <a class="card-vertical__title" href="@Url.Action("Single", "Post", new { slug = post.Slug })">@post.PostTitle</a>
                        <p class="card-vertical__datetime">
                            <span>@post.PostTime</span>
                            @if (post.CommentCount > 0)
                            {
                                <a href="@Url.Action("Single", "Post", new { slug = post.Slug  })#comment" class="comment"><i class="icon-mode_comment_full"></i> <i class="number">@post.CommentCount</i></a>}
                        </p>
                    </div>

                    <div class="skeleton skeleton-vertical">
                        @{
                            if (Model.Posts.IndexOf(post) == 0)
                            {
                                <a class="skeleton-vertical__image"></a>}
                        }
                        <a class="skeleton-vertical__title"></a>
                        <p class="skeleton-vertical__description text-description"></p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>