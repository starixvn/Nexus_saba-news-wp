
@{
	int CurrentPage = Convert.ToInt32(Model.CurrentPage);
	int TotalPages = Convert.ToInt32(Model.TotalPages);
	var pageLast = Model.TotalPages;
	var pageNext = CurrentPage + 1;
	var pagePrev = CurrentPage - 1;
	var checkPrev = CurrentPage > 1 ? "paging" : "disabled";
	var checkNext = CurrentPage < TotalPages ? "paging" : "disabled";
}

@if (TotalPages > 1)
{
	<div class="form-input">
		<p class="label-admin">Page size</p>
		<select class="custom-input" id="page-size">
			<!option value="10" @(Model.PageSize == 10 ? "selected" : "")>10</!option>
			<!option value="20" @(Model.PageSize == 20 ? "selected" : "")>20</!option>
			<!option value="50" @(Model.PageSize == 50 ? "selected" : "")>50</!option>
			<!option value="100" @(Model.PageSize == 100 ? "selected" : "")>100</!option>
		</select>
	</div>
	<div class="pagination">
		<a href="javascript:;" data-page="1" class="icon-pagination icon-page-first @checkPrev"></a>
		<a href="javascript:;" data-page="@pagePrev" class="icon-pagination icon-chevron-left @checkPrev"></a>
		<ul class="main-pagination">
			@{ var front = (CurrentPage - 1 > 2) ? 2 : CurrentPage - 1;
				front = (CurrentPage - 1 == 3) ? 3 : front;
				var back = (TotalPages - CurrentPage > 2) ? 2 : TotalPages - CurrentPage;
				back = (TotalPages - CurrentPage == 3) ? 3 : back;

				if (CurrentPage - 4 >= 1)
				{
					<li class="items-pagination"><a href="javascript:;" data-page="1" class="item paging">1</a></li>
					<li class="items-pagination"><a class="item">...</a></li>
				}

				for (var i = CurrentPage - front; i <= CurrentPage + back; i++)
				{
					var active = i == CurrentPage ? "active" : "";
					<li class="items-pagination @active"><a href="javascript:;" data-page="@i" class="item paging">@i</a></li>
				}

				if (CurrentPage + 4 <= TotalPages)
				{
					<li class="items-pagination"><a class="item">...</a></li>
					<li class="items-pagination"><a href="javascript:;" data-page="@pageLast" class="item paging">@Model.TotalPages</a></li>
				} }
		</ul>
		<a href="javascript:;" data-page="@pageNext" class="icon-pagination icon-chevron-right @checkNext"></a>
		<a href="javascript:;" data-page="@pageLast" class="icon-pagination icon-page-last @checkNext"></a>
	</div>
}