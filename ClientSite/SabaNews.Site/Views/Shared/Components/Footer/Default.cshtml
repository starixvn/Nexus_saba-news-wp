@using SabaNews.Core.Constants;
@using System.Linq;
@model IEnumerable<Menu>;

@{
    var topMenu = Model.Where(item => item.ParentId == 0).ToList();
    var footballCateId = 0;
    var vnCateId = 0;
    var euroCateId = 0;
    var englishCateId = 0;
    var tbnCateId = 0;
    var italyCateId = 0;
    var franceCateId = 0;
    var germanyCateId = 0;
    var globalCateId = 0;
    foreach(var item in Model)
    {
        switch (item.CateSlug)
        {
            case CategorySlug.Football:
                footballCateId = item.PostId;
                break;
            case CategorySlug.Vietnam:
                vnCateId = item.PostId;
                break;
            case CategorySlug.Europe:
                euroCateId = item.PostId;
                break;
            case CategorySlug.England:
                englishCateId = item.PostId;
                break;
            case CategorySlug.TBN:
                tbnCateId = item.PostId;
                break;
            case CategorySlug.Italia:
                italyCateId = item.PostId;
                break;
            case CategorySlug.France:
                franceCateId = item.PostId;
                break;
            case CategorySlug.Germany:
                germanyCateId = item.PostId;
                break;
            case CategorySlug.International:
                globalCateId = item.PostId;
                break;
        }
    }
}

