@functions {
    private string getMenuLink(Menu menu)
    {
        if (menu == null) return null;
        var link = "/tin-the-thao/" + menu.CateSlug;
        if (menu.PageSlug == "lich-thi-dau")
        {
            link = Url.Action("Index", "Soccer");
        }
        else if (menu.PageSlug == "warning")
        {
            link = Url.Action("Warning", "Home");
        }
        else if (menu.CateSlug == "video")
        {
            link = "/video";
        }
        return link;
    }
}