@using SabaNews.Core.Constants;
@using System.Linq;
@model IEnumerable<Menu>;

@{
    var topMenu = Model.Where(item => item.ParentId == 0).ToList();
    var footballCateId = 0;
    var vnCateId = 0;
    var euroCateId = 0;
    var englishCateId = 0;
    var tbnCateId = 0;
    var italyCateId = 0;
    var franceCateId = 0;
    var germanyCateId = 0;
    var globalCateId = 0;
    foreach(var item in Model)
    {
        switch (item.CateSlug)
        {
            case CategoryKey.Football:
                footballCateId = item.PostId;
                break;
            case CategoryKey.Vietnam:
                vnCateId = item.PostId;
                break;
            case CategoryKey.Europe:
                euroCateId = item.PostId;
                break;
            case CategoryKey.England:
                englishCateId = item.PostId;
                break;
            case CategoryKey.TBN:
                tbnCateId = item.PostId;
                break;
            case CategoryKey.Italia:
                italyCateId = item.PostId;
                break;
            case CategoryKey.France:
                franceCateId = item.PostId;
                break;
            case CategoryKey.Germany:
                germanyCateId = item.PostId;
                break;
            case CategoryKey.International:
                globalCateId = item.PostId;
                break;
        }
    }
}

