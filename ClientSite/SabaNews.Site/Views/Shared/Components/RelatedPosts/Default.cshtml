@using SabaNews.Core.Constants;
@using static SabaNews.Site.Extensions.DeviceHelper;

@{
    bool isMobile = IsMobile(Context.Request.Headers["User-Agent"].ToString());
   
}

<div class="block__content">
    <h3 class="block__title"><a>@ViewBag.Title</a></h3>
    @foreach (var post in Model)
    {
        string featureImg = isMobile ? post.GetImageBySize(ImageWidth.Width768) : post.FeatureImage;
        <div class="post card-horizontal card-horizontal-highlight">
            <a href="@Url.Action("Single", "Post", new { slug = post.Uri })" class="card-horizontal__image hover-image">
                <picture>
                    <source srcset="@Url.Content(featureImg)" type="image/webp" class="img-res">
                    <source srcset="@Url.Content(featureImg)" type="image/jpeg" class="img-res">
                    <img data-original="@Url.Content(featureImg)" src="@Url.Content(featureImg)" alt="@post.PostTitle" class="img-res img-block lazy">
                    <noscript>
                        <img src="@Url.Content(featureImg)" alt="@post.PostTitle" class="img-res img-block lazy">
                    </noscript>
                </picture>
            </a>
            <div class="card-horizontal__content">
                <h4><a class="title" href="@Url.Action("Single", "Post", new { slug = post.Uri })">@post.PostTitle</a></h4>
                <p class="datetime">
                    <span>@post.PostTime</span>
                    @if (post.CommentCount > 0)
                    {
                        <a href="@Url.Action("Single", "Post", new { slug = post.Uri  })#comment" class="comment"><i class="icon-mode_comment"></i> <i class="number">@post.CommentCount</i></a>
                    }
                </p>
                <p class="description">@post.PostExcerpt</p>
            </div>
        </div>
    }
</div>