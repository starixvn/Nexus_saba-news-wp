<div class="banner-change-domain banner-left">
	<a href="@(string.IsNullOrEmpty(Model.DesktopLeftNavigationUrl) ? "javascript:;" : Model.DesktopLeftNavigationUrl)">
		<img loading="lazy" src="@Model.DesktopLeftUrl" asp-append-version="true" class="img-res" width="200">
	</a>
</div>
<div class="banner-change-domain banner-right">
	<a href="@(string.IsNullOrEmpty(Model.DesktopRightNavigationUrl)? "javascript:;" : Model.DesktopRightNavigationUrl)">
		<img loading="lazy" src="@Model.DesktopRightUrl" asp-append-version="true" width="200">
	</a>
</div>