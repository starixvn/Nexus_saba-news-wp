@using SabaNews.Core.Constants;
@using System.Linq;
@model MenuViewModel;

<div class="header @Model.Page">
    <div class="button-mobile">
        <span class="line-mb"></span>
        <span class="line-mb"></span>
        <span class="line-mb"></span>
    </div>
    <div class="header-controls">
        <div class="container padding-mobile-none">
            <div class="banner-euro-desktop banner-desktop-top"></div>
            @*<div class="skeleton-desktop skeleton-banner">
                    <div class="skeleton-banner-euro-desktop"></div>
                </div>*@

            <div class="logo">
                <a href="@Url.Action("Index", "Home")">
                    <img src="~/images/sabasports.svg" alt="saba-sports" asp-append-version="true">
                </a>
            </div>
            <ul class="header-auth-provider">
                <li class="item-control languages-box">
                    <div class="language-select"><span class="flag flag-vn"></span><span class="country">Tiếng Việt</span></div>
                    <ul class="languages-list">
                        <li><a class="lang-item" href="https://www.sabasports.cn/"><span class="flag flag-cn"></span><span>简体中文</span></a>
                        <li>
                            <a class="lang-item" href="https://www.sabasports.com/"><span class="flag flag-en"></span><span>English</span></a>
                        </li>
                        <li>
                            <a class="lang-item" href="https://www.sabasports.in/"><span class="flag flag-in"></span><span>India</span></a>
                        </li>
                    </ul>
                </li>
                <li class="item-control search-desktop search-input">
                    <form action="/Search" method="post" id="search">
                        <input class="keyword-input search-box" id="search-keyword" type="text" placeholder="Tìm kiếm...">
                        <button type="submit" class="btn btn-search" aria-label="search">
                            <i class="icon-search"></i>
                        </button>
                    </form>
                </li>

                <li class="item-control notification-auth">
                    <span class="bell">
                        <a href="#" class="auth-bell"><i class="icon-bell"></i></a>
                        <a href="#" class="number-bell">10</a>
                    </span>
                </li>

                <li class="item-control auth-input">
                    @if (Model.IsAuthenticated)
                    {
                        <ul class="auth-provider">
                            @if (Model.User.Photo == null)
                            {
                                <li class="avatar-user">@Model.User.Name.Substring(0, 1)</li>
                            }
                            else if (Model.User.Photo.ToLower().Contains("https://") || Model.User.Photo.ToLower().Contains("http://"))
                            {
                                <li class="avatar-user"><img class="profile_image" loading="lazy" src="@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></li>
                            }
                            else
                            {
                                <li class="avatar-user"><img class="profile_image" loading="lazy" src="/uploads/@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></li>
                            }
                            <li class="auth-displayname"><a class="item display-user">@Model.User.Name</a></li>
                        </ul>
                        <ul class="box-auth">
                            <li>
                                <ul class="auth-provider">
                                    @if (Model.User.Photo == null)
                                    {
                                        <li class="avatar-user">@Model.User.Name.Substring(0, 1)</li>
                                    }
                                    else if (Model.User.Photo.ToLower().Contains("https://") || Model.User.Photo.ToLower().Contains("http://"))
                                    {
                                        <li class="avatar-user"><img class="profile_image" loading="lazy" src="@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></li>
                                    }
                                    else
                                    {
                                        <li class="avatar-user"><img class="profile_image" loading="lazy" src="/uploads/@Model.User.Photo" width="300" data-name="@Model.User.Name.Substring(0, 1)" /></li>
                                    }
                                    <li class="auth-displayname"><a class="item display-user">@Model.User.Name</a></li>
                                </ul>
                            </li>
                            @if (Model.IsAdmin)
                            {
                                <li class="info-user">
                                    <a class="item" href="~/Admin/Statistic/Index">@ViewResources.Administration</a>
                                </li>
                            }
                            <li class="info-user">
                                <a class="item" href="@Url.Action("ListSavedPosts", "Profile")">Tin đã lưu</a>
                            </li>
                            <li class="info-user auth-info"><a href="@Url.Action("Index", "Profile")" class="item">@ViewResources.MyAccount</a></li>
                            <li class="info-user auth-logout"><a href="~/Auth/Logout?returnUrl=@Context.Request.Path" class="item">@ViewResources.Logout<i class="icon-logout"></i> </a></li>
                        </ul>
                    }
                    else
                    {
                        <a class="item auth-login" href="javascript:;">@ViewResources.Login</a>
                    }
                </li>
            </ul>
        </div>
    </div>


</div>

<div class="top-header">
    <div class="container padding-mobile-none">
        <div class="group-menu">
            <div class="nav-menu">
                <ul class="main-menu" id="meumutilv">
                    <li class="menu-item hiden-icon-mobile">
                        <a href="/" class="item @(Model.CategorySlug == "/" ? "active" : "")"><i class="icon-home"></i></a>
                    </li>
                    @foreach (var menu in Model.Menus.Where(item => item.ParentId == 0))
                    {
                        var slug = menu.CateSlug;
                        var link = getMenuLink(menu);
                        if (menu.CateId != Constants.Home)
                        {
                            var activeMenu = (Model.CategorySlug != null && menu.Slug == Model.CategorySlug) ? "active" : "";
                            var lv2Menus = Model.Menus.Where(item => item.ParentId == menu.PostId);
                            <li class="menu-item">
                                <a href="@link" class="item @activeMenu">@menu.MenuTitle</a>
                                @if (menu.CateSlug == Constants.GuessSlug)
                                {
                                    <span class="marked-icon"></span>
                                }
                                @if (menu.PageSlug == Constants.MatchScheduleSlug)
                                {
                                    <ul>
                                        <li>
                                            <a href="@Url.Action("FavouriteMatch", "Soccer")">Trận đấu quan tâm</a>
                                        </li>
                                        <li><a href="@Url.Action("FavouriteLeague", "Soccer")">Giải đấu của tôi</a></li>
                                    </ul>
                                }
                                @{RenderSubMenu(Model.Menus, menu.PostId, link);}
                            </li>
                        }
                    }
                    <li class="right-header-section search-input">
                        <form action="/Search" method="post" id="search">
                            <input class="keyword-input search-box" id="search-keyword" type="text" placeholder="Tìm kiếm...">
                            <button type="submit" class="btn btn-search" aria-label="search">
                                <i class="icon-search"></i>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="child-mobile-menu">
    @{
        var count = 0;
        var menuLink = "";
        var arraySlugs = new string[] { };
        if (Model.Slugs != null && !string.IsNullOrEmpty(Model.Slugs.Slug1))
        {
            arraySlugs = new string[] { Model.Slugs.Slug1, Model.Slugs.Slug2 };
        }
        arraySlugs = arraySlugs.Where(slug => slug != null).ToArray();
    }
    <ul class="main-child-menu @(arraySlugs.Length > 0 ? "multilv-menu-mobile" : "")">
        <li class="menu-item">
            <a href="/" class="item @(Model.CategorySlug == "/" ? "active" : "")"><i class="icon-home"></i></a>
        </li>
        @foreach (var slug in arraySlugs)
        {
            if (slug == null) break;
            count++;
            var menu = Model.Menus.FirstOrDefault(item => item.CateSlug == slug);
            var coMenu = Model.Menus.Where(item => item.ParentId == menu.ParentId);
            menuLink = count == 1 ? getMenuLink(menu) : $"{menuLink}/{menu.CateSlug}";
            var active = count == arraySlugs.Length ? "active" : "";
            <li>
                <div class="menu-select @active">
                    <a href="@menuLink">@menu.MenuTitle</a>
                    <select class="select_ad" onChange="window.location.href=this.value">
                        @foreach (var item in coMenu)
                        {
                            var selected = menu.PostId == item.PostId ? "selected" : "";
                            var subLink = Url.Action("Category", "Home", new { slug1 = Model.Slugs.Slug1, slug2 = (string)null, slug3 = (string)null });
                            var link = item.ParentId == 0 ? getMenuLink(item) : $"{subLink}/{item.CateSlug}";

                            <!option class="@selected" @selected value="@link">@item.MenuTitle</!option>
                        }
                    </select>
                </div>
            </li>
        }
        @if (arraySlugs.Length == 0)
        {
            @foreach (var menu in Model.Menus.Where(item => item.ParentId == 0))
            {
                var slug = menu.CateSlug;
                var link = getMenuLink(menu);
                if (menu.CateId != Constants.Home)
                {
                    var activeMenu = (Model.CategorySlug != null && menu.Slug == Model.CategorySlug) ? "active" : "";
                    <li class="menu-item">
                        <a href="@link" class="item @activeMenu">@menu.MenuTitle</a>
                    </li>
                }

            }
        }

    </ul>
    @if (arraySlugs.Length == 0)
    { 
        <span class="icon-arrow scroll-mobile-menu"></span>
    }
    
</div>
@functions {
    private string getMenuLink(Menu menu, string oldLink = null)
    {
        if (menu == null) return null;
        var link = "/tin-the-thao/" + menu.CateSlug;
        link = oldLink == null ? link : oldLink + "/" + menu.CateSlug;
        if (menu.PageSlug == Constants.MatchScheduleSlug)
        {
            link = Url.Action("Index", "Soccer");
        }
        else if (menu.PageSlug == Constants.WarningSlug)
        {
            link = Url.Action("Warning", "Home");
        }
        else if (menu.CateSlug == Constants.VideoSlug)
        {
            link = Url.Action("Video", "Home", new { slug1 = (int?)null });
        }
        else if (menu.CateSlug == Constants.Euro2020Slug)
        {
            link = Url.Action("index", "Euro2020");
        }
        return link;
    }

    void RenderSubMenu(IEnumerable<Menu> Menus, Nullable<int> parentID, string link)
    {
        var subMenus = Menus.Where(item => item.ParentId == parentID);
        @if (subMenus.Count() > 0)
        {
            <ul>
                @foreach (var subMenu in subMenus)
                {
                    var subLink = $"{link}/{subMenu.CateSlug}";
                    var nextLevelMenu = Menus.Where(item => item.ParentId.Equals(subMenu.PostId)).Count();
                    <li>
                        <a href="@subLink">@subMenu.MenuTitle</a>
                        @if (nextLevelMenu > 0)
                        {
                            { RenderSubMenu(Menus, subMenu.PostId, subLink); }
                        }
                    </li>
                }
            </ul>
        }
    }
}
