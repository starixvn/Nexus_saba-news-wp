@using sabanews.Constants;
@model IEnumerable<Menu>
<section class="header">
	<div class="top-header">
		<div class="container padding-mobile-none">
			<div class="group-menu">
				<div class="logo">
					<a href="@Url.Action("Index", "Home")">
                        <img src="~/images/logo-2.svg" alt="saba-sport">
					</a>
				</div>
				<div class="button-mobile">
					<span class="line-mb"></span>
					<span class="line-mb"></span>
					<span class="line-mb"></span>
				</div>
				<div class="nav-menu">
					<ul class="main-menu">
						@foreach (var menu in Model.Where(p => p.ParentId == 0).ToList())
						{
							var link = Url.Action("Category", "Home", new { slug = (int?)null });
							if (menu.Slug == Constants.MatchScheduleSlug)
							{
								link = Url.Action("MatchSchedule", "Home");
							}
							else if (menu.ID == Constants.VideoIdPage)
							{
								link = Url.Action("Video", "Home", new { slug = (int?)null });
							}
							else if (menu.CatId == Constants.Home)
							{
								link = Url.Action("Index", "Home");
							}
							var activeMenu = menu.CatId == Convert.ToInt32(ViewData["CategoryId"]) ? "active" : "";
							var menuLv2 = Model.Where(p => p.ParentId == menu.ID).ToList();
							@if (menuLv2.Count == 0)
							{
								<li class="menu-item"><a href="@link" class="item @activeMenu">@menu.Name</a></li>
							}
							else
							{
								var selected = Model.Where(p => p.ParentId == menu.ID && p.CatId == Convert.ToInt32(ViewData["CategoryId"])).ToList();
								if (selected.Count > 0)
								{
									activeMenu = "active";
								}
								<li class="menu-item">
									<a href="@link" class="submenu item @activeMenu">@menu.Name</a>
									<span class="icon-chevron-right click-sub"></span>
									<ul class="menu-child">
										@foreach (var Lv2 in menuLv2)
										{
											link = Url.Action("Category", "Home", new { slug = Lv2.Slug });
											if (Lv2.ParentId == Constants.VideoIdPage)
											{
												link = Url.Action("Video", "Home", new { slug = Lv2.Slug });
											}
											var subActiveMenu = Lv2.CatId == Convert.ToInt32(ViewData["CategoryId"]) ? "active" : "";
											<li class="child-menu-item @subActiveMenu"><a href="@link" class="item-child">@Lv2.Name</a></li>
										}
									</ul>
								</li>
							}
						}
						<li class="search-input">
							<form asp-action="Search" method="get">
								<input name="keyword" id="keyword" type="text" placeholder="Tìm kiếm...">
								<button type="submit" class="btn btn-search" aria-label="search">
									<i class="icon-search"></i>
								</button>
							</form>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>