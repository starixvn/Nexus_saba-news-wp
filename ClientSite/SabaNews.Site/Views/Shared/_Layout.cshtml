    <div class="wapper">
        <partial name="_CookieConsentPartial" />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <div class="auth-form" id="auth-form"></div>

        @await Html.PartialAsync("_Footer.cshtml")
    </div>
    <div class="auth-form event-modal-home">
        <div class="modal" id="ChangeDomainModal" style="display:none">
            <div class="modal-content modal-auth event-modal-home">
                <div class="modal-warning">
                    <button type="button" class="close-login" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <div class="modal-body">
                        <a href="https://www.sabavnstore.com/" class="img-event">
                            <img src="~/images/event/ec_800x533.jpg" alt="Alternate Text" class="img-res" />
                        </a>
                        
                    </div>
                </div>
                 <label class="custom-checkbox-container">
                    <input type="checkbox" id="isHidePopupChangeDomain" />
                    <span class="checkmark"></span>
                    Không hiển thị nữa
                </label>
            </div>
        </div>
    </div>

    <div id="auth-form"></div>
    <input type="hidden" id="RootUrl" value="@Url.Content("~/")" />
    @Html.AntiForgeryToken()
