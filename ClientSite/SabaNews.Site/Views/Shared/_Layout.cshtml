        "@@id": "https://www.sabavn.com/",
        "logo": "https://www.sabavn.com/images/sabasports.svg",
        "image": "https://www.sabavn.com/images/sabasports.svg",
        "description": "SABAVN.com là một trang web tin tức bóng đá thể thao hàng đầu, cung cấp thông tin đáng tin cậy và cập nhật về các sự kiện thể thao quốc tế và trong nước.",
        "url": "https://www.sabavn.com/",
        "telephone": "0977928358",
        "priceRange": 0,
        "address": {
            "@@type": "PostalAddress",
            "streetAddress": "21 P. Thái Hà, Trung Liệt",
            "addressLocality": "Đống Đa",
            "addressRegion": "Hà Nội",
            "postalCode": "100000",
            "addressCountry": "VN"
        },
        "openingHoursSpecification": {
            "@@type": "OpeningHoursSpecification",
            "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday"
            ],
            "opens": "00:00",
            "closes": "23:59"
        },
        "sameAs": [
            "https://www.facebook.com/sabasportsvietnam",
            "https://twitter.com/sabavnsports",
            "https://www.linkedin.com/company/sabasports/",
            "https://www.tiktok.com/@@sabasportsvietnam",
            "https://www.pinterest.com/sabasportsvietnam/",
            "https://sabasports.tumblr.com/",
            "https://www.youtube.com/SABASportsVietnam",
            "https://sites.google.com/view/sabavn/",
            "https://sabasportsvietnam.blogspot.com/"
        ]
    }
    </script>
